+// "sturm_root+drang_root" (a bounded name list for the log).
+inline void part_list(unsigned mask,char (&out)[96]) noexcept {
+    out[0]=0;std::size_t at=0;
+    for(unsigned i=0;i<7;++i)if(mask&(1U<<i)){
+        const char* n=discovery::partNames[i];const std::size_t len=std::strlen(n);
+        if(at+len+2>=sizeof(out))break;
