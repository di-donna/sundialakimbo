+    }
+    bool phase(burst_phase::Snapshot& out) noexcept {
+        return current()&&burst_phase::read([](auto at,void* out,std::size_t bytes){return local_read(nullptr,at,out,bytes);},barrel(),out)&&current();
+    }
+    bool replace(std::uintptr_t at,const void* before,const void* after,std::size_t bytes) noexcept {
