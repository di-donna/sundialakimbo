+            rootHandle==h.self?1U:0U,hex(rootOffset),hex(coreSize),ch.tag,ch.kind,hex(ch.definition),hex(contentSize),hex(properties),
+            variant,overrideTag,projectile,hex(propertyPattern),flags,hex(barrelPattern),static_cast<double>(delay));
+        append(line,used," mag_handle_ok=%u mag_offset=%llX mag_def=%08X/%08X/%X/%u mag_e0=%08X/%08X/%08X/%08X mag_200=%u mag_204=%u",
+            magazineHandle==h.self?1U:0U,hex(magazineOffset),magazine[0],magazine[1],magazine[2],magazine[3],
+            capacity[0],capacity[1],capacity[2],capacity[3],ammo[0],ammo[1]);
+        // progress_ptr separates a null patternProgress (progress prints 0) from a zero one.
+        append(line,used," rk=%u progress_ptr=%llX single=%u origin_ok=%u origin=%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g aux_ok=%u aux=",
+            ratKing?1U:0U,hex(reinterpret_cast<std::uintptr_t>(a.patternProgress)),single?1U:0U,originRead?1U:0U,
+            static_cast<double>(origin.q.x),static_cast<double>(origin.q.y),static_cast<double>(origin.q.z),static_cast<double>(origin.q.w),
