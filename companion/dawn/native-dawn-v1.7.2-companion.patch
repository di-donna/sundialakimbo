+    std::byte* find(std::uintptr_t at,std::size_t count){
+        if(at>=asset&&at-asset<=data.size()&&count<=data.size()-(at-asset))return data.data()+at-asset;
+        if(at>=root&&at-root<=native.size()&&count<=native.size()-(at-root))return native.data()+at-root;
+        return nullptr;
+    }
+    template<class T>void put(std::uintptr_t at,T value){auto* p=find(at,sizeof(T));check(p!=nullptr,"fixture bounded write");std::memcpy(p,&value,sizeof(T));}
+    bool read(std::uintptr_t at,void* out,std::size_t count){const auto* p=find(at,count);if(!p)return false;std::memcpy(out,p,count);return true;}
+    explicit Fixture(unsigned mode):instance(mode==2?0x2bf0:0x2d10){
+        put<std::uint64_t>(asset,bytes);put<std::uint64_t>(asset+0x18,0x3200-0x18);
+        put(asset+0x80,tag);put<unsigned>(asset+0x84,0x80bfdfeb);put<std::uint64_t>(asset+0x88,0x3200);
+        put(asset+instance,std::array<unsigned,4>{tag,0x80803abe,definition,0});
+        put<std::int64_t>(asset+instance+0x10,static_cast<std::int64_t>(0xcd0)-instance-0x10);
+        put(asset+definition,std::array<unsigned,4>{tag,0x80803abd,instance,0});put(asset+definition+0x2e8,mode);
+        put(root,tag);put<std::uint64_t>(root+8,0x3200);put(root+36,handle);put(root+44,owner);
+        const auto live=root+instance-0x80;
+        put(live,std::array<unsigned,4>{tag,0x80803abe,definition,0});
+        put<std::int64_t>(live+0x10,static_cast<std::int64_t>(0xcd0)-instance-0x10);
+        for(unsigned i=0;i<3;++i){
+            const auto field=definition+0x10+i*0x20,property=0x6000+i*0x18;
+            put<std::uint64_t>(asset+field,property-field);put<unsigned>(asset+definition+0x340+i*0x10,i==1?0xffffffff:0x80bbaefc+i);
+            const auto at=live+0x20+i*0x30;
+            put(at+0xc,handle);put<std::uint64_t>(at+0x10,instance-0x80+0x20+i*0x30);
+            put(at+0x20,tag);put<unsigned>(at+0x24,0x808045c4);put<std::uint64_t>(at+0x28,property);
+        }
+        for(unsigned i=0;i<6;++i){
+            const auto at=0xb0+i*0x30,expression=0x5000+i*0x60;
+            const std::array<unsigned,4> header{tag,0x808089f6,expression,0};
+            put(asset+instance+at,header);put(live+at,header);
+            put<std::int64_t>(asset+instance+at+0x10,-static_cast<std::int64_t>(at)-0x10);
+            put<std::int64_t>(live+at+0x10,-static_cast<std::int64_t>(at)-0x10);
+            put(asset+expression,std::array<unsigned,4>{tag,0x808089f5,instance+at,0});
+        }
+        put<std::uint64_t>(live+0x204,~std::uint64_t{});put<unsigned>(live+0x20c,0xffffffff);
+    }
+    bool source(c::Source& out){return c::source([&](auto a,void* p,auto n){return read(a,p,n);},asset,tag,bytes,instance,out);}
+    bool live(const c::Source& source,c::Live& out){return c::live([&](auto a,void* p,auto n){return read(a,p,n);},source,root,handle,owner,content,out);}
+};
+void layouts(){
+    for(unsigned mode:{2u,3u}){
+        Fixture f(mode);c::Source source{};c::Live live{};
+        check(f.source(source)&&source.mode==mode,"fusion and bow typed source shape accepted");
+        check(f.live(source,live)&&live.controller==Fixture::root+f.instance-0x80&&live.phase==0,"initialized native context is owned by root allocation");
+        const auto baseline=f;const auto controller=live.controller;
+        for(unsigned field:{0u,4u,8u,0x10u}){
+            f=baseline;f.put<unsigned>(Fixture::asset+f.instance+field,0);check(!f.source(source),"typed serialized controller mismatch refuses");
+        }
+        f=baseline;check(f.source(source),"restore source");
+        for(unsigned i=0;i<6;++i)for(unsigned field:{0u,4u,8u,0x10u}){
+            f=baseline;f.put<unsigned>(Fixture::asset+f.instance+0xb0+i*0x30+field,0);
+            check(!f.live(source,live),"source expression ownership is rechecked before any native callback");
+            f=baseline;f.put<unsigned>(controller+0xb0+i*0x30+field,0);
+            check(!f.live(source,live),"live nested expression ownership cannot be borrowed");
+        }
+        for(unsigned i=0;i<3;++i)for(unsigned field:{0xcu,0x10u,0x20u,0x24u,0x28u}){
+            f=baseline;f.put<unsigned>(controller+0x20+i*0x30+field,0);
+            check(!f.live(source,live),"native property root handle, relocation offset, owner and definition checked");
+        }
+        for(auto at:{controller+0x210,Fixture::asset+f.instance+0x210}){
+            f=baseline;f.put<std::uint64_t>(at,8);check(!f.live(source,live),"unproved sequence child lifetime refuses");}
+        f=baseline;f.put<unsigned>(Fixture::root+36,Fixture::handle+1);check(!f.live(source,live),"reused root generation refuses");
+        f=baseline;f.put<unsigned>(controller+0x20c,Fixture::content+1);check(!f.live(source,live),"foreign content effect override refuses");
+        for(unsigned phase=0;phase<9;++phase){f=baseline;f.put<std::uint8_t>(controller+0x1d0,static_cast<std::uint8_t>(phase));
+            check(f.live(source,live)&&live.phase==phase,"all native charge phases read without fabricating transitions");}
+        f=baseline;f.put<std::uint8_t>(controller+0x1d0,9);check(!f.live(source,live),"unknown charge phase refuses");
+        f=baseline;unsigned count=0;
+        check(!c::live([&](std::uintptr_t at,void* p,std::size_t n){const auto ok=f.read(at,p,n);if(at==controller+0x204&&n==8&&++count==2){const std::uint64_t changed=0x100002000;std::memcpy(p,&changed,n);}return ok;},
+            source,Fixture::root,Fixture::handle,Fixture::owner,Fixture::content,live),"effect replacement during snapshot refuses stale borrowed ownership");
+    }
+}
+void ownership(){
+    c::Live left{0x100000,0x102b70,0x2001,0x2002,3,0x2003,0x100002100},right=left;
+    right.controller+=0x220;right.effect=0x200002101;
+    check(c::independent(left,right),"two distinct engine-owned contexts and effects can qualify");
+    right.effect=left.effect;check(!c::independent(left,right),"effect handle alias across hands refuses");
+    right.effect=~std::uint64_t{};check(c::independent(left,right),"one context may have no owned effect");
+    right.controller=left.controller+0x210;check(!c::independent(left,right),"overlapping controller memory refuses");
+    right.controller=left.controller;check(!c::independent(left,right),"one native controller cannot stand in for two contexts");
+    right.controller=left.controller+0x220;++right.handle;check(!c::independent(left,right),"different generation does not form a pair");
+}
+void stock(const std::filesystem::path& directory,bool appended){
+    for(const auto value:std::array<std::pair<unsigned,unsigned>,8>{{{0x81526485,0x2bf0},{0x81526490,0x2bf0},{0x8152676c,0x2bf0},
+        {0x80ff0140,0x2bf0},{0x81526493,0x2bf0},{0x81525326,0x2d10},{0x815252f0,0x2d10},{0x815252f5,0x2d10}}}){
+        char name[16]{};std::snprintf(name,sizeof(name),"%08X.bin",value.first);
+        std::ifstream stream(directory/name,std::ios::binary);check(bool(stream),"stock fixture exists");
+        std::vector<char> bytes{std::istreambuf_iterator<char>{stream},{}};check(bytes.size()<=0x1000000,"stock fixture bounded");c::Source result{};
+        const auto read=[&](std::uintptr_t at,void* out,std::size_t count){if(at<0x10000||at-0x10000>bytes.size()||count>bytes.size()-(at-0x10000))return false;std::memcpy(out,bytes.data()+at-0x10000,count);return true;};
+        check(c::source(read,0x10000,value.first,static_cast<unsigned>(bytes.size()),value.second,result),name);
+        if(appended){
+            const auto original=result;unsigned matches=0;
+            for(unsigned at=0x27b0;at+0x220<=original.rootDefinition;at+=8){
+                c::Source candidate{};
+                if(at!=value.second&&c::source(read,0x10000,value.first,static_cast<unsigned>(bytes.size()),at,candidate)){result=candidate;++matches;}
+            }
+            check(matches==1,"exactly one Rust-authored second charge subtree reads through native qualifier");
+            check(result.mode==original.mode&&result.instance!=original.instance&&result.definition!=original.definition,"authored contexts own separate mutable storage and definitions");
+            check(result.properties==original.properties,"immutable native property sources remain shared");
+            for(unsigned i=0;i<6;++i){
+                check(result.providerCounts[i]==original.providerCounts[i],"all dynamic expression providers copied");
+                if(result.providerCounts[i])check(result.providerStates[i]!=original.providerStates[i]&&result.providerDefinitions[i]!=original.providerDefinitions[i],"provider state and typed definitions are independently owned");
+            }
+        }
+    }
+}
+}
+int main(int argc,char** argv){layouts();ownership();if(argc>1)stock(argv[1],argc>2);std::printf("akimbo charge layout: %u checks passed\n",checks);}
