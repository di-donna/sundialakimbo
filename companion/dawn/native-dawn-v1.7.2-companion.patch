+// Independent magazine/reload accounting; no game process or private assets.
+#include "../src/client/hooks/akimbo/smg_magazines.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <memory>
+
+namespace a=dawn::client::hooks::akimbo;
+namespace m=a::smg_ammo;
+namespace {
+unsigned checks{};
+void check(bool value,const char* why){++checks;if(!value){std::fprintf(stderr,"FAIL %s\n",why);std::exit(1);}}
+struct NativeStore {
+    int rounds{20},stock{50};bool current{true},ignoreReserve{},ignoreLoaded{},retireAfterReserve{};
+    unsigned loadedWrites{},reserveWrites{},published{};
+    bool valid()const noexcept{return current;}
+    int loaded()const noexcept{return rounds;}
+    int reserve()const noexcept{return stock;}
+    void set_loaded(int n)noexcept{++loadedWrites;if(!ignoreLoaded)rounds=n;}
+    void set_reserve(int n)noexcept{++reserveWrites;if(!ignoreReserve)stock=n;if(retireAfterReserve)current=false;}
+    void publish()noexcept{++published;}
+};
+void transfers(){
+    NativeStore n;
+    check(m::transfer(n,20,50,7)&&n.rounds==27&&n.stock==43&&n.published==1,"native transfer conserves loaded plus reserve");
+    check(!m::transfer(n,20,50,7)&&n.loadedWrites==1&&n.reserveWrites==1,"changed native baseline cannot be overwritten");
+    n={};n.ignoreLoaded=true;
+    check(!m::transfer(n,20,50,7)&&n.rounds==20&&n.stock==50&&n.reserveWrites==2,"failed loaded setter refunds only our reserve debit");
+    n={};n.ignoreReserve=true;
+    check(!m::transfer(n,20,50,7)&&n.rounds==20&&n.stock==50&&!n.loadedWrites,"failed reserve setter cannot create loaded rounds");
+    n={};n.current=false;
+    check(!m::transfer(n,20,50,7)&&!n.loadedWrites&&!n.reserveWrites,"stale owner cannot receive any writes");
+    n={};n.retireAfterReserve=true;
+    check(!m::transfer(n,20,50,7)&&!n.loadedWrites&&n.reserveWrites==1,"owner change stops all subsequent native writes");
+    n={};check(m::transfer(n,20,50,0)&&!n.loadedWrites&&!n.reserveWrites,"unchanged combined count needs no native write");
+    for(int amount:{-1,51,401}){n={};check(!m::transfer(n,20,50,amount)&&!n.reserveWrites,"invalid transfer bounds fail before writing");}
+}
+void state(){
+    const m::Native owner{0x100000,0x1024d0,0x2001,0x2002,0x81a2990a};
+    m::State s;int reserve=100;
+    reserve-=s.initialize(owner,30,30,reserve,1000);
+    check(s.total()==60&&reserve==70,"initial left fill is charged exactly once");
+    for(unsigned i=0;i<10;++i)check(s.consume(1),"left spending");
+    for(unsigned i=0;i<5;++i)check(s.consume(2),"right spending");
+    const int conserved=s.total()+reserve;
+    check(s.rounds[0]==20&&s.rounds[1]==25,"each shot spends its selected magazine");
+    check(s.request(true,reserve,{1.f,2.f},2)==3,"R selects both non-full magazines");
+    check(!s.request(true,reserve,{1.f,2.f},2)&&s.duration[0]==1&&s.duration[1]==2,"holding R never restarts either timer");
+    for(unsigned t=1100;t<=2000;t+=100)reserve-=s.advance(t,reserve,true);
+    check(s.rounds[0]==30&&s.rounds[1]==25&&s.loading==2&&s.available()==1,"shorter left reload completes independently");
+    check(s.total()+reserve==conserved,"partial reload retains existing rounds and spends only its deficit");
+    check(s.consume(1)&&!s.consume(2)&&s.rounds[0]==29,"completed hand can fire while other hand reloads");
+    for(unsigned t=2100;t<=3000;t+=100)reserve-=s.advance(t,reserve,true);
+    check(s.rounds[0]==29&&s.rounds[1]==30&&!s.loading,"other reload completion cannot refill the firing hand");
+    check(s.total()+reserve==conserved-1,"both independent reloads conserve reserve including interleaved fire");
+
+    (void)s.initialize(owner,30,30,30,0);s.rounds[0]=20;s.rounds[1]=25;reserve=3;
+    check(s.request(true,reserve,{.5f,.5f},2)==3,"scarce reserves still allow both reload transitions");
+    for(unsigned t=100;t<=500;t+=100)reserve-=s.advance(t,reserve,true);
+    check(s.rounds[0]==23&&s.rounds[1]==25&&reserve==0&&!s.loading,"shared reserve is never overspent and existing rounds never disappear");
+    check(!s.request(false,10,{1.f,1.f},2)&&s.request(true,10,{1.f,1.f},1)==0,"explicit legacy policy remains empty-only");
+    s.rounds[0]=0;(void)s.request(false,10,2);
+    check(s.request(true,10,2)==1&&s.available()==2,"legacy empty-only path remains independent");
+    check(s.hidden(2)==0,"non-reloading hand stays visible");
+    (void)s.advance(600,10,true);check(s.hidden(1)>0,"only reloading hand lowers");
+    const auto elapsed=s.elapsed[0];(void)s.advance(800,10,false);(void)s.advance(10000,10,true);
+    check(s.elapsed[0]==elapsed,"focus loss and long stalls cannot complete a reload");
+    const int old=s.total();s.cancel();
+    check(!s.loading&&s.total()==old,"interrupt before completion neither removes rounds nor charges reserves");
+
+    (void)s.initialize(owner,30,45,0,0);check(s.rounds[0]==15&&s.rounds[1]==30,"restored combined native count is split without a second reserve charge");
+    check(s.consume(1)&&s.reconcile(44,30)&&s.rounds[0]==14&&s.rounds[1]==30,"observed native spend is not counted twice");
+    check(s.reconcile(46,30)&&s.rounds[0]==16&&s.rounds[1]==30,"native ammo refund is preserved in the affected hand");
+    check(s.request(true,10,{1.f,1.f},2)==1,"partial hand begins reload before external count change");
+    (void)s.advance(100,10,true);check(s.reconcile(46,30)&&s.loading==1&&s.elapsed[0]>0,"matching native store does not restart an active reload");
+    check(s.reconcile(40,30)&&s.total()==40&&!s.loading,"external native spend replaces stale cache and cancels affected transition");
+    check(s.reconcile(40,20)&&s.rounds[0]==20&&s.rounds[1]==20,"capacity reduction redistributes loaded rounds without deleting ammunition");
+    check(!s.reconcile(-1,20)&&!s.reconcile(41,20)&&!s.reconcile(1,0),"invalid native values cannot become HUD or firing state");
+
+    (void)s.initialize(owner,30,40,0,0);
+    // The native trigger has paid one round, but its zero-delay queued shot has
+    // not reached the emission hook when an intervening input pass is sampled.
+    s.defer_native(0x1234,3,1,true,100);
+    check(s.total()==40&&s.prepaidSide==2&&s.firing_mask(1)==2,"prepaid native event retains its original right hand after buttons change");
+    s.defer_native(0x1234,1,2,false,200);
+    check(s.prepaidSide==2&&!s.consume(1),"repeated input cannot reassign an existing native reservation");
+    check(s.consume(2)&&s.total()==39&&s.reconcile(39,30),"prepaid native decrement is assigned exactly once by the accepted ticket");
+    check(s.request(false,100,{1.f,2.f},2)==3,"R intent survives native queue retirement even after key release");
+    const auto phase=s.elapsed[0];
+    check(!s.advance(300,100,true,1.f,false)&&s.elapsed[0]>phase,"other hand's reload clock advances while native emission is pending");
+    for(unsigned t=400;t<=1300;t+=100)(void)s.advance(t,100,true,1.f,false);
+    check(s.rounds[0]==10&&s.loading==3,"pending native emission defers only reserve transfer, not reload progress");
+    check(s.advance(1400,100,true)==20&&s.rounds[0]==30&&s.loading==2,"deferred refill commits once native shot accounting is stable");
+    (void)s.initialize(owner,30,40,0,0);s.defer_native(0x2234,1,2,true,100);
+    check(s.reconcile(40,30)&&!s.prepaid&&s.firing_mask(2)==2,"canceled refunded queue retires its hand even when native total is unchanged");
+    check(s.request(false,100,{1.f,2.f},2)==1,"R intent survives canceled/refunded native emission without a consume callback");
+    (void)s.initialize(owner,30,40,0,0);s.defer_native(0x3234,1,2,true,100);
+    check(s.reconcile(39,30)&&!s.prepaid&&s.rounds[0]==9&&s.rounds[1]==30
+        &&s.request(false,100,{1.f,2.f},2)==1,"canceled prepaid queue assigns retained native cost to its reserved left hand and retains R");
+    (void)s.initialize(owner,30,40,0,0);s.lastSide=1;s.defer_native(0x3235,2,1,false,100);
+    check(s.reconcile(39,30)&&s.rounds[0]==10&&s.rounds[1]==29,"canceled right reservation cannot debit the previous left shot's magazine");
+    (void)s.initialize(owner,30,60,0,0);s.rounds[0]=20;
+    check(s.request(true,100,{1.f,2.f},2)==1,"only partial left begins independent reload");
+    for(unsigned t=100;t<=1000;t+=100){
+        check(!s.advance(t,100,true,1.f,false),"queued right shot defers native refill transfer");
+        s.defer_native(0x4000+t,2,2,false,t);
+        check(s.firing_mask(2)==2&&s.consume(2),"right continues to fire while left reloads");
+        check(s.reconcile(50-static_cast<int>(t/100),30)&&s.loading==1,"right native spend does not restart left reload");
+    }
+    check(s.elapsed[0]>=.999f&&s.rounds[0]==20&&s.rounds[1]==20,"continuous other-hand fire cannot freeze reload elapsed time");
+    check(s.advance(1100,100,true)==10&&s.rounds[0]==30&&s.rounds[1]==20&&!s.loading,"left transfer completes at the next safe pass without touching right rounds");
+    (void)s.initialize(owner,30,60,0,0);s.rounds[0]=20;
+    (void)s.request(true,100,{1.f,2.f},2);(void)s.advance(200,100,true);
+    const float leftElapsed=s.elapsed[0];s.defer_native(0x5331,2,2,false,200);
+    check(s.reconcile(49,30)&&s.rounds[0]==20&&s.rounds[1]==29&&s.loading==1
+        &&s.elapsed[0]==leftElapsed&&s.duration[0]==1,"canceled right debit preserves the left reload's elapsed time and duration");
+
+    m::Book book;auto& first=book.slot(owner);(void)first.initialize(owner,30,40,0,0);
+    check(first.request(true,100,{1.f,2.f},2)==1,"first owner starts only its non-full hand");
+    auto other=owner;++other.handle;other.root+=0x10000;other.magazine+=0x10000;
+    auto& second=book.slot(other);(void)second.initialize(other,30,50,0,0);book.cancel_except(other);
+    check(book.find(owner)->total()==40&&!book.find(owner)->loading&&book.find(other)->total()==50,"weapon swap cancels timing but preserves each owner's separate magazines");
+    auto replacement=owner;++replacement.handle;
+    check(!book.find(replacement),"reused address with another generation never inherits old counts");
+    s={};check(s.initialize(owner,30,61,0,0)<0&&!s.initialized,"invalid initialization leaves no usable state");
+}
+void conservation(){
+    for(int capacity:{1,30,40,200}){
+        m::State s;int reserve=10000;reserve-=s.initialize({},capacity,capacity,reserve,0);
+        const int initial=reserve+s.total();int fired=0;unsigned random=0x8127f395;
+        for(unsigned tick=1;tick<=4000;++tick){
