+   ++stage_;return Result::pending;
+  }
+  if(second_!=first_)return refuse("generation");
+  for(unsigned p=0;p<2;++p)if(!m.pool(974+p,now[p])||now[p]!=pools_[p])return refuse("pool_shape");
+  out=second_;reset();reason_="ok";return Result::accepted;
+ }
+public:
+ void reset() {pools_={};candidate_={};first_={};second_={};links_={};linkHeaders_={};linkCount_=cursor_=stage_=0;started_=linked_=false;}
+ const char* reason()const{return reason_;}unsigned cursor()const{return cursor_;}const Telemetry& telemetry()const{return stats_;}
+ Result poll(Memory& memory,std::uintptr_t base,std::uint64_t budgetTicks,Snapshot& out,unsigned readLimit=512) {
+  out={};const auto start=memory.clock();const auto saved=*this;stats_={};stats_.readLimit=readLimit;
+  BudgetMemory<Memory> limited(memory,start,budgetTicks,stats_);
+  const auto result=advance(limited,base,out);stats_.elapsedTicks=memory.clock()-start;
+  if(stats_.budgetExhausted) {
+   const auto measured=stats_;
+   // Completed scan cells remain useful; incomplete validation/startup is retried.
+   if(result!=Result::pending||saved.cursor_==16384)*this=saved;
+   stats_=measured;out={};return Result::pending;
+  }
+  return result;
+ }
+};
+}
