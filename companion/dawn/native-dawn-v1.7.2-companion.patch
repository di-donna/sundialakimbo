+
+namespace dawn::client::hooks::akimbo::inventory {
+struct Pose {std::array<float,4> q{},ts{};};
+static_assert(sizeof(Pose)==32);
+struct Identity {
+    std::uintptr_t animation{},skeleton{},body{},nodes{},sound{},entity{},parent{};
+    std::uint32_t animationHandle{},skeletonHandle{},bodyHandle{},owner{},parentOwner{},model{},spare{};
+    bool operator==(const Identity&) const = default;
+};
+// The preview's own animation and parent attachment qualify this separately
+// from the first-person 80-bone path. Only the three supported private sets pass.
+[[nodiscard]] bool identify(const Memory&,std::uintptr_t animation,Identity&) noexcept;
+// C86CD0 builds the render pass separately from C87150's resident update.
+// F5F210 then copies that stack context and its controls into the frame arena.
+[[nodiscard]] bool identify_render_source(const Memory&,std::uintptr_t animation,
+                                         std::uintptr_t context,Identity&) noexcept;
+[[nodiscard]] bool copied_render_job(const Memory&,const Identity&,
+                                    std::uintptr_t source,std::uintptr_t copy) noexcept;
+[[nodiscard]] bool correct_export(const Memory&,const Identity&,std::uintptr_t ranges,
+                                  std::uintptr_t outputs,unsigned mode,void* poses) noexcept;
+[[nodiscard]] bool valid_pose(const Pose&) noexcept;
+[[nodiscard]] Pose compose(const Pose&,const Pose&) noexcept;
+[[nodiscard]] Pose inverse(const Pose&) noexcept;
+[[nodiscard]] bool palette_pose(const Pose& handWorld,const Pose& handRest,
+                                const Pose& gripRest,const Pose& spareRest,Pose&) noexcept;
+class Jobs {
+    struct Job {std::uintptr_t key{};Identity id{};};
+    std::array<Job,64> jobs_{};
+public:
+    void erase(std::uintptr_t key) noexcept {for(auto& j:jobs_)if(j.key==key)j={};}
+    bool insert(std::uintptr_t key,const Identity& id) noexcept {
+        if(!key)return false;erase(key);
+        for(auto& j:jobs_)if(!j.key){j={key,id};return true;}return false;
+    }
+    bool take(std::uintptr_t key,Identity& id) noexcept {
+        for(auto& j:jobs_)if(j.key==key&&key){id=j.id;j={};return true;}return false;
+    }
+    void clear() noexcept {jobs_={};}
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/job_registry.h b/Dawn/src/client/hooks/akimbo/job_registry.h
new file mode 100644
index 0000000000000000000000000000000000000000..e97a9e90baacee6a138ba35d683bbee3ec04ddf9
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/job_registry.h
@@ -0,0 +1,26 @@
+#pragma once
+#include "identity.h"
+#include <array>
+namespace dawn::client::hooks::akimbo {
+/** External lock serializes all access. Only eligible Akimbo jobs are retained.
+ * Export consumes the record; re-preparing a reused context invalidates it first. */
+class JobRegistry {
+    struct Job {std::uintptr_t context{};Identity identity{};};
+    std::array<Job,256> jobs_{};
+    Identity generation_{};
+public:
+    void erase(std::uintptr_t key) noexcept {for(auto& job:jobs_)if(job.context==key)job={};}
+    bool insert(std::uintptr_t key,const Identity& id) noexcept {
+        if (!key) return false;
+        if (!(generation_==id)) {clear();generation_=id;}
+        erase(key);
+        for(auto& job:jobs_)if(!job.context){job={key,id};return true;}
+        return false;
+    }
+    bool take(std::uintptr_t key,Identity& id) noexcept {
+        for(auto& job:jobs_)if(job.context==key && key){id=job.identity;job={};return true;}
+        id={};return false;
+    }
+    void clear() noexcept {jobs_={};generation_={};}
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/pose_math.cpp b/Dawn/src/client/hooks/akimbo/pose_math.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b3a18230c8522ff81950cec44a236ec686985d7f
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/pose_math.cpp
@@ -0,0 +1,119 @@
+// No OS calls, allocation, CRT, or persistent state. Experimental full-arm
+// counterpart of whole_arm_placement.py at the verified pose-copy boundary.
+#include <xmmintrin.h>
+#ifdef ALIGN_BLOB
+extern "C" { int _fltused=0; }
+#endif
+struct V {float x,y,z;};
+struct Q {float x,y,z,w;};
+struct Pose {Q q;V p;float scale;};
+static_assert(sizeof(Pose)==32);
+#define INL inline
+INL V add(V a,V b){return {a.x+b.x,a.y+b.y,a.z+b.z};}
+INL V sub(V a,V b){return {a.x-b.x,a.y-b.y,a.z-b.z};}
+INL V mul(V a,float b){return {a.x*b,a.y*b,a.z*b};}
+INL float dot(V a,V b){return a.x*b.x+a.y*b.y+a.z*b.z;}
+INL V cross(V a,V b){return {a.y*b.z-a.z*b.y,a.z*b.x-a.x*b.z,a.x*b.y-a.y*b.x};}
+INL float root(float v){return _mm_cvtss_f32(_mm_sqrt_ss(_mm_set_ss(v)));}
+INL float length(V v){return root(dot(v,v));}
+INL V unit(V v){return mul(v,1/length(v));}
+INL Q norm(Q q){float n=1/root(q.x*q.x+q.y*q.y+q.z*q.z+q.w*q.w);return {q.x*n,q.y*n,q.z*n,q.w*n};}
+INL Q inv(Q q){q=norm(q);return {-q.x,-q.y,-q.z,q.w};}
+INL Q product(Q a,Q b){a=norm(a);b=norm(b);return norm({a.w*b.x+b.w*a.x+a.y*b.z-a.z*b.y,a.w*b.y+b.w*a.y+a.z*b.x-a.x*b.z,a.w*b.z+b.w*a.z+a.x*b.y-a.y*b.x,a.w*b.w-a.x*b.x-a.y*b.y-a.z*b.z});}
+INL V rotate(Q q,V v){q=norm(q);V u{q.x,q.y,q.z};return add(v,add(mul(cross(u,v),2*q.w),mul(cross(u,cross(u,v)),2)));}
+INL Q between(V a,V b){a=unit(a);b=unit(b);float d=dot(a,b);if(d<-.999999f){V axis{1,0,0};float ax=a.x*a.x,ay=a.y*a.y,az=a.z*a.z;if(ay<ax&&ay<=az)axis={0,1,0};else if(az<ax&&az<ay)axis={0,0,1};V v=unit(cross(a,axis));return {v.x,v.y,v.z,0};}V v=cross(a,b);return norm({v.x,v.y,v.z,1+d});}
+INL bool valid(float v){return v>-10000&&v<10000;}
+INL bool validPose(Pose p){float n=p.q.x*p.q.x+p.q.y*p.q.y+p.q.z*p.q.z+p.q.w*p.q.w;return n>.96f&&n<1.04f&&valid(p.p.x)&&valid(p.p.y)&&valid(p.p.z)&&p.scale>.95f&&p.scale<1.05f;}
+INL Pose shifted(Pose p,Q d,V oldOrigin,V newOrigin){p.q=product(d,p.q);p.p=add(newOrigin,rotate(d,sub(p.p,oldOrigin)));return p;}
+
+INL Pose mirrored(Pose left,Pose right,Q gun,Q gunInv,V origin,V destination,bool grip=false){
+    V relative=rotate(gunInv,sub(right.p,origin));relative.y=-relative.y;
+    left.p=add(destination,rotate(gun,relative));
+    Q relativeQ=product(gunInv,right.q);relativeQ.x=-relativeQ.x;relativeQ.z=-relativeQ.z;
+    left.q=product(gun,relativeQ);if(!grip)left.q=product(left.q,{0,1,0,0});return left;
+}
+
+// Mirror the firing grip and the left arm onto the companion gun 0.19 m along
+// the gun root's +y. The right gun keeps its native root (no placement), so a
+// resident pass cannot accumulate an offset. Shared by the 80-bone hand-cannon
+// rig and the 77-bone sidearm rig, whose nodes 0..72 are identical in hash,
+// parent and bind (SIDEARM-RIG.md 3.2).
+INL bool align_pair(Pose* p,unsigned mode,int boneCount,float reach=.75f){
+    if(mode!=0 && mode!=4)return false;
+    for(int i=0;i<boneCount;i++)if((mode==4 || i<25 || i==72) && !validPose(p[i]))return false;
+    const unsigned char bones[]={12,15,19,21,23,27,34,40,42,43,44,45,52,53,54,55,56,62,63,64,65,66};
+    const unsigned char rightBones[]={14,17,20,22,24,28,39,46,48,49,50,51,57,58,59,60,61,67,68,69,70,71};
+    const Pose rg=p[24];Q gun=norm(rg.q),gunInv=inv(gun);
+    V destination=add(rg.p,rotate(p[72].q,{0,.18999923943925734f,0}));
+    // Reject corrupt or degenerate input limbs before modifying the source.
+    float a=length(sub(p[19].p,p[15].p)),b=length(sub(p[21].p,p[19].p));
+    float ra=length(sub(p[20].p,p[17].p)),rb=length(sub(p[22].p,p[20].p));
+    if(!(a>.01f&&a<1&&b>.01f&&b<1&&ra>.01f&&ra<1&&rb>.01f&&rb<1))return false;
+    Pose output[22]; const int count=mode==0?5:22;
+    for(int i=0;i<count;i++){
+        output[i]=mirrored(p[bones[i]],p[rightBones[i]],gun,gunInv,rg.p,destination,bones[i]==23);
+        if(!validPose(output[i])||!(length(sub(output[i].p,p[bones[i]].p))<reach))return false;
+    }
+    for(int i=0;i<count;i++)p[bones[i]]=output[i];
+    return true;
+}
+extern "C" bool align_dual_pose(Pose* p, unsigned mode) {return align_pair(p,mode,80);}
+// Rat King Akimbo (sidearm rig 80BBDB9C, 77 bones): the copy art sits 0.19 m
+// along weapon +y, as Last Word/Thorn/Malfeasance; weapon bones 73..76 are
+// written by the alternating pose, never here. Runtime v4b: the native reload
+// (80BC865F) takes the support hand under and behind the gun: offline, keys
+// 22-24 and 51 of the decoded clip put a mirrored left bone 0.77-0.79 m from
+// the native one, past the 0.75 m corrupt-limb guard, which failed the whole
+// export (the frame stayed unedited and the reload recorder saw a gap). The
+// sidearm uses the SMG's 1.2 m reach instead.
+extern "C" bool align_sidearm_pose(Pose* p, unsigned mode) {return align_pair(p,mode,77,1.2f);}
+// Sturm & Drang Akimbo (80-bone hand-cannon rig, private model 81A29A19): the
+// same mirror as align_dual_pose, which lands the left grip exactly on Drang's
+// root (design-hand 1.2), with Rat King's 1.2 m reach: Sturm's native reload
+// takes its support hand far from the mirrored one, which the 0.75 m
+// corrupt-limb guard would reject for the whole export.
+extern "C" bool align_sturm_drang_pose(Pose* p, unsigned mode) {return align_pair(p,mode,80,1.2f);}
+
+// IKELOS has 77 bones. Mirror the firing grip and every skinned arm/finger
+// bone; its native support hand cannot hold the companion at the front rail.
+// Only completed render poses receive the lateral placement. Resident passes
+// can be revisited by native procedural code and must not accumulate offsets.
+INL bool align_smg_pose_impl(Pose* p,unsigned mode,float spacing,V placement,float reach,unsigned bones=77) {
+    if(!p)return false;
+    if((mode!=0&&mode!=4)||bones<74||bones>128)return false;
+    for(unsigned i=0;i<bones;++i)if((mode==4||i<25||i==72)&&!validPose(p[i]))return false;
+    const unsigned char left[]={12,15,19,21,23,27,34,40,42,43,44,45,52,53,54,55,56,62,63,64,65,66};
+    const unsigned char right[]={14,17,20,22,24,28,39,46,48,49,50,51,57,58,59,60,61,67,68,69,70,71};
+    const Pose grip=p[24];const Q gun=norm(grip.q),gunInv=inv(gun);
+    if(mode!=4)placement={};
+    const V destination=add(add(grip.p,rotate(p[72].q,{0,spacing,0})),placement);
+    const int count=mode==4?22:5;Pose output[22];
+    for(int i=0;i<count;++i){
+        output[i]=mirrored(p[left[i]],p[right[i]],gun,gunInv,grip.p,destination,left[i]==23);
+        if(!validPose(output[i])||length(sub(output[i].p,p[left[i]].p))>=reach)return false;
+    }
+    for(int i=0;i<count;++i){p[left[i]]=output[i];if(mode==4)p[right[i]].p=add(p[right[i]].p,placement);}
+    if(mode==4)for(unsigned i=72;i<bones;++i)p[i].p=add(p[i].p,placement);
+    return true;
+}
+extern "C" bool align_smg_pose(Pose* p,unsigned mode) {
+    if(!p)return false;
+    return align_smg_pose_impl(p,mode,.36f,mode==4?rotate(p[72].q,{0,-.08f,0}):V{},1.2f);
+}
+extern "C" bool align_generated_smg_pose(Pose* p,unsigned mode,float spacing,float x,float y,float z) {
+    const V placement{x,y,z};
+    if(!p||!validPose(p[72])||!(spacing>=.05f&&spacing<=.8f)||!valid(x)||!valid(y)||!valid(z)||length(placement)>=2)return false;
+    spacing*=p[72].scale;
+    // Keep the audited limb-distance guard after accounting for the bounded,
+    // intentional common shift and extra separation selected by the profile.
+    const float reach=1.2f+(mode==4?length(placement):0)+(spacing>.36f?spacing-.36f:0);
+    return align_smg_pose_impl(p,mode,spacing,placement,reach);
+}
+extern "C" bool align_generated_gun_pose(Pose* p,unsigned mode,unsigned bones,float spacing,float x,float y,float z) {
+    const V placement{x,y,z};
+    if(!p||bones<74||bones>128||!validPose(p[72])||!(spacing>=.05f&&spacing<=.8f)
+        ||!valid(x)||!valid(y)||!valid(z)||length(placement)>=2)return false;
+    spacing*=p[72].scale;
+    const float reach=1.2f+(mode==4?length(placement):0)+(spacing>.36f?spacing-.36f:0);
+    return align_smg_pose_impl(p,mode,spacing,placement,reach,bones);
+}
diff --git a/Dawn/src/client/hooks/akimbo/presentation.h b/Dawn/src/client/hooks/akimbo/presentation.h
new file mode 100644
index 0000000000000000000000000000000000000000..33f53c7e4d180aa52b68b8eff6013626d66c0ca0
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/presentation.h
@@ -0,0 +1,136 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include "profile_registry.h"
+
+namespace dawn::client::hooks::akimbo::presentation {
+struct Vec {float x{},y{},z{};};
+struct Quat {float x{},y{},z{},w{1};};
+struct Frame {Quat q;Vec p;float scale{1};};
+static_assert(sizeof(Frame)==32);
+inline Vec add(Vec a,Vec b){return {a.x+b.x,a.y+b.y,a.z+b.z};}
+inline Vec mul(Vec a,float s){return {a.x*s,a.y*s,a.z*s};}
+inline Vec cross(Vec a,Vec b){return {a.y*b.z-a.z*b.y,a.z*b.x-a.x*b.z,a.x*b.y-a.y*b.x};}
+inline Quat normalize(Quat q){float s=1/std::sqrt(q.x*q.x+q.y*q.y+q.z*q.z+q.w*q.w);return {q.x*s,q.y*s,q.z*s,q.w*s};}
+inline Quat product(Quat a,Quat b){return normalize({a.w*b.x+b.w*a.x+a.y*b.z-a.z*b.y,a.w*b.y+b.w*a.y+a.z*b.x-a.x*b.z,a.w*b.z+b.w*a.z+a.x*b.y-a.y*b.x,a.w*b.w-a.x*b.x-a.y*b.y-a.z*b.z});}
+inline Vec rotate(Quat q,Vec v){Vec u{q.x,q.y,q.z};return add(v,add(mul(cross(u,v),2*q.w),mul(cross(u,cross(u,v)),2)));}
+inline Frame compose(Frame a,Frame b){return {product(a.q,b.q),add(a.p,rotate(a.q,mul(b.p,a.scale))),a.scale*b.scale};}
+inline Frame inverse(Frame a){Quat q{-a.q.x,-a.q.y,-a.q.z,a.q.w};return {q,rotate(q,mul(a.p,-1/a.scale)),1/a.scale};}
+inline bool valid(Frame a){float n=a.q.x*a.q.x+a.q.y*a.q.y+a.q.z*a.q.z+a.q.w*a.q.w;return n>.96f&&n<1.04f&&std::isfinite(a.p.x)&&std::isfinite(a.p.y)&&std::isfinite(a.p.z)&&std::abs(a.p.x)<10&&std::abs(a.p.y)<10&&std::abs(a.p.z)<10&&a.scale>.95f&&a.scale<1.05f;}
+inline Frame blend(Frame a,Frame b,float t){
+    float sign=a.q.x*b.q.x+a.q.y*b.q.y+a.q.z*b.q.z+a.q.w*b.q.w<0?-1.0f:1.0f;
+    Quat q=normalize({a.q.x*(1-t)+b.q.x*t*sign,a.q.y*(1-t)+b.q.y*t*sign,a.q.z*(1-t)+b.q.z*t*sign,a.q.w*(1-t)+b.q.w*t*sign});
+    return {q,add(mul(a.p,1-t),mul(b.p,t)),a.scale*(1-t)+b.scale*t};
+}
+struct State {float hidden{},shownAim{};};
+// Aim belongs to the camera's generation-checked player owner. Animation,
+// model and first-person controller generations can change during a switch.
+// Capture every native camera update, including while a normal gun is drawn.
+struct AimSample {
+    unsigned owner{};float amount{};std::uint64_t sampledAt{};bool available{};
+    void set(unsigned o,float a,std::uint64_t now){
+        owner=o;amount=a;sampledAt=now;
+        available=o&&o!=0xffffffff&&std::isfinite(a)&&a>=0&&a<=1;
+    }
+    float get(unsigned o,std::uint64_t now) const {
+        return available&&owner==o&&now>=sampledAt&&now-sampledAt<=100?amount:0;
+    }
+};
+// Neutral standing Warden hip * inverse(neutral standing ADS), measured from
+// capture 20260910T221831Z (395 hip / 251 full-ADS samples). This is a sight
+// alignment offset, never fitted to the current jump/fall/recoil pose.
+// The caller's existing private-model/rig identity gate scopes this calibration.
+inline constexpr Frame sightAlignment{
+    {-.0126044773f,-.0024006722f,.0105139256f,.9998624012f},
+    {.0414469511f,-.0948222709f,-.0121531042f},1};
+// Native controller +0x2e0..+0x2ef. Elapsed time already includes playback speed.
+struct ActionClock {unsigned base{};float speed{1},duration{},elapsed{};};
+static_assert(sizeof(ActionClock)==16);
+inline bool firing_action(unsigned action,ActionClock clock,unsigned modelTag){
+    modelTag=profiles::behavior_tag(modelTag);
+    if(action==8||action==9)return true;
+    if(action==107&&clock.base==8)
+        return modelTag==0x81a295fdu||modelTag==0x81a295e0u
+            ||modelTag==0x81a29815u||modelTag==0x81a29897u;
+    // Native Malfeasance capture 20260915T143948: hip selector98 and ADS
+    // selector97 both retain base clock98. Qualify this pair by private model
+    // and clock; both presentation and alternating recoil must recognize it.
+    return modelTag==0x81a29897u&&(action==97||action==98)&&clock.base==98;
+}
+inline float smoothstep(float t){t=std::clamp(t,0.0f,1.0f);return t*t*(3-2*t);}
+inline bool reload_action(unsigned action,unsigned modelTag){
+    modelTag=profiles::behavior_tag(modelTag);
+    // Ace's native reload variant, captured on the private Ace model. Keep its
+    // clip (including the spin); only lower the assembled presentation frame.
+    return action==4||(action==99&&modelTag==0x81a295fdu);
+}
+inline bool reload_amount(unsigned action,ActionClock clock,float& hidden,unsigned modelTag=0){
+    modelTag=profiles::behavior_tag(modelTag);
+    hidden=0;
+    // Both selectors must still identify reload. A shot/cancel clears lowering
+    // on this very frame rather than leaving a hidden-gun recovery tail.
+    const bool aceClip=action==99&&modelTag==0x81a295fdu&&clock.base==4;
+    if(!reload_action(action,modelTag)||(clock.base!=action&&!aceClip))return true;
+    if(!std::isfinite(clock.elapsed)||!std::isfinite(clock.duration)||clock.duration<.5f
+        ||clock.duration>15||clock.elapsed<0||clock.elapsed>clock.duration+.1f)return false;
+    const float phase=clock.elapsed/clock.duration;
+    // Initial visual tuning: retain magazine exit, lower slowly, and return
+    // before the final insertion/recovery portion. Native clip progress makes
+    // this independent of frame rate and follows reload speed modifiers.
+    // Ace needs a longer visible opening and a gentler descent for its spin.
+    // Apply by model even if its runtime selects ordinary reload (4).
+    const bool ace=modelTag==0x81a295fdu;
+    hidden=smoothstep((phase-(ace?.20f:.12f))/(ace?.25f:.13f))
+        *(1-smoothstep((phase-.58f)/.14f));
+    return true;
+}
+// Native aim remains meaningful while the endpoints change from the outgoing
+// weapon to the incoming one. Do not turn it into zero just because that
+// intermediate zoom ratio is not the private Akimbo camera's 1.4 ratio.
+inline bool aim_from_zoom(float endpointA,float endpointB,float native,float& aim){
+    if(!std::isfinite(endpointA)||!std::isfinite(endpointB)||!std::isfinite(native))return false;
+    const float hip=std::max(endpointA,endpointB),ads=std::min(endpointA,endpointB);
+    if(hip<.6f||hip>2.4f||ads<.1f||hip-ads<.001f||native<ads-.002f||native>hip+.002f)return false;
+    aim=std::clamp((hip-native)/(hip-ads),0.0f,1.0f);
+    return true;
+}
+/** Native FOV endpoints remain unchanged; only the freshly computed output is adjusted. */
+inline bool zoom(float endpointA,float endpointB,float native,float& output,float& aim){
+    if(!aim_from_zoom(endpointA,endpointB,native,aim))return false;
+    const float hip=std::max(endpointA,endpointB),ads=std::min(endpointA,endpointB);
+    // Widening still requires the captured Akimbo ratio. Other guns and camera
+    // modes only supply their native aim sample; their FOV is not changed.
+    if(ads<.4f||std::abs(hip/ads-1.4f)>.015f)return false;
+    output=hip+(hip/1.12f-hip)*aim;
+    return true;
+}
+/** Operates only on a caller-owned copy of the shared presentation transform. */
+inline bool adjust(State& state,Frame controller,Frame weapon,unsigned action,float aim,ActionClock clock,Frame& output,unsigned modelTag=0){
+    if(!valid(controller)||!valid(weapon)||!std::isfinite(aim)||aim<0||aim>1)return false;
+    const bool firing=firing_action(action,clock,modelTag);
+    const bool reloading=reload_action(action,modelTag);
+    const bool drawing=action==3;
+    const bool stowing=action==5;
+    if(action!=0&&action!=1&&!reloading&&!firing&&!drawing&&!stowing)return false;
+    State next=state;
+    if(!reload_amount(action,clock,next.hidden,modelTag))return false;
+    // The native camera already blends ADS, and the supplied frame already
+    // contains draw/stow motion. A second action-clock fade removes alignment
+    // during draw, then snaps it back when the selector becomes idle/fire.
+    // Selector and clock updates need not occur together; neither is an aim
+    // source. Reload lowering alone continues to require its qualified clock.
+    const float shownAim=reloading?0:aim;
+    next.shownAim=shownAim;
+    output=controller;
+    if(shownAim>0){
+        // Blend only the sight offset. Native animated controller/weapon deltas
+        // remain intact at every fixed aim amount, including the first frame
+        // of airborne ADS or simultaneous ADS/fire. No pose history required.
+        output=compose(blend(Frame{},sightAlignment,shownAim),controller);
+    }
+    output.p.z-=1.3f*next.hidden;
+    if(!valid(output))return false;
+    state=next;return true;
+}
+}
