+template<class N> class Driver {
+    N& n_;Shared& s_;
+    std::atomic<bool> busy_{};
+    runtime::DriverThread thread_{};
+    // Driver-owned (only under busy_).
+    Consumer consumer_{};Cadence cadence_{};ammo::Reload reload_{};ammo::Ledger ledger_{};
+    discovery::Snapshot cache_{};std::uint64_t generation_{},revision_{};bool cacheValid_{};
+    std::uint32_t armEpoch_{};bool pendingTransfer_{},emptyHint_{};double pendingSince_{-1};unsigned consecutiveFail_{};std::uint64_t ticket_{};
+    RefuseGate refuseGate_{};float lastRate_{};double lastInterval_{kMinInterval};
