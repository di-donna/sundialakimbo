+    // Already exotic packets and unexpected sound sources pass through unchanged.
+    if(!model||packet[16]!=0x8152c86d||packet[17]!=0x80ef27b9||!presentation_owner(m,address))return false;
+    output[16]=model==0x81a295fd?0x80ef3ed4:0x80ef3ed0;
+    output[17]=model==0x81a295fd?0x80ef2795:0x80ef2631;modelTag=model;return true;
+}
+bool ace_materials(const Memory& m,std::uintptr_t address,const SoundPacket& packet,
+                   SoundPacket& output) noexcept {
+    output=packet;
+    // F3C9E0 places three dye/material parents at +0x2c/+0x30/+0x34. The
+    // default private Ace capture001603 has Warden's base trio; native Ace
+    // supplies the replacements. Capture233554 instead has First Frost, a
+    // socketed shader which must pass through unchanged.
+    if(private_presentation_model(packet)!=0x81a295fd
+        ||packet[11]!=0x80eeaf18||packet[12]!=0x80eeaf17||packet[13]!=0x80eeaf16
+        ||!presentation_owner(m,address))return false;
+    output[11]=0x80eeadd4;output[12]=0x80eeadd5;output[13]=0x80eeadd3;return true;
+}
+bool ace_reload_clips(const Memory& m,std::uintptr_t controller,std::uintptr_t output,
+                      const ClipPacket& packet,ClipPacket& replacement,Identity& id) noexcept {
+    replacement=packet;id={};
+    if(!identify_controller(m,controller,id)||id.modelTag!=0x81a295fd
+        ||output!=id.animation+0x350)return false;
+    // This exact binding is the one traced through B314B0 -> D5DFF0. Do not
+    // reinterpret another animation interface or a relocated subobject.
+    std::uint32_t interfaceTag{},input{},clips{};std::uint64_t offset{};
+    if(!read(m,id.animation+0xa60,interfaceTag)||interfaceTag!=0x80bab20f
+        ||!read(m,id.animation+0xa68,input)||input!=id.controllerHandle
+        ||!read(m,id.animation+0xa70,offset)||offset
+        ||!read(m,id.animation+0xd0,clips)||clips!=0x80bc862a)return false;
+    const auto count=at<std::uint8_t>(packet,0xa8),additive=at<std::uint8_t>(packet,0xa9);
+    if(!count||count>4||additive>4)return false;
+    unsigned seen=0,changes=0;
+    // A5D730 lays out base records at +0 (20 bytes each), their active indices
+    // at +0x50, and count at +0xa8. Additive records and weights stay intact.
+    for(unsigned n=0;n<count;++n){
+        const auto index=at<std::uint8_t>(packet,0x50+n);
+        if(index>=4||(seen&(1U<<index)))return false;
+        seen|=1U<<index;const auto record=index*20;
+        if(at<std::uint32_t>(packet,record+8)!=4)continue;
+        const float weight=at<float>(packet,record+12),time=at<float>(packet,record+16);
+        if(at<std::uint32_t>(packet,record)!=0xffffffff||at<std::uint32_t>(packet,record+4)!=0xffffffff
+            ||!std::isfinite(weight)||weight<0||weight>1.001f
+            ||!std::isfinite(time)||time<0||time>15)return false;
+        ++changes;
+    }
+    if(!changes||!still_current(m,id))return false;
+    for(unsigned n=0;n<count;++n){
+        const auto action=at<std::uint8_t>(packet,0x50+n)*20+8;
+        if(at<std::uint32_t>(packet,action)==4){const std::uint32_t ace=99;std::memcpy(replacement.data()+action,&ace,sizeof(ace));}
+    }
+    return true;
+}
+bool reload_profile(const Memory& m,std::uintptr_t address,std::uintptr_t original,
+                    const Identity& id,std::uintptr_t& selected) noexcept {
+    selected=original;
+    std::uint32_t index{},group{},sounds{};
+    if(id.modelTag==0x81a295fdu){index=35;group=0x5267f9df;sounds=0x80ef3ed4;}
+    else if(id.modelTag==0x81a295e0u){index=47;group=0x4784f884;sounds=0x80ef3ed0;}
+    else return false;
+    Header h{};
+    if(!header(m,address,h)||h.tag!=0x8152ac57||h.kind!=0x80804221
+        ||h.owner!=id.modelOwner||h.definition!=1432)return false;
+    std::uintptr_t asset{};std::uint64_t bytes{},count{},relative{},headerCount{};
+    std::uint32_t arrayClass{},current{},key{},animationGroup{},rig{},bank{};
+    // The pinned native asset tag uses resource pool2709. Dynamic component
+    // identity keeps its original2048-pool bound; only this asset read extends it.
+    if(!resolve(m,h.tag,asset,4096)||!read(m,asset,bytes)||bytes!=16544)return false;
+    const auto definition=asset+1432;
+    if(!read(m,definition+0x588,count)||count!=57
+        ||!read(m,definition+0x590,relative)||relative>16544)return false;
+    const auto array=definition+0x590+relative;
+    if(array!=asset+3200||!read(m,array,headerCount)||headerCount!=count
+        ||!read(m,array+8,arrayClass)||arrayClass!=0x80803e72
+        ||!read(m,address+0x504,current))return false;
+    const auto expected=current<count?array+16+current*232:definition+0x4a0;
+    if(original!=expected)return false;
+    const auto target=array+16+index*232;
+    if(!read(m,target,key)||key!=group||!read(m,target+108,animationGroup)||animationGroup!=group
+        ||!read(m,target+120,rig)||rig!=0x80bc8631
+        ||!read(m,target+152,bank)||bank!=sounds)return false;
+    selected=target;return true;
+}
+bool identify_skeleton(const Memory& m, std::uintptr_t skeleton, Identity& result) noexcept {
+    result={}; Header h{};std::uint32_t handle{};std::uintptr_t animation{};
+    return header(m,skeleton,h) && h.kind==0x80808546
+        && read(m,skeleton+0x68,handle) && resolve(m,handle,animation)
+        && identify(m,animation,result) && result.skeleton==skeleton;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/identity.h b/Dawn/src/client/hooks/akimbo/identity.h
new file mode 100644
index 0000000000000000000000000000000000000000..1dde7103f055a4a292c7251f81990ed65231edef
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/identity.h
@@ -0,0 +1,106 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include "profile_registry.h"
+
+namespace dawn::client::hooks::akimbo {
+using Reader = bool (*)(void*, std::uintptr_t, void*, std::size_t) noexcept;
+struct Memory {
+    void* context{};
+    Reader read{};
+    std::uintptr_t tablesSlot{};
+};
+struct Identity {
+    std::uintptr_t animation{}, skeleton{}, rig{}, controller{}, model{}, nodes{};
+    std::uint32_t animationHandle{}, skeletonHandle{}, rigHandle{}, controllerHandle{}, modelHandle{}, owner{}, modelOwner{}, modelTag{};
+    bool operator==(const Identity&) const = default;
+};
+// First-person rig families. Keyed on animation/skeleton tags, never on weapon
+// class: Drang-type sidearms run on the hand-cannon rig (rat_king.h).
+// Only these two private art graphs carry alternating per-hand vertex programs.
+[[nodiscard]] inline constexpr bool alternating_model(std::uint32_t tag) noexcept {
+    return profiles::is(tag,profiles::Adapter::thorn)||profiles::is(tag,profiles::Adapter::malfeasance);
+}
+[[nodiscard]] inline constexpr bool generic_gun_model(std::uint32_t tag) noexcept {const auto* p=profiles::find(tag);return p&&profiles::generic(p->adapter);}
+[[nodiscard]] inline constexpr bool finite_burst_model(std::uint32_t tag) noexcept {return profiles::is(tag,profiles::Adapter::finiteBurst);}
+[[nodiscard]] inline constexpr bool smg_model(std::uint32_t tag) noexcept {return profiles::is(tag,profiles::Adapter::ikelos)||generic_gun_model(tag);}
+// Rat King Akimbo (rat_king.h): the sidearm rig, one scale-coded marker on
+// weapon bone 1 and Thorn-style alternating firing. 81A29990 is the SEPARATED
+// build's slot-1 model only: the pose, marker and weapon-merge edits assume
+// its patched single-marker shaders. The static-pair build ignores markers, so
+// its generator (rk_dryrun.py static) mints slot-1 model 81A29991 instead,
+// which no path accepts; tests-sidearm\research\check_constants.py pins both.
+[[nodiscard]] inline constexpr bool sidearm_model(std::uint32_t tag) noexcept {return profiles::is(tag,profiles::Adapter::ratKing);}
+// Sturm & Drang Akimbo (sturm_drang_pose.h): the hand-cannon rig, Sturm (right)
+// native, Drang (left) placed by one scale-coded marker (family-D code
+// 1.03515625+mask/512) on weapon bone 5 = full-pose bone 77. 81A29A19 is the
+// item's only unique model (v5c BUILD-REPORT 2); its controller-list siblings
+// 81A29A1B/81A29A1D (slots 5 and 21) are never accepted.
+[[nodiscard]] inline constexpr bool sturm_drang_model(std::uint32_t tag) noexcept {return profiles::is(tag,profiles::Adapter::sturmDrang);}
+// One native shot per trigger event, alternating guns (dispatch_single).
+[[nodiscard]] inline constexpr bool alternating_firing(std::uint32_t tag) noexcept {return alternating_model(tag)||sidearm_model(tag);}
+[[nodiscard]] inline constexpr bool separated_model(std::uint32_t tag) noexcept {return alternating_model(tag)||smg_model(tag)||sidearm_model(tag)||sturm_drang_model(tag);}
+// The rig class a private model must be drawn on. Callers pass accepted models only.
+[[nodiscard]] inline constexpr RigClass rig_class(std::uint32_t tag) noexcept {
+    const auto* entry=profiles::find(tag);
+    return entry?profiles::rig_for(entry->adapter).kind:RigClass::none;
+}
+[[nodiscard]] inline constexpr unsigned pose_bones(std::uint32_t tag) noexcept {
+    const auto* p=profiles::find(tag);return p&&profiles::generic(p->adapter)?72+p->pose.weaponBoneCount:smg_model(tag)||sidearm_model(tag)?77u:80u;
+}
+[[nodiscard]] inline constexpr unsigned pose_controls(std::uint32_t tag) noexcept {
+    const auto* p=profiles::find(tag);return p&&profiles::generic(p->adapter)?p->pose.controlCount:pose_bones(tag)-2;
+}
+[[nodiscard]] inline constexpr unsigned weapon_resident_bones(std::uint32_t tag) noexcept {
+    const auto* p=profiles::find(tag);return p&&profiles::generic(p->adapter)?p->pose.markerBone+1:1u;
+}
+[[nodiscard]] inline constexpr unsigned weapon_procedural_start(std::uint32_t tag) noexcept {return 72+weapon_resident_bones(tag);}
+// Full-pose bone carrying the scale-coded right/single marker. Never 74/75 on the sidearm.
+[[nodiscard]] inline constexpr unsigned marker_bone(std::uint32_t tag) noexcept {
+    const auto* p=profiles::find(tag);return p&&profiles::generic(p->adapter)?72+p->pose.markerBone:sidearm_model(tag)?73u:sturm_drang_model(tag)?77u:75u;
+}
+// Rigs whose completed pose carries ONE scale-coded marker (smg_signals.h code)
+// on marker_bone(): IKELOS, Rat King and Sturm & Drang. Thorn/Malfeasance carry two.
+[[nodiscard]] inline constexpr bool single_marker_model(std::uint32_t tag) noexcept {
+    return smg_model(tag)||sidearm_model(tag)||sturm_drang_model(tag);
+}
+[[nodiscard]] inline constexpr unsigned alternating_left_bone(std::uint32_t tag) noexcept {
+    return profiles::is(tag,profiles::Adapter::malfeasance)?4u:5u;
+}
+/** Exact private Akimbo models only, including the separate Malfeasance copy.
+ * Presence elsewhere in the equipment graph does not satisfy this gate.
+ * Native models and the single First Curse port are deliberately absent. */
+[[nodiscard]] bool identify(const Memory&, std::uintptr_t animation, Identity&) noexcept;
+/** The same exact private model list identify() accepts (read-only probes skip these). */
+[[nodiscard]] bool akimbo_model_tag(std::uint32_t tag) noexcept;
+[[nodiscard]] bool identify_skeleton(const Memory&, std::uintptr_t skeleton, Identity&) noexcept;
+[[nodiscard]] bool still_current(const Memory&, const Identity&) noexcept;
+[[nodiscard]] bool identify_controller(const Memory&,std::uintptr_t controller,Identity&) noexcept;
+[[nodiscard]] bool identify_controller_handle(const Memory&,std::uint32_t controller,Identity&) noexcept;
+[[nodiscard]] bool matches_component(const Memory&,std::uintptr_t,std::uint32_t tag,std::uint32_t kind,std::uint32_t owner) noexcept;
+// A native Thorn barrel belonging to the currently selected private Thorn
+// model. Embedded barrels have a parent link, not a standalone component header.
+// This reads identity/content only; it does not replace projectiles or patterns.
+[[nodiscard]] bool native_thorn_barrel(const Memory&,std::uintptr_t barrel,const Identity&) noexcept;
+// Native-based private Thorn, Last Word, Malfeasance, IKELOS and Rat King; each
+// core/content/projectile tuple is pinned to its own single-projectile configuration.
+[[nodiscard]] bool native_akimbo_barrel(const Memory&,std::uintptr_t barrel,const Identity&) noexcept;
+/** Select an existing native presentation profile for this exact private owner.
+ * The original result is validated; weapon gameplay and shared assets are read-only. */
+[[nodiscard]] bool reload_profile(const Memory&,std::uintptr_t component,std::uintptr_t original,
+                                  const Identity&,std::uintptr_t& selected) noexcept;
+// Native BD6E80 copies this packet into presentation component +0x30, then
+// starts its normal resource update. Sound and material selection operate on
+// caller-owned copies; each changes only its own resource fields.
+using SoundPacket = std::array<std::uint32_t,18>;
+[[nodiscard]] bool exotic_sounds(const Memory&,std::uintptr_t component,const SoundPacket&,
+                                SoundPacket& output,std::uint32_t& modelTag) noexcept;
+[[nodiscard]] bool ace_materials(const Memory&,std::uintptr_t component,const SoundPacket&,
+                                SoundPacket& output) noexcept;
+// Native D5DFF0 produces four base and four additive clip records plus active
+// index lists. Qualify the exact caller-owned first-person output before edits.
+using ClipPacket = std::array<std::byte,0xac>;
+[[nodiscard]] bool ace_reload_clips(const Memory&,std::uintptr_t controller,std::uintptr_t output,
+                                   const ClipPacket&,ClipPacket& replacement,Identity&) noexcept;
+}
diff --git a/Dawn/src/client/hooks/akimbo/inventory.cpp b/Dawn/src/client/hooks/akimbo/inventory.cpp
