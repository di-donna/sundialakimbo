+    std::uint32_t flags{};                             // bit0 action, bit1 clock, bit2 controller, bit3 weapon read
+    std::uint32_t modelOwner{},animationSelf{},rangeCount{};
+    std::array<std::uint16_t,16> ranges{};             // 4 x {index,start,count,flags} at ranges+4
+    std::uint32_t reserved{};
+};
