+// A pinned local selector of 80EF42E3, with its binding byte, particle and the
+// binding table entry (type 3, mask 0x22, capacity, marker hash) re-read.
+inline bool selector(const Memory& m,const firing_effects::Sequence& s,std::uintptr_t address,Selector& out) noexcept {
+    out={};if(s.profile!=&firing_effects::ratKingGlow)return false;
+    for(const auto& item:selectors){
+        if(address!=s.native.asset+item.offset)continue;
+        std::uintptr_t payload{},table{};std::uint8_t binding{};unsigned tag{};std::array<unsigned,4> entry{};
