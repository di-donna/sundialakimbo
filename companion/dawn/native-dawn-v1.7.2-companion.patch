index 0000000000000000000000000000000000000000..404f1c0ba2ff4e325b4b63e662b1bb2208e95268
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/smg.h
@@ -0,0 +1,304 @@
+#pragma once
+#include "effects.h"
+#include "smg_signals.h"
+#include "smg_placement.h"
+
+namespace dawn::client::hooks::akimbo::smg {
+using namespace presentation;
+inline constexpr unsigned left=1,right=2,both=3;
+inline constexpr float spacing=.36f,placement=-.08f;
+inline constexpr Frame weaponBind3{{.5000000596f,.5f,.5000000596f,.5000000596f},{.05381997675f,0,.15486507118f},1};
+inline constexpr Frame rightOffset{{},{0,placement,0},1},leftOffset{{},{0,placement+spacing,0},1};
+// User 2026-09-26: "Fix running animation with akimbo ikelos (they both should be visible and held
+// lower). Fix both bolts not reciprocating and weird behavior where one gun copies the others recoil".
+// Gun-root axes: +x toward the muzzle, +y to the left, +z up.
+// A. Firing base. The native fire clip is one clock for both guns: every shot restarts it and its root
+//    recoil builds to ~51 mm back, ~1.1 deg roll and ~0.7 deg muzzle rise, settling ~0.7 s after the
+//    last shot (candidate-4 fixture, 943 native frames). While it can still play, both guns ride the
+//    idle hold and each kicks only from its own shots.
+inline constexpr std::uint64_t baseSettleMs=650,baseReleaseMs=150;
+inline constexpr float kickBackMeters=.040f,kickRollDegrees=1.1f,kickRiseDegrees=.7f;
+inline constexpr float kickPeakMs=25,kickReturnMs=130,kickStackLimit=1.3f;
+inline constexpr unsigned kickHistory=6;
+// B. Bolt: weapon bone 1 (pose 73) slides along the root's +x, 44 mm ~8 ms after the shot and home
+//    by ~100 ms (the same fixture). One bone serves both guns, so only the gun that fired last
+//    unfreezes its moving parts (marker mask) and the bolt follows that gun's own shot time.
+struct BoltKnot {float ms{},meters{};};
+inline constexpr std::array<BoltKnot,12> boltCurve{{{0,.008f},{8,.045f},{24,.045f},{32,.0425f},{40,.040f},{48,.031f},
+    {56,.023f},{64,.017f},{72,.011f},{80,.0075f},{90,.002f},{100,0}}};
+// C. Sprint: selectors 8 (enter), 10 and 11 (loop), 9 (exit) (live capture 2026-09-26). The native
+//    sprint turns the gun across the view and swings the copy out of it; both guns ride the idle hold
+//    instead, lowered and pitched down, with both arms carried along.
+//    User on the first build: "the running animation jumps too much" (the trace: an 11 cm / 24 deg drop
+//    in 150 ms, the rise in 200 ms, and a 2 cm sideways jolt of the native common root at the loop
+//    start). A smaller drop, slower eased blends, and only a quarter of the native root's motion.
+inline constexpr float sprintDropMeters=.06f,sprintPitchDegrees=14.f,sprintInMs=300,sprintOutMs=300;
+inline constexpr float sprintRootFollow=.25f,sprintTakeInMs=16,sprintTakeOutMs=150;
+inline constexpr float sprintNearMeters=.02f,sprintNearDegrees=6.f;
+inline constexpr bool sprint_action(unsigned action) noexcept {return action==8||action==10||action==11;}
+inline constexpr bool sprint_exit(unsigned action) noexcept {return action==9;}
+inline constexpr float degrees_to_radians(float d) noexcept {return d*.01745329252f;}
+inline Quat axis_quat(Vec axis,float radians) noexcept {
+    const float s=std::sin(radians*.5f);return {axis.x*s,axis.y*s,axis.z*s,std::cos(radians*.5f)};
+}
+// C1 continuous: 0 at the shot, 1 at kickPeakMs, raised-cosine return to 0 at kickPeakMs + kickReturnMs.
+inline float kick_response(float ageMs) noexcept {
+    if(!(ageMs>=0)||ageMs>=kickPeakMs+kickReturnMs)return 0;
+    if(ageMs<kickPeakMs){const float u=ageMs/kickPeakMs;return u*u*std::exp(2*(1-u));}
+    return .5f*(1+std::cos(3.14159265f*(ageMs-kickPeakMs)/kickReturnMs));
+}
+// Gun-local kick: back along the barrel, muzzle rise, roll outward (mirrored for the left gun).
+inline Frame kick_frame(float amount,bool isLeft) noexcept {
+    Frame f{};
+    const Quat roll=axis_quat({1,0,0},degrees_to_radians(kickRollDegrees*amount)*(isLeft?-1.f:1.f));
+    const Quat rise=axis_quat({0,1,0},-degrees_to_radians(kickRiseDegrees*amount));
+    f.q=product(rise,roll);f.p={-kickBackMeters*amount,0,0};return f;
+}
+inline float bolt_meters(float ageMs) noexcept {
+    if(!(ageMs>=0)||ageMs>=boltCurve.back().ms)return 0;
+    for(std::size_t i=1;i<boltCurve.size();++i)if(ageMs<boltCurve[i].ms){
+        const auto a=boltCurve[i-1],b=boltCurve[i];return a.meters+(b.meters-a.meters)*(ageMs-a.ms)/(b.ms-a.ms);
+    }
+    return 0;
+}
+inline float frame_angle_degrees(Frame a,Frame b) noexcept {
+    const Quat d=product(Quat{-a.q.x,-a.q.y,-a.q.z,a.q.w},b.q);
+    return 2*std::atan2(std::sqrt(d.x*d.x+d.y*d.y+d.z*d.z),std::abs(d.w))*57.2957795f;
+}
+// CB43E0 returns the native inter-shot interval. CD06B1 stores that return
+// in the automatic-fire countdown. One event still spends one native round.
+inline float interval(float native,unsigned held) noexcept {
+    return held==both&&std::isfinite(native)&&native>=.005f&&native<=2?native*.5f:native;
+}
+// 4A7F50's two bindings are ORed by the native gameplay action evaluator.
+// These are game key codes, not Win32 virtual keys. No persistent rebinding.
+inline unsigned binding(unsigned slot,unsigned action,unsigned original,bool eligible) noexcept {
+    if(!eligible||slot>1||action>2)return original;
+    return action==0?(slot==0?109u:111u):116u;
+}
+inline unsigned buttons(int leftHeld,int rightHeld) noexcept {
+    return (leftHeld>0?left:0u)|(rightHeld>0?right:0u);
+}
+struct Input {
+    Identity identity{};unsigned mask{},last{};std::uint64_t at{},heldAt{};
+    void sample(const Identity& id,unsigned value,std::uint64_t now) noexcept {
+        if(identity!=id)*this={};
+        identity=id;mask=value&both;at=now;
+        if(mask){last=mask;heldAt=now;}
+    }
+    unsigned held(const Identity& id,std::uint64_t now) const noexcept {
+        return smg_model(id.modelTag)&&identity==id&&now>=at&&now-at<=100?mask:0;
+    }
+    unsigned firing(const Identity& id,std::uint64_t now) const noexcept {
+        if(!smg_model(id.modelTag)||identity!=id||now<at||now-at>100)return 0;
+        // A committed native event can follow its button release by one frame.
+        return mask?mask:now>=heldAt&&now-heldAt<=100?last:0;
+    }
+};
+struct Ticket {Identity identity{};std::uint64_t serial{};unsigned side{};bool valid{};};
+struct State {
+    Identity identity{};unsigned mask{};std::uint64_t shotAt{};bool ready{},hasShot{};
+    std::uint64_t serial{};unsigned pending{};bool busy{};
+    effects::Sample sample{};
+    Frame neutral{},rightGrip{},leftGrip{};
+    std::array<Frame,22> rightRest{},leftRest{};
+    // handShotAt / shots: index 0 the left gun, 1 the right gun (the mask bit order). recentMask: the
+    // sides whose last shot still holds the firing base.
+    std::array<std::uint64_t,2> handShotAt{};unsigned recentMask{};
+    std::array<std::array<std::uint64_t,kickHistory>,2> shots{};std::array<unsigned,2> nextShot{};
+    std::array<Frame,2> gunRoots{};std::uint64_t gunAt{};
+    // Idle samples: the bolt relative to the root, and both arms relative to the common root.
+    Frame boltRest{},idleRoot{};std::array<Frame,22> rightArmHold{},leftArmHold{};
+    float sprintWeight{},sprintTake{};std::uint64_t sprintAt{};
+    void select(const Identity& id) noexcept {if(identity!=id){*this={};identity=id;}}
+    void fired(const Identity& id,unsigned side,std::uint64_t now) noexcept {
+        select(id);if(!smg_model(id.modelTag)||!side||side>both)return;
+        mask=side;shotAt=now;hasShot=true;
+        for(unsigned i=0;i<2;++i)if(side&(1u<<i)){
+            handShotAt[i]=now;recentMask|=1u<<i;shots[i][nextShot[i]]=now;nextShot[i]=(nextShot[i]+1)%kickHistory;
+        }
+    }
+    // The stacked kick of one gun (0 left, 1 right) from its own remembered shots.
+    float kick_amount(unsigned index,std::uint64_t now) const noexcept {
+        float sum=0;
+        for(const auto at:shots[index])if(at&&at<=now)sum+=kick_response(static_cast<float>(now-at));
+        return std::min(sum,kickStackLimit);
+    }
+    Ticket begin(const Identity& id,unsigned held) noexcept {
+        select(id);
+        if(!smg_model(id.modelTag)||!held||held>both||busy)return {};
+        // Both held: one native shot per half interval, alternating barrels.
+        // A failed event does not advance the selected side.
+        pending=held==both?(mask==left?right:left):held;busy=true;
+        return {id,++serial,pending,true};
+    }
+    void finish(const Ticket& ticket,bool emitted,std::uint64_t now) noexcept {
+        if(!ticket.valid||ticket.identity!=identity||ticket.serial!=serial||!busy||ticket.side!=pending)return;
+        busy=false;pending=0;if(emitted)fired(identity,ticket.side,now);
+    }
+    effects::Sample effect_sample(const Identity& id,std::uint64_t now,bool& isLeft) const noexcept {
+        isLeft=identity==id&&(busy?pending:mask)==left;
+        if(sample.identity==id&&now>=sample.at&&now-sample.at<=100)return sample;
+        if(!profiles::legacy(id.modelTag))return {};
+        return {id,now,rightOffset,leftOffset};
+    }
+    bool gun_root(const Identity& id,unsigned side,std::uint64_t now,Frame& root) const noexcept {
+        if(identity!=id||sample.identity!=id||!smg_model(id.modelTag)||(side!=left&&side!=right)
+            ||!gunAt||now<gunAt||now-gunAt>100)return false;
+        root=gunRoots[side==left?0:1];return valid(root);
+    }
+    bool muzzle_root(const Identity& id,unsigned side,std::uint64_t now,Frame& root) const noexcept {
+        if(!gun_root(id,side,now,root))return false;
+        const auto* profile=profiles::find(id.modelTag);if(!profile)return false;
+        const auto* binding=profiles::attachment_bone(profile->visual,1);
+        if(!binding)return true;
+        Frame source{},target{};
+        if(!effects::attachment_frames(sample,*profile,1,0,side==left,Frame{},source,target))return false;
+        root=compose(root,target);return valid(root);
+    }
+    // Input is the completed, mirrored pose. The native firing event
+    // chooses sides; animation selection never creates an additional shot.
+    bool pose(const Identity& id,void* data,unsigned mode,unsigned action,ActionClock clock,std::uint64_t now,
+              float leftHidden=0,float rightHidden=0,const Frame* sourceRoot=nullptr) noexcept {
+        select(id);
+        if(!smg_model(id.modelTag)||mode!=4||!data||!std::isfinite(leftHidden)||!std::isfinite(rightHidden)
+            ||leftHidden<0||leftHidden>1||rightHidden<0||rightHidden>1)return false;
+        const bool generated=!profiles::legacy(id.modelTag);
+        const bool generic=generic_gun_model(id.modelTag);
+        const unsigned count=pose_bones(id.modelTag),marker=marker_bone(id.modelTag);
+        const auto* profile=profiles::find(id.modelTag);
+        if(!profile||count<74||count>128||marker<=72||marker>=count)return false;
+        const float width=smg_placement::gap(id.modelTag);
+        if(!width||(generated&&(!sourceRoot||!valid(*sourceRoot))))return false;
+        std::array<Frame,128> p{};std::memcpy(p.data(),data,count*sizeof(Frame));
+        for(unsigned i=0;i<count;++i)if(!valid(p[i]))return false;
+        std::array<Frame,56> nativeBones{};
+        if(generic){
+            const auto rootInverse=inverse(p[72]);
+            for(unsigned i=0;i<count-72;++i)if(i!=marker-72){
+                nativeBones[i]=compose(rootInverse,p[72+i]);
+                if(!valid(nativeBones[i]))return false;
+            }
+        }
+        // IKELOS selector/base 3 is firing (live capture 20260916T002433Z).
+        // It must retain the neutral grips and the selected-hand signal:
+        // clearing ready here also skips the independent reload lowering.
+        const bool interruption=!generic&&(action==4||action==5||clock.base==4);
+        if(interruption){hasShot=false;recentMask=0;handShotAt={};shots={};}
+        if(hasShot&&now<shotAt)return false;
+        for(const auto at:handShotAt)if(at&&now<at)return false;
+        // A. The firing base holds while the native fire clip may still move the root; it releases
+        // after the last shot of either gun has settled.
+        const std::uint64_t lastShot=std::max(handShotAt[0],handShotAt[1]);
+        float base=0;
+        if(lastShot){
+            const auto age=now-lastShot;
+            base=age<=baseSettleMs?1.f:1-smoothstep(static_cast<float>(age-baseSettleMs)/baseReleaseMs);
+        }
+        recentMask=0;
+        if(base>0)for(unsigned i=0;i<2;++i)if(handShotAt[i]&&now-handShotAt[i]<=baseSettleMs+baseReleaseMs)recentMask|=1u<<i;
+        hasShot=base>0;
+        if(!hasShot){handShotAt={};shots={};}
+        if((generic?(leftHidden<=0&&rightHidden<=0):(action==0||action==1))&&!hasShot){
+            neutral=compose(inverse(p[0]),p[72]);
+            rightGrip=compose(inverse(p[72]),p[24]);leftGrip=compose(inverse(p[72]),p[23]);
+            boltRest=compose(inverse(p[72]),p[73]);idleRoot=p[0];
+            for(unsigned i=0;i<22;++i){
+                rightRest[i]=compose(inverse(p[24]),p[alternating::rightArm[i]]);
+                leftRest[i]=compose(inverse(p[23]),p[alternating::leftArm[i]]);
+                rightArmHold[i]=compose(inverse(p[0]),p[alternating::rightArm[i]]);
+                leftArmHold[i]=compose(inverse(p[0]),p[alternating::leftArm[i]]);
+            }
+            ready=true;
+        }
+        const Frame native=p[72];Frame rightRoot=native,leftRoot=native;
+        const Frame hold=compose(p[0],neutral);
+        if(ready&&(base>0||leftHidden>0||rightHidden>0)){
+            const Frame held=blend(native,hold,base);
+            const Vec diff=add(held.p,mul(native.p,-1));
+            if(diff.x*diff.x+diff.y*diff.y+diff.z*diff.z>.25f)return false;
+            // Each gun kicks from its own shots only, on the shared hold.
+            rightRoot=compose(held,kick_frame(kick_amount(1,now),false));
+            leftRoot=compose(held,kick_frame(kick_amount(0,now),true));
+            rightRoot.p=add(rightRoot.p,rotate(p[0].q,{0,0,-1.15f*rightHidden}));
+            leftRoot.p=add(leftRoot.p,rotate(p[0].q,{0,0,-1.15f*leftHidden}));
+            const Frame targetRight=compose(rightRoot,blend(compose(inverse(native),p[24]),rightGrip,base));
+            const Frame targetLeft=compose(leftRoot,blend(compose(inverse(native),p[23]),leftGrip,base));
+            const Frame rd=compose(targetRight,inverse(p[24])),ld=compose(targetLeft,inverse(p[23]));
+            for(unsigned i=0;i<22;++i){
+                const auto r=alternating::rightArm[i],l=alternating::leftArm[i];
+                p[r]=blend(compose(rd,p[r]),compose(targetRight,rightRest[i]),base);
+                p[l]=blend(compose(ld,p[l]),compose(targetLeft,leftRest[i]),base);
+            }
+        }
+        // C. Sprint: both guns on the idle hold, lowered and pitched down, both arms carried. The
+        // exit keeps it until the native root is back near the hold, so the turned gun never shows.
+        // Two weights: the takeover (both guns and arms on the idle hold instead of the native sprint
+        // pose) comes in on the first sprint frame (sprintTakeInMs), before the native gun has turned, and leaves
+        // only once the native root is back near the hold; the lowering eases in and out inside it. The
+        // turned native gun never shows in either blend. A shot hands the guns to the firing base.
+        const float stepMs=sprintAt&&now>=sprintAt?std::min(static_cast<float>(now-sprintAt),100.f):0.f;sprintAt=now;
+        // Generic rigs retain their own sprint/action graph. IKELOS selector
+        // numbers and its manually fitted sprint trajectory are not universal.
+        const bool eligible=!generic&&ready&&!interruption&&leftHidden<=0&&rightHidden<=0;
+        const bool sprinting=eligible&&sprint_action(action);
+        bool away=false;
+        if(eligible&&sprintTake>0){
+            const Vec d=add(native.p,mul(hold.p,-1));
+            away=std::sqrt(d.x*d.x+d.y*d.y+d.z*d.z)>sprintNearMeters||frame_angle_degrees(native,hold)>sprintNearDegrees;
+        }
+        sprintTake=sprinting||away?std::min(1.f,sprintTake+stepMs/sprintTakeInMs):std::max(0.f,sprintTake-stepMs/sprintTakeOutMs);
+        sprintWeight=std::min(sprintTake,sprinting?std::min(1.f,sprintWeight+stepMs/sprintInMs):std::max(0.f,sprintWeight-stepMs/sprintOutMs));
+        const float take=smoothstep(sprintTake)*(1-base),sprint=smoothstep(sprintWeight);
+        if(take>0||sprint>0){
+            // The common root follows the native sprint's own root only in part.
+            const Frame root=blend(idleRoot,p[0],sprintRootFollow);
+            const Frame sprintHold=compose(root,neutral);
+            Frame lowered=sprintHold;
+            lowered.q=product(sprintHold.q,axis_quat({0,1,0},degrees_to_radians(sprintPitchDegrees)));
+            lowered.p=add(sprintHold.p,rotate(root.q,{0,0,-sprintDropMeters}));
+            const Frame shift=compose(lowered,inverse(sprintHold));
+            rightRoot=blend(blend(rightRoot,sprintHold,take),lowered,sprint);
+            leftRoot=blend(blend(leftRoot,sprintHold,take),lowered,sprint);
+            for(unsigned i=0;i<22;++i){
+                const auto r=alternating::rightArm[i],l=alternating::leftArm[i];
+                const Frame rightIdle=compose(root,rightArmHold[i]),leftIdle=compose(root,leftArmHold[i]);
+                p[r]=blend(blend(p[r],rightIdle,take),compose(shift,rightIdle),sprint);
+                p[l]=blend(blend(p[l],leftIdle,take),compose(shift,leftIdle),sprint);
+            }
+        }
+        // Native geometry uses local bones0,1,2,4. Carry every moving part
+        // with the chosen right root. Unweighted bone3 is the left shader
+        // marker; its weapon-local inverse bind cancels exactly in the GPU.
+        const Frame delta=compose(rightRoot,inverse(native));
+        for(unsigned i=73;i<count;++i)if(i!=marker)p[i]=compose(delta,p[i]);
+        // B. Only the gun that fired last unfreezes its moving parts; its bolt follows its own shot
+        // time (the left copy's rows are re-based from this root onto the left one by the shader).
+        unsigned moving=interruption?both:0;
+        if(generic){
+            // Preserve the donor's local animation on its native bones. A
+            // shared native clip belongs to the most recent firing hand; do
+            // not synthesize IKELOS's bolt travel on other weapon skeletons.
+            moving=interruption||!hasShot?both:(handShotAt[0]>handShotAt[1]?left:right);
+        }else if(!interruption&&(handShotAt[0]||handShotAt[1])){
+            const unsigned owner=handShotAt[0]>handShotAt[1]?0:1;
+            const float age=static_cast<float>(now-handShotAt[owner]);
+            if(age<boltCurve.back().ms){
+                moving=owner==0?left:right;
+                if(ready){Frame bolt=boltRest;bolt.p=add(bolt.p,{bolt_meters(age),0,0});p[73]=compose(rightRoot,bolt);}
+            }
+        }
+        p[72]=rightRoot;
+        Frame unplaced=native;unplaced.p=add(native.p,mul(rotate(native.q,{0,placement,0}),-1));
+        if(generated)unplaced=*sourceRoot;
+        effects::Sample nextSample{id,now,compose(inverse(unplaced),rightRoot),
+            compose(compose(inverse(unplaced),leftRoot),Frame{{},{0,width,0},1})};
+        if(generic){nextSample.bones=nativeBones;nextSample.boneCount=count-72;nextSample.moving=moving;}
+        const std::array<Frame,2> roots{compose(leftRoot,Frame{{},{0,width,0},1}),rightRoot};
+        const Frame markerBind=generic?std::bit_cast<Frame>(profile->pose.markerBind):weaponBind3;
+        leftRoot.scale*=marker_scale(moving);p[marker]=compose(leftRoot,markerBind);
+        for(unsigned i=0;i<count;++i)if(!smg_placement::valid_completed(id.modelTag,p[i],i,p[72].scale))return false;
+        std::memcpy(data,p.data(),count*sizeof(Frame));sample=nextSample;gunRoots=roots;gunAt=now;return true;
+    }
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/smg_magazines.h b/Dawn/src/client/hooks/akimbo/smg_magazines.h
