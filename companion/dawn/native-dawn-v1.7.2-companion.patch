+namespace dawn::client::hooks::akimbo::alternating {
+using namespace presentation;
+inline constexpr unsigned thorn=0x81a295e0u;
+inline constexpr unsigned malfeasance=0x81a29897u;
+inline constexpr float marker=1.03125f;
+// The weapon renderer skins against local skeleton 80B9EAD2, whose root bind
+// is identity. Its slots 3/5 map to full-pose slots 75/77 and have no weights
+// in Thorn. Encode the scale marker before these local binds so the native
+// inverse bind cancels their translations. Using character-space 80BC8623
+// binds here offsets the rendered gun from its grip by about 3.7 cm.
+inline constexpr Frame weaponBind3{{.5000000596f,.5f,.5000000596f,.5000000596f},{.048846744f,.0001507371635f,.09440819919f},1};
+// Malfeasance uses bone5 for native moving geometry; its spare left marker is
+// bone4. Both native bind values come from the same weapon-local 80B9EAD2.
+inline constexpr Frame weaponBind4{{.5000000596f,.5f,.5000000596f,.5000000596f},{.07118686289f,.0001507341804f,.06969963014f},1};
+inline constexpr Frame weaponBind5{{.5000000596f,.5f,.5000000596f,.5000000596f},{.1428218186f,.0001507397974f,.09178310633f},1};
+inline constexpr unsigned char leftArm[]{12,15,19,21,23,27,34,40,42,43,44,45,52,53,54,55,56,62,63,64,65,66};
+inline constexpr unsigned char rightArm[]{14,17,20,22,24,28,39,46,48,49,50,51,57,58,59,60,61,67,68,69,70,71};
+// Same qualified Thorn skeleton, standing hip idle capture 20260914T172612Z.
+// Used only for a first shot that arrives before this identity renders idle.
+// A live idle sample replaces these immediately. These are common-root and
+// gun-relative frames, so camera movement remains live even without history.
+inline constexpr Frame restNeutral{{-.012714907738f,-.005525703f,.010177633463f,.99985209581f},{.35341599295f,-.092752446127f,1.4722027837f},.99999713897f};
+inline constexpr Frame restLeftGrip{{.000079120772169f,.000059102689007f,.000032379514034f,1},{-.000021902707479f,.19004054326f,.000010231799487f},1.000002861f};
+inline constexpr Frame restRightGrip{{.000079121118487f,.000059102487145f,.000032379786345f,1},{-.000021903460205f,.000040581509397f,.000010227058313f},1.0000047684f};
+// Thorn keeps the outgoing gun's last root and hand pose and releases them
+// over 180 ms after an opposite-hand shot. Rat King Akimbo (sidearm rig) no
+// longer uses this pose at all: its static pair, kick and throw reload live in
+// rat_king_pose.h; this State only issues its alternating firing tickets.
+inline constexpr bool releases_outgoing_hand(std::uint32_t tag) noexcept {return profiles::is(tag,profiles::Adapter::thorn);}
+// Thorn's firing gun keeps this share of the native fire clip's kick (its
+// root's offset from the calibrated idle hold); its hand follows the gun.
+// User 2026-09-26: "can we slightly lessen the visual recoil".
+inline constexpr float thornRecoilKeep=.7f;
+struct Ticket {std::uint64_t generation{};bool left{},valid{};};
+// A successful opposite-hand shot must not erase the outgoing gun's recoil.
+// Keep its last rendered pose in aligned common-root space, then release that
+// hand independently. Camera, body and ADS movement remain live throughout.
+struct HandRecovery {
+    bool valid{},left{};
+    std::uint64_t at{};
+    Frame root{},grip{};
+    std::array<Frame,22> fingers{};
+};
+struct State {
+    Identity identity{};
+    std::uint64_t generation{1},shotAt{},sampleAt{},idleAt{};
+    bool nextLeft{},shotLeft{},hasShot{},busy{},neutralReady{},drawing{},recovering{};
+    Frame neutral{},leftGrip{},rightGrip{};
+    std::array<Frame,22> leftHandRest{},rightHandRest{};
+    HandRecovery rendered{},released{};
+    void reset(const Identity& id) noexcept {
+        const auto next=generation+1;*this={};generation=next?next:1;identity=id;
+    }
+    void select(const Identity& id) noexcept {if(id!=identity)reset(id);}
+    // Rat King Akimbo: a draw (sidearm 60/28/46) restarts the alternation on
+    // the right gun, as the hand cannon's draw 3 does inside pose().
+    void draw_edge(const Identity& id,bool draw) noexcept {
+        select(id);
+        if(draw&&!drawing)reset(id);
+        drawing=draw;
+    }
+    Ticket begin(const Identity& id) noexcept {
+        select(id);
+        if(!alternating_firing(id.modelTag)||busy)return {};
+        busy=true;return {generation,nextLeft,true};
+    }
+    void finish(Ticket t,bool emitted,std::uint64_t now) noexcept {
+        if(!t.valid||!busy||t.generation!=generation)return;
+        busy=false;
+        if(emitted){
+            if(releases_outgoing_hand(identity.modelTag)&&hasShot&&t.left!=shotLeft&&rendered.valid
+                &&rendered.left==shotLeft&&now>=rendered.at&&now-rendered.at<=100){
+                released=rendered;released.at=now;
+            }else released={};
