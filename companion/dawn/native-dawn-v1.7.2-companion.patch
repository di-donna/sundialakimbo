+    a::profiles::Registration entry{0x81d40048,a::profiles::Adapter::ikelos,
+        a::profiles::legacy_barrel(a::profiles::Adapter::ikelos),a::profiles::legacy_binding(a::profiles::Adapter::ikelos)};
+    entry.reloadPolicy=2;
