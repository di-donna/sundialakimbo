+bool identify(const Memory& m, std::uintptr_t animation, Identity& result) noexcept {
+    result={}; Identity id{}; Header a{},s{},r{},c{};
+    if (!header(m,animation,a) || a.kind!=0x808036cf) return false;
+    const FirstPersonRig rig=first_person_rig(a.tag);
+    if (rig.kind==RigClass::none) return false;
+    id.animation=animation; id.animationHandle=a.self; id.owner=a.owner;
+    std::uint64_t rigOffset{}, skeletonOffset{};
+    if (!read(m,animation+0x44,id.controllerHandle)
+        || !read(m,animation+0x888,id.rigHandle) || !read(m,animation+0x890,rigOffset)
+        || !read(m,animation+0x8d8,id.skeletonHandle) || !read(m,animation+0x8e0,skeletonOffset)
+        || rigOffset || skeletonOffset) return false;
+    if (!component(m,id.skeletonHandle,rig.skeleton,0x80808546,id.owner,id.skeleton,s)
+        || !component(m,id.rigHandle,rig.rig,0x80808f8f,id.owner,id.rig,r)
+        || !component(m,id.controllerHandle,0x80bde357,0x80803b60,id.owner,id.controller,c)) return false;
+    std::uint32_t animationBack{}, controllerAnimation{}, count{};
+    if (!read(m,id.skeleton+0x68,animationBack) || animationBack!=a.self
+        || !read(m,id.controller+0x110,controllerAnimation) || controllerAnimation!=a.self
+        || !read(m,id.controller+0x124,id.modelOwner) || !read(m,id.controller+0x128,count)
+        || !count || count>32) return false;
+    std::uintptr_t entity{}; std::uint32_t entitySelf{};
+    if (!resolve(m,id.modelOwner,entity) || !read(m,entity+12,entitySelf) || entitySelf!=id.modelOwner) return false;
+    unsigned matches=0;
+    for (std::uint32_t i=0;i<count;++i) {
+        std::uint32_t handle{}; std::uintptr_t address{}; Header model{};
+        if (!read(m,id.controller+0x130+8*i,handle)) return false;
+        if (!handle || handle==0xffffffff) continue;
+        if (!resolve(m,handle,address) || !header(m,address,model) || model.self!=handle) return false;
+        if (akimbo_model(model.tag) && model.kind==0x808072bd && model.owner==id.modelOwner) {
+            id.model=address; id.modelHandle=handle; id.modelTag=model.tag; ++matches;
+        }
+    }
+    // The private model must belong to this rig family: an SMG or sidearm
+    // model never passes on the hand-cannon rig, and the reverse.
+    const auto* profile=profiles::find(id.modelTag);
+    if (matches!=1||!profile||rig.kind!=rig_class(id.modelTag)
+        ||profile->binding.animation!=a.tag||profile->binding.skeleton!=s.tag||profile->binding.rig!=r.tag) return false;
+    std::uintptr_t definition{}; std::uint64_t countNodes{},relative{};
+    if (!resolve(m,s.tag,definition,asset_pools(s.tag)) || s.definition>0x1000000 || definition>0x00007fffffffffffULL-s.definition-0x90) return false;
+    definition+=s.definition;
+    if (!read(m,definition+0x80,countNodes) || countNodes!=pose_bones(id.modelTag) || !read(m,definition+0x88,relative)
+        || relative>0x1000000 || definition>0x00007fffffffffffULL-relative-0x98) return false;
+    id.nodes=definition+0x98+static_cast<std::uintptr_t>(relative);
+    // Recheck the two selections after the bounded walk; an in-flight switch fails closed.
+    std::uint32_t currentAnimation{},currentOwner{};
+    if (!read(m,id.controller+0x110,currentAnimation) || currentAnimation!=id.animationHandle
+        || !read(m,id.controller+0x124,currentOwner) || currentOwner!=id.modelOwner) return false;
+    result=id; return true;
+}
+bool akimbo_model_tag(std::uint32_t tag) noexcept {return akimbo_model(tag);}
+bool still_current(const Memory& m, const Identity& expected) noexcept {
+    Identity now{}; return identify(m,expected.animation,now) && now==expected;
+}
+bool identify_controller(const Memory& m,std::uintptr_t controller,Identity& result) noexcept {
+    result={};Header h{};std::uint32_t handle{};std::uintptr_t animation{};
+    return header(m,controller,h)&&h.tag==0x80bde357&&h.kind==0x80803b60
+        &&read(m,controller+0x110,handle)&&resolve(m,handle,animation)
+        &&identify(m,animation,result)&&result.controller==controller;
+}
+bool identify_controller_handle(const Memory& m,std::uint32_t handle,Identity& result) noexcept {
+    result={};std::uintptr_t controller{};
+    return resolve(m,handle,controller)&&identify_controller(m,controller,result)
+        &&result.controllerHandle==handle;
+}
+bool matches_component(const Memory& m,std::uintptr_t address,std::uint32_t tag,std::uint32_t kind,std::uint32_t owner) noexcept {
