+// Cancel recovery (rat_king.h D.3): each side from its state at the cancel
+// towards the live target of every frame; e = real seconds since the cancel.
+inline float recovery_seconds(const Side& s,bool fromHold) noexcept {
+    if(s.role==Role::held)return fromHold?rk::handoverHoldSeconds:rk::handoverHeldSeconds;
