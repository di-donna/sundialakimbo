+    Header after{},contentAfter{};std::uint32_t contentNow{},indexNow{},overrideNow{};
+    return still_current(m,id)&&header(m,root,after)&&after.self==h.self&&after.owner==h.owner&&after.tag==h.tag
+        &&header(m,content,contentAfter)&&contentAfter.self==contentHeader.self&&contentAfter.owner==h.owner
+        &&read(m,root+0x8c0,contentNow)&&contentNow==contentHandle
+        &&read(m,content+0x68,indexNow)&&indexNow==index
+        &&read(m,content+0x60,overrideNow)&&overrideNow==overrideTag;
+}
+bool native_thorn_barrel(const Memory& m,std::uintptr_t barrel,const Identity& id) noexcept {
+    return profiles::is(id.modelTag,profiles::Adapter::thorn)&&native_akimbo_barrel(m,barrel,id);
+}
+bool exotic_sounds(const Memory& m,std::uintptr_t address,const SoundPacket& packet,
+                   SoundPacket& output,std::uint32_t& modelTag) noexcept {
+    output=packet;modelTag=0;
