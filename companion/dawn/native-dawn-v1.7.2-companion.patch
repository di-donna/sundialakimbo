+    if(parts&partActive)component(next.active,next.activeHeader,partActive);
+    if(parts&partModel)component(next.model,next.modelHeader,partModel);
+    if(parts&partEquipment)component(next.equipment,next.equipmentHeader,partEquipment);
+    if(parts&partLinks){component(next.sturmLink,next.sturmLinkHeader,partLinks);component(next.drangLink,next.drangLinkHeader,partLinks);}
