+// Rebase a gun-local displacement into the native attachment's current space.
+// Other muzzle markers retain their own offsets; no camera/world assumption.
+inline Frame world_delta(Frame nativeMuzzle,Frame gunDelta,Frame localAttachment=muzzle) noexcept {
