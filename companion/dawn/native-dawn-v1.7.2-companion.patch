+                &&layout.cards[0].top>=30&&layout.cards[0].bottom<30+size[1]*.8f,"panel fits viewport above native weapon rows");
+            check(layout.labelFont>=10.5f&&layout.statusFont>=9.f&&layout.countFont>=18.75f,"small viewport preserves readable text sizes");
+            check(layout.padding*2+layout.countFont*4.5f<layout.cards[0].right-layout.cards[0].left,"wide capacity text has horizontal room");
+            check(layout.statusFont+57*layout.scale<84*layout.scale-7*layout.scale,"status text does not overlap progress bar");
+        }
+    }
+    h::AmmoLayout out{};
+    check(!h::ammo_layout(0,0,639,360,out)&&!h::ammo_layout(0,0,640,359,out),"undersized viewport suppresses safely");
+    check(!h::ammo_layout(0,0,std::numeric_limits<float>::infinity(),1080,out),"invalid viewport refused");
+}
+void default_content_tests(const p::Registration& entry){
+    check(p::valid(entry),"generic default descriptor is valid");
+    auto old=profile(0x81d03003);old.barrel.variant=0xffffffff;
+    check(!p::valid(old),"original SMG adapter does not inherit default sentinel");
+    auto empty=entry;empty.barrel.propertyCount=0;empty.barrel.contentSize=empty.barrel.contentDefinition+0x270;
+    check(p::valid(empty),"generic empty variant array requires only complete definition");
+    empty.barrel.variant=0;check(!p::valid(empty),"empty variant array cannot use indexed row");
+    empty=entry;empty.barrel.variant=entry.barrel.propertyCount;
+    check(!p::valid(empty),"out of range index is not the explicit default sentinel");
+    Scene scene(entry);const auto id=identity(entry.modelTag);const auto& b=entry.barrel;
+    const auto original=scene.segments;unsigned key{};std::uintptr_t asset{},row{};
+    for(const auto index:{b.propertyCount,b.propertyCount+1,0x80000000u,0xffffffffu}){
+        scene.put(Scene::content+0x68,index);
+        check(a::content_selection::row(scene.memory(),b,index,asset,row)
+            &&asset==Scene::asset&&row==asset+b.contentDefinition+0x80,"native out-of-range index selects embedded default");
+        check(h::ammo_native_key(scene.memory(),id,Scene::root,key)&&key==Scene::key,
+            "qualified generic HUD reads the actual embedded default row");
+    }
+    for(const auto index:{0u,b.propertyCount-1}){
+        scene.put(Scene::content+0x68,index);key=123;
+        check(!h::ammo_native_key(scene.memory(),id,Scene::root,key)&&!key,
+            "generic default registration cannot silently accept an indexed runtime row");
+    }
+    scene.segments=original;
+    auto reject=[&](const char* why){asset=row=123;
+        check(!a::content_selection::row(scene.memory(),b,0xffffffff,asset,row)&&!asset&&!row,why);
+        scene.segments=original;
+    };
+    scene.put<std::uint64_t>(Scene::asset+b.contentDefinition+0x240,b.propertyCount+1);reject("changed source count refuses default");
+    scene.put<unsigned>(Scene::asset+b.contentDefinition+0x278,0x80803ace);reject("wrong property table type refuses default");
+    scene.put<std::uint64_t>(Scene::asset+b.contentDefinition+0x270,b.propertyCount-1);reject("wrong typed header count refuses default");
+    scene.put<std::uint64_t>(Scene::asset+b.contentDefinition+0x248,0);reject("overlapping property array refuses default");
+    scene.put<std::uint64_t>(Scene::asset+b.contentDefinition+0x248,~std::uint64_t{});reject("overflowing property array refuses default");
+    auto zero=b;zero.propertyCount=0;zero.contentSize=zero.contentDefinition+0x270;
+    scene.put<std::uint64_t>(Scene::asset,zero.contentSize);
+    scene.put<std::uint64_t>(Scene::asset+zero.contentDefinition+0x240,0);
+    scene.put<std::uint64_t>(Scene::asset+zero.contentDefinition+0x248,~std::uint64_t{});
+    for(const auto index:{0u,1u,0xffffffffu})check(a::content_selection::row(scene.memory(),zero,index,asset,row)
+        &&row==Scene::asset+zero.contentDefinition+0x80,"empty array ignores unused relative pointer and selects default");
+    --zero.contentSize;scene.put<std::uint64_t>(Scene::asset,zero.contentSize);
+    check(!a::content_selection::row(scene.memory(),zero,0xffffffff,asset,row),"truncated content definition cannot supply default");
+}
+}
+int main(){
+    auto fallback=profile(0x81d03002);fallback.adapter=p::Adapter::genericGun;
+    fallback.binding={0x81d03010,0x81d03011,0x81d03012};
+    fallback.pose={6,1,std::bit_cast<std::array<std::uint32_t,8>>(a::presentation::Frame{}),76,0x3500};
+    fallback.barrel.variant=0xffffffff;
+    const std::array<p::Registration,3> entries{profile(0x81d40048),profile(0x81d03001),fallback};
+    check(p::generated.publish(p::kSchemaVersion,p::kGameBuild,entries)==p::PublishResult::published,"publish actual and dynamically allocated carriers");
+    for(unsigned i=0;i<2;++i){state_tests(entries[i]);binding_tests(entries[i]);}
+    default_content_tests(fallback);
+    layout_tests();std::printf("akimbo HUD: %u checks passed\n",checks);
+}
diff --git a/Dawn/unit/akimbo_infinite_ammo_tests.cpp b/Dawn/unit/akimbo_infinite_ammo_tests.cpp
