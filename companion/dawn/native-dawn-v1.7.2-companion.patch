+}
+__declspec(noinline) void __fastcall burst_emit_hook(void* barrel,void* replay,void* packet,float elapsed) noexcept {
+    Invocation invocation;const auto next=nextBurstEmit.load(std::memory_order_acquire);
+    const auto caller=reinterpret_cast<std::uintptr_t>(_ReturnAddress()),address=reinterpret_cast<std::uintptr_t>(barrel);
+    Identity id{};smg_ammo::Native native{};
+    if(!enabled.load(std::memory_order_acquire)){next(barrel,replay,packet,elapsed);return;}
+    if(!current_identity(id)||!generic_gun_model(id.modelTag)
+        ||!native_akimbo_barrel(memory,address,id)||!smg_ammo::qualify(memory,id,address+0x1760,native)){
+        if(finite_burst_owned(address)||finite_burst_candidate(address)){burst_native::refused("emission_identity");return;}
+        next(barrel,replay,packet,elapsed);return;
+    }
+    burst::runtime::Owner saved{};bool managed=false;
+    AcquireSRWLockShared(&magazineLock);
+    if(const auto* owner=burstBook.find(burst::runtime::key(native))){saved=*owner;managed=true;}
+    ReleaseSRWLockShared(&magazineLock);
+    if(!managed){
+        if(finite_burst_owned(address)||finite_burst_candidate(address)){burst_native::refused("missing_receipt_owner");return;}
+        next(barrel,replay,packet,elapsed);return;
+    }
+    burst_native::EmitScope scope{id,native,address,reinterpret_cast<std::uintptr_t>(packet),{},false};
+    if(saved.failed||caller!=moduleBase+0xccf7e6||replay||burst_native::emitScope
+        ||!std::isfinite(elapsed)||elapsed<0||elapsed>60
+        ||!burst::runtime::popped(memory,address,scope.packetAddress,saved,scope.event)
+        ||!smg_ammo::unchanged(memory,native)||!still_current(memory,id)){
+        burst_native::refused("popped_receipt");return;
+    }
+    burst_native::invoke_emission(scope,barrel,replay,packet,elapsed);
+}
diff --git a/Dawn/src/client/hooks/akimbo/burst_order.h b/Dawn/src/client/hooks/akimbo/burst_order.h
new file mode 100644
index 0000000000000000000000000000000000000000..ff4b0832e6e04528921f251fb8f7f740fb3ea71e
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/burst_order.h
@@ -0,0 +1,24 @@
+#pragma once
+#include "burst_driver.h"
+
+namespace dawn::client::hooks::akimbo::burst_driver {
+// A native finite burst is atomic with respect to hand ownership. Interleave
+// complete bursts; do not splice alternating hands into one ordinal sequence.
+// Recovery remains in the two native phase clocks and overlaps freely.
+struct Order {
+    unsigned last{};
+    bool valid()const noexcept{return last==0||last==burst::left||last==burst::right;}
+    bool may_start(unsigned side,const std::array<Hand,2>& hands)const noexcept {
+        if(!valid()||(side!=burst::left&&side!=burst::right)
+            ||!hands[0].valid()||!hands[1].valid())return false;
+        const auto i=burst_cadence::index(side),other=1-i;
+        const auto ready=[](const Hand& hand){return hand.phase.idle()&&(hand.requests&requestMask);};
+        if(!ready(hands[i])||hands[other].phase.phase==1)return false;
+        if(!ready(hands[other]))return true;
+        return side==(last==burst::left?burst::right:burst::left);
+    }
+    bool started(unsigned side,const std::array<Hand,2>& before)noexcept {
+        if(!may_start(side,before))return false;last=side;return true;
+    }
+};
+}
