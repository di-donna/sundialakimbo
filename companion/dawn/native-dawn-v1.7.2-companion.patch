+void candidate_transfers(){
+    const a::smg_ammo::Native owner{0x100000,0x1024d0,0x2001,0x2002,0x81a2990a};
+    a::smg_ammo::State before;(void)before.initialize(owner,4,4,0,0);before.tubeMode=true;
+    check(before.request_tube(true,20,inputs,3)==1,"transaction fixture begins one tube");
+    for(unsigned now=100;now<=900;now+=100)(void)before.advance_tube(now,20,true,inputs);
+    auto candidate=before;const int amount=candidate.advance_tube(1000,20,true,inputs);
