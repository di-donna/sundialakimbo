+                if(model.owner==r.modelOwner)++r.ownedModels;
+            }
+        }
+        ++r.modelCount;
+    }
+    // Recheck the selection after the bounded walk; an in-flight switch is dropped.
+    std::uint32_t current{};
+    if(!read(m,r.controller+0x110,current)||current!=a.self)return false;
+    r.animation=animation;r.self=a.self;r.owner=a.owner;
+    r.animationTag=a.tag;r.skeletonTag=s.tag;r.rigTag=g.tag;r.controllerTag=c.tag;
+    r.animationDefinition=a.definition;r.skeletonDefinition=s.definition;r.rigDefinition=g.definition;r.controllerDefinition=c.definition;
+    out=r;return true;
+}
