+            if(key=="runtime_sha256")return once(mask,8)&&hex(out.runtime);
+            if(key=="exe_sha256")return once(mask,16)&&hex(out.executable);
+            if(key=="packages")return once(mask,32)&&artifacts(out.packages,out.packageCount);
+            if(key=="source_artifacts")return once(mask,64)&&artifacts(out.sources,out.sourceCount);
+            return key=="profiles"&&once(mask,128)&&profiles(out);
+        });space();if(!ok||mask!=255||at_!=text_.size()||!out.packageCount)return false;
+        if(profiles::check_entries(out.schema,out.build,{out.profiles.data(),out.profileCount})!=profiles::PublishResult::published)return false;
+        for(std::size_t i=0;i<out.packageCount;++i){
+            for(std::size_t j=0;j<i;++j)if(equal_path(out.packages[i].name(),out.packages[j].name()))return false;
+            for(std::size_t j=0;j<out.sourceCount;++j)if(equal_path(out.packages[i].name(),out.sources[j].name()))return false;
+        }
+        for(std::size_t i=0;i<out.sourceCount;++i)for(std::size_t j=0;j<i;++j)if(equal_path(out.sources[i].name(),out.sources[j].name()))return false;
+        return true;
+    }
+};
+// Host lifecycle: prepare before State/inventory initialization; activate before
+// network hooks expose snapshots; shutdown only after every akimbo hook detached.
+[[nodiscard]] bool prepare(void* runtimeModule) noexcept;
+[[nodiscard]] bool activate() noexcept;
+void shutdown() noexcept;
+} // namespace dawn::client::hooks::akimbo::bindings
diff --git a/Dawn/src/client/hooks/akimbo/burst.h b/Dawn/src/client/hooks/akimbo/burst.h
new file mode 100644
index 0000000000000000000000000000000000000000..711f645d997b7ff70e4546b46e3ada87b1a432bd
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/burst.h
@@ -0,0 +1,115 @@
+#pragma once
+#include <array>
+#include <cstdint>
+
+namespace dawn::client::hooks::akimbo::burst {
+// Pre-debit/queue bookkeeping. The production hook must qualify both the native required-ammo value
+// and actual debit, then identify the generation-bearing queued event. The
+// emission callback alone is too late to enforce an individual magazine.
+inline constexpr unsigned left=1,right=2,both=3,maxShots=64,maxRounds=200;
+struct Key {
+    std::uint32_t handle{},owner{},model{};
+    bool operator==(const Key&) const=default;
+    bool valid() const noexcept {
+        return handle&&handle!=~0u&&owner&&owner!=~0u&&model&&model!=~0u;
+    }
+};
+struct Spend {
+    Key key{};
+    std::uint64_t serial{};
+    unsigned ordinal{},count{},side{},cost{};
+    bool valid{};
+};
+struct Receipt {
+    std::uint32_t token{};
+    unsigned ordinal{},side{},cost{};
+    bool valid{};
+};
+// A settlement is applied to the selected magazine exactly once, at the
+// observed native debit. Emission (including failure) never spends it again.
+struct Settlement {unsigned side{},cost{};bool valid{},queued{};};
+struct State {
+    Key key{};
+    std::uint64_t serial{};
+    unsigned side{},count{},nextOrdinal{},lastSide{};
+    bool active{},busy{};
+    Spend pending{};
+    std::array<Receipt,maxShots> queue{};
+
+    void select(Key next) noexcept {
+        if(next==key)return;
+        const auto nextSerial=serial+1;
+        *this={};key=next;serial=nextSerial?nextSerial:1;
+    }
+    // A qualified native phase transition out of the active burst retires its
+    // ordinal sequence. Already paid queued events retain their original hand.
+    // Raw input release is NOT this transition: a native burst can finish after
+    // release. Callers must invalidate an in-flight transaction before calling.
+    bool leave_burst(Key current) noexcept {
+        if(current!=key||busy)return false;
+        active=false;side=count=nextOrdinal=0;return true;
+    }
+    Spend begin(Key current,unsigned ordinal,unsigned shots,unsigned required,
+                unsigned cost,unsigned held,const std::array<unsigned,2>& rounds,
+                unsigned loading) noexcept {
+        select(current);
+        if(!current.valid()||busy||shots<2||shots>maxShots||ordinal>=shots
+            ||required>maxRounds||!cost||cost>maxRounds||held>both||loading>both
+            ||rounds[0]>maxRounds||rounds[1]>maxRounds)return {};
+        // Reserve queue capacity before permitting a native debit. A queue
+        // allocation failure in native code is handled as a paid, dropped shot.
+        bool space=false;for(const auto& entry:queue)space|=!entry.valid;
+        if(!space)return {};
+        unsigned chosen=side;
+        const auto affordable=[&](unsigned candidate) {
+            const auto i=candidate==left?0u:1u;
+            return !(loading&candidate)&&rounds[i]>=required&&rounds[i]>=cost;
+        };
+        if(!active){
+            if(ordinal)return {};
+            unsigned eligible=0;
+            if((held&left)&&affordable(left))eligible|=left;
+            if((held&right)&&affordable(right))eligible|=right;
+            if(!eligible)return {};
+            chosen=eligible==both?(lastSide==left?right:left):eligible;
+        }else if(shots!=count||ordinal!=nextOrdinal||!affordable(chosen))return {};
+        // The caller applies the successful settlement before another begin.
+        // Do not reserve the entire burst: a partially loaded magazine can emit
+        // its remaining rounds, then fail the native sufficiency check safely.
+        if(++serial==0)++serial;
+        pending={current,serial,ordinal,shots,chosen,cost,true};busy=true;return pending;
+    }
+    Settlement settle(const Spend& ticket,bool debited,std::uint32_t queueToken) noexcept {
+        if(!ticket.valid||!busy||ticket.key!=key||ticket.serial!=pending.serial
+            ||ticket.ordinal!=pending.ordinal||ticket.count!=pending.count
+            ||ticket.side!=pending.side||ticket.cost!=pending.cost)return {};
+        busy=false;pending={};
+        if(!debited)return {};
+        // CB7680 advances its ordinal after CC6010 even if queue allocation
+        // failed. A verified debit without a queued event is still a debit.
+        active=true;side=ticket.side;count=ticket.count;nextOrdinal=ticket.ordinal+1;
+        lastSide=side;
+        Settlement result{side,ticket.cost,true,false};
+        if(!queueToken||queueToken==~0u)return result;
+        for(const auto& entry:queue)if(entry.valid&&entry.token==queueToken)return result;
+        for(auto& entry:queue)if(!entry.valid){
+            entry={queueToken,ticket.ordinal,side,ticket.cost,true};result.queued=true;break;
+        }
+        return result;
+    }
+    Receipt emission(Key current,std::uint32_t queueToken,unsigned ordinal) const noexcept {
+        if(current!=key||!current.valid())return {};
+        for(const auto& entry:queue)
+            if(entry.valid&&entry.token==queueToken&&entry.ordinal==ordinal)return entry;
+        return {};
+    }
+    bool retire(Key current,const Receipt& receipt) noexcept {
+        if(current!=key||!receipt.valid)return false;
+        for(auto& entry:queue)if(entry.valid&&entry.token==receipt.token
+            &&entry.ordinal==receipt.ordinal&&entry.side==receipt.side&&entry.cost==receipt.cost){
+            entry={};return true;
+        }
+        return false;
+    }
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/burst_cadence.h b/Dawn/src/client/hooks/akimbo/burst_cadence.h
new file mode 100644
index 0000000000000000000000000000000000000000..a3dd36fb034f498d33dd887dd5233ea017a6f9a8
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/burst_cadence.h
@@ -0,0 +1,112 @@
+#pragma once
+#include "burst_phase.h"
+#include <algorithm>
+
+namespace dawn::client::hooks::akimbo::burst_cadence {
+// Clock coordinator, deliberately separate from the native ABI adapter. The
+// adapter must supply qualified phase transitions and the one shared-property
+// advance. Calling the complete native FFB10E31 handler once per hand is not a
+// valid implementation of either callback: it would advance shared timers twice.
+struct Context {
+    float step{},elapsed{},remaining{};
+};
+struct State {
+    std::array<burst_phase::Snapshot,2> hands{};
+    unsigned next{burst::left};
+    bool busy{},failed{};
+    float handoff{};
+};
+enum class Transition { blocked, unchanged, changed, changed_wake };
+struct Result {
+    bool complete{};
+    float advanced{};
+    unsigned transitions{},advances{};
+};
+inline unsigned index(unsigned side) noexcept {return side==burst::left?0u:1u;}
+inline unsigned opposite(unsigned side) noexcept {return side==burst::left?burst::right:burst::left;}
+
+// Every callback sees the exact timeline point. A changed callback commits only
+// its own lane. A blocked callback permanently stops this pass: native effects
+// may already have happened, so neither clocks nor ammunition may be retried by
+// restoring a saved C++ State. The native adapter owns recovery/requalification.
+//
+// shared(Context, hands) advances native weapon-wide clocks once. It must not
+// advance either supplied lane timer. transition(side, Context, Snapshot&) runs
+// the native phase body under the forced-hand debit/queue scope. It runs at a
+// deadline and after every time step, including while a timer remains positive:
+// native forced-stop checks and phase3 recovery callbacks cannot be skipped. It may
+// leave a zero-time lane unchanged (e.g. idle with no trigger). Such a lane is
+// dormant until time advances, preventing a busy loop. No interval is divided by
+// two, and a simultaneous deadline visits the previously unpreferred hand first
+// on the next tie. Whether an idle hand may start is the adapter's input policy.
+template<class Shared,class Step>
+Result advance(State& state,float duration,Shared&& shared,Step&& transition) noexcept {
+    Result result{};
+    if(state.busy||state.failed||!std::isfinite(duration)||duration<0||duration>60
+        ||!std::isfinite(state.handoff)||state.handoff<0||state.handoff>60
+        ||(state.next!=burst::left&&state.next!=burst::right)
+        ||!state.hands[0].valid()||!state.hands[1].valid())return result;
+    if(duration==0){result.complete=true;return result;}
+    state.busy=true;
+    double advanced=0;
+    unsigned dormant=0,pending=0;
+    float lastStep=0;
+    std::array<unsigned,2> zeroTransitions{};
+    constexpr unsigned maxZeroTransitions=6;
+    constexpr unsigned maxTransitions=512;   // bounded even for malformed rates
+    const auto fail=[&](){state.failed=true;state.busy=false;return result;};
+    while(true){
+        const Context at{pending?lastStep:0,static_cast<float>(advanced),static_cast<float>(duration-advanced)};
+        unsigned due=pending;
+        for(unsigned i=0;i<2;++i)if(state.hands[i].remaining==0&&!(dormant&(1u<<i)))due|=1u<<i;
+        if(due){
+            pending=0;
+            const unsigned first=state.next;
+            bool progressed=false,wake=false;
+            for(unsigned ordinal=0;ordinal<2;++ordinal){
+                const unsigned side=ordinal?opposite(first):first,slot=index(side),bit=1u<<slot;
+                if(!(due&bit))continue;
+                auto candidate=state.hands[slot];
+                const auto outcome=transition(side,at,candidate);
+                if(outcome==Transition::blocked||!candidate.valid())return fail();
+                if(outcome==Transition::unchanged){
+                    if(candidate!=state.hands[slot])return fail();
+                    dormant|=bit;
+                }else{
+                    if((outcome!=Transition::changed&&outcome!=Transition::changed_wake)
+                        ||candidate==state.hands[slot])return fail();
+                    wake|=outcome==Transition::changed_wake;
+                    state.hands[slot]=candidate;progressed=true;
+                    ++result.transitions;
+                    if(result.transitions>maxTransitions
+                        ||(at.step==0&&++zeroTransitions[slot]>maxZeroTransitions))return fail();
+                }
+            }
+            if(progressed)state.next=opposite(first);
+            // Ending the active burst can make the opposite idle hand eligible
+            // at this same timestamp. Do not wait through the first hand's
+            // recovery interval before considering that pending request.
+            if(wake)dormant=0;
+            continue;
+        }
+        if(advanced==duration){result.complete=true;state.busy=false;return result;}
+        const double left=duration-advanced;
+        double delta=left;
+        for(const auto& hand:state.hands)if(hand.remaining>0)delta=std::min(delta,static_cast<double>(hand.remaining));
+        if(state.handoff>0)delta=std::min(delta,static_cast<double>(state.handoff));
+        if(!(delta>0)||!std::isfinite(delta))return fail();
+        const double end=delta==left?duration:advanced+delta;
+        // Accumulate in double so two float deadlines differing by one rounding
+        // bit are not rejected as simultaneous. Refuse a rate too small even
+        // for that timeline; never spin or
+        // silently replace a source-derived interval with an arbitrary epsilon.
+        if(!(end>advanced)||end>duration)return fail();
+        const Context step{static_cast<float>(delta),static_cast<float>(end),static_cast<float>(duration-end)};
+        if(!shared(step,state.hands))return fail();
+        for(auto& hand:state.hands)hand.remaining=static_cast<float>(std::max(0.,hand.remaining-delta));
+        state.handoff=static_cast<float>(std::max(0.,state.handoff-delta));
+        advanced=end;result.advanced=static_cast<float>(end);++result.advances;
+        dormant=0;zeroTransitions={};pending=3;lastStep=step.step;
+    }
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/burst_driver.h b/Dawn/src/client/hooks/akimbo/burst_driver.h
new file mode 100644
index 0000000000000000000000000000000000000000..a961e52f42c17ece0c8a57c2a17eadd947fb1009
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/burst_driver.h
@@ -0,0 +1,87 @@
+#pragma once
+#include "burst_cadence.h"
+#include <cstddef>
+
+namespace dawn::client::hooks::akimbo::burst_driver {
+// Native CCB8C0's stack context, passed unchanged in shape to CC5080, CD0530
+// and CB0110. +14 is CB7FF0(root), +15 the owning-object participation bit;
+// neither is a fabricated mouse state. All native call wrappers still require
+// exact executable signatures, typed owner/storage checks and scoped receipts.
+struct Context {
+    std::uintptr_t root{};
+    float step{},elapsed{},remaining{};
+    std::uint8_t blocked{},participates{};
+    std::array<std::byte,2> padding{};
+    bool valid()const noexcept {
+        return root>=0x10000&&root<=0x00007fffffffffffULL
+            &&std::isfinite(step)&&std::isfinite(elapsed)&&std::isfinite(remaining)
+            &&step>=0&&step<=elapsed&&elapsed<=60&&remaining>=0&&remaining<=60
+            &&blocked<=1&&participates<=1;
+    }
+};
+static_assert(sizeof(Context)==24&&offsetof(Context,step)==8&&offsetof(Context,blocked)==20);
+struct Output {
+    std::uint32_t unused{};
+    std::uint8_t flags{},active{},stop{},reserved{};
+    bool valid()const noexcept{return unused==0&&flags<=7&&active<=1&&stop<=1&&reserved==0;}
+};
+static_assert(sizeof(Output)==8&&offsetof(Output,flags)==4&&offsetof(Output,stop)==6);
+inline constexpr unsigned requestMask=2,forcedStopMask=4,privateMask=6;
+struct Hand {
+    burst_phase::Snapshot phase{};
+    unsigned requests{};
+    float charge{};
+    bool valid()const noexcept {
+        // This adapter is exclusively uncharged. A charge controller needs its
+        // own owned resource and release/cancel path, not a copied scalar.
+        return phase.valid()&&!(requests&~privateMask)&&charge==0;
+    }
+};
+inline void clear_request(Hand& hand) noexcept {hand.requests&=~requestMask;hand.charge=0;}
+
+// The scalar branches are transcribed from CCB8C0. Complex native actions remain
+// callbacks: active=CD0530, idle=CB0110, cooldown=CB3BB0, blocked_idle=CD1660.
+// A callback returns false when its exact owner/bytecode/observation qualification
+// failed. This helper does not undo native side effects or publish a phase scope.
+template<class Calls>
+bool body(Hand& hand,const Context& context,Output& output,Calls&& calls) noexcept {
+    if(!hand.valid()||!context.valid()||!output.valid())return false;
+    if(output.stop)return true;
+    switch(hand.phase.phase){
+    case 0:
+        if(context.blocked){
+            clear_request(hand);bool nativeActive=false;
+            if(!calls.blocked_idle(hand,context,nativeActive))return false;
+            output.active|=nativeActive?1:0;
+        }else if(hand.requests&requestMask){
+            hand.phase.phase=1;hand.phase.remaining=0;
+            break;
+        }else if(!calls.idle(hand,context,output,(hand.requests&forcedStopMask)!=0))return false;
+        if(hand.phase.phase==0)output.stop=1;
+        break;
+    case 1:
+        if(!calls.active(hand,context,output))return false;
+        break;
+    case 2:
+    case 3:
+        if(hand.phase.phase==3&&!calls.idle(hand,context,output,true))return false;
+        if(hand.phase.remaining==0){
+            float total{},recovery{};
+            if(!calls.cooldown(context,total,recovery)||!std::isfinite(total)||!std::isfinite(recovery)
+                ||recovery<0||total<recovery||total>60)return false;
+            hand.phase.phase=4;hand.phase.remaining=total-recovery;
+        }else clear_request(hand);
+        break;
+    case 4:
+        if(hand.phase.remaining==0)hand.phase={};
+        break;
+    default:return false;
+    }
+    return hand.valid()&&output.valid();
+}
+// CC5080/CCED10 test phase==1 while advancing spin-up and recovery properties.
+// Shared time observes either hand firing, never merely the last borrowed lane.
+inline unsigned shared_phase(const std::array<Hand,2>& hands) noexcept {
+    return hands[0].phase.phase==1||hands[1].phase.phase==1?1u:0u;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/burst_exit.h b/Dawn/src/client/hooks/akimbo/burst_exit.h
new file mode 100644
index 0000000000000000000000000000000000000000..b04625c45f0192568b45ffa16afbd60948936dcf
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/burst_exit.h
@@ -0,0 +1,67 @@
+#pragma once
+#include "burst_runtime.h"
+
+namespace dawn::client::hooks::akimbo::burst::runtime {
+// CB5DF0 ends a finite native burst by reading loaded at return CB5F62 and
+// debiting loaded % CB9440 through CCA120. That getter must see this hand, not
+// both magazines. This transaction covers only that native phase-exit debit;
+// CB7680 shot debits have already settled through Transaction before it begins.
+struct ExitDebit {
+    Phase phase{};
+    std::uint64_t magazineRevision{},ownerRevision{};
+    int loaded{},hand{},reported{},remainder{};
+    unsigned loading{};
+    bool valid{},settled{},rejected{};
+    bool callback_complete()const noexcept {return !rejected&&(!valid||settled);}
+};
+// Published by the qualified phase adapter, never by a getter. A
+// native callback can own at most one such debit at a time. The adapter must
+// settle it in its finally path, before retiring the stack scope.
+inline thread_local ExitDebit* phaseExit{};
+inline bool begin_exit(Owner& owner,smg_ammo::State& magazine,ExitDebit& debit,
+                       const Phase& selected,int loaded) noexcept {
+    if(debit.valid||debit.settled||debit.rejected||!selected.qualified||!selected.revision
+        ||(selected.side!=left&&selected.side!=right)||selected.count<2||selected.count>maxShots
+        ||key(selected.native)!=owner.identity||owner.failed||owner.busy
+        ||magazine.native!=selected.native||!magazine.initialized||magazine.updating
+        ||magazine.prepaid||magazine.capacity<1||magazine.capacity>static_cast<int>(maxRounds)
+        ||magazine.rounds[0]<0||magazine.rounds[1]<0
+        ||magazine.rounds[0]>magazine.capacity||magazine.rounds[1]>magazine.capacity
+        ||loaded!=magazine.total())return false;
+    const int hand=magazine.rounds[selected.side==left?0:1];
+    // A custom per-hand reload can interrupt a native burst. Its failed-shot
+    // cleanup still runs, but cannot round down ammunition currently reloading.
+    // Preserve the real count for publication; only this scoped getter sees 0.
+    const int reported=magazine.loading&selected.side?0:hand;
+    magazine.updating=true;++magazine.revision;owner.busy=true;++owner.revision;
+    debit={selected,magazine.revision,owner.revision,loaded,hand,reported,
+        reported%static_cast<int>(selected.count),magazine.loading,true,false};return true;
+}
+inline bool settle_exit(Owner& owner,smg_ammo::State& magazine,ExitDebit& debit,
+                        int loadedAfter,bool current) noexcept {
+    if(!debit.valid||debit.settled)return false;
+    debit.settled=true;
+    const bool sameOwner=owner.identity==key(debit.phase.native)&&owner.busy
+        &&owner.revision==debit.ownerRevision;
+    const bool sameMagazine=magazine.native==debit.phase.native&&magazine.updating
+        &&magazine.revision==debit.magazineRevision;
+    if(!sameOwner||!sameMagazine||!current||loadedAfter!=debit.loaded-debit.remainder){
+        // Never mutate a replacement generation or a newer transaction. A
+        // failed exact observation requires explicit native reconciliation.
+        if(owner.identity==key(debit.phase.native))owner.failed=true;
+        if(sameOwner){owner.busy=false;++owner.revision;}
+        if(sameMagazine){magazine.updating=false;++magazine.revision;}
+        return false;
+    }
+    const auto slot=debit.phase.side==left?0u:1u;
+    if(magazine.rounds[slot]!=debit.hand||magazine.loading!=debit.loading){
+        owner.failed=true;owner.busy=false;++owner.revision;
+        magazine.updating=false;++magazine.revision;return false;
+    }
+    magazine.rounds[slot]-=debit.remainder;
+    if(debit.remainder)magazine.lastSide=debit.phase.side;
+    magazine.updating=false;++magazine.revision;owner.busy=false;++owner.revision;
+    // Paid native queue entries retain their hand even after this phase exits.
+    return owner.leave(debit.phase.side);
+}
+}
