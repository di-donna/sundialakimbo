+        // S2 fixes: the session stop criteria and the new behaviours.
+        (void)std::snprintf(text,sizeof(text),"ev=sd stage=s2_fix s=%.0f emit_relocs=%llu sprint_shots=%llu sturm_disabled_sprint=%llu sturm_state=%llu unarmed=%llu cadence=%llu stale=%llu",
+            now,static_cast<unsigned long long>(s_.emitRelocs.load()),static_cast<unsigned long long>(s_.sprintShots.load()),static_cast<unsigned long long>(s_.sturmDisabledSprint.load()),
+            static_cast<unsigned long long>(s_.refusals[static_cast<unsigned>(Refuse::sturmState)].load()),static_cast<unsigned long long>(s_.refusals[static_cast<unsigned>(Refuse::unarmed)].load()),
+            static_cast<unsigned long long>(s_.refusals[static_cast<unsigned>(Refuse::cadence)].load()),static_cast<unsigned long long>(s_.refusals[static_cast<unsigned>(Refuse::stale)].load()));
+        e_.log(LogLevel::info,text);
+    }
+public:
+    InputPass(E& e,Shared& s) noexcept:e_(e),s_(s){}
+    void reset() noexcept {
+        remap_={};trigger_={};cache_={};cacheValid_=false;generation_=revision_=0;armed_=magsLive_=rmbArmed_=false;failures_=discoverLines_=relocLines_=remapLines_=0;
+        lastPeriodic_=-1e9;orphanSince_=-1;armedAt_=-1e9;lastSerial_=0;noTickGate_={};lastMode_=Remap::native;quickMoved_={};otherOnce_=false;
+    }
+    [[nodiscard]] bool armed() const noexcept {return armed_;}
+    [[nodiscard]] bool cache_valid() const noexcept {return cacheValid_;}
+    [[nodiscard]] const discovery::Snapshot& cache() const noexcept {return cache_;}
+    [[nodiscard]] const Trigger& trigger() const noexcept {return trigger_;}
+    // One evaluator pass (slot 0, action 0). clock(): precise seconds;
+    // focused(): game focused and no UI. Both are evaluated only past the pre-gate.
+    // S2: the cache follows its handles, the table follows the drawn weapon, and the
+    // driver runs at the end of every armed pass (e_.drive(): Driver::frame).
+    template<class Clock,class Focus> Remap pass(std::uint64_t nowMs,Clock&& clock,Focus&& focused) noexcept {
+        auto& ss=e_.session();
+        if(!ss.firing.load(std::memory_order_acquire)||s_.inputFailed.load(std::memory_order_acquire)){
+            rmbArmed_=false;
+            if(remap_.armed||armed_||trigger_.eligible||lastMode_!=Remap::native){
+                const double now=clock();remap_={};disarm();trigger_.sample(false,false,now);e_.publish_trigger(trigger_);
+                return finish(Remap::native,now,ss.firing.load(std::memory_order_acquire)?"input_failed":"off",Evidence::unknown,false,false,false,false,false);
+            }
+            return Remap::native;
+        }
+        const bool seen=ss.seen(nowMs,kSeenMs);
+        // S2 fix (gameplay F4): once S&D has a cache (S&D owners only), the pre-gate
+        // follows the active component by handle and reads it (about 10 checked reads, no
+        // clock): a swap back to S&D takes the S&D table from the switch, before the
+        // model is presented (S2: native, RMB zoomed and LMB fired Sturm in that window).
+        // Another weapon ends a lapsed stretch (the next switch to Sturm gets its grace).
+        bool quickSturm=false;
+        if(!seen&&!remap_.armed&&cacheValid_){
+            discovery::Relocation q{};bool qs=false,qd=false;
+            if(e_.relocate(cache_,discovery::partActive,q)&&e_.active(cache_,qs,qd)){
+                quickSturm=qs&&!remap_.lapsed;
+                if(!qs&&(remap_.lapsed||remap_.activeAt>-1e8))remap_={};
+                if(q.moved){quickMoved_.moved+=q.moved;quickMoved_.movedMask|=q.movedMask;}
+            }
+        }
+        if(!seen&&!remap_.armed&&!quickSturm){              // the pre-gate: no sample, no pump, no clock
+            // Regression-review F1: the magazine observers do not outlive S&D (a
+            // freed magazine address is reused); republished when S&D is back.
+            if(magsLive_){const auto at=ss.seenAt.load(std::memory_order_relaxed);if(!at||nowMs<at||nowMs-at>kMagOrphanMs)clear_mags();}
+            rmbArmed_=false;return Remap::native;
+        }
+        const double now=clock();const bool focusedNoUi=focused();
+        s_.bindingTid.store(e_.thread(),std::memory_order_relaxed);
+        s_.focused.store(focusedNoUi,std::memory_order_relaxed);
+        if(cacheValid_&&s_.dropRequest.load(std::memory_order_acquire)==generation_){drop();trigger_.reset();}
+        // S2 decision 1: the cache follows its handles every pass (the roots, so the
+        // hooks' barrel and magazine pointers are current, and the active component).
+        // A relocation is followed; only a lost handle or identity drops the cache.
+        bool activeKnown=false,activeSturm=false,activeDrang=false;
+        if(cacheValid_){
+            discovery::Relocation r{};
+            if(!e_.relocate(cache_,kPassParts,r))lost(r,now);
+            else{
+                // a move the pre-gate's quick check followed is published here (once)
+                if(quickMoved_.moved){r.moved+=quickMoved_.moved;r.movedMask|=quickMoved_.movedMask;}
+                quickMoved_={};
+                if(r.moved)relocated(r,now);
+                // An unreadable active component is unknown: the table follows the
+                // presented model; a freed cache drops after 1 s (the orphan timer).
+                if(e_.active(cache_,activeSturm,activeDrang)){activeKnown=true;orphanSince_=-1;}
+                else if(orphanSince_<0)orphanSince_=now;
+                else if(now-orphanSince_>kCacheOrphan)drop();
+            }
+        }
+        if(cacheValid_&&!magsLive_&&seen)publish_mags();
+        // S2 decision 3: the table follows the DRAWN weapon (the handle-resolved active
+        // component, else the presented private model), never the cache's validity.
+        // S2 fix (gameplay F7): while the S&D model is presented, one "other" read (a read
+        // racing a relocation) is not enough to hand the table back and disarm (which
+        // cancels Drang's reload and resets the trigger): two consecutive passes are.
+        // Drang itself still stops on that pass (drangCan reads the real active component).
+        bool vetoKnown=activeKnown;
+        if(activeKnown&&!activeSturm&&seen&&remap_.armed&&!otherOnce_){otherOnce_=true;vetoKnown=false;}
+        else otherOnce_=false;
+        const auto ev=evidence(vetoKnown,activeSturm,seen);
+        const Remap mode=remap_.drawn(false,ev,focusedNoUi,now,activeKnown&&activeSturm);
+        const char* why=ev==Evidence::other?"other_weapon":ev==Evidence::unknown?(mode==Remap::native?"grace_expired":"grace")
+            :!focusedNoUi?"ui":activeKnown?"drawn_active":"drawn_seen";
+        if(mode==Remap::native){
+            disarm();trigger_.sample(false,false,now);e_.publish_trigger(trigger_);rmbArmed_=false;
+            return finish(mode,now,why,ev,activeKnown,activeSturm,activeDrang,seen,focusedNoUi);
+        }
+        const bool latched=ss.latched();
+        if(!cacheValid_&&mode==Remap::sturmDrang&&seen&&!latched){
+            discovery::Snapshot snap{};
+            if(e_.pump(snap)==discovery::Result::accepted&&snap.sturmActive)accept(snap,now);
+        }
+        // Drang fires only while presented, focused, cached, unlatched and not known
+        // to be another weapon.
+        const bool drangCan=mode==Remap::sturmDrang&&seen&&cacheValid_&&!latched&&(!activeKnown||activeSturm);
+        if(drangCan){
+            s_.lastPass.store(now,std::memory_order_release);s_.lastEligible.store(now,std::memory_order_release);
+            if(!armed_){armed_=true;armedAt_=now;s_.armEpoch.fetch_add(1,std::memory_order_acq_rel);}
+            ss.sturmBarrel.store(cache_.sturm.key.barrel,std::memory_order_release);
+        }else{
+            // crash-review F1: eligibility ends on the first pass that cannot fire
+            // (kEligibleFresh then only covers passes that stopped coming). The driver
+            // stays armed (its reload clock runs) while the table holds.
+            s_.lastEligible.store(-1e9,std::memory_order_release);
+            if(armed_&&cacheValid_)s_.lastPass.store(now,std::memory_order_release);
+            else disarm();
+        }
+        // One 343C30 sample per S&D pass: LMB (Drang's trigger) and RMB (gameplay-review
+        // F5: slot-0 fire stays unbound after any entry into S&D until RMB is seen up).
+        bool lmb=false,rmb=false,sampled=false;
+        if(drangCan){
+            if(!e_.mouse(lmb,rmb)){
+                lmb=false;
+                if(++failures_>=kInputFailures){
+                    s_.inputFailed.store(true,std::memory_order_release);e_.firing().latchMask.fetch_or(1ULL<<L9,std::memory_order_relaxed);
+                    e_.log(LogLevel::warn,"ev=sd stage=latch reason=L9_input detail=mouse_sample_unreadable bindings=native");
+                    remap_={};rmbArmed_=false;disarm();trigger_.sample(false,false,now);e_.publish_trigger(trigger_);
+                    return finish(Remap::native,now,"input_failed",ev,activeKnown,activeSturm,activeDrang,seen,focusedNoUi);
+                }
+            }else{failures_=0;sampled=true;}
+        }else if(mode==Remap::sturmDrang)sampled=e_.mouse(lmb,rmb);
+        if(mode!=Remap::sturmDrang)rmbArmed_=false;
+        else if(sampled&&!rmb)rmbArmed_=true;
+        trigger_.sample(drangCan,lmb,now);e_.publish_trigger(trigger_);
+        if(trigger_.serial!=lastSerial_){
+            lastSerial_=trigger_.serial;
+            // Gameplay-review F3 (evidence): the OS cursor at the press (a game menu?).
+            const bool cursor=e_.cursor_showing();s_.pressCursor.store(cursor?1:0,std::memory_order_relaxed);
+            if(cursor)s_.cursorPresses.fetch_add(1,std::memory_order_relaxed);
+            // Gameplay-review F4: a press while no armed driver pass came for kStale
+            // (S2: the driver runs below in this pass, so only a busy driver counts).
+            const double tick=s_.lastDriverTick.load(std::memory_order_acquire);
+            if(armed_&&now-(tick>armedAt_?tick:armedAt_)>kStale){
+                auto& f=e_.firing();f.refusals.fetch_add(1,std::memory_order_relaxed);f.refuseLast.store(static_cast<std::uint64_t>(Refuse::noTick),std::memory_order_relaxed);
+                s_.refusals[static_cast<unsigned>(Refuse::noTick)].fetch_add(1,std::memory_order_relaxed);
+                std::uint32_t count{};
+                if(noTickGate_.note(Refuse::noTick,count)&&s_.budget.take(now)){
+                    char text[128]{};(void)std::snprintf(text,sizeof(text),"ev=sd stage=refuse reason=no_tick count=%u since_tick_ms=%.0f",count,tick>-1e8?(now-tick)*1000:-1.0);
+                    e_.log(LogLevel::info,text);
+                }
+            }
+        }
+        if(armed_){probe(now);periodic(now);e_.drive();}
+        const Remap out=mode==Remap::sturmDrang&&!rmbArmed_?Remap::sturmDrangHeld:mode;
+        return finish(out,now,out==Remap::sturmDrangHeld?"rmb_held":why,ev,activeKnown,activeSturm,activeDrang,seen,focusedNoUi);
+    }
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/sturm_drang_firing.h b/Dawn/src/client/hooks/akimbo/sturm_drang_firing.h
new file mode 100644
index 0000000000000000000000000000000000000000..bb32feeca6310c5371c57b9274a32790cdfe381e
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/sturm_drang_firing.h
@@ -0,0 +1,408 @@
+#pragma once
+// Sturm & Drang Akimbo S1: the pure firing rules (design-firing 9.1 with the
+// critique-firing fixes B2/B3/B6, 3.2/3.3 and the INTEGRATION-S1 rulings 4, 12
+// and 13). No OS call, no native call, no game-memory read: the driver
+// (sturm_drang_driver.h) and the tests (Dawn\unit\sturm_drang_firing_tests.cpp)
+// compile it as is.
+//
+//  - binding(): the remap. RMB (111) is Sturm's native fire on slot 0; slot-1
+//    fire and both zoom actions are unbound (116); reload (6) stays native. The
+//    quiet mode (a transient ineligibility while armed, critique 3.2) unbinds
+//    fire and zoom; the native mode returns the originals (the kill file, an
+//    input failure or S&D not drawn). A latch keeps the S&D table (ruling 13:
+//    RMB = Sturm, zoom unbound, LMB -> nothing); only Drang stops.
+//    sturmDrangHeld (gameplay-review F5): the S&D table with slot-0 fire still
+//    unbound, from any entry into S&D until RMB has been seen up once, so an
+//    RMB held across the switch (ADS on another weapon, a menu, alt-tab) never
+//    becomes a new Sturm fire press (a ghost shot).
+//  - Remap: the ~1 s hysteresis (ruling 13) over the per-pass eligibility.
+//  - Trigger / take(): LMB edges with a session-monotonic serial; every reset
+//    bumps the epoch inside sample() and records the serial at the bump; the
+//    consumer primes to that serial (critique B6: no swallowed first press, no
+//    serial wrap). Release-to-arm: a button held through a (re)start never fires.
+//  - Cadence: one shot per edge, 50 ms early buffer, 150 ms staleness,
+//    interval clamp(1/rate, 0.20 s, 0.60 s). A due shot stays pending until
+//    fired() or drop(): a transient refusal (another thread, a lock) retries.
+//  - left_shift() / left_origin(): the current native right origin shifted to
+//    Drang's muzzle, from the hand's published left frame when fresh, else the
+//    static pair.
+//  - Probe / verdict / Runaway / keep_awake(): ruling 4 (probe once per session,
+//    keep-awake only on a sparse/none verdict against the binding heartbeat, the
+//    runaway latch).
+//  - LogBudget / RefuseGate: the S1 log budget (design-firing 7.2, T11).
+// S2 (INTEGRATION-S2): RemapState::drawn / evidence() (decision 3: the table
+// follows the drawn weapon), aim() (decision 4: the crosshair direction),
+// kKeepAwake false (decision 2: H1 is an observer), Refuse::fireThread.
+#include "presentation.h"
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace dawn::client::hooks::akimbo::sturm_drang {
+using presentation::Frame;
+using presentation::Vec;
+
+// ---- The remap -------------------------------------------------------------------
+// 4A7F50 key codes: 109 = LMB buttons[0], 111 = RMB buttons[2], 116 = none
+// (evaluator 12B90D6..12B90FF; smg.h:18-21, the IKELOS precedent).
+inline constexpr unsigned keyLmb=109,keyRmb=111,keyNone=116;
+inline constexpr unsigned bindFire=0,bindZoom=1,bindZoomToggle=2,bindReload=6;
+enum class Remap : unsigned char {native,sturmDrang,quiet,sturmDrangHeld};
+[[nodiscard]] inline constexpr unsigned binding(unsigned slot,unsigned action,unsigned original,Remap mode) noexcept {
+    if(mode==Remap::native||slot>1)return original;
+    if(action==bindFire)return mode==Remap::sturmDrang&&slot==0?keyRmb:keyNone;   // LMB never reaches native fire
+    if(action==bindZoom||action==bindZoomToggle)return keyNone;                  // no ADS
+    return original;                                                                 // reload (6) and the rest native
+}
+// Ruling 13 hysteresis. eligible: S&D drawn and presented (<= 100 ms), game
+// focused, no UI; sturmActive: the discovery cache (when valid) does not say
+// another weapon is active. Once armed, a transient ineligibility up to kGrace
+// keeps fire and zoom unbound (quiet) instead of handing LMB back to Sturm.
+inline constexpr double kGrace=1.0;
+// S2 decision 3: while S&D is the DRAWN weapon the table is stable. Drawn is
+// decided per pass from cheap evidence, never from the discovery cache's
+// validity: the active-weapon component (re-resolved by its handle every pass)
+// names the S&D Sturm core -> drawn; it names anything else (another weapon,
+// Drang drawn on its own) -> not drawn, native at once; no readable active
+// component (no cache yet, a refresh) -> the S&D private model presented within
+// 100 ms decides, and after it lapses kUnknownGrace keeps the table (a
+// presentation hitch) before native bindings return.
+inline constexpr double kUnknownGrace=.5;
+enum class Evidence : unsigned char {drawn,other,unknown};
+// S2 fix (gameplay F3 / regression F1): the active component VETOES (another weapon:
+// native at once) and the presented model CONFIRMS. An active Sturm without a
+// presented model (a super, a vehicle, a finisher, an emote, death) is unknown: the
+// table holds kUnknownGrace from the last presentation or from the switch to Sturm
+// (RemapState::drawn activeAt), then native (S1: native after 1 s), never indefinitely.
+[[nodiscard]] inline constexpr Evidence evidence(bool activeKnown,bool activeSturm,bool seen) noexcept {
+    return activeKnown&&!activeSturm?Evidence::other:seen?Evidence::drawn:Evidence::unknown;
+}
+struct RemapState {
+    bool armed{};double lastEligible{-1e9};
+    // S1's per-pass decision (kept for its tests): eligible = drawn and presented and
+    // focused; sturmActive = the cache does not name another weapon.
+    Remap decide(bool native,bool eligible,bool sturmActive,double now) noexcept {
+        if(native){*this={};return Remap::native;}
+        if(eligible&&sturmActive){armed=true;lastEligible=now;return Remap::sturmDrang;}
+        if(armed&&sturmActive&&now>=lastEligible&&now-lastEligible<=kGrace)return Remap::quiet;
+        *this={};return Remap::native;
+    }
+    // S2: the drawn decision. The S&D table (RMB = Sturm 111, zoom 116, LMB never
+    // Sturm's) holds while drawn; quiet only while the game is unfocused or a UI
+    // is up (fire and zoom unbound: a Dawn-UI right click never fires Sturm).
+    // S2 fix (gameplay F3/F4): activeAt = the first pass the active component named the
+    // S&D Sturm without a presented model since the last veto (a swap-in whose model is
+    // presented a little later: the table from the switch, never native with RMB on
+    // zoom). The grace runs from max(lastEligible, activeAt); once it lapses the table is
+    // native and stays native (lapsed; activeAt is kept so it does not flap) until the
+    // model is presented again or another weapon vetoes (which starts a new stretch).
+    double activeAt{-1e9};bool lapsed{};
+    Remap drawn(bool native,Evidence e,bool focusedNoUi,double now,bool activeSturm=false) noexcept {
+        if(native||e==Evidence::other){*this={};return Remap::native;}
+        if(e==Evidence::drawn){armed=true;lastEligible=now;lapsed=false;}
+        else{
+            if(activeSturm&&activeAt<-1e8)activeAt=now;
+            const double from=lastEligible>activeAt?lastEligible:activeAt;
+            if(!(now>=from&&now-from<=kUnknownGrace)){armed=false;lapsed=activeSturm;return Remap::native;}
+            armed=true;
+        }
+        return focusedNoUi?Remap::sturmDrang:Remap::quiet;
+    }
+};
+[[nodiscard]] inline constexpr const char* remap_name(Remap m) noexcept {
+    return m==Remap::native?"native":m==Remap::sturmDrang?"sturm_drang":m==Remap::quiet?"quiet":"sturm_drang_held";
+}
+
+// ---- The trigger (critique B6) ------------------------------------------------------
+// Written by binding_hook once per evaluator pass (slot 0, action 0) under the
+// input lock; the driver copies it under the same lock (no native call inside).
+struct Trigger {
+    std::uint32_t epoch{};
+    std::uint64_t serial{},epochSerial{};   // serial: session-monotonic; epochSerial: serial at the last epoch bump
+    double pressedAt{};
+    bool eligible{},held{},armed{};
+    void bump() noexcept {++epoch;epochSerial=serial;}
+    // Any reset (eligibility lost or regained, a latch, a cache change): the epoch
+    // bumps here and the button must be seen up before a press counts.
+    void reset() noexcept {bump();eligible=held=armed=false;}
+    void sample(bool isEligible,bool lmb,double now) noexcept {
+        if(!isEligible){if(eligible||held||armed)reset();return;}
+        if(!eligible){reset();eligible=true;}
+        if(!lmb){armed=true;held=false;return;}
+        if(armed&&!held){++serial;pressedAt=now;}
+        held=true;
+    }
+};
+struct Consumer {std::uint32_t epoch{};std::uint64_t consumed{};bool primed{};};
+struct Press {bool fresh{};double at{};unsigned coalesced{};};
+// A new epoch discards any backlog from before its bump (the consumer primes to
+// the serial at the bump, never to the current serial: a press made after the
+// bump and before the first driver tick still fires). More than one unconsumed
+// edge coalesces to the newest.
+[[nodiscard]] inline Press take(const Trigger& t,Consumer& c) noexcept {
+    if(!c.primed||c.epoch!=t.epoch||t.serial<c.consumed)c={t.epoch,t.epochSerial,true};
+    if(t.serial<=c.consumed)return {};
+    const auto n=t.serial-c.consumed;c.consumed=t.serial;
+    return {true,t.pressedAt,static_cast<unsigned>(n>1?(n-1>0xffffu?0xffffu:n-1):0)};
+}
+
+// ---- Cadence ------------------------------------------------------------------------
+inline constexpr double kStale=.150,kBuffer=.050,kMinInterval=.20,kMaxInterval=.60;
+// A press stamped by the main thread may be read a little before the driver's
+// clock catches up (another core's QPC); up to kFuture ahead counts as now.
+inline constexpr double kFuture=.002;
+[[nodiscard]] inline double interval(float shotsPerSecond) noexcept {
+    if(!std::isfinite(shotsPerSecond)||shotsPerSecond<=0)return kMinInterval;
+    const double v=1.0/shotsPerSecond;return v<kMinInterval?kMinInterval:v>kMaxInterval?kMaxInterval:v;
+}
+enum class Decision : unsigned char {idle,fire,wait,dropStale,dropCadence};
+struct Cadence {
+    double nextReady{-1e9},pendingAt{};bool pending{};unsigned merged{};
+    // S2 fix (gameplay F1): a press made before Drang is ready is kept until it is
+    // ready (one shot per edge; several early presses merge into that one shot), like a
+    // native semi-auto tapped faster than its RPM. Staleness runs from the later of
+    // the press and the readiness. dropCadence only for a press more than kMaxInterval
+    // early (cannot happen while nextReady = the last shot + interval <= kMaxInterval).
+    // kBuffer is kept as the S1 value for the record; it no longer drops presses.
+    Decision tick(const Press& p,double now) noexcept {
+        if(p.fresh){
+            if(p.at-now>kFuture||now-p.at>kStale){pending=false;return Decision::dropStale;}
+            if(nextReady-now>kMaxInterval+kFuture)return Decision::dropCadence;
+            if(pending)++merged;else{pending=true;pendingAt=p.at;}
+        }
+        if(!pending)return Decision::idle;
+        if(now-(pendingAt>nextReady?pendingAt:nextReady)>kStale){pending=false;return Decision::dropStale;}
+        return now>=nextReady?Decision::fire:Decision::wait;
+    }
+    void fired(double now,double iv) noexcept {nextReady=now+iv;pending=false;}
+    void drop() noexcept {pending=false;}
+    void reset() noexcept {*this={};}
+};
+
+// ---- The left origin (design-firing 5) ----------------------------------------------
+// Origin records (181E930 ABI, firing.h:9): 0x50 origin, 0x10 aux.
+struct alignas(16) Origin {std::array<std::byte,0x50> bytes{};};
+struct alignas(16) Aux {float x{},y{},z{},w{1.f};};
+static_assert(sizeof(Origin)==0x50&&alignof(Origin)==16&&sizeof(Aux)==0x10);
+inline constexpr Vec sturmMuzzle{.3459f,0,.0992f};        // 80B9EAD3+0x2F0 (generic HC; ASSETS 1) [I]
+inline constexpr Vec drangMuzzle{.302569f,0,.157473f};    // 80BBBBA1+0x2A0 bone 0 (ASSETS 1) [V data]
+inline constexpr Vec staticPair{0,.18999924f,0};          // BUILD-REPORT 2 marker spacing
+inline constexpr double kHandFresh=.100;
+inline constexpr float kHandMaxMeters=.6f,kHandMinCosHalf=.98481f;   // |angle| < 20 deg <=> |w| > cos(10 deg)
+// The hand's published left gun in Sturm's weapon-root frame (leftInRight =
+// inverse(root 72) o leftGun, sturm_drang_pose.h Signals::publish_left).
+// camera: the world camera rotation of the same frame (log only: aim_delta_deg).
+// aim (S2 decision 4): the crosshair frame of the latest S&D export frame, q = the
+// world camera rotation (controller+0xB0), p = the view origin (camera o eye,
+// controller+0x70, the frame the first-person weapon is drawn in), at aimAt.
+struct LeftPose {Frame leftInRight{};double at{-1e9};bool valid{};presentation::Quat camera{};bool cameraValid{};
+    Frame aim{};double aimAt{-1e9};bool aimValid{};};
+[[nodiscard]] inline bool finite(Vec v) noexcept {return std::isfinite(v.x)&&std::isfinite(v.y)&&std::isfinite(v.z);}
+[[nodiscard]] inline Vec static_shift() noexcept {
+    return presentation::add(presentation::add(staticPair,drangMuzzle),presentation::mul(sturmMuzzle,-1));
+}
+[[nodiscard]] inline Vec left_shift(const LeftPose& h,double now,bool& fromHand) noexcept {
+    using namespace presentation;fromHand=false;
+    if(h.valid&&now>=h.at-kFuture&&now-h.at<=kHandFresh&&valid(h.leftInRight)){
+        const auto& f=h.leftInRight;const float d2=f.p.x*f.p.x+f.p.y*f.p.y+f.p.z*f.p.z;
+        if(d2<kHandMaxMeters*kHandMaxMeters&&std::fabs(f.q.w)>kHandMinCosHalf){
+            fromHand=true;return add(add(f.p,rotate(f.q,drangMuzzle)),mul(sturmMuzzle,-1));
+        }
+    }
+    return static_shift();
+}
+[[nodiscard]] inline bool origin_frame(const Origin& o,Frame& f) noexcept {
+    std::memcpy(&f,o.bytes.data()+0x10,sizeof(f));
+    const float q=f.q.x*f.q.x+f.q.y*f.q.y+f.q.z*f.q.z+f.q.w*f.q.w;
+    return q>.96f&&q<1.04f&&f.scale>.95f&&f.scale<1.05f&&finite(f.p);
+}
+// Right native origin -> left origin + aux. Only +0x20..+0x2B change
+// (181E930/181C8B0 read +0x10..+0x2F; aux = {x, y, z, 1}, CB53E0).
+[[nodiscard]] inline bool left_origin(const Origin& right,Vec shift,Origin& left,Aux& aux) noexcept {
+    Frame f{};
+    if(!origin_frame(right,f)||!finite(shift)||shift.x*shift.x+shift.y*shift.y+shift.z*shift.z>1.f)return false;
+    const Vec p=presentation::add(f.p,presentation::rotate(f.q,shift));
+    if(!finite(p))return false;
+    left=right;std::memcpy(left.bytes.data()+0x20,&p,sizeof(p));aux={p.x,p.y,p.z,1.f};return true;
+}
+// The angle (degrees) and distance (m) between two origin frames (calibration 5.4).
+inline void frame_delta(const Frame& a,const Frame& b,float& meters,float& degrees) noexcept {
+    const float dx=a.p.x-b.p.x,dy=a.p.y-b.p.y,dz=a.p.z-b.p.z;meters=std::sqrt(dx*dx+dy*dy+dz*dz);
+    const float dot=std::fabs(a.q.x*b.q.x+a.q.y*b.q.y+a.q.z*b.q.z+a.q.w*b.q.w);
+    degrees=2.f*std::acos(dot>1.f?1.f:dot)*57.29577951f;
+}
+
+// Gameplay-review F2 (log only): the angle (degrees) between the emission's
+// origin rotation and the world camera rotation of the same export frame; -1
+// without a fresh camera. It shows whether Drang's shots follow Sturm's
+// animated muzzle away from the view (reload tilt, sprint drop) [C].
+[[nodiscard]] inline float aim_delta_deg(const Frame& origin,const LeftPose& h,double now) noexcept {
+    if(!h.cameraValid||!(now>=h.at-kFuture&&now-h.at<=kHandFresh))return -1.f;
+    const auto& c=h.camera;const float n=c.x*c.x+c.y*c.y+c.z*c.z+c.w*c.w;
+    if(!(n>.96f&&n<1.04f))return -1.f;
+    float meters{},degrees{};frame_delta(origin,Frame{c,origin.p,1},meters,degrees);return degrees;
+}
+
+// ---- S2 decision 4: Drang's shot direction is the aim, not Sturm's animated muzzle ----
+// The S1 log: shots during Sturm's fire clip (66) had aim_delta_deg up to 27 and
+// during its reload (59) 24 on average, because the left origin's rotation was
+// the rotation of Sturm's collector frame (its animated muzzle). S2 keeps the
+// ORIGIN at the left muzzle (the collector position shifted by the hand's left
+// frame, as S1) and takes the DIRECTION from the aim frame: the ray from the left
+// muzzle to the point kConvergeMeters down the crosshair (converge), like the
+// native weapons converging on the crosshair. The weapon and camera frames share
+// their axes (+x forward, +y left, +z up: the muzzle offsets are +x; the S1 idle
+// shots had the collector and camera rotations 1.6 degrees apart on average).
+// Guards: the aim frame must be fresh (<= kHandFresh) and unit; the convergence
+// needs Sturm's muzzle in front of the view origin within 1.5 m (the axis and the
+// view origin are what we think they are), else the direction is the camera
+// forward itself (parallel); without a fresh aim frame the S1 direction stays
+// (muzzle, logged). The roll is the camera's.
+inline constexpr float kConvergeMeters=20.f;
+enum class AimSource : unsigned char {muzzle,parallel,converge};
+[[nodiscard]] inline constexpr const char* aim_name(AimSource s) noexcept {
+    return s==AimSource::converge?"converge":s==AimSource::parallel?"parallel":"muzzle";
+}
+[[nodiscard]] inline Vec forward(presentation::Quat q) noexcept {return presentation::rotate(q,{1,0,0});}
+[[nodiscard]] inline float dot(Vec a,Vec b) noexcept {return a.x*b.x+a.y*b.y+a.z*b.z;}
+[[nodiscard]] inline float length(Vec a) noexcept {return std::sqrt(dot(a,a));}
+// The angle (degrees) between two directions (any length > 0); -1 if degenerate.
+[[nodiscard]] inline float angle_deg(Vec a,Vec b) noexcept {
+    const float n=length(a)*length(b);if(!(n>1e-12f)||!std::isfinite(n))return -1.f;
+    float c=dot(a,b)/n;c=c>1.f?1.f:c<-1.f?-1.f:c;return std::acos(c)*57.29577951f;
+}
+// The shortest rotation taking unit a onto unit b (a and b not opposite).
+[[nodiscard]] inline presentation::Quat from_to(Vec a,Vec b) noexcept {
+    const Vec c=presentation::cross(a,b);const float d=dot(a,b);
+    if(d>.9999999f)return {0,0,0,1};
+    return presentation::normalize({c.x,c.y,c.z,1.f+d});
+}
+struct Aim {presentation::Quat q{};AimSource source{AimSource::muzzle};float deltaDeg{-1},muzzleDeg{-1};double ageMs{-1};};
+[[nodiscard]] inline bool unit(presentation::Quat q) noexcept {
+    const float n=q.x*q.x+q.y*q.y+q.z*q.z+q.w*q.w;return n>.96f&&n<1.04f;
+}
+// origin: the left origin frame (p = the left muzzle, q = Sturm's collector
+// rotation); right: Sturm's collector frame (its muzzle). Returns the rotation to emit.
+[[nodiscard]] inline Aim aim(const Frame& origin,const Frame& right,const LeftPose& h,double now) noexcept {
+    Aim r{origin.q,AimSource::muzzle,aim_delta_deg(origin,h,now),-1.f,-1};
+    if(!h.aimValid||!(now>=h.aimAt-kFuture&&now-h.aimAt<=kHandFresh)||!unit(h.aim.q)||!finite(h.aim.p)||!finite(origin.p)||!finite(right.p))return r;
+    const auto cq=presentation::normalize(h.aim.q);const Vec f=forward(cq);
+    r.ageMs=(now-h.aimAt)*1000;if(r.ageMs<0)r.ageMs=0;
+    r.muzzleDeg=angle_deg(forward(origin.q),f);
+    r.q=cq;r.source=AimSource::parallel;
+    const Vec toRight=presentation::add(right.p,presentation::mul(h.aim.p,-1));const float d=length(toRight);
+    if(std::isfinite(d)&&d>.05f&&d<1.5f&&dot(toRight,f)>.3f*d){
+        const Vec target=presentation::add(h.aim.p,presentation::mul(f,kConvergeMeters));
+        const Vec ray=presentation::add(target,presentation::mul(origin.p,-1));const float n=length(ray);
+        if(std::isfinite(n)&&n>1.f){r.q=presentation::product(from_to(f,presentation::mul(ray,1/n)),cq);r.source=AimSource::converge;}
+    }
+    r.deltaDeg=angle_deg(forward(r.q),f);
+    return r;
+}
+
+// ---- H1 return policy and the probe (ruling 4, critique B2) -----------------------------
+// S2 decision 2: the driver runs in the input pass (the binding thread, proven in
+// the S1 session to be the native firing thread for the whole session), so no
+// press waits on H1 any more and keep-awake no longer earns its keep: the S1 log
+// had it forcing 30,695 H1 returns on Sturm's barrel while the relocation gaps
+// (max_gap_ms 2150) still starved the H1 driver. H1 stays attached as an
+// observer only (the probe, the fire-thread evidence, Drang's EmitGate); it
+// always returns the native result. The pure policy below is kept (tested) but
+// never engaged.
+inline constexpr bool kKeepAwake=false;
+inline constexpr double kProbeSeconds=2.0,kAwakeReportSeconds=5.0,kInputFresh=.5;
+enum class Verdict : unsigned char {pending,ticking,sparse,none};
+// Measured against the binding_hook heartbeat (passes during the same window).
+[[nodiscard]] inline Verdict verdict(std::uint64_t calls,std::uint64_t passes,double window,double maxGap) noexcept {
+    if(!calls)return Verdict::none;
+    const double perSecond=window>0?static_cast<double>(calls)/window:0;
+    const bool heartbeat=passes==0||calls*5>=passes*4;
+    return perSecond>=20&&maxGap<=.100&&heartbeat?Verdict::ticking:Verdict::sparse;
+}
+// Keep-awake returns true only for the armed S&D Sturm barrel, after a
+// sparse/none verdict, unlatched, with barrel+0x98 == sturm.self just read.
+[[nodiscard]] inline bool keep_awake(bool enabled,Verdict v,bool armed,bool latched,bool selfOk) noexcept {
+    return enabled&&(v==Verdict::sparse||v==Verdict::none)&&armed&&!latched&&selfOk;
+}
+[[nodiscard]] inline bool post_update_result(bool native,bool keepAwake) noexcept {return native||keepAwake;}
+// Runaway (critique B2.2): more than 3 S&D-barrel H1 calls within 2 ms, or more
+// than 400 in one second, while keep-awake is engaged -> latch L7 at once.
+struct Runaway {
+    std::array<double,4> last{};unsigned count{};double secondStart{-1e9};unsigned inSecond{};
+    [[nodiscard]] bool note(double now) noexcept {
+        last[count%4]=now;++count;
+        const bool burst=count>=4&&now-last[count%4]<.002;   // last[count%4] = the 4th most recent
+        if(now-secondStart>=1.0||now<secondStart){secondStart=now;inSecond=0;}
+        return burst||++inSecond>400;
+    }
+    void reset() noexcept {*this={};}
+};
+
+// ---- The damage feed and the perk evidence (design-firing 7.2) -----------------------
+inline constexpr double kDamageWindow=2.0,kPerkWindow=1.5;
+[[nodiscard]] inline bool damage_window(double now,double lastDrangShot) noexcept {
+    return now>=lastDrangShot&&now-lastDrangShot<=kDamageWindow;
+}
+// Sturm's HUD magazine rose within 1.5 s of a Drang-window kill with no native
+// Sturm shot since that kill (a native reload cannot be told apart here [I]).
+[[nodiscard]] inline bool perk_candidate(int before,int after,double now,double lastKill,double lastSturmShot) noexcept {
+    return after>before&&now>=lastKill&&now-lastKill<=kPerkWindow&&lastSturmShot<lastKill;
+}
+
+// ---- Refusals, latches and the log budget -------------------------------------------
+// drangH1: Drang's own H1 in flight on some thread (crash-review F2, transient);
+// sturmState: Sturm's latest selector is a draw/put-away/sprint or an unknown
+// action (melee, finisher; gameplay-review F2). fireThread (S2 decision 2): the
+// driver's thread is not the thread native firing was last seen on (or none was
+// seen yet this session): no native call, the press stays pending (transient).
+enum class Refuse : unsigned {off,latched,reentry,unarmed,stale,cadence,drangChanged,variant,empty,reloading,
+    noOrigin,badFrame,okNoProjectile,returnedFalse,noTick,thread,lock,sturmDisabled,magazine,drangH1,sturmState,fireThread,count};
+inline constexpr const char* refuseNames[]{"off","latched","reentry","unarmed","stale","cadence","drang_changed","variant","empty","reloading",
+    "no_origin","bad_frame","ok_no_projectile","returned_false","no_tick","thread","lock","sturm_disabled","magazine","drang_h1","sturm_state","fire_thread"};
+static_assert(sizeof(refuseNames)/sizeof(refuseNames[0])==static_cast<unsigned>(Refuse::count));
+[[nodiscard]] inline const char* refuse_name(Refuse r) noexcept {
+    return static_cast<unsigned>(r)<static_cast<unsigned>(Refuse::count)?refuseNames[static_cast<unsigned>(r)]:"?";
+}
+// Latches: bit n of latchMask. L1..L6 design-firing 6.4 (every one disarms Drang
+// and keeps the S&D remap, ruling 13); L7 keep-awake runaway (keep-awake only);
+// L8 Drang's own H1 overlapping an emission on another thread (critique 3.8);
+// L9 input failure (the mouse sample unreadable: native bindings).
+enum Latch : unsigned {L1=1,L2,L3,L4,L5,L6,L7,L8,L9};
+inline constexpr const char* latch_name(unsigned n) noexcept {
+    return n==L1?"L1_projectiles":n==L2?"L2_emit_false":n==L3?"L3_identity":n==L4?"L4_origin":n==L5?"L5_reentry"
+        :n==L6?"L6_ammo":n==L7?"L7_keepawake":n==L8?"L8_drang_h1_overlap":n==L9?"L9_input":"?";
+}
+// Rate-limited refusal lines: the first 8 per reason, then one per 64.
+struct RefuseGate {
+    std::array<std::uint32_t,static_cast<unsigned>(Refuse::count)> counts{};
+    [[nodiscard]] bool note(Refuse r,std::uint32_t& count) noexcept {
+        const auto i=static_cast<unsigned>(r);if(i>=counts.size())return false;
+        count=++counts[i];return count<=8||count%64==0;
+    }
+};
+// The global budget for ordinary lines (shot, damage, refuse, native_*,
+// sturm_mag, sd_ammo): kLogRate lines/s with a burst of kLogBurst, shared by
+// every thread lock-free (a GCRA on one atomic). Rare lines (install, discover,
+// h1_probe, h1_awake, threads, summary, latch) bypass it (design-firing 7.2, T11).
+enum class LogLevel : unsigned char {info,warn};
+inline constexpr double kLogRate=5.0,kLogBurst=14.0;
+class LogBudget {
+    std::atomic<double> tat_{-1e300};std::atomic<std::uint64_t> dropped_{};
+public:
+    static_assert(std::atomic<double>::is_always_lock_free);
+    [[nodiscard]] bool take(double now) noexcept {
+        constexpr double period=1.0/kLogRate,tolerance=(kLogBurst-1)*period;
+        double tat=tat_.load(std::memory_order_relaxed);
+        for(;;){
+            const double base=tat<now?now:tat;
+            if(base-now>tolerance){dropped_.fetch_add(1,std::memory_order_relaxed);return false;}
+            if(tat_.compare_exchange_weak(tat,base+period,std::memory_order_relaxed))return true;
+        }
+    }
+    [[nodiscard]] std::uint64_t dropped() const noexcept {return dropped_.load(std::memory_order_relaxed);}
+    void reset() noexcept {tat_.store(-1e300);dropped_.store(0);}
+};
+}
