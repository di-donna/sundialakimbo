+inline constexpr double kTransferStale=.5;
+[[nodiscard]] inline bool eligible_now(double now,double lastEligible) noexcept {
+    return now>=lastEligible-kFuture&&now-lastEligible<=kEligibleFresh;
+}
+// What the emission produced (projectile_init_hook under the thread-local scope).
+struct Observation {unsigned projectiles{};std::uint32_t tag{},owner{};};
+// Barrel state around an emission (log only): F50 (bit 8 set by 181ED77 when it
