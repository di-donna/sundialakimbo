+++ b/Dawn/src/client/hooks/akimbo/export_filter.h
@@ -0,0 +1,20 @@
+#pragma once
+#include "identity.h"
+struct Pose;
+namespace dawn::client::hooks::akimbo {
+enum class Pass { first, procedural };
+// C86CD0 prepares the complete render pass independently of C87150. F5F210
+// freezes its controls and copies the context to the worker's frame arena.
+// Historical Thorn API names are retained; these qualify only the two
+// alternating_model identities (Thorn and Malfeasance), never generic guns.
+[[nodiscard]] bool identify_thorn_render_source(const Memory&,std::uintptr_t animation,
+    std::uintptr_t context,Identity&) noexcept;
+[[nodiscard]] bool copied_thorn_render_job(const Memory&,const Identity&,
+    std::uintptr_t source,std::uintptr_t copy) noexcept;
+// Revalidate an already completed, registered render output at its consumer.
+[[nodiscard]] bool completed_thorn_render_job(const Memory&,const Identity&,
+    std::uintptr_t copy,std::uintptr_t output) noexcept;
+/** Caller-owned spans remain borrowed for this native export invocation only. */
+[[nodiscard]] bool correct_export(const Memory&,const Identity&,Pass,
+    std::uintptr_t ranges,std::uintptr_t outputs,unsigned* selection,Pose* poses) noexcept;
+}
diff --git a/Dawn/src/client/hooks/akimbo/firing.cpp b/Dawn/src/client/hooks/akimbo/firing.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..90ef238d62553b86792e54fe1a562795f3da9a1b
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/firing.cpp
@@ -0,0 +1,125 @@
+#include "firing.h"
+#include <array>
+#include <cmath>
+#include <cstring>
+#include "presentation.h"
+
+namespace dawn::client::hooks::akimbo::firing {
+namespace {
+struct alignas(16) Origin {std::array<std::byte,0x50> bytes{};};
+struct alignas(16) Auxiliary {std::array<std::byte,0x10> bytes{};};
+static_assert(sizeof(Origin)==0x50&&sizeof(Auxiliary)==0x10);
+bool invoke(NativeBatch next,const Arguments& a,void* origins,void* auxiliary,
+            std::int32_t count,std::int32_t selected) noexcept {
+    return next(a.barrel,a.patternLimit,origins,auxiliary,count,selected,a.variant,
+                a.charge,a.scale,a.patternProgress,a.flag,a.replay,a.fromReplay);
+}
+}
+bool single_origin(const Arguments& a) noexcept {
+    return a.patternLimit==1&&a.originCount==1&&(a.selectedOrigin==-1||a.selectedOrigin==0)
+        &&a.patternProgress&&!a.replay&&!a.fromReplay;
+}
+Result dispatch_single(const Memory& memory,NativeBatch next,const Arguments& a,bool left,presentation::Vec leftOffset,presentation::Vec rightOffset) noexcept {
+    if(!single_origin(a))return {invoke(next,a,a.origins,a.auxiliary,a.originCount,a.selectedOrigin),Route::original};
+    Origin origin{};Auxiliary auxiliary{};presentation::Frame frame{};
+    if(!memory.read||!memory.read(memory.context,reinterpret_cast<std::uintptr_t>(a.origins),&origin,sizeof(origin))
+        ||!memory.read(memory.context,reinterpret_cast<std::uintptr_t>(a.auxiliary),&auxiliary,sizeof(auxiliary)))
+        return {invoke(next,a,a.origins,a.auxiliary,a.originCount,a.selectedOrigin),Route::unreadable};
+    // A1E8A0 composes the marker frame at +0x10. 181C8B0 reads its
+    // translation at +0x20. The other 48 bytes are opaque native metadata.
+    std::memcpy(&frame,origin.bytes.data()+0x10,sizeof(frame));
+    const float q=frame.q.x*frame.q.x+frame.q.y*frame.q.y+frame.q.z*frame.q.z+frame.q.w*frame.q.w;
+    if(!(q>.96f&&q<1.04f&&frame.scale>.95f&&frame.scale<1.05f)
+        ||!std::isfinite(frame.p.x)||!std::isfinite(frame.p.y)||!std::isfinite(frame.p.z))
+        return {invoke(next,a,a.origins,a.auxiliary,a.originCount,a.selectedOrigin),Route::unreadable};
+    // Rat King Akimbo (runtime v7b): the right shot moves too when the pair is widened.
+    const presentation::Vec offset=left?leftOffset:rightOffset;
+    if(left||offset.x!=0||offset.y!=0||offset.z!=0){
+        frame.p=presentation::add(frame.p,presentation::rotate(frame.q,offset));
+        std::memcpy(origin.bytes.data()+0x20,&frame.p,sizeof(frame.p));
+    }
+    return {invoke(next,a,&origin,&auxiliary,1,a.selectedOrigin),left?Route::left:Route::right};
+}
+Result dispatch(const Memory& memory,NativeBatch next,const Arguments& a,bool eligible) noexcept {
+    Route route=Route::original;
+    if(eligible&&a.patternLimit==1&&a.originCount==1
+        &&(a.selectedOrigin==-1||a.selectedOrigin==0)&&a.patternProgress
+        &&!a.replay&&!a.fromReplay){
+        // Preserve native Thorn's projectile selection, payload and firing
+        // pattern. Let the native multi-origin loop perform both emissions.
+        // Never re-enter the fire function, mutate shared data, or enqueue an
+        // additional trigger/reload event. Replay packets pass through.
+        std::array<Origin,2> origins{};
+        std::array<Auxiliary,2> auxiliary{};
+        if(memory.read&&memory.read(memory.context,reinterpret_cast<std::uintptr_t>(a.origins),&origins[0],sizeof(Origin))
+            &&memory.read(memory.context,reinterpret_cast<std::uintptr_t>(a.auxiliary),&auxiliary[0],sizeof(Auxiliary))){
+            origins[1]=origins[0];auxiliary[1]=auxiliary[0];
+            return {invoke(next,a,origins.data(),auxiliary.data(),2,-1),Route::paired};
+        }
+        route=Route::unreadable;
+    }
+    return {invoke(next,a,a.origins,a.auxiliary,a.originCount,a.selectedOrigin),route};
+}
+Result dispatch_smg(const Memory& memory,NativeBatch next,const Arguments& a,unsigned sides,bool requireTicket,const presentation::Vec* worldOrigin) noexcept {
+    if(requireTicket&&single_origin(a)&&(sides!=1&&sides!=2))return {false,Route::blocked};
+    if(!sides||sides>2||!single_origin(a))return dispatch(memory,next,a,false);
+    std::array<Origin,2> origins{};std::array<Auxiliary,2> auxiliary{};presentation::Frame frame{};
+    if(!memory.read||!memory.read(memory.context,reinterpret_cast<std::uintptr_t>(a.origins),&origins[0],sizeof(Origin))
+        ||!memory.read(memory.context,reinterpret_cast<std::uintptr_t>(a.auxiliary),&auxiliary[0],sizeof(Auxiliary)))
+        return requireTicket?Result{false,Route::blocked}:Result{invoke(next,a,a.origins,a.auxiliary,a.originCount,a.selectedOrigin),Route::unreadable};
+    std::memcpy(&frame,origins[0].bytes.data()+0x10,sizeof(frame));
+    const float q=frame.q.x*frame.q.x+frame.q.y*frame.q.y+frame.q.z*frame.q.z+frame.q.w*frame.q.w;
+    if(q<.96f||q>1.04f||!std::isfinite(q)||frame.scale<.95f||frame.scale>1.05f||!std::isfinite(frame.scale)
+        ||!std::isfinite(frame.p.x)||!std::isfinite(frame.p.y)||!std::isfinite(frame.p.z))
+        return requireTicket?Result{false,Route::blocked}:Result{invoke(next,a,a.origins,a.auxiliary,a.originCount,a.selectedOrigin),Route::unreadable};
+    auto position=presentation::add(frame.p,presentation::rotate(frame.q,{0,sides==1?.28f:-.08f,0}));
+    if(worldOrigin){
+        const auto p=*worldOrigin;const auto delta=presentation::add(p,presentation::mul(frame.p,-1));
+        if(!std::isfinite(p.x)||!std::isfinite(p.y)||!std::isfinite(p.z)
+            ||std::abs(p.x)>=1000000||std::abs(p.y)>=1000000||std::abs(p.z)>=1000000
+            ||delta.x*delta.x+delta.y*delta.y+delta.z*delta.z>9)return {false,Route::blocked};
+        // The caller supplies the generation-checked, fresh completed-pose muzzle.
+        // Keep native aim/orientation and every opaque origin/payload byte intact.
+        position=p;
+    }
+    std::memcpy(origins[0].bytes.data()+0x20,&position,sizeof(position));
+    return {invoke(next,a,origins.data(),auxiliary.data(),1,a.selectedOrigin),sides==1?Route::left:Route::right};
+}
+Result dispatch_group(const Memory& memory,NativeBatch next,const Arguments& a,unsigned side,const presentation::Vec& worldOrigin) noexcept {
+    // CB48C0 reserves 64 marker records. 181E930 either emits the selected
+    // index, or walks the origin/auxiliary arrays in 0x50/0x10-byte strides;
+    // each call into 181C8B0 receives the original patternLimit unchanged.
+    if(!next||!memory.read||(side!=1&&side!=2)||!a.patternLimit||a.patternLimit>maxGroupPattern
+        ||a.originCount<1||a.originCount>static_cast<int>(maxGroupOrigins)
+        ||a.selectedOrigin<-1||a.selectedOrigin>=a.originCount||!a.patternProgress||a.replay||a.fromReplay
+        ||!std::isfinite(worldOrigin.x)||!std::isfinite(worldOrigin.y)||!std::isfinite(worldOrigin.z)
+        ||std::abs(worldOrigin.x)>=1000000||std::abs(worldOrigin.y)>=1000000||std::abs(worldOrigin.z)>=1000000)
+        return {false,Route::blocked};
+    std::array<Origin,maxGroupOrigins> origins{};
+    std::array<Auxiliary,maxGroupOrigins> auxiliary{};
+    const auto count=static_cast<std::size_t>(a.originCount);
+    const auto originAddress=reinterpret_cast<std::uintptr_t>(a.origins),auxAddress=reinterpret_cast<std::uintptr_t>(a.auxiliary);
+    if(originAddress<0x10000||auxAddress<0x10000
+        ||originAddress>0x00007fffffffffffULL-count*sizeof(Origin)||auxAddress>0x00007fffffffffffULL-count*sizeof(Auxiliary)
+        ||!memory.read(memory.context,originAddress,origins.data(),count*sizeof(Origin))
+        ||!memory.read(memory.context,auxAddress,auxiliary.data(),count*sizeof(Auxiliary)))return {false,Route::blocked};
+    std::array<presentation::Frame,maxGroupOrigins> frames{};
+    for(std::size_t i=0;i<count;++i){
+        std::memcpy(&frames[i],origins[i].bytes.data()+0x10,sizeof(frames[i]));
+        const auto& f=frames[i];const auto q=f.q.x*f.q.x+f.q.y*f.q.y+f.q.z*f.q.z+f.q.w*f.q.w;
+        if(!(q>.96f&&q<1.04f&&f.scale>.95f&&f.scale<1.05f)
+            ||!std::isfinite(f.p.x)||!std::isfinite(f.p.y)||!std::isfinite(f.p.z))return {false,Route::blocked};
+    }
+    const auto anchor=static_cast<std::size_t>(a.selectedOrigin<0?0:a.selectedOrigin);
+    const auto delta=presentation::add(worldOrigin,presentation::mul(frames[anchor].p,-1));
+    if(delta.x*delta.x+delta.y*delta.y+delta.z*delta.z>9)return {false,Route::blocked};
+    for(std::size_t i=0;i<count;++i){
+        const auto translated=presentation::add(frames[i].p,delta);
+        if(!std::isfinite(translated.x)||!std::isfinite(translated.y)||!std::isfinite(translated.z)
+            ||std::abs(translated.x)>=1000000||std::abs(translated.y)>=1000000||std::abs(translated.z)>=1000000)
+            return {false,Route::blocked};
+        std::memcpy(origins[i].bytes.data()+0x20,&translated,sizeof(translated));
+    }
+    return {invoke(next,a,origins.data(),auxiliary.data(),a.originCount,a.selectedOrigin),side==1?Route::left:Route::right};
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/firing.h b/Dawn/src/client/hooks/akimbo/firing.h
new file mode 100644
index 0000000000000000000000000000000000000000..8b38a8302f1a13221f1333bff042a4c5110b99b8
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/firing.h
@@ -0,0 +1,53 @@
+#pragma once
+#include "identity.h"
+#include "presentation.h"
+
+namespace dawn::client::hooks::akimbo::firing {
+// Fixed-build ABI: CB4A99 calls 181E930. Its native loop at 181F1B0 advances
+// origin records by 0x50 and auxiliary records by 0x10. These are borrowed
+// synchronous inputs from CB48C0's stack; it does not read them after this call.
+using NativeBatch=bool(__fastcall*)(void*,std::uint32_t,void*,void*,std::int32_t,
+    std::int32_t,std::uint32_t,float,float,std::uint32_t*,bool,void*,bool);
+struct Arguments {
+    void* barrel{};
+    std::uint32_t patternLimit{};
+    void* origins{};
+    void* auxiliary{};
+    std::int32_t originCount{},selectedOrigin{};
+    std::uint32_t variant{};
+    float charge{},scale{};
+    std::uint32_t* patternProgress{};
+    bool flag{};
+    void* replay{};
+    bool fromReplay{};
+};
+enum class Route { original, paired, unreadable, right, left, blocked };
+struct Result { bool returned{}; Route route{}; };
+// Exactly one call to the native trampoline, including every rejection path.
+// Caller qualifies private identity and the single supported call site.
+[[nodiscard]] Result dispatch(const Memory&,NativeBatch,const Arguments&,bool eligible) noexcept;
+[[nodiscard]] bool single_origin(const Arguments&) noexcept;
+// Hand-cannon pair spacing along the origin frame's local +Y (Thorn, Malfeasance).
+inline constexpr presentation::Vec pairOffset{0,.18999923943925734f,0};
+// Thorn experiment: one synchronous native emission, with the left origin
+// translated in the captured world-frame layout. No extra fire event or timer.
+// leftOffset is expressed in the origin frame at +0x10 (Rat King passes
+// rat_king::leftMuzzleOffset, the same 0.19 m along the named lateral axis).
+// rightOffset (runtime v7b, Rat King's widened pair): the right origin's
+// translation in the same frame; zero leaves the right shot native.
+[[nodiscard]] Result dispatch_single(const Memory&,NativeBatch,const Arguments&,bool left,
+    presentation::Vec leftOffset=pairOffset,presentation::Vec rightOffset={}) noexcept;
+// IKELOS: bit1 left, bit2 right. One native event and one selected origin;
+// both buttons alternate through the caller's native cadence transaction.
+// Generated profiles require a committed hand ticket. An unavailable/reentrant
+// ticket must not fall through to an untracked native shot or magazine spend.
+[[nodiscard]] Result dispatch_smg(const Memory&,NativeBatch,const Arguments&,unsigned sides,
+    bool requireTicket=false,const presentation::Vec* worldOrigin=nullptr) noexcept;
+// Qualified generic-gun event: translate the existing muzzle group to one hand.
+// Native spread/pattern count, selected muzzle and every payload remain intact;
+// this never duplicates projectiles or schedules another trigger. A malformed
+// group or absent hand ticket blocks the event. Caller owns cadence/ammo policy.
+inline constexpr unsigned maxGroupOrigins=64,maxGroupPattern=64;
+[[nodiscard]] Result dispatch_group(const Memory&,NativeBatch,const Arguments&,unsigned side,
+    const presentation::Vec& worldOrigin) noexcept;
+}
diff --git a/Dawn/src/client/hooks/akimbo/firing_effects.h b/Dawn/src/client/hooks/akimbo/firing_effects.h
new file mode 100644
index 0000000000000000000000000000000000000000..24e0e9a3047b53d55c68f724464a7a74a34b1054
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/firing_effects.h
@@ -0,0 +1,339 @@
+#pragma once
+#include "effects.h"
+
+namespace dawn::client::hooks::akimbo::firing_effects {
+using effects::Frame;
+using effects::Group;
+using effects::Buffer;
+using effects::read;
+inline constexpr unsigned lastWord=0x81a29815;
+// sound: the assembly's presentation/sound component the owner walk pins. The
+// hand cannons use 80BBD8A5; Rat King Akimbo uses the sidearm's 80BBDC8E.
+struct Profile {unsigned model{},tag{},bytes{},definition{},assembly{},key{},fx{},sound{0x80bbd8a5};};
+inline constexpr Profile thorn{alternating::thorn,0x80ef262f,27296,0x1fe8,0x80bbbf36,0x46e42225,0x80ef2631};
+// Soul Devourer is a separate perk-driven sequence, observed when the user
+// activated the perk. Its local emitter has ONE allocated muzzle attachment.
+inline constexpr Profile soul{alternating::thorn,0x80ff0531,10384,0x10d8,0x80bbbf36,0x46e42225,0x80ef2631};
+inline constexpr Profile word{lastWord,0x80ef2608,35024,0x2678,0x81a6aa47,0xeb0f0a93,0x80ef260a};
+inline constexpr Profile ikelos{0x81a2990a,0x80ef5685,34992,0x26f8,0,0xe8933a94,0};
+// Rat King Akimbo, alternating like Thorn (research\SIDEARM-CONSTANTS.md 3,
+// data\firing_fx.json). VERIFIED: first-person firing sequence 80EF42BA
+// (kind 808084E9, 34,848 bytes, header definition 0x2838). VALIDATED 4/4 rule:
+// FX root = content 8152AEA5 variant 10 +0xC0 = 80EF42E5 (SoundPacket[17]) ->
+// override list 80EF42E4 slot 0 -> entity 80BBDB54 +0xCC -> 80EF42BA. The
+// assembly is 80BBDC90 (INFERRED to be assembly+4, as for Thorn and Last Word),
+// the owner key the private HUD key. key/fx/assembly/sound are read only by
+// private_owner(), which only the paired (Last Word/Soul) allocation calls.
+inline constexpr Profile ratKing{rat_king::model,0x80ef42ba,34848,0x2838,rat_king::assembly,rat_king::item,0x80ef42e5,rat_king::soundComponent};
+// Muzzle 60FECDD4, bone 0, part marker asset 8152AC78 +0x530 (VERIFIED bytes;
+// slot-1 root 80BBD8BC +0xF0, kept by the private slot-1 root per plan.json).
+// A part marker that holds 60FECDD4 beats the generic one (Thorn and Last Word
+// use theirs; Malfeasance and IKELOS have none): medium-high, CAPTURE C4. The
+// generic fallback, core 8152AEA4 +0x8990 == 80B9EAB6 +0x2F0, is exactly
+// effects::muzzle. Both have identity rotation, so the rebase of the left
+// gun's pure +0.19 m offset is the same with either (the translations cancel).
+inline constexpr Frame ratKingMuzzle=std::bit_cast<Frame>(std::array<unsigned,8>{
+    0,0,0,0x3f800000,0x3ea25268,0x33999996,0x3e0b957a,0x3f800000}); //8152AC78+530, t=(.31703,0,.13631)
+// Native binding table (80808615): b0 type4/0x36 owner, b1 type3/0x22 LOCAL
+// muzzle 60FECDD4 capacity 1, b2 type1/0x5F projectile endpoint, b3 type2/0x3C
+// world view. No ejection binding.
+inline constexpr unsigned ratKingEndpoint=2;
+// Rat King always-on / Rat Pack sequence 80EF42E3 (27,840 bytes, definition
+// 0x2418; entity 80BBDB92 +0xCC; research\data\glow_fx.json): the same owner
+// walk as ratKing (assembly 80BBDC90, sound 80BBDC8E, key CF60DEE4, FX root
+// 80EF42E5). It is not a firing profile: selector() never matches it; its ten
+// local emitters are paired on both guns by rat_king_glow.h (runtime v4a).
+inline constexpr Profile ratKingGlow{rat_king::model,0x80ef42e3,27840,0x2418,rat_king::assembly,rat_king::item,0x80ef42e5,rat_king::soundComponent};
+// Native SMG marker component80B9EAC3, bone0: muzzle60FECDD4 and
+// ejection marker9216EEA9. The latter has its own rotated local frame.
+inline constexpr Frame ikelosMuzzle=std::bit_cast<Frame>(std::array<unsigned,8>{
+    0,0,0,0x3f800000,0x3e6dd806,0x33233333,0x3df41e2b,0x3f7ffffe});
+inline constexpr Frame ikelosEject=std::bit_cast<Frame>(std::array<unsigned,8>{
+    0x3ee8b6c6,0xbf0aab3a,0xbee8b6c9,0x3f0aab39,0x3db2c30a,0xbd4b67c6,0x3e0d98fc,0x3f7fffff});
+// Exact native part markers: hash60FECDD4, bone0. These differ from the
+// generic core marker used by Malfeasance and must retain their own offsets.
