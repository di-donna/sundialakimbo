+            (reinterpret_cast<void*>(barrel()),&context,&output);}
+        __finally {burst_native::settle_exit(debit);burst::runtime::phaseExit=oldExit;burst::runtime::phase=previous;}
+        if(!debit.callback_complete())return false;
+        return current();
+    }
+    struct Calls {
+        Native& native;unsigned side;
+        bool active(burst_driver::Hand& hand,const burst_driver::Context& context,burst_driver::Output& output) noexcept {
+            return native.current()&&native.invoke_active(side,context,output)&&native.capture(hand)&&output.valid();
+        }
+        bool idle(burst_driver::Hand& hand,const burst_driver::Context& context,burst_driver::Output& output,bool forced) noexcept {
+            if(!native.current())return false;
+            reinterpret_cast<void(__fastcall*)(void*,const burst_driver::Context*,burst_driver::Output*,bool)>(moduleBase+0xcb0110)
+                (reinterpret_cast<void*>(native.barrel()),&context,&output,forced);
+            return native.current()&&native.capture(hand)&&output.valid();
+        }
+        bool cooldown(const burst_driver::Context&,float& total,float& recovery) noexcept {
+            if(!native.current())return false;
+            reinterpret_cast<void(__fastcall*)(void*,float*,float*)>(moduleBase+0xcb3bb0)
+                (reinterpret_cast<void*>(native.barrel()),&total,&recovery);return native.current();
+        }
+        bool blocked_idle(burst_driver::Hand& hand,const burst_driver::Context& context,bool& nativeActive) noexcept {
+            burst_trigger::View view{};
+            if(!native.view(view)||!native.apply(burst_trigger::request_plan(native.pins,view,static_cast<std::uint16_t>(hand.requests),hand.charge)))return false;
+            nativeActive=reinterpret_cast<bool(__fastcall*)(void*)>(moduleBase+0xcd1660)(reinterpret_cast<void*>(context.root));
+            return native.current()&&native.capture(hand);
+        }
+    };
+    Calls calls(unsigned side) noexcept{return {*this,side};}
+};
+
+struct Entry {
+    burst::Key key{};
+    std::uintptr_t root{};
+    burst_session::State state{};
+    std::uint64_t revision{};
+    bool busy{},failed{};
+};
+std::array<Entry,8> sessions{};
+SRWLOCK sessionLock=SRWLOCK_INIT;
+struct Task {Native native{};burst_session::State state{};std::size_t slot{};std::uint64_t revision{};};
+bool intended(std::uint32_t tag) noexcept {
+    const auto* profile=profiles::find(tag);
+    return profile&&profile->adapter==profiles::Adapter::finiteBurst;
+}
+bool known(std::uintptr_t root) noexcept {
+    unsigned handle{},owner{};const bool read=local_read(nullptr,root+36,&handle,4)&&local_read(nullptr,root+44,&owner,4);
+    bool found=false;AcquireSRWLockShared(&sessionLock);
+    for(const auto& entry:sessions)if(entry.key.valid()&&((!read&&entry.root==root)
+        ||(read&&entry.key.handle==handle&&entry.key.owner==owner))){found=true;break;}
+    ReleaseSRWLockShared(&sessionLock);return found;
+}
+bool qualify(const Identity& id,std::uintptr_t root,float duration,Native& out) noexcept {
+    out={};const auto* profile=profiles::find(id.modelTag);smg_ammo::Native native{};
+    gun_layout::Layout layout{};unsigned count{},definition{};std::uintptr_t source{};
+    if(!profile||!intended(id.modelTag)||!std::isfinite(duration)||duration<0||duration>60
+        ||!smg_ammo::locate(memory,id,native)||native.root!=root
+        ||!gun_layout::source(memory,profile->barrel,layout)||!layout.ordinary_reload()
+        ||!burst_native::contract(id,native,0,count)||!hud::detail::resolve(memory,profile->barrel.coreTag,source)
+        ||!gun_layout::component(memory,source,profile->barrel.coreSize,profile->barrel.coreTag,
+            0xcd0,0x8080388b,0x8080388a,-0xc60,definition))return false;
+    bool initialized=false;AcquireSRWLockShared(&magazineLock);
+    if(const auto* magazine=magazineBook.find(native))initialized=activeMagazine==native&&magazine->initialized
+        &&!magazine->updating&&!magazine->prepaid;
+    if(const auto* owner=burstBook.find(burst::runtime::key(native)))initialized&=!owner->failed&&!owner->busy;
+    ReleaseSRWLockShared(&magazineLock);if(!initialized)return false;
+    out.selected={id,native,burst::left,count,1,true};
+    out.pins={burst::runtime::key(native),root,source,profile->barrel.coreTag,profile->barrel.coreSize,definition};
+    out.duration=duration;burst_trigger::View view{};return out.view(view);
+}
+bool acquire(Native native,Task& task) noexcept {
+    burst_trigger::View view{};burst_phase::Snapshot phase{};unsigned queue{};
+    if(!native.view(view)||!native.phase(phase)||!local_read(nullptr,native.barrel()+0x1720,&queue,4))return false;
+    const auto key=burst::runtime::key(native.selected.native);
+    bool accepted=false;AcquireSRWLockExclusive(&sessionLock);
+    std::size_t chosen=sessions.size();
+    for(std::size_t i=0;i<sessions.size();++i)if(sessions[i].key==key){chosen=i;break;}
+    if(chosen==sessions.size())for(std::size_t i=0;i<sessions.size();++i)if(!sessions[i].key.valid()){chosen=i;break;}
+    if(chosen==sessions.size()&&TryAcquireSRWLockShared(&magazineLock)){
+        for(std::size_t i=0;i<sessions.size();++i){const auto& entry=sessions[i];
+            if(entry.busy||entry.failed||!entry.state.phases[0].idle()||!entry.state.phases[1].idle()
+                ||!entry.state.triggers.lanes[0].idle()||!entry.state.triggers.lanes[1].idle())continue;
+            const auto* owner=burstBook.find(entry.key);if(owner&&!owner->retired())continue;
+            chosen=i;break;
+        }
+        ReleaseSRWLockShared(&magazineLock);
+        if(chosen!=sessions.size())sessions[chosen]={};
+    }
+    if(chosen!=sessions.size()){
+        auto& entry=sessions[chosen];
+        if(!entry.key.valid()){entry.key=key;entry.root=native.selected.native.root;
+            if(queue!=~0u||!entry.state.initialize(native.pins,view,phase))entry.failed=true;
+        }
+        if(!entry.failed&&!entry.busy&&!entry.state.failed&&entry.state.relocate(native.pins,view,phase)){
+            entry.root=native.selected.native.root;entry.busy=true;if(++entry.revision==0)++entry.revision;
+            native.selected.revision=entry.revision;task={native,entry.state,chosen,entry.revision};accepted=true;
+        }
+    }
+    ReleaseSRWLockExclusive(&sessionLock);return accepted;
+}
+void finish(Task& task,bool success) noexcept {
+    const bool current=task.native.current();bool published=false;
+    AcquireSRWLockExclusive(&sessionLock);
+    if(task.slot<sessions.size()){
+        auto& entry=sessions[task.slot];
+        if(entry.busy&&entry.revision==task.revision&&entry.key==task.native.pins.key){
+            entry.state=task.state;entry.failed|=!success||!current||task.state.failed;
+            entry.busy=false;published=!entry.failed;
+        }
+    }
+    ReleaseSRWLockExclusive(&sessionLock);
+    if(!published){
+        AcquireSRWLockExclusive(&magazineLock);
+        if(auto* owner=burstBook.find(task.native.pins.key))owner->failed=true;
+        if(activeMagazine==task.native.selected.native)activeMagazine={};
+        ReleaseSRWLockExclusive(&magazineLock);burst_native::refused("phase_publication");
+    }
+}
+bool run(Task& task,bool trigger) noexcept {
+    bool ok=false;
+    __try {
+        if(trigger){
+            burst_trigger::Input source{};unsigned held=0;
+            if(task.native.current()&&local_read(nullptr,task.native.selected.native.root+0x670,source.data(),source.size())){
+                AcquireSRWLockShared(&alternatingLock);held=smgInput.held(task.native.selected.identity,GetTickCount64());ReleaseSRWLockShared(&alternatingLock);
+                ok=burst_session::trigger(task.state,task.native,source,held);
+            }
+        }else ok=burst_session::update(task.state,task.native,task.native.duration);
+    } __finally {finish(task,ok);}
+    return ok&&(trigger?task.native.triggerResult:task.native.updateResult);
+}
+bool route(void* component,float duration,bool trigger,bool& handled) noexcept {
+    handled=false;const auto address=reinterpret_cast<std::uintptr_t>(component);const unsigned offset=trigger?0xc50u:0xd70u;
+    if(!enabled.load(std::memory_order_acquire)||!profiles::generated.has_adapter(profiles::Adapter::finiteBurst)
+        ||address<0x10000+offset)return false;
+    const auto root=address-offset;Identity id{};const bool identified=current_identity(id)&&intended(id.modelTag);
+    // Private core ownership is proved by the loader's emitted-artifact gate.
+    // Wait before the first presentation too; no shared trigger phase may run
+    // merely because the model has not yet reached the animation callback.
+    handled=finite_burst_candidate(root+0xd70)||known(root);
+    if(!identified){if(handled)burst_native::refused("phase_identity");return false;}
+    unsigned owner{};
+    if(!local_read(nullptr,root+44,&owner,4)||owner!=id.modelOwner)return false;
+    handled=true;Native native{};Task task{};
+    if(!qualify(id,root,duration,native)||!acquire(native,task)){burst_native::refused("phase_qualification");return false;}
+    return run(task,trigger);
+}
+__declspec(noinline) bool __fastcall update_hook(void* barrel,float duration) noexcept {
+    Invocation invocation;bool handled=false;const auto result=route(barrel,duration,false,handled);
+    return handled?result:nextUpdate.load(std::memory_order_acquire)(barrel,duration);
+}
+__declspec(noinline) bool __fastcall trigger_hook(void* trigger,float duration) noexcept {
+    Invocation invocation;bool handled=false;const auto result=route(trigger,duration,true,handled);
+    return handled?result:nextTrigger.load(std::memory_order_acquire)(trigger,duration);
+}
+
+// Scoped input substitution is a caller-owned 48-byte copy. The actual native
+// input object stays untouched; a failed scope returns a neutral local copy.
+__declspec(noinline) void* __fastcall input_hook(void* trigger) noexcept {
+    Invocation invocation;const auto next=nextInput.load(std::memory_order_acquire);auto* scope=inputScope;
+    if(!scope)return next(trigger);
+    static thread_local burst_trigger::Input neutral{};
+    const auto caller=reinterpret_cast<std::uintptr_t>(_ReturnAddress());auto& native=*scope->native;
+    if(caller!=moduleBase+0xd09a60||reinterpret_cast<std::uintptr_t>(trigger)!=native.selected.native.root+0xc50
+        ||scope->calls++||!native.current()){native.failed=true;return neutral.data();}
+    const auto original=next(trigger);
+    if(reinterpret_cast<std::uintptr_t>(original)!=native.selected.native.root+0x670||!native.current()){
+        native.failed=true;return neutral.data();
+    }
+    return const_cast<std::byte*>(scope->input->data());
+}
+__declspec(noinline) void __fastcall finalize_hook(void* barrel,burst_driver::Output* output) noexcept {
+    Invocation invocation;const auto next=nextFinalize.load(std::memory_order_acquire);auto* scope=finalScope;
+    if(!scope){next(barrel,output);return;}
+    auto& native=*scope->native;burst_driver::Output actual{},empty{};
+    if(reinterpret_cast<std::uintptr_t>(_ReturnAddress())!=moduleBase+0xccbc31
+        ||reinterpret_cast<std::uintptr_t>(barrel)!=native.barrel()||scope->calls++||!native.current()
+        ||!local_read(nullptr,reinterpret_cast<std::uintptr_t>(output),&actual,sizeof(actual))
+        ||std::memcmp(&actual,&empty,sizeof(actual))){native.failed=true;return;}
+    // The zero-delta original produces an empty stack output. Supply the actual
+    // accumulated outputs and run its shared post-processing exactly once.
+    if(!local_write(reinterpret_cast<std::uintptr_t>(output),&scope->output,sizeof(*output))){native.failed=true;return;}
+    next(barrel,output);
+    burst_trigger::View view{};
+    if(!native.view(view)){native.failed=true;return;}
+    const auto expected=static_cast<std::uint16_t>(scope->output.flags?scope->requests&~2u:scope->requests);
+    if(view.lane.request!=expected||!native.apply(burst_trigger::request_plan(native.pins,view,scope->requests,0))){native.failed=true;return;}
+    scope->valid=true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/burst_queue.h b/Dawn/src/client/hooks/akimbo/burst_queue.h
new file mode 100644
index 0000000000000000000000000000000000000000..00c9d17e36b63ec3cde555677acb7d2f9b218b7f
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/burst_queue.h
@@ -0,0 +1,107 @@
+#pragma once
+#include "burst.h"
+#include "hud.h"
+#include <cmath>
+#include <cstring>
+
+namespace dawn::client::hooks::akimbo::burst {
+// CBC8F0 selects min22/23 and max24/25 by native aim state. Until that
+// selection is individually pinned, both modes must describe the same finite
+// maximum as CB9440 (which separately includes selected content+140).
+inline bool finite_counts(const std::array<float,4>& values,unsigned count) noexcept {
+    if(count<2||count>maxShots)return false;
+    for(const auto value:values)
+        if(!std::isfinite(value)||value<0||value>maxShots||value!=std::trunc(value))return false;
+    return values[0]<=count&&values[1]<=count&&values[2]==count&&values[3]==count;
+}
+// Build86657 CC6010 copies exactly 0x1c bytes. CCF720 reads delay, removes
+// next from barrel+1720, calls CB48C0 with this packet, then frees its handle.
+// Therefore barrel+1720 at the final emission callback names the NEXT event.
+struct Packet {
+    float delay{};
+    std::uint32_t progress{};
+    std::int32_t selected{};
+    std::uint32_t ordinal{};
+    float charge{};
+    std::uint8_t flags{},flag{};
+    std::uint16_t padding{};
+    std::uint32_t next{~0u};
+};
+static_assert(sizeof(Packet)==0x1c&&offsetof(Packet,ordinal)==0xc&&offsetof(Packet,next)==0x18);
+struct Queued {std::uint32_t token{};std::uintptr_t address{};Packet packet{};};
+struct Queue {std::array<Queued,maxShots> events{};unsigned count{};};
+inline bool bounded(const Packet& p) noexcept {
+    return std::isfinite(p.delay)&&p.delay>=0&&p.delay<=60&&p.progress<=64
+        &&p.selected>=-1&&p.selected<64&&p.ordinal<maxShots
+        &&std::isfinite(p.charge)&&p.charge>=0&&p.charge<=1&&p.flag<=1;
+}
+inline bool same_payload(const Packet& a,const Packet& b) noexcept {
+    // Native insertion changes links, and CCF720 changes remaining delay.
+    // Everything else identifies this paid packet, including its flag bytes.
+    return a.progress==b.progress&&a.selected==b.selected&&a.ordinal==b.ordinal
+        &&a.charge==b.charge&&a.flags==b.flags&&a.flag==b.flag&&a.padding==b.padding;
+}
+// CC6010 either prepends the copied packet or appends through CC5DF0.
+// Identify exactly one new generation token; require the old list and every
+// old payload to remain intact. No ordinal-only or guessed head association.
+inline bool inserted(const Queue& before,const Queue& after,const Packet& source,bool front,Queued& output) noexcept {
+    output={};if(before.count>=maxShots||after.count!=before.count+1||!bounded(source))return false;
+    const unsigned index=front?0:before.count;
+    const auto& added=after.events[index];
+    if(!added.token||added.token==~0u||!added.address||!same_payload(added.packet,source)
+        ||added.packet.delay!=source.delay||added.packet.next!=(front&&before.count?before.events[0].token:~0u))return false;
+    for(unsigned i=0;i<before.count;++i){
+        const auto& old=before.events[i];const auto& now=after.events[i+(front?1:0)];
+        const auto next=!front&&i+1==before.count?added.token:old.packet.next;
+        if(old.token==added.token||old.token!=now.token||old.address!=now.address
+            ||!same_payload(old.packet,now.packet)||old.packet.delay!=now.packet.delay||now.packet.next!=next)return false;
+    }
+    output=added;return true;
+}
+// Caller qualifies the barrel's exact owner/instance before AND after this
+// walk. This reader does not turn an arbitrary pointer into a trusted barrel.
+// It re-reads every borrowed record and resolver result, rejecting movement,
+// mutation, cycles and overlong lists instead of returning a partial snapshot.
+inline bool snapshot(const Memory& memory,std::uintptr_t barrel,Queue& output) noexcept {
+    output={};if(barrel<0x10000||barrel>0x00007fffffffffffULL-0x1724)return false;
+    using hud::detail::read;using hud::detail::resolve;
+    std::uint32_t head{};
+    if(!read(memory,barrel+0x1720,head))return false;
+    Queue result{};auto token=head;
+    while(token!=~0u){
+        if(!token||result.count==maxShots)return false;
+        for(unsigned i=0;i<result.count;++i)if(result.events[i].token==token)return false;
+        auto& event=result.events[result.count];event.token=token;
+        if(!resolve(memory,token,event.address)||!read(memory,event.address,event.packet)
+            ||!bounded(event.packet))return false;
+        token=event.packet.next;++result.count;
+    }
+    for(unsigned i=0;i<result.count;++i){
+        const auto& event=result.events[i];Packet again{};std::uintptr_t address{};
+        if(!resolve(memory,event.token,address)||address!=event.address||!read(memory,address,again)
+            ||std::memcmp(&again,&event.packet,sizeof(again)))return false;
+    }
+    std::uint32_t after{};if(!read(memory,barrel+0x1720,after)||after!=head)return false;
+    output=result;return true;
+}
+struct Drain {
+    Key key{};
+    Queue before{};
+    unsigned cursor{};
+    bool failed{};
+    // Called before the one native emission, under the same lock as its paid
+    // receipt lookup/retirement. Existing arguments must exactly match the
+    // popped packet; a repeated ordinal alone never identifies a queue event.
+    std::uint32_t take(Key current,std::uint32_t currentHead,unsigned ordinal,
+                       unsigned progress,std::int32_t selected,float charge,bool flag,
+                       bool replay) noexcept {
+        if(failed||current!=key||!key.valid()||replay||cursor>=before.count){failed=true;return 0;}
+        const auto& event=before.events[cursor];const auto& packet=event.packet;
+        if(currentHead!=packet.next||ordinal!=packet.ordinal||progress!=packet.progress
+            ||selected!=packet.selected||charge!=packet.charge||flag!=(packet.flag!=0)){
+            failed=true;return 0;
+        }
+        ++cursor;return event.token;
+    }
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/burst_runtime.h b/Dawn/src/client/hooks/akimbo/burst_runtime.h
new file mode 100644
index 0000000000000000000000000000000000000000..9396d4dd94ff93a264820a3a1c62e7a281f937a1
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/burst_runtime.h
@@ -0,0 +1,190 @@
+#pragma once
+#include "burst_queue.h"
+#include "smg_magazines.h"
+
+namespace dawn::client::hooks::akimbo::burst::runtime {
+inline Key key(const smg_ammo::Native& native) noexcept{return {native.handle,native.owner,native.modelTag};}
+// The native phase driver publishes a stack-bounded scope only after exact
+// owner/storage and per-hand phase qualification. The debit/queue hooks do not
+// infer a hand from current buttons or create a phase scope on their own.
+struct Phase {
+    Identity identity{};
+    smg_ammo::Native native{};
+    unsigned side{},count{};
+    std::uint64_t revision{};
+    bool qualified{};
+};
+inline thread_local const Phase* phase{};
+struct Event {Receipt receipt{};Packet packet{};};
+struct Owner {
+    Key identity{};
+    std::array<State,2> hands{};
+    std::array<Event,maxShots> events{};
+    std::uint64_t revision{};
+    bool busy{},failed{};
+    void select(Key next) noexcept {
+        if(identity==next)return;
+        const auto serial=revision+1;
+        const std::array<std::uint64_t,2> previous{hands[0].serial,hands[1].serial};
+        *this={};identity=next;revision=serial?serial:1;
+        for(unsigned i=0;i<2;++i){hands[i].key=next;hands[i].serial=previous[i]+1;if(!hands[i].serial)++hands[i].serial;}
+    }
+    bool room()const noexcept {for(const auto& e:events)if(!e.receipt.valid)return true;return false;}
+    bool retired()const noexcept {
+        if(busy||hands[0].active||hands[1].active||hands[0].busy||hands[1].busy)return false;
+        for(const auto& event:events)if(event.receipt.valid)return false;
+        return true;
+    }
+    Spend begin(unsigned side,unsigned ordinal,unsigned count,unsigned required,unsigned cost,
+        const std::array<unsigned,2>& rounds,unsigned loading) noexcept {
+        if(busy||failed||(side!=left&&side!=right)||!identity.valid()||!room())return {};
+        auto result=hands[side==left?0:1].begin(identity,ordinal,count,required,cost,side,rounds,loading);
+        if(result.valid){busy=true;++revision;}return result;
+    }
+    Settlement settle(const Spend& spend,bool debited,const Queued* queued) noexcept {
+        if(!busy||spend.key!=identity||(spend.side!=left&&spend.side!=right))return {};
+        if(queued&&(!bounded(queued->packet)||queued->packet.ordinal!=spend.ordinal))return {};
+        auto& hand=hands[spend.side==left?0:1];
+        const auto result=hand.settle(spend,debited,queued?queued->token:0);
+        if(hand.busy)return {}; // stale ticket must not release another transaction
+        busy=false;++revision;
+        if(result.queued){
+            for(auto& event:events)if(!event.receipt.valid){
+                event={hand.emission(identity,queued->token,spend.ordinal),queued->packet};break;
+            }
+        }
+        return result;
+    }
+    Event find(std::uint32_t token)const noexcept {
+        for(const auto& e:events)if(e.receipt.valid&&e.receipt.token==token)return e;return {};
+    }
+    bool retire(const Event& event) noexcept {
+        if(!event.receipt.valid||(event.receipt.side!=left&&event.receipt.side!=right))return false;
+        for(auto& stored:events)if(stored.receipt.valid&&stored.receipt.token==event.receipt.token
+            &&stored.receipt.ordinal==event.receipt.ordinal&&stored.receipt.side==event.receipt.side
+            &&stored.receipt.cost==event.receipt.cost&&same_payload(stored.packet,event.packet)){
+            if(!hands[event.receipt.side==left?0:1].retire(identity,stored.receipt))return false;
+            stored={};++revision;return true;
+        }
+        return false;
+    }
+    // Retry/continuation packets are already paid. Transfer their receipt;
+    // no ammunition or burst ordinal is charged a second time.
+    bool continuation(const Event& previous,const Queued& next) noexcept {
+        if(!previous.receipt.valid||!next.token||next.token==~0u||!bounded(next.packet)
+            ||next.packet.ordinal!=previous.receipt.ordinal||next.packet.charge!=previous.packet.charge
+            ||next.packet.selected!=previous.packet.selected||find(next.token).receipt.valid)return false;
+        const auto side=previous.receipt.side;if(side!=left&&side!=right)return false;
+        for(auto& stored:events)if(stored.receipt.valid&&stored.receipt.token==previous.receipt.token
+            &&stored.receipt.side==previous.receipt.side&&stored.receipt.ordinal==previous.receipt.ordinal
+            &&stored.receipt.cost==previous.receipt.cost&&same_payload(stored.packet,previous.packet)){
+            auto& hand=hands[side==left?0:1];
+            for(auto& receipt:hand.queue)if(receipt.valid&&receipt.token==stored.receipt.token){
+                receipt.token=next.token;stored={receipt,next.packet};++revision;return true;
+            }
+        }
+        return false;
+    }
+    bool leave(unsigned side) noexcept {
+        if(busy||(side!=left&&side!=right))return false;
+        const auto ok=hands[side==left?0:1].leave_burst(identity);if(ok)++revision;return ok;
+    }
+};
+struct Book {
+    std::array<Owner,8> owners{};
+    unsigned cursor{};
+    Owner* find(Key identity) noexcept {
+        if(!identity.valid())return nullptr;
+        for(auto& owner:owners)if(owner.identity==identity)return &owner;return nullptr;
+    }
+    Owner* slot(Key identity) noexcept {
+        if(!identity.valid())return nullptr;
+        if(auto* found=find(identity))return found;
+        for(auto& owner:owners)if(!owner.identity.valid()){owner.select(identity);return &owner;}
+        for(unsigned i=0;i<owners.size();++i){
+            auto& owner=owners[cursor];cursor=(cursor+1)%static_cast<unsigned>(owners.size());
+            if(owner.retired()){owner.select(identity);return &owner;}
+        }
+        return nullptr;
+    }
+};
+struct Transaction {
+    Phase phase{};
+    Spend spend{};
+    int loaded{};
+    std::uint64_t magazineRevision{};
+    bool settled{};
+};
+// Burst debit publication precedes queue emission. There is no outstanding
+// one-shot prepaid adjustment for magazine_tick to guess from held input.
+// An unexplained aggregate delta must block; it cannot be assigned to whichever
+// hand fired last or cancel the opposite hand's reload.
+inline bool aggregate_matches(const smg_ammo::State& magazine,int loaded,int capacity) noexcept {
+    return magazine.initialized&&!magazine.prepaid&&!magazine.updating
+        &&capacity==magazine.capacity&&capacity>0&&capacity<=static_cast<int>(maxRounds)
+        &&magazine.rounds[0]>=0&&magazine.rounds[0]<=capacity
+        &&magazine.rounds[1]>=0&&magazine.rounds[1]<=capacity&&loaded==magazine.total();
+}
+inline bool reserve(Owner& owner,smg_ammo::State& magazine,Transaction& transaction,
+                    const Phase& selected,unsigned ordinal,unsigned required,int loaded) noexcept {
+    if(transaction.spend.valid||!selected.qualified||!selected.revision||selected.count<2||selected.count>maxShots
+        ||(selected.side!=left&&selected.side!=right)||key(selected.native)!=owner.identity
+        ||magazine.native!=selected.native||!magazine.initialized||magazine.updating||magazine.prepaid
+        ||loaded!=magazine.total()||loaded<0||magazine.rounds[0]<0||magazine.rounds[1]<0)return false;
+    const auto spend=owner.begin(selected.side,ordinal,selected.count,required,1,
+        {static_cast<unsigned>(magazine.rounds[0]),static_cast<unsigned>(magazine.rounds[1])},magazine.loading);
+    if(!spend.valid)return false;
+    magazine.updating=true;++magazine.revision;
+    transaction={selected,spend,loaded,magazine.revision,false};return true;
+}
+// Observe the native aggregate after its real setter; never synthesize a
+// second spend at emission. Unexpected mutation blocks this owner instead of
+// initializing a replacement magazine or borrowing from its other hand.
+inline bool settle(Owner& owner,smg_ammo::State& magazine,Transaction& transaction,
+                   int loadedAfter,bool current,const Queued* queued) noexcept {
+    if(transaction.settled||!transaction.spend.valid)return false;
+    transaction.settled=true;
+    const bool same=owner.identity==transaction.spend.key&&magazine.native==transaction.phase.native
+        &&magazine.revision==transaction.magazineRevision&&magazine.updating;
+    const bool paid=current&&loadedAfter==transaction.loaded-static_cast<int>(transaction.spend.cost);
+    const bool unpaid=current&&loadedAfter==transaction.loaded;
+    if(!same||(!paid&&!unpaid)||(!paid&&queued)){
+        owner.failed=true;(void)owner.settle(transaction.spend,false,nullptr);
+        if(same){magazine.updating=false;++magazine.revision;}return false;
+    }
+    const auto result=owner.settle(transaction.spend,paid,paid?queued:nullptr);
+    const auto index=transaction.spend.side==left?0u:1u;
+    const bool valid=paid?result.valid&&result.side==transaction.spend.side
+        &&result.cost==transaction.spend.cost&&magazine.rounds[index]>=static_cast<int>(result.cost):!owner.busy;
+    if(!valid){owner.failed=true;magazine.updating=false;++magazine.revision;return false;}
+    if(paid){
+        magazine.rounds[index]-=static_cast<int>(result.cost);
+        magazine.lastSide=result.side;magazine.prepaid=0;magazine.prepaidToken=~0u;magazine.prepaidSide=0;
+    }
+    magazine.updating=false;++magazine.revision;return true;
+}
+// Called at CB48C0 entry, exact caller CCF7E6, after native pops but before it
+// frees the token. A matching ordinal is insufficient: resolve the captured
+// generation token to this exact still-live packet address and pin its fields.
+inline bool popped(const Memory& memory,std::uintptr_t barrel,std::uintptr_t packetAddress,
+                   const Owner& owner,Event& output) noexcept {
+    output={};if(!owner.identity.valid()||packetAddress<0x10000||barrel<0x10000
+        ||barrel>0x00007fffffffffffULL-0x1724)return false;
+    using hud::detail::read;using hud::detail::resolve;
+    Packet packet{},again{};unsigned head{},afterHead{};
+    if(!read(memory,packetAddress,packet)||!bounded(packet)||!read(memory,barrel+0x1720,head)||head!=packet.next)return false;
+    unsigned matches=0;Event found{};std::uintptr_t matchedAddress{};
+    for(const auto& event:owner.events)if(event.receipt.valid){
+        std::uintptr_t address{};
+        if(resolve(memory,event.receipt.token,address)&&address==packetAddress){
+            if(!same_payload(event.packet,packet))return false;
+            ++matches;found=event;matchedAddress=address;
+        }
+    }
+    std::uintptr_t address{};
+    if(matches!=1||!resolve(memory,found.receipt.token,address)||address!=matchedAddress
+        ||!read(memory,packetAddress,again)||std::memcmp(&packet,&again,sizeof(packet))
+        ||!read(memory,barrel+0x1720,afterHead)||afterHead!=head)return false;
+    output=found;return true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/burst_session.h b/Dawn/src/client/hooks/akimbo/burst_session.h
new file mode 100644
index 0000000000000000000000000000000000000000..6b60d8515d767d50d9392453d96a9e937de588b8
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/burst_session.h
@@ -0,0 +1,181 @@
+#pragma once
+#include "burst_order.h"
+#include "burst_trigger.h"
+
+namespace dawn::client::hooks::akimbo::burst_session {
+// One logical gun owns two trigger histories and two phase clocks. Every native
+// borrow is checked against the exact physical resident; durable request bits
+// live only in trigger::Bank. No native callback runs while a book lock is held.
+struct State {
+    burst_trigger::Bank triggers{};
+    std::array<burst_phase::Snapshot,2> phases{};
+    burst_phase::Snapshot resident{};
+    burst_driver::Order order{};
+    unsigned next{burst::left};
+    float handoff{};
+    bool initialized{},busy{},failed{};
+    bool initialize(const burst_trigger::Pins& pins,const burst_trigger::View& view,
+                    burst_phase::Snapshot phase) noexcept {
+        if(initialized||busy||!phase.idle()||!triggers.initialize(pins,view))return false;
+        resident=phase;initialized=true;return true;
+    }
+    // Caller must have independently re-resolved the generation-bearing owner.
+    // Replacing storage is not permission to copy/reset a running native phase.
+    bool relocate(const burst_trigger::Pins& pins,const burst_trigger::View& view,
+                  burst_phase::Snapshot phase) noexcept {
+        if(!initialized||busy||failed||phase!=resident)return false;
+        return triggers.relocate(pins,view);
+    }
+    std::array<burst_driver::Hand,2> hands()const noexcept {
+        return {{{phases[0],triggers.lanes[0].request,triggers.lanes[0].charge},
+                 {phases[1],triggers.lanes[1].request,triggers.lanes[1].charge}}};
+    }
+    burst_phase::Snapshot aggregate()const noexcept {
+        // Active native callbacks observe the one atomic burst. Otherwise keep
+        // the native owner awake while either independent recovery is pending.
+        for(const auto& phase:phases)if(phase.phase==1)return phase;
+        for(const auto& phase:phases)if(!phase.idle())return {4,0,phase.remaining};
+        return {};
+    }
+};
+
+// Native supplies: view(), phase(), mount_phase(before,after), apply(Plan),
+// trigger(side,Input), shared(Context,active), context(clock,Context), Calls' four body
+// functions, interval(), available(mask), exited(side), and finalize(Output, expected requests). Every method
+// must revalidate the full owner/address before AND after a native callback.
+template<class Native>
+bool observe(State& state,Native& native,burst_trigger::View& view) noexcept {
+    burst_phase::Snapshot phase{};
+    return native.view(view)&&native.phase(phase)&&phase==state.resident
+        &&view.valid()&&view.config==state.triggers.config&&view.lane==state.triggers.resident;
+}
+template<class Native>
+bool mount(State& state,Native& native,burst_phase::Snapshot phase) noexcept {
+    if(!phase.valid()||!native.mount_phase(state.resident,phase))return false;
+    state.resident=phase;return true;
+}
+template<class Native>
+bool publish(State& state,Native& native,const std::array<burst_driver::Output,2>& output,
+             bool final) noexcept {
+    burst_trigger::View view{};
+    if(!observe(state,native,view))return false;
+    const auto lease=state.triggers.begin_aggregate(state.triggers.pins,view,{output[0].flags,output[1].flags});
+    if(!lease.valid||!native.apply(burst_trigger::request_plan(lease.pins,view,lease.after.request,lease.after.charge))
+        ||!mount(state,native,state.aggregate()))return false;
+    const burst_driver::Output combined{0,static_cast<std::uint8_t>(output[0].flags|output[1].flags),
+        static_cast<std::uint8_t>(output[0].active|output[1].active),0,0};
+    // CBF240 clears the physical request when either output fires. The native
+    // wrapper restores ONLY this already-derived aggregate request immediately
+    // after that call, before CCB8C0's one shared keep-awake/final cleanup tail.
+    if(final&&!native.finalize(combined,lease.after.request))return false;
+    burst_phase::Snapshot phase{};
+    return native.phase(phase)&&phase==state.resident&&native.view(view)
+        &&state.triggers.finish_aggregate(lease,lease.pins,view);
+}
+
+template<class Native>
+bool trigger(State& state,Native& native,const burst_trigger::Input& source,unsigned held) noexcept {
+    if(!state.initialized||state.busy||state.failed||held>3)return false;
+    state.busy=true;
+    const auto fail=[&](){state.failed=true;state.busy=false;return false;};
+    unsigned available{};
+    if(!native.available(available)||available>3)return fail();
+    held&=available;
+    for(unsigned side:{burst::left,burst::right}){
+        const auto i=burst_cadence::index(side);burst_trigger::View view{};burst_trigger::Input input{};
+        if(!observe(state,native,view)||!burst_trigger::copy_input(source,view.config,(held&side)!=0,input))return fail();
+        const auto lease=state.triggers.begin(state.triggers.pins,view,side);
+        if(!lease.valid||!mount(state,native,state.phases[i])
+            ||!native.apply(burst_trigger::plan(lease.pins,view,lease.mount))||!native.trigger(side,input))return fail();
+        burst_phase::Snapshot after{};
+        // Trigger update may query phase/readiness, but this digital route must
+        // not run a barrel phase or spend ammunition outside the phase lease.
+        if(!native.phase(after)||after!=state.resident||!native.view(view)
+            ||!state.triggers.finish(lease,lease.pins,view))return fail();
+    }
+    if(!publish(state,native,{},false))return fail();
+    state.busy=false;return true;
+}
+
+template<class Native>
+bool update(State& state,Native& native,float duration) noexcept {
+    if(!state.initialized||state.busy||state.failed||!std::isfinite(duration)||duration<0||duration>60)return false;
+    state.busy=true;
+    std::array<burst_driver::Output,2> outputs{};
+    burst_cadence::State clock{state.phases,state.next};
+    clock.handoff=state.handoff;
+    bool sharedActive=false,sharedSeen=false;float sharedAt=0;unsigned sharedPhase=0;
+    const auto fail=[&](){state.failed=true;state.busy=false;return false;};
+    const auto shared=[&](const burst_cadence::Context& at,const auto& phases){
+        state.phases=phases;burst_trigger::View view{};burst_driver::Context context{};
+        if(!observe(state,native,view)||!native.context(at,context))return false;
+        const auto hands=state.hands();const burst_phase::Snapshot borrowed{burst_driver::shared_phase(hands),0,0};
+        bool nativeActive=false;
+        if(!mount(state,native,borrowed)||!native.shared(context,nativeActive))return false;
+        sharedActive|=nativeActive;sharedSeen=true;sharedAt=at.elapsed;sharedPhase=borrowed.phase;
+        burst_trigger::View after{};burst_phase::Snapshot phase{};
+        return native.phase(phase)&&phase==borrowed&&native.view(after)&&after.lane==view.lane&&after.config==view.config;
+    };
+    const auto step=[&](unsigned side,const burst_cadence::Context& at,burst_phase::Snapshot& phase){
+        const auto blocked=burst_cadence::Transition::blocked;
+        state.phases=clock.hands;const auto i=burst_cadence::index(side);
+        auto hands=state.hands();hands[i].phase=phase;
+        auto eligible=hands;
+        // CC5080 dispatches start/stop bindings even with step=0. Match the
+        // aggregate active transition, not the number of borrowed hand visits:
+        // an opposite idle/recovery callback must not replay shared start FX.
+        const auto activePhase=burst_driver::shared_phase(hands);
+        // A requested opposite gun waits only for the atomic active burst, not
+        // for the other gun's recovery. Never clear a waiting request to gate it.
+        burst_trigger::View view{};burst_driver::Context context{};
+        if(!observe(state,native,view)||!native.context(at,context))return blocked;
+        if(!context.blocked&&phase.idle()&&(hands[i].requests&burst_driver::requestMask)){
+            unsigned available{};
+            if(!native.available(available)||available>3)return blocked;
+            // An unavailable pending request stays durable but cannot win the
+            // next-burst tie and prevent the other loaded hand from firing.
+            for(unsigned slot=0;slot<2;++slot)
+                if(eligible[slot].phase.idle()&&!(available&(1u<<slot)))eligible[slot].requests&=~burst_driver::requestMask;
+            if(!(available&side)||clock.handoff>0||!state.order.may_start(side,eligible))
+                return burst_cadence::Transition::unchanged;
+        }
+        const bool aggregateDue=activePhase|| (hands[0].phase.idle()&&hands[1].phase.idle())
+            ||(sharedSeen&&sharedPhase!=activePhase);
+        if(at.step==0&&aggregateDue&&(!sharedSeen||sharedAt!=at.elapsed||sharedPhase!=activePhase))
+            if(!shared(at,state.phases))return blocked;
+        const auto lease=state.triggers.begin_phase(state.triggers.pins,view,side);
+        if(!lease.valid||!mount(state,native,phase)
+            ||!native.apply(burst_trigger::request_plan(lease.pins,view,lease.mount.request,lease.mount.charge)))return blocked;
+        auto hand=hands[i];const auto before=hand.phase;
+        auto calls=native.calls(side);
+        if(!burst_driver::body(hand,context,outputs[i],calls))return blocked;
+        // Body callbacks read their native phase/request changes back into Hand.
+        // Pure scalar branches are written here under the same address lease.
+        burst_phase::Snapshot observed{};
+        if(!native.phase(observed))return blocked;
+        state.resident=observed;
+        if(!mount(state,native,hand.phase)||!native.view(view)
+            ||!native.apply(burst_trigger::request_plan(lease.pins,view,static_cast<std::uint16_t>(hand.requests),hand.charge))
+            ||!native.view(view)||!state.triggers.finish_phase(lease,lease.pins,view))return blocked;
+        if(before.idle()&&hand.phase.phase==1&&!state.order.started(side,eligible))return blocked;
+        if(before.phase==1&&hand.phase.ordinal>before.ordinal){
+            // Every accepted native round establishes the next possible handoff
+            // time. In particular the opposite burst cannot start at the exact
+            // timestamp of this burst's last round. This getter is not halved.
+            float interval{};
+            if(!native.interval(interval)||!std::isfinite(interval)||interval<=0||interval>60)return blocked;
+            clock.handoff=interval;
+        }
+        if(before.phase==1&&hand.phase.phase!=1&&!native.exited(side))return blocked;
+        phase=hand.phase;state.phases[i]=phase;
+        if(phase==before)return burst_cadence::Transition::unchanged;
+        return before.phase==1&&phase.phase!=1?burst_cadence::Transition::changed_wake:burst_cadence::Transition::changed;
+    };
+    const auto result=burst_cadence::advance(clock,duration,shared,step);
+    state.phases=clock.hands;state.next=clock.next;
+    state.handoff=clock.handoff;
+    outputs[0].active|=sharedActive?1:0;
+    if(!result.complete||!publish(state,native,outputs,true))return fail();
+    state.busy=false;return true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/burst_startup.h b/Dawn/src/client/hooks/akimbo/burst_startup.h
new file mode 100644
index 0000000000000000000000000000000000000000..6d446513800698279a1b698240355d1e9723f66d
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/burst_startup.h
@@ -0,0 +1,17 @@
+#pragma once
+#include "profile_registry.h"
+
+namespace dawn::client::hooks::akimbo::burst_startup {
+// Admission barrier only: no hand, source semantics or firing permission is
+// inferred here. An intended private root waits for full presentation/owner
+// qualification, instead of first advancing the shared stock trigger state.
+template<class Read>
+bool candidate(const profiles::Registry& registry,Read&& read,std::uintptr_t root) noexcept {
+    if(root<0x10000||root>0x00007fffffffffffULL-4
+        ||!registry.has_adapter(profiles::Adapter::finiteBurst))return false;
+    // This is intentionally only an intent lookup. A partially initialized or
+    // malformed private root must stay blocked too; typed header, definition
+    // and generation checks belong to the full qualification before execution.
+    unsigned tag{};return read(root,&tag,sizeof(tag))&&registry.finite_core(tag);
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/burst_trigger.h b/Dawn/src/client/hooks/akimbo/burst_trigger.h
new file mode 100644
index 0000000000000000000000000000000000000000..6d559e6946ba69ac1c16fb5d4aa021ae0b31b9db
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/burst_trigger.h
@@ -0,0 +1,231 @@
+#pragma once
+// Build86657 trigger adapter. The production session qualifies the live owner and component
+// graph, serialize native updates, and revalidate every borrowed address before
+// applying a plan. These helpers never write game memory or synthesize a shot.
+#include "burst.h"
+#include <cmath>
+#include <cstddef>
+#include <cstring>
+
+namespace dawn::client::hooks::akimbo::burst_trigger {
+inline constexpr std::size_t triggerOffset=0xc50,barrelOffset=0xd70,inputOffset=0x670;
+inline constexpr std::uint8_t feedbackMask=0x20;
+inline constexpr std::uint16_t requestMask=0x6;
+struct Config {
+    std::uint8_t inputMode{},hipSelector{},aimSelector{};
+    bool operator==(const Config&)const=default;
+    bool valid()const noexcept{return inputMode==0&&hipSelector<=1&&aimSelector<=1;}
+};
+struct Snapshot {
+    std::uint8_t held{},feedback{},edge{};
+    std::uint64_t feedbackUntil{}; // Native opaque B4CC10/35F310 time, not float.
+    float previousInput{},charge{};
+    std::uint16_t request{};
+    bool operator==(const Snapshot&)const=default;
+    bool valid()const noexcept {
+        // This first adapter admits uncharged, digital primary input only.
+        return held<=1&&feedback<=1&&edge<=1&&!(request&~requestMask)
+            &&std::isfinite(previousInput)&&previousInput==0
+            &&std::isfinite(charge)&&charge==0;
+    }
+    bool idle()const noexcept{return valid()&&!held&&!feedback&&!request;}
+};
+struct Pins {
+    burst::Key key{};
+    std::uintptr_t root{},source{};
+    std::uint32_t coreTag{},coreBytes{},definition{};
+    bool operator==(const Pins&)const=default;
+    bool valid()const noexcept {
+        return key.valid()&&coreTag>=0x80000000&&coreTag!=0xffffffff
+            &&root>=0x10000&&root<=0x00007fffffffffffULL-barrelOffset-0xf58
+            &&source>=0x10000&&source<=0x00007fffffffffffULL-coreBytes
+            &&coreBytes>=0x27b0&&coreBytes<=0x1000000
+            &&definition>=0x27b0&&!(definition&7u)&&definition<=coreBytes
+            &&coreBytes-definition>=0x5c;
+    }
+};
+struct View {
+    Config config{};
+    Snapshot lane{};
+    std::uint8_t triggerFlags{};
+    std::uint16_t barrelFlags{};
+    bool operator==(const View&)const=default;
+    bool valid()const noexcept {
+        return config.valid()&&lane.valid()&&lane.feedback==static_cast<std::uint8_t>(bool(triggerFlags&feedbackMask))
+            &&lane.request==(barrelFlags&requestMask);
+    }
+};
+// Only the native trigger's proven lane fields are banked. In particular F50
+// activity bits1/40, epoch1700, phase clocks and native event queues are shared.
+template<class Read> bool read(Read&& reader,const Pins& pins,View& out) noexcept {
+    out={};if(!pins.valid())return false;
+    const auto trigger=pins.root+triggerOffset,barrel=pins.root+barrelOffset;
+    const auto once=[&](View& v){
+        const auto get=[&]<class T>(std::uintptr_t at,T& value){return reader(at,&value,sizeof(value));};
+        std::uint64_t size{},chargeLink{},rootOffset{};
+        std::int64_t parent{},barrelLink{};
+        std::uint32_t rootTag{},self{},owner{},rootReference{};
+        std::array<std::uint32_t,4> instance{},back{},native{};
+        if(!get(pins.source,size)||size!=pins.coreBytes
+            ||!get(pins.source+0xcd0,instance)||instance!=std::array<std::uint32_t,4>{pins.coreTag,0x8080388b,pins.definition,0}
+            ||!get(pins.source+0xce0,parent)||parent!=-0xc60
+            ||!get(pins.source+pins.definition,back)||back!=std::array<std::uint32_t,4>{pins.coreTag,0x8080388a,0xcd0,0}
+            ||!get(pins.source+pins.definition+0x5a,v.config.inputMode)
+            ||!get(pins.root,rootTag)||rootTag!=pins.coreTag
+            ||!get(pins.root+36,self)||self!=pins.key.handle
+            ||!get(pins.root+44,owner)||owner!=pins.key.owner
+            ||!get(trigger,native)||native!=instance
+            ||!get(trigger+0x10,parent)||parent!=-0xc60
+            ||!get(trigger+0x98,rootReference)||rootReference!=self
+            ||!get(trigger+0xa0,rootOffset)||rootOffset
+            ||!get(trigger+0xe8,barrelLink)||barrelLink!=0x38
+            ||!get(trigger+0xf0,chargeLink)||chargeLink
+            ||!get(trigger+0x108,v.config.hipSelector)||!get(trigger+0x109,v.config.aimSelector)
+            ||!get(trigger+0xe0,v.lane.held)||!get(trigger+0xf8,v.triggerFlags)
+            ||!get(trigger+0x100,v.lane.feedbackUntil)||!get(trigger+0x10c,v.lane.previousInput)
+            ||!get(trigger+0x110,v.lane.edge)||!get(barrel+0xf50,v.barrelFlags)
+            ||!get(barrel+0xf54,v.lane.charge))return false;
+        v.lane.feedback=bool(v.triggerFlags&feedbackMask);v.lane.request=v.barrelFlags&requestMask;
+        return v.valid();
+    };
+    View first{},second{};if(!once(first)||!once(second)||first!=second)return false;
+    out=first;return true;
+}
+struct Write {
+    std::uintptr_t address{};
+    std::array<std::byte,8> before{},after{};
+    std::size_t bytes{};
+};
+struct Plan {
+    Pins pins{};
+    Config config{};
+    std::array<Write,7> writes{};
+    std::size_t count{};
+    bool valid{};
+};
+inline Plan plan(const Pins& pins,const View& current,const Snapshot& mount) noexcept {
+    if(!pins.valid()||!current.valid()||!mount.valid())return {};
+    Plan out{pins,current.config};unsigned index=0;
+    const auto add=[&]<class T>(std::uintptr_t at,T before,T after){
+        auto& w=out.writes[index++];w.address=at;w.bytes=sizeof(T);
+        std::memcpy(w.before.data(),&before,sizeof(T));std::memcpy(w.after.data(),&after,sizeof(T));
+    };
+    const auto trigger=pins.root+triggerOffset,barrel=pins.root+barrelOffset;
+    add(trigger+0xe0,current.lane.held,mount.held);
+    add(trigger+0xf8,current.triggerFlags,static_cast<std::uint8_t>((current.triggerFlags&~feedbackMask)|(mount.feedback?feedbackMask:0)));
+    add(trigger+0x100,current.lane.feedbackUntil,mount.feedbackUntil);
+    add(trigger+0x10c,current.lane.previousInput,mount.previousInput);
+    add(trigger+0x110,current.lane.edge,mount.edge);
+    add(barrel+0xf50,current.barrelFlags,static_cast<std::uint16_t>((current.barrelFlags&~requestMask)|mount.request));
+    add(barrel+0xf54,current.lane.charge,mount.charge);
+    out.count=index;out.valid=true;return out;
+}
+inline Plan request_plan(const Pins& pins,const View& current,std::uint16_t request,float charge) noexcept {
+    auto mount=current.lane;mount.request=request;mount.charge=charge;
+    const auto full=plan(pins,current,mount);if(!full.valid)return {};
+    Plan out{pins,current.config};out.writes[0]=full.writes[5];out.writes[1]=full.writes[6];
+    out.count=2;out.valid=true;return out;
+}
+// CBE710 returns root+670. D09A30 mode0 consumes held+20, auxiliary+22,
+// analog+28. The auxiliary is NOT established as an edge bit. Leave its
+// semantics untouched by refusing an active auxiliary/analog route here.
+using Input=std::array<std::byte,48>;
+inline bool copy_input(const Input& source,const Config& config,bool held,Input& out) noexcept {
+    out={};float analog{};std::memcpy(&analog,source.data()+0x28,sizeof(analog));
+    if(!config.valid()||std::to_integer<unsigned>(source[0x20])>1||source[0x22]!=std::byte{}
+        ||!std::isfinite(analog)||analog!=0)return false;
+    out=source;out[0x20]=std::byte{static_cast<unsigned char>(held)};return true;
+}
+struct Lease {
+    Pins pins{};Config config{};Snapshot before{},mount{};
+    std::uint64_t revision{};unsigned side{};bool valid{},phase{};
+};
+struct Aggregate {
+    Pins pins{};Config config{};Snapshot before{},after{};
+    std::array<Snapshot,2> lanes{};
+    std::uint64_t revision{};bool valid{};
+};
+struct Bank {
+    Pins pins{};Config config{};Snapshot resident{};
+    std::array<Snapshot,2> lanes{};
+    std::uint64_t revision{};bool initialized{},busy{},phaseBusy{},aggregateBusy{};
+    bool initialize(const Pins& current,const View& observed) noexcept {
+        if(initialized||busy||!current.valid()||!observed.valid()||!observed.lane.idle())return false;
+        const auto next=revision+1;*this={};pins=current;config=observed.config;resident=observed.lane;
+        lanes.fill(resident);revision=next?next:1;initialized=true;return true;
+    }
+    bool relocate(const Pins& current,const View& observed) noexcept {
+        if(!initialized||!current.valid()||current.key!=pins.key||current.coreTag!=pins.coreTag
+            ||current.coreBytes!=pins.coreBytes||current.definition!=pins.definition
+            ||!observed.valid()||observed.config!=config||observed.lane!=resident)return false;
+        if(current==pins)return !busy;
+        pins=current;busy=phaseBusy=aggregateBusy=false;if(++revision==0)++revision;return true;
+    }
+    Lease begin(const Pins& current,const View& observed,unsigned side) noexcept {
+        if(!initialized||busy||current!=pins||!observed.valid()||observed.config!=config
+            ||observed.lane!=resident||(side!=burst::left&&side!=burst::right))return {};
+        if(!lanes[side==burst::left?0:1].valid())return {};
+        if(++revision==0)++revision;busy=true;phaseBusy=aggregateBusy=false;
+        return {pins,config,resident,lanes[side==burst::left?0:1],revision,side,true,false};
+    }
+    bool accepts(const Lease& lease)const noexcept {
+        return initialized&&busy&&!aggregateBusy&&lease.valid&&lease.pins==pins&&lease.config==config
+            &&lease.revision==revision&&lease.phase==phaseBusy&&(lease.side==burst::left||lease.side==burst::right);
+    }
+    bool finish(const Lease& lease,const Pins& current,const View& observed) noexcept {
+        if(lease.phase||!accepts(lease)||current!=pins||!observed.valid()||observed.config!=config)return false;
+        resident=observed.lane;lanes[lease.side==burst::left?0:1]=resident;busy=false;return true;
+    }
+    bool abort(const Lease& lease,const View& restored) noexcept {
+        if(!accepts(lease)||!restored.valid()||restored.config!=config||restored.lane!=lease.before)return false;
+        busy=false;return true;
+    }
+    // CD0530 and CBF240 can clear/set the same request bits as trigger update.
+    // There is one durable request bank, not separate trigger/phase copies.
+    // Phase leases share the exact address and revision exclusion above, and
+    // may only change the selected hand's request/charge fields.
+    Lease begin_phase(const Pins& current,const View& observed,unsigned side) noexcept {
+        auto lease=begin(current,observed,side);if(!lease.valid)return {};
+        const auto selected=lease.mount;lease.mount=lease.before;
+        lease.mount.request=selected.request;lease.mount.charge=selected.charge;
+        lease.phase=true;phaseBusy=true;return lease;
+    }
+    bool finish_phase(const Lease& lease,const Pins& current,const View& observed) noexcept {
+        if(!lease.phase||!accepts(lease)||current!=pins||!observed.valid()||observed.config!=config)return false;
+        auto locals=observed.lane;locals.request=lease.before.request;locals.charge=lease.before.charge;
+        if(locals!=lease.before)return false;
+        auto& lane=lanes[lease.side==burst::left?0:1];lane.request=observed.lane.request;lane.charge=observed.lane.charge;
+        resident=observed.lane;busy=false;return true;
+    }
+    // CBF240's proven flags&7 branch clears only the emitting hand's pending
+    // request. Native shared post-processing runs once with ORed outputs; do not
+    // copy its aggregate physical request back into either durable hand lane.
+    Aggregate begin_aggregate(const Pins& current,const View& observed,
+                              const std::array<std::uint8_t,2>& outputs) noexcept {
+        if(!initialized||busy||current!=pins||!observed.valid()||observed.config!=config
+            ||observed.lane!=resident||outputs[0]>7||outputs[1]>7
+            ||!lanes[0].valid()||!lanes[1].valid())return {};
+        auto candidates=lanes;std::uint16_t requests=0;
+        for(unsigned i=0;i<2;++i){
+            if(outputs[i]){candidates[i].request&=static_cast<std::uint16_t>(~2u);candidates[i].charge=0;}
+            requests|=candidates[i].request;
+        }
+        auto after=resident;after.request=requests;after.charge=0;
+        if(++revision==0)++revision;busy=aggregateBusy=true;phaseBusy=false;
+        return {pins,config,resident,after,candidates,revision,true};
+    }
+    bool accepts(const Aggregate& lease)const noexcept {
+        return initialized&&busy&&aggregateBusy&&lease.valid&&lease.pins==pins
+            &&lease.config==config&&lease.revision==revision;
+    }
+    bool finish_aggregate(const Aggregate& lease,const Pins& current,const View& observed) noexcept {
+        if(!accepts(lease)||current!=pins||!observed.valid()||observed.config!=config
+            ||observed.lane!=lease.after)return false;
+        lanes=lease.lanes;resident=observed.lane;busy=aggregateBusy=false;return true;
+    }
+    bool abort_aggregate(const Aggregate& lease,const View& restored) noexcept {
+        if(!accepts(lease)||!restored.valid()||restored.config!=config||restored.lane!=lease.before)return false;
+        busy=aggregateBusy=false;return true;
+    }
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/charge.h b/Dawn/src/client/hooks/akimbo/charge.h
new file mode 100644
index 0000000000000000000000000000000000000000..2f0038ed3b66e888d3ab98c1fad3d21bbbcc1829
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/charge.h
@@ -0,0 +1,179 @@
+#pragma once
+// Isolated build86657 charge-phase/ownership prototype. NOT used by the DLL.
+// Native D090F0 owns effect handles and callback ordering; these decisions do
+// not authorize copying a controller, calling its callbacks, or firing a gun.
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+
+namespace dawn::client::hooks::akimbo::charge {
+enum class Mode : unsigned {Timed=0,Automatic=2,Release=3};
+enum class Phase : unsigned {
+    Idle=0,PausedCharging=1,PausedReady=2,Charging=3,Ready=4,
+    Overdrawing=5,Overdrawn=6,EffectWait=7,Recovering=8
+};
+// The future native bridge must produce one owner-qualified immutable sample.
+// 'after' is native CF09F0's elapsed time after its conditional fraction cap,
+// not before+wallclock delta. Timings come from B8B7F0, not source constants.
+// thirdFlag deliberately retains its native meaning: its source includes
+// CED940 and cannot safely be replaced with a raw input button.
+struct Sample {
+    Phase phase{};
+    Mode mode{};
+    bool held{},thirdFlag{},continueOnRelease{},earlyRelease{},overdrawRelease{};
+    bool fullChargeAllowed{true},effectGone{};
+    float before{},after{},chargeTime{1},holdTime{},overdrawTime{},preCharge{};
+};
+inline bool valid(const Sample& s) noexcept {
+    const auto finite=[](float f){return std::isfinite(f)&&f>=0;};
+    return (s.mode==Mode::Timed||s.mode==Mode::Automatic||s.mode==Mode::Release)
+        &&static_cast<unsigned>(s.phase)<=8&&finite(s.before)&&finite(s.after)
+        &&finite(s.chargeTime)&&s.chargeTime>0&&finite(s.holdTime)&&finite(s.overdrawTime)
+        &&std::isfinite(s.chargeTime+s.holdTime+s.overdrawTime)
+        &&finite(s.preCharge)&&s.preCharge<=1;
+}
+struct Decision {
+    bool qualified{};
+    Phase next{};
+    bool start{},advance{},cancel{},release{},resetElapsed{};
+    float output{};
+};
+inline Decision update(const Sample& s) noexcept {
+    Decision d{};
+    // Recovery state8 depends on native tick conversion and the release/repress
+    // latch at+200; leave it blocked until its side effects are integrated.
+    if(!valid(s)||s.phase==Phase::Recovering)return d;
+    d.qualified=true;d.next=s.phase;
+    const bool full=s.mode!=Mode::Release||s.fullChargeAllowed;
+    const float holdEnd=s.chargeTime+s.holdTime;
+    const float overdrawEnd=holdEnd+s.overdrawTime;
+    switch(s.phase){
+    case Phase::Idle:
+        // D0928F restores retained+1E8, clears it and starts native effects.
+        if(s.held){d.next=Phase::Charging;d.start=true;}
+        break;
+    case Phase::PausedCharging:d.next=Phase::Charging;break;
+    case Phase::PausedReady:d.next=Phase::Ready;break;
+    case Phase::Charging:
+        if(!s.held&&!s.continueOnRelease){
+            if(s.earlyRelease)d.release=true;else d.cancel=true;
+        }else{
+            d.advance=true;
+            if(s.after>=s.chargeTime&&full)d.next=Phase::Ready;
+        }
+        break;
+    case Phase::Ready:
+        if(s.mode==Mode::Automatic){
+            // D095AD cancels on the qualified third argument, even when full.
+            if(s.thirdFlag)d.cancel=true;else d.release=true;
+        }else if(s.mode==Mode::Timed){
+            // D096AA tests existing elapsed; it does NOT advance this pass.
+            d.release=!s.held||s.before>holdEnd;
+        }else if(!s.held)d.release=true;
+        else{
+            d.advance=true;
+            if(!full)d.next=Phase::Charging;
+            else if(s.after>holdEnd)d.next=Phase::Overdrawing;
+        }
+        break;
+    case Phase::Overdrawing:
+        // D096ED advances before release/limit/overdraw tests, but release
+        // output remains the fraction sampled BEFORE that advancement.
+        d.advance=true;
+        if(!s.held)d.release=true;
+        else if(!full)d.next=Phase::Charging;
+        else if(s.after>overdrawEnd)d.next=Phase::Overdrawn;
+        break;
+    case Phase::Overdrawn:
+        d.release=!s.held||(s.before>overdrawEnd&&s.overdrawRelease);
+        break;
+    case Phase::EffectWait:
+        // The caller must qualify the actual native owned effect's retirement.
+        if(s.effectGone){d.next=Phase::Idle;d.resetElapsed=true;}
+        break;
+    case Phase::Recovering:break;
+    }
+    if(d.release||d.cancel){d.next=Phase::Idle;d.resetElapsed=true;}
+    // D099AA zeroes the fifth argument on every non-release path.
+    if(d.release)d.output=s.preCharge;
+    return d;
+}
+inline Phase pause(Phase p) noexcept {
+    // CF4760 preserves elapsed and only parks charging/ready states.
+    return p==Phase::Charging?Phase::PausedCharging:p==Phase::Ready?Phase::PausedReady:p;
+}
+struct Cancellation {bool qualified{},active{},release{},replaceEffect{};};
+inline Cancellation cancellation(const Sample& s) noexcept {
+    if(!valid(s))return {};
+    // CE48C0 jump table at CE4B38: states1/3/8 cancel; states2/4/5/6
+    // may emit. State0/7 do nothing. All active paths first evaluate the
+    // retained-charge expression+B0 and own effect+204. No raw handle copy.
+    if(s.phase==Phase::Idle||s.phase==Phase::EffectWait)return {true,false,false,false};
+    const bool ready=s.phase==Phase::PausedReady||s.phase==Phase::Ready
+        ||s.phase==Phase::Overdrawing||s.phase==Phase::Overdrawn;
+    const bool release=ready&&(s.mode==Mode::Timed||(s.mode==Mode::Automatic&&!s.thirdFlag));
+    return {true,true,release,!release};
+}
+
+enum class Side : unsigned {Left=0,Right=1};
+struct Key {
+    std::uint32_t handle{},owner{},model{};
+    bool operator==(const Key&)const=default;
+    bool valid()const noexcept {
+        return handle&&handle!=~0u&&owner&&owner!=~0u&&model>=0x80000000u&&model!=~0u;
+    }
+};
+struct Ticket {
+    Key key{};
+    std::uint64_t serial{};
+    Side side{};
+    float charge{};
+    bool operator==(const Ticket&)const=default;
+    explicit operator bool()const noexcept{return serial!=0;}
+};
+// Logical ownership only: no addresses, ammo, effects or native queue writes.
+// A future integration must reserve BEFORE release, settle after the exact
+// native call, then carry this ticket through its actual emission queue.
+class Releases {
+    struct Pending {Ticket ticket{};bool accepted{};};
+    Key key_{};
+    std::array<Pending,2> hands_{};
+    std::uint64_t serial_{};
+    static bool side_ok(Side side)noexcept{return static_cast<unsigned>(side)<2;}
+    bool matches(const Ticket& ticket)const noexcept {
+        return ticket&&side_ok(ticket.side)&&ticket.key==key_
+            &&hands_[static_cast<unsigned>(ticket.side)].ticket==ticket;
+    }
+public:
+    bool bind(Key key) noexcept {
+        if(!key.valid())return false;
+        if(key!=key_){key_=key;hands_={};}
+        return true;
+    }
+    bool available(Key key,Side side)const noexcept {
+        return key.valid()&&key==key_&&side_ok(side)
+            &&!hands_[static_cast<unsigned>(side)].ticket;
+    }
+    Ticket reserve(Key key,Side side,const Decision& decision) noexcept {
+        if(!available(key,side)||!decision.qualified||!decision.release||decision.cancel
+            ||!std::isfinite(decision.output)||decision.output<0||decision.output>1
+            ||serial_==std::numeric_limits<std::uint64_t>::max())return {};
+        Ticket ticket{key,++serial_,side,decision.output};
+        hands_[static_cast<unsigned>(side)]={ticket,false};return ticket;
+    }
+    bool settle(const Ticket& ticket,bool nativeAccepted) noexcept {
+        if(!matches(ticket))return false;
+        auto& hand=hands_[static_cast<unsigned>(ticket.side)];
+        if(hand.accepted)return false;
+        if(nativeAccepted)hand.accepted=true;else hand={};
+        return true;
+    }
+    Ticket take(const Ticket& ticket) noexcept {
+        if(!matches(ticket))return {};
+        auto& hand=hands_[static_cast<unsigned>(ticket.side)];
+        if(!hand.accepted)return {};
+        const auto result=hand.ticket;hand={};return result;
+    }
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/charge_layout.h b/Dawn/src/client/hooks/akimbo/charge_layout.h
new file mode 100644
index 0000000000000000000000000000000000000000..322a6955293ffc268c8d2240a83c82d527841afd
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/charge_layout.h
@@ -0,0 +1,153 @@
+#pragma once
+// Read-only construction qualification for the future charged adapter. NOT
+// installed. This validates typed serialized/native records; it never copies
+// opaque controller state or creates a second context by copying effect handles.
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace dawn::client::hooks::akimbo::charge_layout {
+inline constexpr std::size_t controllerBytes=0x220;
+struct Source {
+    std::uintptr_t asset{};
+    std::uint32_t tag{},bytes{},rootDefinition{},instance{},definition{},mode{};
+    std::array<std::uint32_t,3> properties{};
+    std::array<std::uint32_t,6> expressions{};
+    std::array<std::uint32_t,6> providerCounts{},providerStates{},providerDefinitions{};
+    std::array<std::uint32_t,3> effects{};
+    bool operator==(const Source&)const=default;
+};
+template<class Read> bool source(Read&& reader,std::uintptr_t asset,std::uint32_t tag,
+    std::uint32_t bytes,std::uint32_t instance,Source& out) noexcept {
+    out={};
+    if(asset<0x10000||asset>0x00007fffffffffffULL-bytes||tag<0x80000000||tag==0xffffffff
+        ||bytes<0x3000||bytes>0x1000000||instance<0x27b0||(instance&7u)
+        ||instance>bytes||bytes-instance<controllerBytes)return false;
+    const auto get=[&]<class T>(std::uint32_t at,T& value){return at<=bytes&&sizeof(T)<=bytes-at&&reader(asset+at,&value,sizeof(value));};
+    std::uint64_t declared{},rootRelative{},sequence{};std::int64_t parent{};
+    std::array<std::uint32_t,4> component{},back{};std::uint32_t rootTag{},rootKind{};
+    if(!get(0,declared)||declared!=bytes||!get(0x18,rootRelative)||rootRelative>bytes-0x18
+        ||!get(0x80,rootTag)||rootTag!=tag||!get(0x84,rootKind)
+        ||(rootKind!=0x80bfdfeb&&rootKind!=0x80c1c533&&rootKind!=0x80c22c04)
+        ||!get(instance,component)||component[0]!=tag||component[1]!=0x80803abe||component[3]
+        ||component[2]>bytes||bytes-component[2]<0x418||(component[2]&7u)
+        ||!get(component[2],back)||back!=std::array<std::uint32_t,4>{tag,0x80803abd,instance,0}
+        ||!get(instance+0x10,parent)||parent!=static_cast<std::int64_t>(0xcd0)-instance-0x10
+        ||!get(instance+0x210,sequence)||sequence
+        ||!get(component[2]+0x410,sequence)||sequence)return false;
+    Source result{asset,tag,bytes,static_cast<std::uint32_t>(rootRelative+0x18),instance,component[2]};
+    // CF3140/F40240 encode the property location as a root handle plus32-bit
+    // offset. Every instance must lie inside the engine-owned instance prefix,
+    // before immutable definitions, so native relocation retains that offset.
+    if(result.rootDefinition<0x80||result.rootDefinition>bytes
+        ||instance+controllerBytes>result.rootDefinition||result.definition<result.rootDefinition)return false;
+    std::uint64_t rootDefinition{};
+    if(!get(0x88,rootDefinition)||rootDefinition!=result.rootDefinition
+        ||!get(result.definition+0x2e8,result.mode)||(result.mode!=2&&result.mode!=3))return false;
+    for(unsigned i=0;i<3;++i){
+        const auto field=result.definition+0x10+i*0x20;std::int64_t relative{};
+        if(!get(field,relative)||relative<-static_cast<std::int64_t>(field)
+            ||relative>static_cast<std::int64_t>(bytes)-field-24)return false;
+        const auto property=static_cast<std::int64_t>(field)+relative;
+        if(property<result.rootDefinition||(property&7))return false;
+        result.properties[i]=static_cast<std::uint32_t>(property);
+        if(!get(result.definition+0x340+i*0x10,result.effects[i])
+            ||(result.effects[i]!=0xffffffff&&(result.effects[i]<0x80000000)))return false;
+    }
+    for(unsigned i=0;i<6;++i){
+        const auto offset=0xb0+i*0x30,at=instance+offset;
+        if(!get(at,component)||component[0]!=tag||component[1]!=0x808089f6||component[3]
+            ||component[2]<result.rootDefinition||component[2]>bytes||bytes-component[2]<0x60||(component[2]&7u)
+            ||!get(component[2],back)||back!=std::array<std::uint32_t,4>{tag,0x808089f5,at,0}
+            ||!get(at+0x10,parent)||parent!=-static_cast<std::int64_t>(offset)-0x10)return false;
+        result.expressions[i]=component[2];
+        const auto array=[&](unsigned descriptor,unsigned kind,unsigned stride,unsigned& count,unsigned& rows){
+            std::uint64_t n{},declaredCount{},classValue{};std::int64_t relative{};unsigned marker{};
+            if(!get(descriptor,n)||n>32)return false;
+            count=static_cast<unsigned>(n);rows=0;if(!n)return true;
+            if(!get(descriptor+8,relative)||relative<4-static_cast<std::int64_t>(descriptor+8)
+                ||relative>static_cast<std::int64_t>(bytes)-(descriptor+8)-16-static_cast<std::int64_t>(n)*stride)return false;
+            const auto header=static_cast<unsigned>(descriptor+8+relative);
+            if(!get(header-4,marker)||marker!=0x80809fbd||!get(header,declaredCount)||declaredCount!=n
+                ||!get(header+8,classValue)||classValue!=kind)return false;
+            rows=header+16;return true;
+        };
+        unsigned count{},states{},definitions{},defined{};
+        if(!array(at+0x20,0x80809788,96,count,states)
+            ||!array(component[2]+0x40,0x80809789,40,defined,definitions)||count!=defined
+            ||(count&&(states<0x80||states+count*96>result.rootDefinition||definitions<result.rootDefinition)))return false;
+        for(unsigned j=0;j<count;++j){
+            const auto state=states+j*96,definition=definitions+j*40;
+            if(!get(state,component)||component!=std::array<unsigned,4>{tag,0x80809789,definition,0}
+                ||!get(definition,back)||back!=std::array<unsigned,4>{tag,0x80809788,state,0}
+                ||!get(state+16,parent)||parent!=static_cast<std::int64_t>(at)-state-16)return false;
+        }
+        result.providerCounts[i]=count;result.providerStates[i]=states;result.providerDefinitions[i]=definitions;
+    }
+    out=result;return true;
+}
+struct Live {
+    std::uintptr_t root{},controller{};
+    std::uint32_t handle{},owner{},phase{},content{};
+    std::uint64_t effect{},elapsed{},retained{},retainedAt{},recoveryAt{};
+    std::uint8_t released{};
+    bool operator==(const Live&)const=default;
+};
+template<class Read> bool live(Read&& reader,const Source& expected,std::uintptr_t root,
+    std::uint32_t handle,std::uint32_t owner,std::uint32_t content,Live& out) noexcept {
+    out={};Source actual{};
+    if(!handle||handle==0xffffffff||!owner||owner==0xffffffff||!content||content==0xffffffff
+        ||root<0x10000||root>0x00007fffffffffffULL-expected.bytes
+        ||!source(reader,expected.asset,expected.tag,expected.bytes,expected.instance,actual)||actual!=expected)return false;
+    const auto offset=expected.instance-0x80;
+    const auto at=root+offset;
+    const auto get=[&]<class T>(std::uintptr_t address,T& value){return reader(address,&value,sizeof(value));};
+    const auto once=[&](Live& state){
+        std::uint32_t tag{},self{},entity{};std::uint64_t definition{},sequence{};
+        std::array<std::uint32_t,4> component{};std::int64_t parent{};std::uint8_t phase{};
+        if(!get(root,tag)||tag!=expected.tag||!get(root+8,definition)||definition!=expected.rootDefinition
+            ||!get(root+36,self)||self!=handle||!get(root+44,entity)||entity!=owner
+            ||!get(at,component)||component!=std::array<std::uint32_t,4>{expected.tag,0x80803abe,expected.definition,0}
+            ||!get(at+0x10,parent)||parent!=static_cast<std::int64_t>(0xcd0)-expected.instance-0x10
+            ||!get(at+0x210,sequence)||sequence)return false;
+        for(unsigned i=0;i<3;++i){
+            const auto property=at+0x20+i*0x30;std::uint32_t propertyHandle{},kind{};std::uint64_t location{},propertyDefinition{};
+            if(!get(property+0xc,propertyHandle)||propertyHandle!=handle
+                ||!get(property+0x10,location)||location!=offset+0x20+i*0x30
+                ||!get(property+0x20,tag)||tag!=expected.tag||!get(property+0x24,kind)||kind!=0x808045c4
+                ||!get(property+0x28,propertyDefinition)||propertyDefinition!=expected.properties[i])return false;
+        }
+        for(unsigned i=0;i<6;++i){
+            const auto nested=0xb0+i*0x30;
+            if(!get(at+nested,component)||component!=std::array<std::uint32_t,4>{expected.tag,0x808089f6,expected.expressions[i],0}
+                ||!get(at+nested+0x10,parent)||parent!=-static_cast<std::int64_t>(nested)-0x10)return false;
+            for(unsigned j=0;j<expected.providerCounts[i];++j){
+                const auto sourceState=expected.providerStates[i]+j*96;
+                const auto provider=root+sourceState-0x80;
+                if(!get(provider,component)||component!=std::array<unsigned,4>{expected.tag,0x80809789,expected.providerDefinitions[i]+j*40,0}
+                    ||!get(provider+16,parent)||parent!=static_cast<std::int64_t>(expected.instance+nested)-sourceState-16)return false;
+            }
+        }
+        if(!get(at+0x1d0,phase)||phase>8||!get(at+0x204,state.effect)||!get(at+0x20c,state.content)
+            ||(state.content!=0xffffffff&&state.content!=content)||!get(at+0x1e0,state.elapsed)
+            ||!get(at+0x1e8,state.retained)||!get(at+0x1f0,state.retainedAt)||!get(at+0x1f8,state.recoveryAt)
+            ||!get(at+0x200,state.released)||state.released>1)return false;
+        state.root=root;state.controller=at;state.handle=handle;state.owner=owner;state.phase=phase;return true;
+    };
+    Live first{},second{};if(!once(first)||!once(second)||first!=second)return false;
+    out=first;return true;
+}
+// Two qualified contexts must have disjoint engine-owned storage and never
+// alias a live effect. This is a precondition, not a constructor or ownership
+// transfer. The native weak-handle resolver must still verify each generation
+// before a release/cancel/teardown callback can consume it.
+inline bool independent(const Live& left,const Live& right) noexcept {
+    if(!left.root||left.root!=right.root||left.handle!=right.handle||left.owner!=right.owner
+        ||left.controller<left.root||right.controller<right.root)return false;
+    const auto low=left.controller<right.controller?left.controller:right.controller;
+    const auto high=left.controller<right.controller?right.controller:left.controller;
+    return high-low>=controllerBytes&&(left.effect==std::numeric_limits<std::uint64_t>::max()
+        ||right.effect==std::numeric_limits<std::uint64_t>::max()||left.effect!=right.effect);
+}
+}
