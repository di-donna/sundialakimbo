+    }
+    bool context(const burst_cadence::Context& at,burst_driver::Context& out) noexcept {
+        if(!current())return false;
+        const auto blocked=reinterpret_cast<bool(__fastcall*)(void*)>(moduleBase+0xcb7ff0)(reinterpret_cast<void*>(selected.native.root));
+        const auto owner=selected.native.owner&0x1fff;std::uint32_t bits{};
+        if(!current()||!local_read(nullptr,moduleBase+0x26be0e0+(owner/32)*4,&bits,sizeof(bits)))return false;
