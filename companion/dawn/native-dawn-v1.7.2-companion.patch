+template<class T> bool read(const Memory& m, std::uintptr_t a, T& out) noexcept {
+    if (!m.read || a < 0x10000 || a > 0x00007fffffffffffULL - sizeof(T)) return false;
+    return m.read(m.context, a, &out, sizeof(out));
+}
+template<class T, std::size_t N> T at(const std::array<std::byte,N>& b, std::size_t offset) noexcept {
+    T result{}; std::memcpy(&result,b.data()+offset,sizeof(result)); return result;
+}
+bool resolve(const Memory& m, std::uint32_t handle, std::uintptr_t& out,unsigned pools=2048) noexcept {
+    if (!handle || handle == 0xffffffff) return false;
+    std::uintptr_t wrapper{}, table{};
+    if (!read(m,m.tablesSlot,wrapper) || !read(m,wrapper,table)) return false;
+    const auto shifted=static_cast<std::int32_t>(handle)>>13;
+    const auto pool=((static_cast<std::uint64_t>(static_cast<std::int64_t>(shifted))|0x0ffc0000ULL)>>18)
+        & (static_cast<std::uint32_t>(shifted)&0xffffU);
+    if (pool>=pools) return false;
+    std::array<std::byte,64> meta{};
+    if (!read(m,table+pool*64,meta)) return false;
+    const auto stride=at<std::uint32_t>(meta,48);
+    const auto mask=at<std::int32_t>(meta,52);
+    const auto cells=at<std::uintptr_t>(meta,8);
+    if (!stride || stride>1048576 || (mask!=0 && mask!=-1)) return false;
+    const auto offset=static_cast<std::uint32_t>((handle&8191U)*stride);
+    if (cells>0x00007fffffffffffULL-offset-8) return false;
+    const auto cell=cells+offset;
+    std::uintptr_t relative{};
+    if (!read(m,cell+8,relative)) return false;
+    // Native relative indirection is defined modulo 2^64.
+    out=cell-(static_cast<std::uintptr_t>(static_cast<std::intptr_t>(mask))&relative);
+    return out>=0x10000 && out<=0x00007fffffffffffULL;
+}
+struct Header { std::uint32_t tag{}, kind{}, self{}, owner{}; std::uint64_t definition{}; };
+bool akimbo_model(std::uint32_t tag) noexcept {
+    return profiles::find(tag)!=nullptr;
+}
+// First-person rig by animation tag (kind 808036CF). The sidearm rig is
+// SIDEARM-RIG.md 1: animation entity 80BBDBAF, 77 nodes, 75 controls.
+struct FirstPersonRig { RigClass kind{}; std::uint32_t skeleton{}, rig{}; };
+FirstPersonRig first_person_rig(std::uint32_t animation) noexcept {
+    const auto rig=profiles::generated.rig(animation);
+    return {rig.kind,rig.skeleton,rig.rig};
+}
+// Resource tags from 0x81000000 up live in pools past 2048 (81529057 -> 2708),
+// as reload_profile found; component handles keep the 2048-pool bound.
+unsigned asset_pools(std::uint32_t tag) noexcept { return (tag>>24)>=0x81 ? 4096U : 2048U; }
+bool header(const Memory& m, std::uintptr_t address, Header& h) noexcept {
+    std::array<std::byte,48> b{}; std::uintptr_t resolved{};
+    if (!read(m,address,b)) return false;
+    h={at<std::uint32_t>(b,0),at<std::uint32_t>(b,4),at<std::uint32_t>(b,36),at<std::uint32_t>(b,44),at<std::uint64_t>(b,8)};
+    return h.owner && h.owner!=0xffffffff && resolve(m,h.self,resolved) && resolved==address;
+}
+bool component(const Memory& m, std::uint32_t handle, std::uint32_t tag, std::uint32_t kind,
+               std::uint32_t owner, std::uintptr_t& address, Header& h) noexcept {
+    return resolve(m,handle,address) && header(m,address,h) && h.self==handle
+        && h.tag==tag && h.kind==kind && h.owner==owner;
+}
+std::uint32_t private_presentation_model(const SoundPacket& packet) noexcept {
+    constexpr std::array<std::uint32_t,7> thorn{0xffffffff,0x80b74ca9,0xffffffff,0xffffffff,0x80b74cab,0xffffffff,0x80b74caa};
+    // Native packet order differs from numeric art-slot order: Ace's slot5
+    // hammer occupies the fourth part. Both sets match recorded live packets.
+    constexpr std::array<std::uint32_t,7> ace{0x80b74cac,0x80b74cad,0xffffffff,0x80b74cae,0x80b74caf,0xffffffff,0x80b74cb0};
+    std::array<std::uint32_t,7> parts{};std::memcpy(parts.data(),packet.data()+4,sizeof(parts));
+    if(parts==thorn)return 0x81a295e0;
+    if(parts==ace)return 0x81a295fd;
+    return 0;
+}
+bool presentation_owner(const Memory& m,std::uintptr_t address) noexcept {
+    // Exact private parent sets are pinned by assembly-report.json and installed
+    // art-map checks. Never resolve parent assets that can unload between equips.
+    Header h{};std::uintptr_t owner{};std::uint32_t self{};
+    if(!header(m,address,h)||h.tag!=0x80bbd8a5||h.kind!=0x80803f47||h.definition!=568
+        ||!resolve(m,h.owner,owner)||!read(m,owner+12,self)||self!=h.owner)return false;
+    Header after{};
+    return header(m,address,after)&&after.self==h.self&&after.owner==h.owner&&after.tag==h.tag;
+}
