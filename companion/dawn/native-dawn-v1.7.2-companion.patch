+// S2 decision 1: the parts the input pass follows every pass (the barrels for the
+// hooks' routing, the magazines, the active weapon for the remap) and the parts a
+// shot follows before its checks (everything the revalidation reads).
+inline constexpr unsigned kPassParts=discovery::partSturm|discovery::partDrang|discovery::partActive;
+// S2 fix (gameplay F5): the private model is not a shot part. Nothing a shot does reads
+// it, drawn-ness is the active component (core == Sturm's self, checked below) plus the
+// presented stamp, and a model re-created on each draw (a new handle, [I] dumps) would
+// otherwise refuse the first taps after every swap (drang_changed + a 1-2 s rediscovery).
+inline constexpr unsigned kShotParts=discovery::partSturm|discovery::partDrang|discovery::partActive
+    |discovery::partEquipment|discovery::partContent;
+// The per-shot fast revalidation (design-firing 3, about 50 checked reads
+// through the discovery Reader): Refuse::count = valid; variant = Drang's
+// content variant is not 3 (S1 never writes it); drangChanged = anything else.
+// Any refusal drops the cache and re-pumps (the driver's caller). S2: the
+// snapshot first follows its handles (discovery::relocate, kShotParts): a part
+// that moved is followed (c is updated), only a part whose handle stops
+// resolving or whose identity pins fail refuses drangChanged.
+template<class R> Refuse fast_revalidate(R& r,discovery::Snapshot& c) noexcept {
+    if(!discovery::relocate(r,c,kShotParts).ok())return Refuse::drangChanged;
+    const auto& d=c.drang.key;const auto& s=c.sturm.key;
+    std::uintptr_t a{},owner{},assembly{};discovery::Header h{},ch{},sh{};std::array<std::uint32_t,4> barrel{};
+    std::uint32_t back{},parent{},assemblyHandle{},assemblyTag{},contentHandle{},activeEntity{},activeCore{};std::uint64_t off{};std::int32_t variant{};
