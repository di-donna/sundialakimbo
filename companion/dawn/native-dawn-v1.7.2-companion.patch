+// ---- Recorder (rat_king.h D.2) -------------------------------------------------------
+// One call per posed sidearm frame, before the pose layer edits anything. raw:
+// the native pre-correction pose (77 frames) or null. Writes only s.inProgress,
+// s.previous and, on acceptance, s.committed/info/valid/dirty.
+struct Recorder {
+    bool active{};
+    unsigned next{},samples{};
+    float tFirst{},tPrev{},maxGap{},duration{},speed{};
+    double wallPrev{};
+    // Runtime v4 final (review F7): the native reload being seen (seen, its
+    // last phase tSeen), whether it may still arm and report a decline
+    // (pending), the reasons its refused frames gave (declined) and whether any of
+    // its frames came in the arming window (early).
+    bool seen{},pending{},early{};float tSeen{};std::uint32_t declined{};
+    // Runtime v5: the reload's first-seen phase, and the values behind the last
+    // event 2, 3 or 4 (akimbo.cpp logs them).
+    float firstSeen{-1};
+    Measure measure{};
+    // event: 0 none, 1 started, 2 accepted (committed), 3 rejected (aborted or
+    // not accepted: reasons), 4 declined (a reload that could have been
+    // recorded never armed: reasons, reason::late when none of its frames came
+    // in the arming window); gap/coverage: the finished recording's; first: the
+    // phase of a native reload's first frame (on that frame only, else -1).
+    struct Result {unsigned event{};std::uint32_t reasons{};float gap{-1},coverage{-1},first{-1};};
+    static bool relative(const Frame* raw,KnotPose& out) noexcept {
+        if(!raw)return false;
+        for(unsigned i=0;i<bones;++i)if(!valid(raw[i]))return false;
+        const Frame back=inverse(raw[0]);
+        for(unsigned i=0;i<bones;++i){out[i]=compose(back,raw[i]);if(!valid(out[i]))return false;}
+        return true;
+    }
+    Result abort(std::uint32_t why) noexcept {
+        if(!active)return {};
+        active=false;
+        measure={firstSeen,tFirst,tPrev,maxGap,samples};
+        return {3,why,maxGap,tPrev};
+    }
+    Result feed(Store& s,const Frame* raw,bool native,float t,ActionClock clock,bool draw,float aim,double now) noexcept {
+        // A native reload's first frame (a new one, or a restart): its first-seen
+        // phase; a decline report opens while no complete recording is kept.
+        const bool reload=native&&std::isfinite(t);
+        float first=-1;
+        if(reload&&(!seen||t+rk::reloadPhaseRestart<tSeen)){first=t;firstSeen=t;pending=!s.complete();early=false;declined=0;}
+        seen=reload;if(reload)tSeen=t;
+        Result r=record(s,raw,native,t,clock,draw,aim,now,first>=0);
+        r.first=first;
+        return r;
+    }
+private:
+    Result decline() noexcept {
+        pending=false;measure={firstSeen};
+        return {4,declined|(early?0U:reason::late),-1,-1};
+    }
+    Result record(Store& s,const Frame* raw,bool native,float t,ActionClock clock,bool draw,float aim,double now,bool firstFrame) noexcept {
+        if(active){
+            if(draw)return abort(reason::draw);
+            if(!native)return finish(s);
+            std::uint32_t why{};
+            if(!std::isfinite(t)||t<tPrev-rk::recordBackwards)why|=std::isfinite(t)&&tPrev-t<=rk::reloadPhaseRestart?reason::backwards:reason::restart;
+            if(!(now-wallPrev<=rk::recordMaxWallSeconds))why|=reason::wall;
+            if(t-tPrev>rk::recordMaxGap)why|=reason::gap;
+            if(!(aim<=rk::recordMaxAim))why|=reason::aim;
+            KnotPose sample{};
+            if(!relative(raw,sample))why|=reason::invalid;
+            if(why)return abort(why);
+            add(s,t,sample,now);
+            return t>=rk::recordFinishPhase?finish(s):Result{};
+        }
+        // Runtime v5: a complete recording is kept; only a back-filled one
+        // (improvable) is recorded again, and only from a sampled head.
+        if(s.complete()&&!s.improvable()){pending=false;return {};}
+        const bool improve=s.complete();
+        if(improve)pending=false;
+        // The arming window (rat_king.h D.2): any frame by recordHeadPhase; the
+        // reload's first frame by recordArmPhase (a later frame after refused
+        // ones does not arm). Past it, or the reload ended: report why.
+        const bool window=native&&std::isfinite(t)&&(t<=rk::recordHeadPhase||(!improve&&firstFrame&&t<=rk::recordArmPhase));
+        if(!window)return pending?decline():Result{};
+        early=true;
+        std::uint32_t no{};
+        if(draw)no|=reason::draw;
+        if(!(aim<=rk::recordMaxAim))no|=reason::aim;
+        KnotPose sample{};
+        if(!no&&!relative(raw,sample))no|=reason::invalid;
+        if(no){declined|=no;return {};}
+        pending=false;
+        active=true;next=0;samples=0;tFirst=tPrev=t;maxGap=0;wallPrev=now;duration=clock.duration;speed=clock.speed;
+        add(s,t,sample,now);
+        return {1,0,-1,-1};
+    }
+    // Fills every knot in (tPrev, t] from the previous and this sample (the
+    // first sample fills every knot up to t: the back-filled head of a late
+    // first frame, runtime v5).
+    void add(Store& s,float t,const KnotPose& sample,double now) noexcept {
+        const float gap=samples?t-tPrev:0.f;
+        maxGap=std::max(maxGap,gap);
+        while(next<knots){
+            const float tk=static_cast<float>(next)*rk::knotPhase;
+            if(tk>t+1e-6f)break;
+            auto& knot=s.inProgress.knot[next];
+            if(!samples||std::abs(tk-t)<=1e-6f||!(gap>0))knot=sample;
+            else{
+                const float f=std::clamp((tk-tPrev)/gap,0.f,1.f);
+                for(unsigned i=0;i<bones;++i)knot[i]=blend(s.previous[i],sample[i],f);
+            }
+            ++next;
+        }
+        s.previous=sample;tPrev=t;wallPrev=now;++samples;
+    }
+    Result finish(Store& s) noexcept {
+        active=false;
+        Result r{3,0,maxGap,tPrev};
+        measure={firstSeen,tFirst,tPrev,maxGap,samples};
+        const bool complete=tPrev>=rk::recordComplete,provisional=!complete&&tPrev>=rk::recordProvisional;
+        // Runtime v5: the head/tail check runs on a sampled head only.
+        const bool headTail=complete&&tFirst<=rk::recordHeadPhase;
+        if(!complete&&!provisional){r.reasons=reason::coverage;return r;}
+        // A provisional recording only fills an empty store (a complete one
+        // replaces it); a complete one replaces a complete one only when the
+        // kept head was back-filled and this head was sampled.
+        if(provisional&&s.valid){r.reasons=reason::notBetter;return r;}
+        if(complete&&s.complete()&&!(s.improvable()&&headTail)){r.reasons=reason::notBetter;return r;}
+        while(next<knots)s.inProgress.knot[next++]=s.previous;
+        r.reasons=structure(s.inProgress,tPrev,headTail,maxGap,&measure);
+        if(r.reasons)return r;
+        s.committed=s.inProgress;
+        s.info={tFirst,tPrev,maxGap,duration,speed,samples,complete?(headTail?flagComplete|flagHeadTail:flagComplete):flagProvisional};
+        s.valid=s.dirty=true;s.loaded=false;
+        r.event=2;return r;
+    }
+};
+
+// Runtime v5: the diagnostics' rate limit (akimbo.cpp, under alternatingLock):
+// at most rk::recordLogBudget lines a session, rk::recordLogSeconds apart; a
+// line refused here is counted and the next admitted line reports the count.
+struct LogGate {
+    unsigned lines{},dropped{};double last{-1e9};
+    bool admit(double now) noexcept {
+        if(lines>=rk::recordLogBudget||!(now-last>=rk::recordLogSeconds)){++dropped;return false;}
+        ++lines;last=now;return true;
+    }
+    // The count to report on an admitted line (then cleared).
+    unsigned take_dropped() noexcept {const unsigned d=dropped;dropped=0;return d;}
+};
+// One diagnostics line for a recorder event (2 accepted, 3 rejected or
+// aborted, 4 declined) with the measured values (metres, degrees, phases):
+// first = the reload's first-seen phase, tfirst/tlast/gap/samples the
+// recording's; after the structure checks: grip (min-max), slide_head (key 0),
+// slide_head_max (keys 0..checkSlideHeadLast), slide_rest / mag_rest (the
+// largest offsets in the at-rest windows), slide_rack (key 50), mag_out /
+// mag_low (keys 12 / 24) and headtail (root 72 mm / deg, left hand mm) or
+// headtail=skipped (a back-filled head). Returns the snprintf result.
+inline int describe(char* out,std::size_t size,unsigned event,std::uint32_t reasons,const Measure& m,unsigned dropped) noexcept {
+    if(!out||!size)return -1;
+    // rejected: finished and refused (structure, frames, coverage, not better); aborted: stopped mid-reload.
+    const char* result=event==2?"accepted":event==4?"declined"
+        :m.structured||(reasons&(reason::frames|reason::coverage|reason::notBetter))?"rejected":"aborted";
+    int n=std::snprintf(out,size,"ev=akimbo stage=reload_recording_check result=%s reasons=%X first=%.3f tfirst=%.3f tlast=%.3f gap=%.4f samples=%u",
+        result,reasons,static_cast<double>(m.firstSeen),static_cast<double>(m.tFirst),static_cast<double>(m.tLast),static_cast<double>(m.maxGap),m.samples);
+    const auto more=[&](int k) noexcept {if(k<0||n<0)n=-1;else n+=k;};
+    const auto room=[&]() noexcept {return n>=0&&static_cast<std::size_t>(n)<size?size-static_cast<std::size_t>(n):std::size_t{0};};
+    if(m.structured&&room())more(std::snprintf(out+n,room(),
+        " grip=%.4f-%.4f slide_head=%.4f slide_head_max=%.4f slide_rest=%.4f slide_rack=%.4f mag_rest=%.4f mag_out=%.4f mag_low=%.4f",
+        static_cast<double>(m.gripMin),static_cast<double>(m.gripMax),static_cast<double>(m.slideHead),static_cast<double>(m.slideHeadMax),
+        static_cast<double>(m.slideRest),static_cast<double>(m.slideRack),static_cast<double>(m.magazineRest),static_cast<double>(m.magazineOut),
+        static_cast<double>(m.magazineLow)));
+    if(m.structured&&room()){
+        if(m.headTail)more(std::snprintf(out+n,room()," headtail=%.1fmm/%.2fdeg hand=%.1fmm",static_cast<double>(m.headTailMeters*1000),
+            static_cast<double>(m.headTailDegrees),static_cast<double>(m.headTailHand*1000)));
+        else more(std::snprintf(out+n,room()," headtail=skipped"));
+    }
+    if(dropped&&room())more(std::snprintf(out+n,room()," dropped=%u",dropped));
+    return n;
+}
