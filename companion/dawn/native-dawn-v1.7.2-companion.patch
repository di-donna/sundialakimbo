+        for(unsigned i=0;i<files_.size();++i){
+            const auto& f=files_[i];if(!f.used)continue;
+            if(f.animation==r.animationTag&&f.ratKing==r.ratKing&&f.nodes==r.nodes)return static_cast<int>(i);
+            if(!f.ratKing)++others;
+        }
+        if(!r.ratKing&&(r.animationTag==handCannonAnimation||r.animationTag==smgAnimation
+            ||!r.ownedModels||r.nodes>100||others>=otherPoseFiles))return -1;
+        for(unsigned i=0;i<files_.size();++i)if(!files_[i].used){
+            files_[i]={r.animationTag,r.skeletonTag,r.rigTag,r.controllerTag,r.modelOwner,r.nodes,r.ratKing,true};
+            return static_cast<int>(i);
+        }
+        return -1;
+    }
