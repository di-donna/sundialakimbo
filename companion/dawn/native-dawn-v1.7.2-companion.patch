+    // Thorn/Malfeasance only (80 bones, two markers). Rat King Akimbo shares
+    // the tickets above but not this pose (rat_king_pose.h).
+    bool pose(const Identity& id,void* data,unsigned mode,unsigned action,
+              ActionClock clock,float aim,std::uint64_t now,Frame controller) noexcept {
+        select(id);
+        if(!alternating_model(id.modelTag)||mode!=4||!data)return false;
+        if(action==3&&!drawing)reset(id);
+        drawing=action==3;
+        const bool firing=firing_action(action,clock,id.modelTag);
+        const bool idle=action==0||action==1;
+        // Reload/melee cancellation must not discard this identity's grip
+        // calibration: the next shot can interrupt reload before any idle
+        // frame is rendered. Draw and identity changes reset it above.
+        if(!idle&&!firing){hasShot=false;recovering=false;rendered={};released={};return false;}
+        const unsigned poseCount=pose_bones(id.modelTag);
+        // Frames past the rig's own bone count stay default (valid) and are
+        // never written back.
+        std::array<Frame,80> p{};std::memcpy(p.data(),data,poseCount*sizeof(Frame));
+        for(const auto& f:p)if(!valid(f))return false;
+        if(!valid(controller)||!std::isfinite(aim)||aim<0||aim>1)return false;
