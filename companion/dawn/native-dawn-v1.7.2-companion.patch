+// ---- Pair mirror (RELOAD-V4.md 4) -----------------------------------------------------
+// sconj(F) = S F S with S = diag(1,-1,1): a proper rotation (det +1), never
+// inside-out. reflect(M, F) = M sconj(M^-1 F) mirrors a frame across the y = 0
+// plane of M; its local y axis is restored.
+inline Frame sconj(Frame f) noexcept {return {{-f.q.x,f.q.y,-f.q.z,f.q.w},{f.p.x,-f.p.y,f.p.z},f.scale};}
+inline Frame reflect(Frame mirror,Frame f) noexcept {return compose(mirror,sconj(compose(inverse(mirror),f)));}
+// The pair mid-plane of a hold: the right gun root moved half the spacing along
+// its +y. reflect(H72) is then exactly the copy frame H72 * T(0, spacing, 0).
+inline Frame mirror_frame(Frame rightRoot) noexcept {return compose(rightRoot,Frame{{},{0,rk::spacing*.5f,0},1});}
+// Bind convention of 80BBDB9C (VERIFIED on all 22 arm pairs): left = mirror
+// (right) * Ry180, except the grips 23/24 (arm index 4); pose_math mirrored().
+inline constexpr Frame ry180{{0,1,0,0},{},1};
+inline Frame mirror_arm_bone(Frame mirror,Frame f,unsigned armIndex) noexcept {
+    const Frame r=reflect(mirror,f);
+    return armIndex==4?r:compose(r,ry180);
+}
+// Both arm groups swapped across the mirror plane (out may not alias in).
+inline void mirror_arms(const std::array<Frame,80>& in,Frame mirror,std::array<Frame,80>& out) noexcept {
+    for(unsigned i=0;i<22;++i){
+        out[alternating::leftArm[i]]=mirror_arm_bone(mirror,in[alternating::rightArm[i]],i);
+        out[alternating::rightArm[i]]=mirror_arm_bone(mirror,in[alternating::leftArm[i]],i);
+    }
+}
+// A shared moving part (74/75) relative to the output right root, so that the
+// copy (left) gun shows the mirror image of the recorded right part: the
+// patched shader draws a copy part at leftGun * (p72^-1 * P) * bind^-1 (RECIPE
+// family D, rebase and pivot fix), so P = p72 * sconj(G) * bind with
+// G = gun^-1 * part * bind^-1 (the part in weapon-bind space). INFERRED: the
+// magazine and slide art are symmetric about weapon y = 0.
+inline Frame mirrored_part(Frame gun,Frame part,Frame bind) noexcept {
+    return compose(sconj(compose(compose(inverse(gun),part),inverse(bind))),bind);
+}
