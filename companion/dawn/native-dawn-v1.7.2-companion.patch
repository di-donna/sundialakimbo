+void conservation(){
+    for(int capacity=1;capacity<=12;++capacity)for(int quantum=1;quantum<=capacity+1;++quantum)
+    for(int reserve=0;reserve<=capacity*2+1;++reserve){
+        auto v=inputs;v.quantum=quantum;t::Hand hands[2];int loaded[2]{0,capacity/2};
+        int stock=reserve,shots=0;const int total=stock+loaded[0]+loaded[1];
+        if(stock){check(hands[0].start(v,loaded[0],capacity,stock),"left independent fixture starts");
+            if(loaded[1]<capacity)check(hands[1].start(v,loaded[1],capacity,stock),"right independent fixture starts");}
+        for(unsigned tick=0;tick<100;++tick){
+            for(unsigned side=0;side<2;++side){const int n=hands[side].advance(.25,v,loaded[side],capacity,stock);
+                check(n>=0&&n<=quantum&&n<=stock&&loaded[side]+n<=capacity,"each event obeys quantum, capacity and shared reserve");
+                loaded[side]+=n;stock-=n;
+            }
+            if(tick%7==0&&!hands[1].active()&&loaded[1]){--loaded[1];++shots;}
+            check(loaded[0]+loaded[1]+stock+shots==total,"two independent schedules conserve rounds during opposite-hand fire");
+        }
