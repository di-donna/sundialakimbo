+// Runtime v6: the entry blend's span in v (rat_king.h E.1): handoverEntrySeconds
+// of the reload's real time (the native clock's duration / speed; v runs
+// 1 / (1 - start) times faster than the clip phase), within handoverBlendIn ..
+// handoverBlendInMax; an implausible clock keeps handoverBlendIn.
+inline float entry_span(ActionClock clock,float start) noexcept {
+    const float seconds=std::isfinite(clock.speed)&&clock.speed>0&&std::isfinite(clock.duration)?clock.duration/clock.speed:0.f;
+    if(!(seconds>=.5f&&seconds<=30.f)||!std::isfinite(start))return rk::handoverBlendIn;
