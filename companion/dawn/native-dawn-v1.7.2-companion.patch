+void native_runtime_receipts() {
+    namespace r=b::runtime;
+    Image image;b::Queue before{},after{};b::Queued added{};
+    const b::Packet first{.01f,0,-1,0,.75f,0xa,0,0,~0u};
+    image.put<unsigned>(Image::head,~0u);
+    check(b::snapshot(image.memory(),Image::barrel,before),"empty insertion snapshot");
+    image.packet(1,first);image.put<unsigned>(Image::head,1);
+    check(b::snapshot(image.memory(),Image::barrel,after)&&b::inserted(before,after,first,false,added)
+        &&added.token==1,"append identifies exact new token");
+    r::Owner owner;owner.select(key);
+    auto left=owner.begin(b::left,0,3,1,1,{30,30},0);
+    check(left.valid&&owner.settle(left,true,&added).queued,"left debit records actual native packet");
+    before=after;auto second=first;second.charge=.5f;
+    auto linked=first;linked.next=2;image.packet(1,linked);image.packet(2,second);
+    check(b::snapshot(image.memory(),Image::barrel,after)&&b::inserted(before,after,second,false,added)
+        &&added.token==2,"append preserves previous payload and changes only tail link");
+    auto right=owner.begin(b::right,0,3,1,1,{29,30},0);
+    check(right.valid&&owner.settle(right,true,&added).queued,"right burst begins independently while left burst pending");
+    check(owner.find(1).receipt.side==b::left&&owner.find(2).receipt.side==b::right,"identical ordinals retain distinct hand receipts");
+    auto damaged=after;damaged.events[0].packet.progress++;
+    check(!b::inserted(before,damaged,second,false,added),"unexpected old packet mutation refuses association");
+    damaged=after;damaged.events[1].token=1;
+    check(!b::inserted(before,damaged,second,false,added),"duplicate native token refuses insertion");
+    damaged=after;damaged.events[0].packet.next=~0u;
+    check(!b::inserted(before,damaged,second,false,added),"missing append link refuses insertion");
+    r::Event event{};
+    check(!r::popped(image.memory(),Image::barrel,Image::cells+0x40,owner,event),"queued packet cannot masquerade as already popped");
+    image.put<unsigned>(Image::head,2);
+    check(r::popped(image.memory(),Image::barrel,Image::cells+0x40,owner,event)&&event.receipt.side==b::left,
+        "popped scope resolves exact native generation and payload");
+    check(!r::popped(image.memory(),Image::barrel,Image::cells+0x80,owner,event),"same ordinal is insufficient for wrong address");
+    check(r::popped(image.memory(),Image::barrel,Image::cells+0x40,owner,event),"left popped event recoverable after refusal");
+    const auto previous=event;
+    check(b::snapshot(image.memory(),Image::barrel,before)&&before.count==1,"continuation snapshots remaining queue");
+    auto retry=first;retry.progress=1;retry.next=2;image.packet(3,retry);image.put<unsigned>(Image::head,3);
+    check(b::snapshot(image.memory(),Image::barrel,after)&&b::inserted(before,after,retry,true,added)&&added.token==3,
+        "continuation prepends exact retry token");
+    auto forged=previous;forged.receipt.side=b::right;
+    check(!owner.continuation(forged,added),"forged retry hand cannot transfer paid receipt");
+    forged=previous;forged.receipt.cost++;
+    check(!owner.continuation(forged,added),"forged retry cost cannot transfer paid receipt");
+    check(owner.continuation(previous,added)&&!owner.find(1).receipt.valid&&owner.find(3).receipt.side==b::left,
+        "retry transfers existing receipt without another debit");
+    check(!owner.retire(previous),"old retry token no longer owns receipt");
+    image.put<unsigned>(Image::head,2);
+    check(r::popped(image.memory(),Image::barrel,Image::cells+0xc0,owner,event)&&event.receipt.side==b::left,
+        "retry can drain in the same native loop without a stale snapshot cursor");
+    check(owner.retire(event)&&!owner.retire(event),"successful retry retires once");
+    image.put<unsigned>(Image::head,~0u);
+    check(r::popped(image.memory(),Image::barrel,Image::cells+0x80,owner,event)&&event.receipt.side==b::right,
+        "other hand's queued shot survives retry drain");
+    image.mutate=Image::cells+0x80;image.reads=0;
+    check(!r::popped(image.memory(),Image::barrel,Image::cells+0x80,owner,event),"packet mutation during resolution refuses scope");
+    image.mutate=0;image.packet(2,second);
+    auto next=owner.begin(b::left,1,3,1,1,{29,29},0);
+    check(next.valid,"left ordinal advances independently of right");
+    const auto failed=owner.settle(next,true,nullptr);
+    check(failed.valid&&!failed.queued&&failed.side==b::left&&failed.cost==1,"allocation failure still accounts observed debit once");
+    check(!owner.settle(next,true,nullptr).valid,"allocation failure cannot settle twice");
+    const auto stale=owner.begin(b::left,2,3,1,1,{28,29},0);
+    auto replacement=key;++replacement.handle;owner.select(replacement);owner.select(key);
+    const auto current=owner.begin(b::left,0,3,1,1,{30,30},0);
+    check(current.valid&&!owner.settle(stale,true,nullptr).valid&&owner.busy,"generation cycle cannot reuse an old ticket");
+    check(!owner.settle(current,false,nullptr).valid&&!owner.busy,"verified unpaid refusal releases current transaction");
+    r::Book book;
+    for(unsigned i=0;i<8;++i){auto id=key;id.handle+=i;auto* o=book.slot(id);check(o!=nullptr,"bounded book allocates owner");o->busy=true;}
+    replacement=key;replacement.handle+=8;
+    check(!book.slot(replacement),"full book never evicts an in-flight debit");
+    book.owners[3].busy=false;check(book.slot(replacement)==&book.owners[3],"only inactive owner can be evicted");
+}
+void native_magazine_bridge() {
+    namespace r=b::runtime;namespace a=dawn::client::hooks::akimbo;
+    for(unsigned side:{b::left,b::right})for(unsigned loading:{0u,b::left,b::right})for(int count=0;count<=12;++count){
+        a::smg_ammo::State mag{};mag.native={0x50000,0x524e0,key.handle,key.owner,key.model};
+        mag.initialized=true;mag.capacity=30;mag.rounds[0]=count;mag.rounds[1]=12-count;mag.loading=loading;
+        r::Owner owner;owner.select(key);
+        r::Phase phase{};phase.native=mag.native;phase.side=side;phase.count=3;phase.revision=1;phase.qualified=true;
+        r::Transaction txn{};const std::array<int,2> before{mag.rounds[0],mag.rounds[1]};const auto i=side==b::left?0u:1u;
+        const bool expected=!(loading&side)&&mag.rounds[i]>0;
+        check(r::reserve(owner,mag,txn,phase,0,1,12)==expected,"production reserve uses selected hand capacity and reload state");
+        if(!expected){check(!mag.updating&&!owner.busy&&std::array<int,2>{mag.rounds[0],mag.rounds[1]}==before,"refused native check leaves both magazines untouched");continue;}
+        check(mag.updating&&owner.busy,"native callbacks run with concurrent reload publication blocked");
+        b::Queued queued{5,0x30000,{0,0,-1,0,0,0,0,0,~0u}};
+        check(r::settle(owner,mag,txn,11,true,&queued),"actual native one-round debit settles production transaction");
+        auto after=before;--after[i];
+        check(std::array<int,2>{mag.rounds[0],mag.rounds[1]}==after&&mag.total()==11&&!mag.updating&&!owner.busy,
+            "observed debit changes exactly one hand and agrees with native aggregate");
+        check(mag.loading==loading,"opposite reload survives native shot accounting");
+        check(!r::settle(owner,mag,txn,10,true,&queued)&&std::array<int,2>{mag.rounds[0],mag.rounds[1]}==after,"production settlement is once only");
+    }
+    a::smg_ammo::State mag{};mag.native={0x50000,0x524e0,key.handle,key.owner,key.model};
+    mag.initialized=true;mag.capacity=30;mag.rounds[0]=mag.rounds[1]=12;
+    r::Phase phase{};phase.native=mag.native;phase.side=b::left;phase.count=3;phase.revision=1;phase.qualified=true;
+    for(unsigned failure=0;failure<5;++failure){
+        auto candidate=mag;r::Owner owner;owner.select(key);r::Transaction txn{};
+        check(r::reserve(owner,candidate,txn,phase,0,1,24),"failure test reserves real production transaction");
+        if(failure==0){
+            check(r::settle(owner,candidate,txn,24,true,nullptr)&&candidate.rounds[0]==12&&candidate.rounds[1]==12&&!owner.failed,
+                "native unpaid refusal releases reservation without ammunition loss");
+        }else if(failure==1){
+            check(r::settle(owner,candidate,txn,23,true,nullptr)&&candidate.rounds[0]==11&&!owner.failed,
+                "allocation failure retains actual debit without fabricating emission receipt");
+        }else{
+            if(failure==4)++candidate.revision;
+            check(!r::settle(owner,candidate,txn,failure==2?22:23,failure!=3,nullptr)&&owner.failed,
+                "unexpected debit or stale ownership/revision blocks this owner");
+            check(candidate.initialized&&candidate.rounds[0]==12&&candidate.rounds[1]==12,"failed observation never replenishes or reinitializes a magazine");
+            check(!owner.begin(b::right,0,3,1,1,{12,12},0).valid,"failed owner cannot silently resume with ambiguous accounting");
+        }
+    }
+}
+void native_cost_expressions() {
+    namespace a=dawn::client::hooks::akimbo;
+    Image image;constexpr std::uintptr_t asset=Image::cells+0x40,barrel=Image::barrel+0xd70;
+    a::profiles::Barrel profile{};profile.coreTag=0x80000001;profile.coreSize=0x8000;profile.barrelDefinition=0x43b0;
+    image.put<std::uint64_t>(asset,profile.coreSize);image.put<unsigned>(asset+profile.barrelDefinition+0xd98,1);
+    for(unsigned i=0;i<2;++i){
+        const unsigned at=0x2480+i*0x30,definition=0x5150+i*0x60;
+        const std::array<unsigned,4> header{profile.coreTag,0x808089f6,definition,0};
+        const auto parent=-0x16a0-static_cast<std::int64_t>(i)*0x30;
+        image.put(asset+at,header);image.put(asset+at+16,parent);
+        image.put(asset+definition,std::array<unsigned,4>{profile.coreTag,0x808089f5,at,0});
+        const auto codeAt=asset+0x7000+i*0x80,constantsAt=codeAt+0x20;
+        image.put(asset+definition+0x10,std::array<std::uint64_t,2>{4,codeAt-asset-definition-0x28});
+        image.put(codeAt-16,std::array<std::uint64_t,2>{4,0x80800009});
+        image.put(codeAt,std::array<unsigned char,4>{0x34,0,0x3e,0});
+        image.put(asset+definition+0x20,std::array<std::uint64_t,2>{1,constantsAt-asset-definition-0x38});
+        image.put(constantsAt-16,std::array<std::uint64_t,2>{1,0x80800090});
+        image.put(constantsAt,std::array<float,4>{-1,-1,-1,-1});
+        image.put(asset+definition+0x50,std::array<std::uint64_t,2>{0,0x811c9dc5});
+        image.put(barrel+0x1690+i*0x30,header);image.put(barrel+0x1690+i*0x30+16,parent);
+    }
+    a::gun_cost::Expressions cost{};
+    check(a::gun_cost::qualify(image.memory(),profile,barrel,cost)
+        &&cost.debit==barrel+0x1690&&cost.required==barrel+0x16c0&&cost.fallback==1,
+        "cost evaluator accepts typed nested expressions at verified source offsets");
+    image.put<unsigned>(barrel+0x1694,0x808045c4);
+    check(!a::gun_cost::qualify(image.memory(),profile,barrel,cost)&&!cost.debit,"float property cannot be passed to expression evaluator");
+    image.put<unsigned>(barrel+0x1694,0x808089f6);image.put<unsigned>(barrel+0x1690,profile.coreTag+1);
+    check(!a::gun_cost::qualify(image.memory(),profile,barrel,cost),"wrong source owner refuses native callback");
+    image.put<unsigned>(barrel+0x1690,profile.coreTag);image.put<std::int64_t>(barrel+0x16d0,-0x16a0);
+    check(!a::gun_cost::qualify(image.memory(),profile,barrel,cost),"required expression must retain its own parent relationship");
+    image.put<std::int64_t>(barrel+0x16d0,-0x16d0);image.put<unsigned>(asset+0x5158,0x24b0);
+    check(!a::gun_cost::qualify(image.memory(),profile,barrel,cost),"definition must point back to matching expression instance");
+    image.put<unsigned>(asset+0x5158,0x2480);image.put<unsigned>(asset+profile.barrelDefinition+0xd98,2);
+    check(!a::gun_cost::qualify(image.memory(),profile,barrel,cost),"unqualified fallback cost cannot enter one-round accounting");
+    image.put<unsigned>(asset+profile.barrelDefinition+0xd98,1);image.put(asset+0x7020,std::array<float,4>{2,2,2,2});
+    check(!a::gun_cost::qualify(image.memory(),profile,barrel,cost),"source multi-cost expression is rejected before native evaluator or debit");
+    image.put(asset+0x7020,std::array<float,4>{-1,-1,-1,-1});image.put(asset+0x7000,std::array<unsigned char,4>{0x3c,0,0x3e,0});
+    check(!a::gun_cost::qualify(image.memory(),profile,barrel,cost),"charge-dependent expression cannot pass on an earlier unit-cost sample");
+    image.put(asset+0x7000,std::array<unsigned char,4>{0x34,0,0x3e,0});image.put<std::uint64_t>(asset+0x5190,1);
+    check(!a::gun_cost::qualify(image.memory(),profile,barrel,cost),"auxiliary expression input cannot alter constant unit-cost contract");
+    for(float debit:{-1.f,1.f})for(float required:{-1.f,1.f})
+        check(a::gun_cost::unit(debit,required,1),"native exact one or minus-one fallback remains supported");
+    for(float value:{0.f,-.25f,.5f,1.25f,2.f,100.f,std::numeric_limits<float>::quiet_NaN(),std::numeric_limits<float>::infinity()}){
+        check(!a::gun_cost::unit(value,1.f,1),"non-unit debit cannot charge wrong hand through aggregate backing");
+        check(!a::gun_cost::unit(1.f,value,1),"non-unit required value requires pre-debit transaction");
+    }
+    check(!a::gun_cost::unit(-1.f,-1.f,2),"fallback itself must remain unit cost");
+}
