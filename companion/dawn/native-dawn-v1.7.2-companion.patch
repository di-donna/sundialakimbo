+            leftGrip=compose(inverse(p[72]),p[23]);rightGrip=compose(inverse(p[72]),p[24]);
+            const Frame inverseLeft=inverse(p[23]),inverseRight=inverse(p[24]);
+            for(unsigned i=0;i<22;++i){
+                leftHandRest[i]=compose(inverseLeft,p[leftArm[i]]);
+                rightHandRest[i]=compose(inverseRight,p[rightArm[i]]);
+            }
+            neutralReady=true;sampleAt=now;
+        }
+        if(hasShot&&!neutralReady){
+            neutral=restNeutral;leftGrip=restLeftGrip;rightGrip=restRightGrip;
+            leftHandRest=restLeftArm;rightHandRest=restRightArm;
+            neutralReady=true;sampleAt=now;
+        }
+        if(!hasShot||!neutralReady||now<sampleAt)return false;
+        const Frame hold=compose(inverse(alignment),compose(p[0],neutral));
+        const Frame quiet=blend(p[72],hold,weight);
+        // The firing gun's root: native, or for Thorn pulled part-way back to
+        // the hold; the pull fades with the idle recovery so native resumes.
+        const Frame shot=profiles::is(id.modelTag,profiles::Adapter::thorn)?blend(p[72],hold,(1-thornRecoilKeep)*weight):p[72];
+        const Vec displacement=add(quiet.p,mul(p[72].p,-1));
+        if(displacement.x*displacement.x+displacement.y*displacement.y+displacement.z*displacement.z>.25f)return false;
+        // A root delta alone preserves native wrist-to-gun drift, which is
+        // reflected differently for the left hand. Constrain both grips to
+        // their chosen gun root, carrying each complete arm/finger group with
+        // its grip. The active hand keeps its native wrist/finger animation.
+        // A rigid delta alone leaves that local firing motion on the quiet
+        // hand too; hold its calibrated articulation relative to its selected
+        // grip. Shared camera/common-root movement still follows the gun.
+        const Frame targetRight=compose(shotLeft?quiet:shot,blend(compose(inverse(p[72]),p[24]),rightGrip,weight));
+        const Frame targetLeft=compose(shotLeft?shot:quiet,blend(compose(inverse(p[72]),p[23]),leftGrip,weight));
+        const Frame rightDelta=compose(targetRight,inverse(p[24]));
+        const Frame leftDelta=compose(targetLeft,inverse(p[23]));
+        for(unsigned i=0;i<22;++i){
+            const Frame right=compose(rightDelta,p[rightArm[i]]);
+            const Frame left=compose(leftDelta,p[leftArm[i]]);
+            p[rightArm[i]]=shotLeft?blend(right,compose(targetRight,rightHandRest[i]),weight):right;
+            p[leftArm[i]]=shotLeft?left:blend(left,compose(targetLeft,leftHandRest[i]),weight);
+        }
+        Frame rightRoot=shotLeft?quiet:shot;
+        Frame leftRoot=shotLeft?shot:quiet;
+        if(releases_outgoing_hand(id.modelTag)&&released.valid&&released.left!=shotLeft){
+            if(now<released.at)return false;
+            const float retain=1-smoothstep(static_cast<float>(now-released.at)/180.f);
+            if(retain>0){
+                const Frame previousRoot=compose(inverse(alignment),compose(p[0],released.root));
+                if(!valid(previousRoot))return false;
+                auto& gun=released.left?leftRoot:rightRoot;
+                const Frame grip=p[released.left?23:24],inverseGrip=inverse(grip);
+                const Frame localGrip=blend(compose(inverse(gun),grip),released.grip,retain);
+                gun=blend(gun,previousRoot,retain);
+                const Frame targetGrip=compose(gun,localGrip);
+                const auto* bones=released.left?leftArm:rightArm;
+                for(unsigned i=0;i<22;++i)
+                    p[bones[i]]=compose(targetGrip,blend(compose(inverseGrip,p[bones[i]]),released.fingers[i],retain));
+            }else released={};
+        }
+        HandRecovery next{};
+        if(releases_outgoing_hand(id.modelTag)){
+            const auto& gun=shotLeft?leftRoot:rightRoot;
+            const auto grip=p[shotLeft?23:24];
+            next={true,shotLeft,now,compose(inverse(p[0]),compose(alignment,gun)),
+                  compose(inverse(gun),grip),{}};
+            const auto* bones=shotLeft?leftArm:rightArm;
+            for(unsigned i=0;i<22;++i)next.fingers[i]=compose(inverse(grip),p[bones[i]]);
+        }
+        rightRoot.scale*=marker;leftRoot.scale*=marker;
+        p[75]=compose(rightRoot,weaponBind3);
+        p[72+alternating_left_bone(id.modelTag)]=compose(leftRoot,profiles::is(id.modelTag,profiles::Adapter::malfeasance)?weaponBind4:weaponBind5);
+        for(const auto& f:p)if(!valid(f))return false;
+        if(next.valid)rendered=next;
+        std::memcpy(data,p.data(),poseCount*sizeof(Frame));return true;
+    }
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/binding_descriptor.cpp b/Dawn/src/client/hooks/akimbo/binding_descriptor.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..891f0857621ef67a1204e3ac5517eeae5793f182
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/binding_descriptor.cpp
@@ -0,0 +1,222 @@
+#include "binding_descriptor.h"
+#include "akimbo.h"
+#include "firing_effects.h"
+#include "../../../core/provenance/build_provenance.h"
+#include "../../../core/logging/log.h"
+#include <Windows.h>
+#include <string>
+#include <cstdio>
+
+namespace dawn::client::hooks::akimbo::bindings {
+namespace {
+Descriptor pending{};
+std::array<HANDLE,kMaximumPackages+kMaximumSources+3> held{};
+std::size_t heldCount{};
+std::wstring root,transactionPath;
+Digest descriptorDigest{},publishedDescriptor{};
+bool prepared{},present{},everPublished{},active{};
+
+void release_files() noexcept {
+    for(std::size_t i=0;i<heldCount;++i) if(held[i]) (void)CloseHandle(held[i]);
+    held={};heldCount=0;
+}
+bool fail(std::string_view reason) noexcept {
+    core::log::write(core::log::Channel::client,core::log::Level::error,reason);
+    prepared=false;present=false;if(!active)release_files();return false;
+}
+bool module_path(HMODULE module,std::wstring& path) {
+    std::array<wchar_t,32768> buffer{};
+    const DWORD length=GetModuleFileNameW(module,buffer.data(),static_cast<DWORD>(buffer.size()));
+    if(!length||length>=buffer.size())return false;path.assign(buffer.data(),length);return true;
+}
+bool absent(const std::wstring& path) noexcept {
+    if(GetFileAttributesW(path.c_str())!=INVALID_FILE_ATTRIBUTES)return false;
+    const DWORD error=GetLastError();return error==ERROR_FILE_NOT_FOUND||error==ERROR_PATH_NOT_FOUND;
+}
+HANDLE lock_file(const std::wstring& path) noexcept {
+    if(heldCount==held.size())return INVALID_HANDLE_VALUE;
+    const HANDLE handle=CreateFileW(path.c_str(),GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,
+        FILE_ATTRIBUTE_NORMAL|FILE_FLAG_OPEN_REPARSE_POINT|FILE_FLAG_SEQUENTIAL_SCAN,nullptr);
+    if(handle==INVALID_HANDLE_VALUE)return handle;
+    BY_HANDLE_FILE_INFORMATION info{};
+    if(!GetFileInformationByHandle(handle,&info)||(info.dwFileAttributes&(FILE_ATTRIBUTE_REPARSE_POINT|FILE_ATTRIBUTE_DIRECTORY))){
+        (void)CloseHandle(handle);return INVALID_HANDLE_VALUE;
+    }
+    held[heldCount++]=handle;return handle;
+}
+bool hash_locked(const std::wstring& path,const Digest& expected) noexcept {
+    if(lock_file(path)==INVALID_HANDLE_VALUE)return false;
+    Digest actual{};return core::provenance::file_sha256(path.c_str(),actual)&&actual==expected;
+}
+bool locked_package_id(std::uint16_t& id) noexcept {
+    if(!heldCount)return false;
+    LARGE_INTEGER offset{};offset.QuadPart=4;
+    std::array<unsigned char,2> bytes{};DWORD read{};
+    if(!SetFilePointerEx(held[heldCount-1],offset,nullptr,FILE_BEGIN)
+        ||!ReadFile(held[heldCount-1],bytes.data(),2,&read,nullptr)||read!=2)return false;
+    id=static_cast<std::uint16_t>(bytes[0]|(static_cast<unsigned>(bytes[1])<<8));return true;
+}
+std::wstring artifact_path(const Artifact& artifact) {
+    std::wstring path=root;path.push_back(L'\\');
+    for(const char c:artifact.name())path.push_back(c=='/'?L'\\':static_cast<wchar_t>(c));
+    return path;
+}
+bool no_transaction() noexcept {return !transactionPath.empty()&&absent(transactionPath);}
+bool complete_package_inventory(std::span<const std::uint16_t> protectedIds) {
+    WIN32_FIND_DATAW entry{};
+    const HANDLE search=FindFirstFileW((root+L"\\packages\\*.pkg").c_str(),&entry);
+    if(search==INVALID_HANDLE_VALUE)return false;
+    bool valid=true;std::size_t count{};
+    do {
+        if(++count>16384){valid=false;break;}
+        if(entry.dwFileAttributes&FILE_ATTRIBUTE_DIRECTORY)continue;
+        const std::wstring path=root+L"\\packages\\"+entry.cFileName;
+        const HANDLE file=CreateFileW(path.c_str(),GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,
+            FILE_ATTRIBUTE_NORMAL|FILE_FLAG_OPEN_REPARSE_POINT,nullptr);
+        if(file==INVALID_HANDLE_VALUE){valid=false;break;}
+        std::array<unsigned char,6> header{};DWORD got{};
+        const bool read=ReadFile(file,header.data(),static_cast<DWORD>(header.size()),&got,nullptr)&&got==header.size();
+        (void)CloseHandle(file);
+        if(!read){valid=false;break;}
+        const auto id=static_cast<std::uint16_t>(header[4]|(static_cast<unsigned>(header[5])<<8));
+        if(std::find(protectedIds.begin(),protectedIds.end(),id)==protectedIds.end())continue;
+        if(entry.dwFileAttributes&FILE_ATTRIBUTE_REPARSE_POINT){valid=false;break;}
+        std::string relative="packages/";
+        for(const auto* c=entry.cFileName;*c;++c){if(*c>127){valid=false;break;}relative.push_back(static_cast<char>(*c));}
+        if(!valid)break;
+        bool found=false;
+        for(std::size_t i=0;i<pending.packageCount;++i)found|=equal_path(relative,pending.packages[i].name());
+        for(std::size_t i=0;i<pending.sourceCount;++i)found|=equal_path(relative,pending.sources[i].name());
+        if(!found){valid=false;break;}
+    } while(FindNextFileW(search,&entry));
+    if(valid&&GetLastError()!=ERROR_NO_MORE_FILES)valid=false;
+    (void)FindClose(search);return valid;
+}
+std::array<std::uint16_t,kMaximumPackages+kMaximumSources> packageIds{};
+} // namespace
+
+bool prepare(void* runtimeModule) noexcept {
+    try {
+        if(prepared)return no_transaction();
+        release_files();present=false;
+        std::wstring executablePath,runtimePath;
+        if(!runtimeModule||!module_path(nullptr,executablePath)
+            ||!module_path(static_cast<HMODULE>(runtimeModule),runtimePath))
+            return fail("ev=akimbo_bindings stage=prepare result=fail reason=module_path");
+        const auto slash=executablePath.find_last_of(L"\\/");
+        if(slash==executablePath.npos)return fail("ev=akimbo_bindings stage=prepare result=fail reason=game_root");
+        root=executablePath.substr(0,slash);
+        const auto packages=root+L"\\packages";
+        transactionPath=packages+L"\\.parhelion-install-transaction.json";
+        if(!no_transaction())return fail("ev=akimbo_bindings stage=prepare result=fail reason=pending_transaction");
+        const auto path=packages+L"\\parhelion-akimbo-bindings.json";
+        if(absent(path)){
+            if(everPublished)return fail("ev=akimbo_bindings stage=prepare result=fail reason=published_generation_removed");
+            prepared=true;return true;
+        }
+        const auto directoryAttributes=GetFileAttributesW(packages.c_str());
+        if(directoryAttributes==INVALID_FILE_ATTRIBUTES||!(directoryAttributes&FILE_ATTRIBUTE_DIRECTORY)
+            ||(directoryAttributes&FILE_ATTRIBUTE_REPARSE_POINT))
+            return fail("ev=akimbo_bindings stage=prepare result=fail reason=package_directory");
+        const HANDLE file=lock_file(path);
+        LARGE_INTEGER size{};
+        if(file==INVALID_HANDLE_VALUE||!GetFileSizeEx(file,&size)||size.QuadPart<=0||size.QuadPart>kMaximumBytes)
+            return fail("ev=akimbo_bindings stage=prepare result=fail reason=descriptor_size");
+        std::string text(static_cast<std::size_t>(size.QuadPart),'\0');DWORD got{};
+        if(!ReadFile(file,text.data(),static_cast<DWORD>(text.size()),&got,nullptr)||got!=text.size()
+            ||!Parser(text).parse(pending))
+            return fail("ev=akimbo_bindings stage=prepare result=fail reason=descriptor_schema");
+        for(std::size_t i=0;i<pending.profileCount;++i)
+            if((pending.profiles[i].adapter!=profiles::Adapter::ikelos&&!profiles::generic(pending.profiles[i].adapter))
+                ||!firing_effects::compatible_generated_visual(pending.profiles[i].visual))
+                return fail("ev=akimbo_bindings stage=prepare result=fail reason=unsupported_generated_adapter_or_visual");
+        if(!core::provenance::file_sha256(path.c_str(),descriptorDigest)
+            ||(everPublished&&descriptorDigest!=publishedDescriptor))
+            return fail("ev=akimbo_bindings stage=prepare result=fail reason=generation_replacement");
+        if(!hash_locked(runtimePath,pending.runtime)||!hash_locked(executablePath,pending.executable))
+            return fail("ev=akimbo_bindings stage=prepare result=fail reason=host_hash");
+        packageIds={};
+        for(std::size_t i=0;i<pending.packageCount;++i){
+            if(!hash_locked(artifact_path(pending.packages[i]),pending.packages[i].digest))
+                return fail("ev=akimbo_bindings stage=prepare result=fail reason=package_hash");
+            if(!locked_package_id(packageIds[i]))
+                return fail("ev=akimbo_bindings stage=prepare result=fail reason=package_header");
+        }
+        for(std::size_t i=0;i<pending.sourceCount;++i){
+            if(!hash_locked(artifact_path(pending.sources[i]),pending.sources[i].digest))
+                return fail("ev=akimbo_bindings stage=prepare result=fail reason=source_hash");
+            if(!locked_package_id(packageIds[pending.packageCount+i]))
+                return fail("ev=akimbo_bindings stage=prepare result=fail reason=source_header");
+        }
+        const auto covered=[&](std::uint32_t tag,std::size_t count) noexcept {
+            if(tag<0x80800000u||tag==0xffffffff)return false;
+            const auto id=static_cast<std::uint16_t>((tag-0x80800000u)>>13);
+            for(std::size_t j=0;j<count;++j)if(packageIds[j]==id)return true;
+            return false;
+        };
+        const auto referenced=[&](std::uint32_t tag) noexcept {return covered(tag,pending.packageCount+pending.sourceCount);};
+        for(std::size_t i=0;i<pending.profileCount;++i){
+            const auto& profile=pending.profiles[i];
+            if(!covered(profile.modelTag,pending.packageCount))
+                return fail("ev=akimbo_bindings stage=prepare result=fail reason=model_outside_artifacts");
+            if(profile.adapter==profiles::Adapter::finiteBurst&&!covered(profile.barrel.coreTag,pending.packageCount))
+                return fail("ev=akimbo_bindings stage=prepare result=fail reason=burst_core_outside_artifacts");
+            if(!referenced(profile.barrel.coreTag)||!referenced(profile.barrel.contentTag)
+                ||!referenced(profile.binding.animation)||!referenced(profile.binding.skeleton)||!referenced(profile.binding.rig)
+                ||(profile.barrel.projectile!=0xffffffff&&!referenced(profile.barrel.projectile)))
+                return fail("ev=akimbo_bindings stage=prepare result=fail reason=unbound_profile_source");
+            if(profile.adapter==profiles::Adapter::ikelos||profiles::generic(profile.adapter)){
+                const auto& visual=profile.visual;
+                if(!referenced(visual.tracerTag)||!referenced(visual.fx.tag))
+                    return fail("ev=akimbo_bindings stage=prepare result=fail reason=unbound_visual_source");
+                for(std::size_t j=0;j<visual.fx.count;++j)
+                    if(!referenced(visual.fx.selectors[j].particle)||!referenced(visual.fx.selectors[j].program))
+                        return fail("ev=akimbo_bindings stage=prepare result=fail reason=unbound_selector_source");
+            }
+        }
+        if(!complete_package_inventory({packageIds.data(),pending.packageCount+pending.sourceCount}))
+            return fail("ev=akimbo_bindings stage=prepare result=fail reason=unpinned_package_chain");
+        if(!no_transaction())return fail("ev=akimbo_bindings stage=prepare result=fail reason=pending_transaction");
+        present=true;prepared=true;
+        core::log::write(core::log::Channel::client,core::log::Level::info,
+            "ev=akimbo_bindings stage=prepare result=ok state=awaiting_native_hook_signatures");
+        return true;
+    } catch(...) {
+        return fail("ev=akimbo_bindings stage=prepare result=fail reason=allocation");
+    }
+}
+bool activate() noexcept {
+    if(!prepared||!no_transaction())return fail("ev=akimbo_bindings stage=activate result=fail reason=unprepared_or_transaction");
+    if(!present)return true;
+    try {
+        if(!complete_package_inventory({packageIds.data(),pending.packageCount+pending.sourceCount}))
+            return fail("ev=akimbo_bindings stage=activate result=fail reason=unpinned_package_chain");
+    } catch(...) {return fail("ev=akimbo_bindings stage=activate result=fail reason=allocation");}
+    // install() verifies the fixed-build image and all22 hook signatures before
+    // committing its detour transaction. No generated model is active before it.
+    if(!akimbo::install())return fail("ev=akimbo_bindings stage=activate result=fail reason=native_signatures");
+    active=true;
+    if(!everPublished){
+        if(profiles::generated.publish(pending.schema,pending.build,{pending.profiles.data(),pending.profileCount})
+            !=profiles::PublishResult::published)
+            return fail("ev=akimbo_bindings stage=activate result=fail reason=registry_publication");
+        publishedDescriptor=descriptorDigest;everPublished=true;
+    }
+    core::log::write(core::log::Channel::client,core::log::Level::info,
+        "ev=akimbo_bindings stage=activate result=ok state=published");
+    for(std::size_t i=0;i<pending.profileCount;++i){
+        const auto& profile=pending.profiles[i];char line[192]{};
+        (void)std::snprintf(line,sizeof(line),
+            "ev=akimbo_bindings stage=profile result=ok model=%08X adapter=%u core=%08X content=%08X variant=%u gap_mm=%u reload_policy=%u",
+            profile.modelTag,static_cast<unsigned>(profile.adapter),profile.barrel.coreTag,
+            profile.barrel.contentTag,profile.barrel.variant,profile.gapMillimeters,profile.reloadPolicy);
+        core::log::write(core::log::Channel::client,core::log::Level::info,line);
+    }
+    return true;
+}
+void shutdown() noexcept {
+    // The registry itself intentionally survives: a reinitialization must prove
+    // the same descriptor again; live generated-profile replacement is forbidden.
+    prepared=false;present=false;active=false;release_files();
+}
+} // namespace dawn::client::hooks::akimbo::bindings
diff --git a/Dawn/src/client/hooks/akimbo/binding_descriptor.h b/Dawn/src/client/hooks/akimbo/binding_descriptor.h
new file mode 100644
index 0000000000000000000000000000000000000000..bc66d508ada9548ede262a2251cbac66baacab57
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/binding_descriptor.h
@@ -0,0 +1,215 @@
+#pragma once
+#include "profile_registry.h"
+#include <algorithm>
+#include <charconv>
+#include <string_view>
+
+namespace dawn::client::hooks::akimbo::bindings {
+inline constexpr std::size_t kMaximumBytes=256*1024;
+inline constexpr std::size_t kMaximumPackages=64,kMaximumSources=512;
+using Digest=std::array<std::byte,32>;
+struct Artifact {
+    std::array<char,256> path{};
+    std::size_t length{};
+    Digest digest{};
+    [[nodiscard]] std::string_view name() const noexcept {return {path.data(),length};}
+};
+struct Descriptor {
+    std::uint32_t schema{},build{};
+    std::array<std::byte,16> generation{};
+    Digest runtime{},executable{};
+    std::array<Artifact,kMaximumPackages> packages{};
+    std::array<Artifact,kMaximumSources> sources{};
+    std::array<profiles::Registration,profiles::kGeneratedLimit> profiles{};
+    std::size_t packageCount{},sourceCount{},profileCount{};
+};
+[[nodiscard]] inline bool package_path(std::string_view path) noexcept {
+    if(path.size()>=256||!path.starts_with("packages/")||!path.ends_with(".pkg")) return false;
+    const auto name=path.substr(9);
+    if(name.size()<5||name.front()=='.'||name.find("..")!=name.npos) return false;
+    for(const char c:name) if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'||c=='-'||c=='.')) return false;
+    return true;
+}
+[[nodiscard]] inline bool equal_path(std::string_view left,std::string_view right) noexcept {
+    if(left.size()!=right.size()) return false;
+    const auto lower=[](char c){return c>='A'&&c<='Z'?static_cast<char>(c-'A'+'a'):c;};
+    for(std::size_t i=0;i<left.size();++i) if(lower(left[i])!=lower(right[i])) return false;
+    return true;
+}
+class Parser final {
+    std::string_view text_;
+    std::size_t at_{};
+    void space() noexcept {while(at_<text_.size()&&(text_[at_]==' '||text_[at_]=='\r'||text_[at_]=='\n'||text_[at_]=='\t')) ++at_;}
+    bool take(char c) noexcept {space();if(at_==text_.size()||text_[at_]!=c)return false;++at_;return true;}
+    bool string(std::string_view& out) noexcept {
+        if(!take('"'))return false;const auto start=at_;
+        while(at_<text_.size()){
+            const auto c=static_cast<unsigned char>(text_[at_++]);
+            if(c=='"'){out=text_.substr(start,at_-start-1);return true;}
+            // All schema strings are ASCII identifiers, hex or bounded filenames.
+            // Escapes are unnecessary and deliberately not accepted.
+            if(c<32||c>126||c=='\\')return false;
+        }
+        return false;
+    }
+    bool number(std::uint32_t& out) noexcept {
+        space();const auto start=at_;
+        while(at_<text_.size()&&text_[at_]>='0'&&text_[at_]<='9')++at_;
+        if(at_==start||(at_-start>1&&text_[start]=='0'))return false;
+        const auto parsed=std::from_chars(text_.data()+start,text_.data()+at_,out);
+        return parsed.ec==std::errc{}&&parsed.ptr==text_.data()+at_;
+    }
+    template<std::size_t N> bool hex(std::array<std::byte,N>& out) noexcept {
+        std::string_view s;if(!string(s)||s.size()!=N*2)return false;
+        const auto digit=[](char c)->int {if(c>='0'&&c<='9')return c-'0';if(c>='A'&&c<='F')return c-'A'+10;if(c>='a'&&c<='f')return c-'a'+10;return -1;};
+        for(std::size_t i=0;i<N;++i){const auto high=digit(s[2*i]),low=digit(s[2*i+1]);if(high<0||low<0)return false;out[i]=static_cast<std::byte>((high<<4)|low);}
+        return true;
+    }
+    template<class F> bool object(F&& field) noexcept {
+        if(!take('{'))return false;if(take('}'))return true;
+        for(;;){std::string_view key;if(!string(key)||!take(':')||!field(key))return false;if(take('}'))return true;if(!take(','))return false;}
+    }
+    static bool once(unsigned& mask,unsigned bit) noexcept {if(mask&bit)return false;mask|=bit;return true;}
+    bool artifact(Artifact& out) noexcept {
+        unsigned fields{};
+        const bool ok=object([&](std::string_view key){
+            if(key=="path"){
+                std::string_view path;if(!once(fields,1)||!string(path)||!package_path(path))return false;
+                out.length=path.size();std::copy(path.begin(),path.end(),out.path.begin());return true;
+            }
+            return key=="sha256"&&once(fields,2)&&hex(out.digest);
+        });
+        return ok&&fields==3;
+    }
+    template<std::size_t N> bool artifacts(std::array<Artifact,N>& out,std::size_t& count) noexcept {
+        if(!take('['))return false;if(take(']'))return true;
+        for(;;){if(count==N||!artifact(out[count]))return false;++count;if(take(']'))return true;if(!take(','))return false;}
+    }
+    bool rig(profiles::RigBinding& out) noexcept {
+        unsigned mask{};const bool ok=object([&](std::string_view key){
+            if(key=="animation_tag")return once(mask,1)&&number(out.animation);
+            if(key=="skeleton_tag")return once(mask,2)&&number(out.skeleton);
+            return key=="rig_tag"&&once(mask,4)&&number(out.rig);
+        });return ok&&mask==7;
+    }
+    bool barrel(profiles::Barrel& out) noexcept {
+        constexpr std::array<std::string_view,11> keys{"core_tag","content_tag","content_definition","root_definition","barrel_definition","core_size","variant","projectile","content_size","property_count","flags"};
+        const std::array<std::uint32_t*,11> values{&out.coreTag,&out.contentTag,&out.contentDefinition,&out.rootDefinition,&out.barrelDefinition,&out.coreSize,&out.variant,&out.projectile,&out.contentSize,&out.propertyCount,&out.flags};
+        unsigned mask{};const bool ok=object([&](std::string_view key){for(unsigned i=0;i<keys.size();++i)if(key==keys[i])return once(mask,1u<<i)&&number(*values[i]);return false;});
