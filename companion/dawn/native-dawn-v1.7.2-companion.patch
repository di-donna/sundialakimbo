+    auto released=accepted;released.held=0;released.edge=1;released.feedback=0;
+    f.apply(t::plan(f.pins,fired,released));check(f.view(fired)&&bank.finish(left,f.pins,fired),"native release can rearm without clearing pending burst");
+    check(bank.lanes[0].request==2&&!bank.lanes[1].request,"request state remains hand owned after release");
+    auto moved=f.pins;moved.root+=0x40000;check(bank.relocate(moved,fired),"qualified logical relocation preserves trigger histories");
+    check(!bank.begin(f.pins,fired,b::left).valid,"old physical address cannot lease after relocation");
+    auto current=bank.begin(moved,fired,b::left);check(current.valid&&current.mount==released,"relocated lane retains edge and request state");
+    auto changed=moved;++changed.key.handle;check(!bank.relocate(changed,fired),"different generation cannot inherit trigger bank");
+    check(bank.abort(current,fired),"unmounted exact lease may abort");
+    auto invalid=initial;invalid.config.aimSelector=2;check(!t::plan(before.pins,invalid,accepted).valid,"invalid configuration cannot emit writes");
+    // Exactly seven scalar writes: no input buffer, unknown bytes, phase clock,
+    // global shot epoch or queue token is present in the plan.
+    const auto plan=t::plan(before.pins,initial,accepted);const std::array<std::size_t,7> widths{1,1,8,4,1,2,4};
+    const std::array<std::uintptr_t,7> addresses{before.pins.root+t::triggerOffset+0xe0,before.pins.root+t::triggerOffset+0xf8,
+        before.pins.root+t::triggerOffset+0x100,before.pins.root+t::triggerOffset+0x10c,before.pins.root+t::triggerOffset+0x110,
+        before.pins.root+t::barrelOffset+0xf50,before.pins.root+t::barrelOffset+0xf54};
+    for(unsigned i=0;i<7;++i)check(plan.writes[i].address==addresses[i]&&plan.writes[i].bytes==widths[i],"patch plan touches only proven lane scalar fields");
+}
+void phase_request_tests(){
+    for(unsigned side:{b::left,b::right})for(std::uint16_t pending:std::array<std::uint16_t,4>{0,2,4,6}){
+        Fixture f;t::View view{};check(f.view(view),"phase fixture readable");t::Bank bank;check(bank.initialize(f.pins,view),"phase bank initialized");
+        for(unsigned lane:{b::left,b::right}){
+            const auto lease=bank.begin(f.pins,view,lane);check(lease.valid,"seed trigger callback owns one lane");
+            auto accepted=lease.mount;accepted.held=1;accepted.edge=0;accepted.request=lane==side?pending:6;
+            f.apply(t::plan(f.pins,view,accepted));check(f.view(view)&&bank.finish(lease,f.pins,view),"trigger result retained before phase callback");
+        }
+        const auto phase=bank.begin_phase(f.pins,view,side);
+        check(phase.valid&&phase.phase&&phase.mount.request==pending,"phase borrows selected durable trigger request");
+        check(!bank.begin(f.pins,view,b::left).valid&&!bank.begin_phase(f.pins,view,b::right).valid,"phase and trigger callbacks share exclusion");
+        const auto mount=t::request_plan(f.pins,view,phase.mount.request,phase.mount.charge);
+        check(mount.valid&&mount.count==2&&mount.writes[0].address==f.pins.root+t::barrelOffset+0xf50
+            &&mount.writes[1].address==f.pins.root+t::barrelOffset+0xf54,"phase mounts exactly request flags and charge");
+        const auto previous=view;f.apply(mount);check(f.view(view),"phase request mount readable");
+        // Native CD0530 selector1 or CBF240 can clear the pending request.
+        const auto barrel=f.pins.root+t::barrelOffset;
+        f.put<std::uint16_t>(barrel+0xf50,static_cast<std::uint16_t>((view.barrelFlags&~t::requestMask)|0x40));
+        check(f.view(view)&&!bank.finish(phase,f.pins,view)&&bank.finish_phase(phase,f.pins,view),"only phase publication may settle request-only callback");
+        check(!bank.finish_phase(phase,f.pins,view),"phase result cannot publish twice");
+        const auto index=side==b::left?0u:1u;
+        check(!bank.lanes[index].request&&bank.lanes[1-index].request==6,"native clear updates one durable bank and preserves opposite request");
+        const auto next=bank.begin(f.pins,view,side);
+        check(next.valid&&!next.mount.request&&next.mount.held&&next.mount.edge==0,"next trigger callback cannot resurrect cleared semi-auto request");
+        check(bank.abort(next,view),"unmounted trigger lease aborts");
+        const auto changed=bank.begin_phase(f.pins,view,side);check(changed.valid,"next phase lease acquired");
+        auto unexpected=view;unexpected.lane.edge^=1;
+        check(!bank.finish_phase(changed,f.pins,unexpected),"phase cannot silently change native trigger latch");
+        auto relocated=f.pins;relocated.root+=0x10000;
+        check(!bank.finish_phase(changed,relocated,view),"mid-callback physical relocation refuses phase publication");
+        check(bank.abort(changed,view),"unchanged native state permits explicit phase abort");
+        check(view.lane.held==previous.lane.held&&view.lane.edge==previous.lane.edge
+            &&view.lane.feedbackUntil==previous.lane.feedbackUntil,"phase kept resident trigger-local state unchanged");
+    }
+}
+void aggregate_request_tests(){
+    for(std::uint16_t left:std::array<std::uint16_t,4>{0,2,4,6})for(std::uint16_t right:std::array<std::uint16_t,4>{0,2,4,6})
+        for(unsigned lf=0;lf<8;++lf)for(unsigned rf=0;rf<8;++rf){
+            Fixture f;t::View view{};check(f.view(view),"aggregate fixture readable");t::Bank bank;
+            check(bank.initialize(f.pins,view),"aggregate bank initialized");
+            for(unsigned side=1;side<=2;++side){
+                auto lease=bank.begin(f.pins,view,side);check(lease.valid,"seed aggregate durable lane");
+                auto accepted=lease.mount;accepted.request=side==1?left:right;accepted.edge=0;accepted.held=1;
+                f.apply(t::plan(f.pins,view,accepted));check(f.view(view)&&bank.finish(lease,f.pins,view),"seed aggregate native snapshot");
+            }
+            const auto before=bank.lanes;
+            auto lease=bank.begin_aggregate(f.pins,view,{static_cast<std::uint8_t>(lf),static_cast<std::uint8_t>(rf)});
+            const auto l=static_cast<std::uint16_t>(left&(lf?~2u:~0u));
+            const auto r=static_cast<std::uint16_t>(right&(rf?~2u:~0u));
+            check(lease.valid&&lease.after.request==(l|r),"native output clears the emitting hand before physical union");
+            check(!bank.begin(f.pins,view,1).valid&&!bank.begin_phase(f.pins,view,2).valid,"aggregate publication excludes trigger and phase callbacks");
+            check(bank.lanes==before,"durable requests remain uncommitted until native aggregate writes qualify");
+            f.apply(t::request_plan(f.pins,view,lease.after.request,lease.after.charge));
+            check(f.view(view)&&bank.finish_aggregate(lease,f.pins,view),"physical union publishes once");
+            check(bank.lanes[0].request==l&&bank.lanes[1].request==r,"physical aggregate cannot contaminate either hand");
+            check(bank.lanes[0].edge==before[0].edge&&bank.lanes[1].held==before[1].held,"aggregate keeps independent native trigger histories");
+            check(!bank.finish_aggregate(lease,f.pins,view),"stale aggregate cannot republish");
+            for(unsigned side=1;side<=2;++side){const auto next=bank.begin_phase(f.pins,view,side);
+                check(next.valid&&next.mount.request==(side==1?l:r),"next phase sees its own request, not physical OR");
+                check(bank.abort(next,view),"unmounted phase lease aborts exactly");}
+        }
+    Fixture f;t::View view{};check(f.view(view),"bad aggregate fixture");t::Bank bank;check(bank.initialize(f.pins,view),"bad aggregate init");
+    check(!bank.begin_aggregate(f.pins,view,{8,0}).valid,"unknown native output flags refuse");
+    auto lease=bank.begin_aggregate(f.pins,view,{0,0});check(lease.valid,"aggregate failure lease");
+    auto changed=view;changed.lane.edge^=1;check(!bank.finish_aggregate(lease,f.pins,changed),"aggregate cannot overwrite changed native trigger history");
+    auto moved=f.pins;moved.root+=0x10000;check(!bank.finish_aggregate(lease,moved,view),"aggregate rejects stale physical storage");
+    check(bank.abort_aggregate(lease,view),"unmodified aggregate can abort without fake rollback");
+}
+}
+int main(){input_tests();read_tests();bank_and_plan_tests();phase_request_tests();aggregate_request_tests();std::printf("akimbo burst trigger: %u checks passed\n",checks);}
