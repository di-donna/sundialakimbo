@@ -0,0 +1,96 @@
+#pragma once
+#include "burst.h"
+#include <cmath>
+#include <cstddef>
+
+namespace dawn::client::hooks::akimbo::burst_phase {
+// Storage/transaction primitive only; not installed. Native FFB10E31 advances
+// more than these fields. Its caller must isolate shared property updates and
+// qualify the additional 1708/170C state before mounting two timing histories.
+// In particular 1700 is the shared latest-shot epoch, and 1720 is the shared
+// native queue. Neither belongs to this snapshot or may be rolled back with it.
+inline constexpr std::size_t phaseOffset=0x16f9,remainingOffset=0x16fc,ordinalOffset=0x1710;
+struct Snapshot {
+    unsigned phase{},ordinal{};
+    float remaining{};
+    bool operator==(const Snapshot&) const=default;
+    bool valid() const noexcept {
+        return phase<=4&&ordinal<=burst::maxShots&&std::isfinite(remaining)
+            &&remaining>=0&&remaining<=60;
+    }
+    bool idle() const noexcept {return phase==0&&ordinal==0&&remaining==0;}
+};
+struct Address {
+    burst::Key key{};
+    std::uintptr_t barrel{};
+    bool operator==(const Address&) const=default;
+    bool valid() const noexcept {return key.valid()&&barrel>=0x10000&&barrel<=0x00007fffffffffffULL-ordinalOffset-4;}
+};
+struct Lease {
+    Address address{};
+    std::uint64_t revision{};
+    unsigned side{};
+    Snapshot before{},mount{};
+    bool valid{};
+};
+struct Bank {
+    Address address{};
+    std::array<Snapshot,2> lane{};
+    Snapshot resident{};
+    std::uint64_t revision{};
+    unsigned mounted{};
+    bool initialized{},busy{};
+    // A new generation may be adopted only at a proven idle native boundary.
+    // Never clone a partly completed native burst into the other hand.
+    bool initialize(Address current,Snapshot observed) noexcept {
+        if(!current.valid()||!observed.valid()||!observed.idle()||busy)return false;
+        const auto next=revision+1;
+        *this={};address=current;resident=observed;initialized=true;revision=next?next:1;return true;
+    }
+    // Called only after the full native owner/layout lookup has qualified the
+    // replacement address. Logical relocation preserves both timing histories
+    // while invalidating a lease that still points at old storage.
+    bool relocate(Address current,Snapshot observed) noexcept {
+        if(!initialized||!current.valid()||current.key!=address.key||!observed.valid()
+            ||observed!=resident)return false;
+        if(current==address)return !busy;
+        address=current;busy=false;if(++revision==0)++revision;return true;
+    }
+    Lease begin(Address current,unsigned side,Snapshot observed) noexcept {
+        if(!initialized||busy||current!=address||(side!=burst::left&&side!=burst::right)
+            ||!observed.valid()||observed!=resident)return {};
+        const auto index=side==burst::left?0u:1u;
+        if(!lane[index].valid())return {};
+        if(++revision==0)++revision;
+        busy=true;return {current,revision,side,observed,lane[index],true};
+    }
+    bool accepts(const Lease& lease) const noexcept {
+        return lease.valid&&initialized&&busy&&lease.address==address&&lease.revision==revision
+            &&(lease.side==burst::left||lease.side==burst::right);
+    }
+    bool finish(const Lease& lease,Address current,Snapshot observed) noexcept {
+        if(!accepts(lease)||current!=address||!observed.valid())return false;
+        lane[lease.side==burst::left?0u:1u]=observed;resident=observed;mounted=lease.side;busy=false;return true;
+    }
+    // Abort is allowed only when the borrowed native snapshot was restored or
+    // was never mounted. It cannot pretend native side effects were undone.
+    bool abort(const Lease& lease,Snapshot observed) noexcept {
+        if(!accepts(lease)||observed!=lease.before)return false;
+        busy=false;return true;
+    }
+};
+// Read only the three proven scalar fields and check them twice. The enclosing
+// adapter still must qualify the concrete barrel and revalidate owner/layout.
+template<class Read> bool read(Read&& reader,std::uintptr_t barrel,Snapshot& out) noexcept {
+    out={};if(barrel<0x10000||barrel>0x00007fffffffffffULL-ordinalOffset-4)return false;
+    const auto once=[&](Snapshot& s){
+        std::uint8_t phase{};
+        if(!reader(barrel+phaseOffset,&phase,sizeof(phase))
+            ||!reader(barrel+remainingOffset,&s.remaining,sizeof(s.remaining))
+            ||!reader(barrel+ordinalOffset,&s.ordinal,sizeof(s.ordinal)))return false;
+        s.phase=phase;return s.valid();
+    };
+    Snapshot first{},second{};if(!once(first)||!once(second)||first!=second)return false;
+    out=first;return true;
+}
+}
