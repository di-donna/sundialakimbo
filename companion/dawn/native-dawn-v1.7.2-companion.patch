+    std::uint64_t tick{},calls{};                      // GetTickCount64, qualifying exports so far
+    std::uint32_t mode{},nodes{},controls{},action{};  // selection mode, ranges-0xAC, ranges-0x9C, animation+0x358
+    presentation::ActionClock clock{};                 // controller+0x2E0 (base, speed, duration, elapsed)
+    presentation::Frame controller{};                  // controller+0x70
+    presentation::Frame weapon{};                      // skeleton+0x500
