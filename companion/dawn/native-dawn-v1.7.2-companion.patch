+// rested: a displaced part (mask 1 or 2) was shown at rest on a posed frame.
+// firing: the mask switch to the firing gun's bit (review F3).
+struct Recovery {Side right{},left{};std::array<Frame,3> parts{};unsigned mask{rk::staticPairMask};float seconds{};bool fromHold{},rested{};FiringMask firing{};};
+// A displaced magazine/slide (mask 1 or 2) blends to rest with its mask; the
+// mask goes to both bits on the frame after one that showed the parts at rest
+// (at any frame rate), which then blend into the live parts.
+inline std::array<Frame,3> recovery_parts(Recovery& r,float e,const std::array<Frame,3>& live,unsigned& mask) noexcept {
+    std::array<Frame,3> out{};mask=rk::staticPairMask;
