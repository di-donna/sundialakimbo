+    ||(prefix[1]==0x80bfdfeb&&(prefix[0]==0x81529057||prefix[0]==0x8152aea4));
+   if(!relevant){++cursor_;++visited;continue;}
+   if(!m.header(a,h)||(h.self&8191U)!=index||Reader<Limited>::pool_index(h.self)!=974+poolNumber) {
+    if(!limited.available())return Result::pending;++cursor_;++visited;continue;
+   }
+   if(h.owner==player&&h.tag==0x80f56156&&h.kind==0x80803e64) {
+    if(candidate_.equipment)return refuse("membership");candidate_.equipment=a;candidate_.equipmentHeader=h;
+   } else if(h.owner==player&&h.tag==0x80c0c51a&&h.kind==0x80803a00) {
+    if(candidate_.active)return refuse("identity");candidate_.active=a;candidate_.activeHeader=h;
+   } else {
+    std::uintptr_t owner{};std::uint32_t parent{};
+    if(!m.entity(h.owner,owner)||!m.read(owner+0x3c,parent)||parent!=player) {
+     if(!limited.available())return Result::pending;++cursor_;++visited;continue;
+    }
+    if(h.kind==0x80809707) {
+     if(linkCount_==links_.size())return refuse("overflow");links_[linkCount_]=a;linkHeaders_[linkCount_++]=h;
+    } else if(h.tag==0x81a29a19&&h.kind==0x808072bd) {
+     if(candidate_.model)return refuse("identity");candidate_.model=a;candidate_.modelHeader=h;
+    } else if(h.kind==0x80bfdfeb&&(h.tag==0x81529057||h.tag==0x8152aea4)) {
+     auto& weapon=h.tag==0x81529057?candidate_.sturm:candidate_.drang;
