+    }
+    // (d) C9E280 after the native key, when hud::select did not qualify it.
+    void hud_key(const Memory& m,std::uintptr_t content,std::uintptr_t output,std::uint64_t now) noexcept {
+        if(!armed())return;
+        std::uint32_t key{};Header c{};
+        if(!read(m,output,key)||!header(m,content,c))return;
+        const bool isLocal=local(c.owner,now);
+        AcquireSRWLockExclusive(&lock_);
+        const bool due=counters_&&!hudSeen_.exhausted()&&walk_due(mix(mix(mix(seed,1U),content),key),now);
+        ReleaseSRWLockExclusive(&lock_);
+        if(!due)return;
+        std::uint32_t variant{},overrideTag{},entitySelf{},assemblyHandle{},assemblyTag{};
+        std::uintptr_t entity{},assembly{},asset{},sound{};std::uint64_t bytes{},count{},relative{};
+        (void)read(m,content+0x68,variant);(void)read(m,content+0x60,overrideTag);
+        Header soundHeader{};SoundPacket packet{};unsigned soundRows=0;
+        if(resolve(m,c.owner,entity)&&read(m,entity+12,entitySelf)&&entitySelf==c.owner&&read(m,entity+0x4c,assemblyHandle)
+            &&resolve(m,assemblyHandle,assembly)&&read(m,assembly+4,assemblyTag)&&resolve(m,assemblyTag,asset)
+            &&read(m,asset,bytes)&&bytes>=48&&bytes<=0x100000&&read(m,asset+16,count)&&count&&count<=128
+            &&read(m,asset+24,relative)&&relative<=bytes-0x28&&count*12<=bytes-0x28-relative){
+            for(unsigned i=0;i<count;++i){
+                std::array<std::uint32_t,3> row{};Header h{};
+                if(!read(m,asset+0x28+relative+i*12,row))break;
+                if(row[2]>0x100000||!header(m,assembly+row[2],h)||h.kind!=soundKind||h.owner!=c.owner)continue;
+                if(!soundRows++){sound=assembly+row[2];soundHeader=h;}
+            }
+        }
+        const bool packetRead=sound&&read(m,sound+0x30,packet);
+        const bool ratKing=packetRead&&rat_king_packet(packet);
+        if(!isLocal&&!ratKing)return;
+        if(packetRead&&hud::detail::key_for_parts(packet))return; // a private Akimbo packet
+        const auto recordKey=mix(mix(mix(mix(mix(seed,key),c.tag),variant),soundHeader.tag),packetRead?packet_hash(packet):0);
+        bool logIt=false;unsigned index=0;
+        AcquireSRWLockExclusive(&lock_);
+        if(counters_&&hudSeen_.insert(recordKey,ratKing||(isLocal&&local_rat_king()))){logIt=true;index=hudSeen_.count();counters_->hudRecords.store(index,std::memory_order_relaxed);}
+        ReleaseSRWLockExclusive(&lock_);
+        if(!logIt)return;
+        Line line{};std::size_t used=0;
+        append(line,used,"ev=akimbo_probe kind=hud n=%u local=%u rk=%u key=%08X content=%08X content_kind=%08X content_def=%llu variant=%u "
+            "override=%08X owner=%08X assembly=%08X rows=%llu sounds=%u sound=%08X sound_kind=%08X sound_def=%llu parts=",
+            index,isLocal?1U:0U,ratKing?1U:0U,key,c.tag,c.kind,hex(c.definition),variant,overrideTag,c.owner,assemblyTag,hex(count),
+            soundRows,soundHeader.tag,soundHeader.kind,hex(soundHeader.definition));
+        for(unsigned i=4;i<11;++i)append(line,used,i>4?",%08X":"%08X",packet[i]);
+        append(line,used," s16=%08X s17=%08X",packet[16],packet[17]);
+        emit(line,used);
+    }
+    // (d) BD6E80 after the native setter, when no Akimbo sound/material swap applied.
+    void sounds(const Memory& m,std::uintptr_t component,std::uintptr_t packetAddress,bool flag,std::uint64_t now) noexcept {
+        if(!armed())return;
+        SoundPacket packet{};Header h{};
+        if(!read(m,packetAddress,packet)||!header(m,component,h))return;
+        const bool isLocal=local(h.owner,now),ratKing=rat_king_packet(packet);
+        if((!isLocal&&!ratKing)||hud::detail::key_for_parts(packet))return;
+        const auto key=mix(mix(mix(seed,h.tag),h.definition),packet_hash(packet));
+        bool logIt=false;unsigned index=0;
+        AcquireSRWLockExclusive(&lock_);
+        if(counters_&&soundSeen_.insert(key,ratKing||(isLocal&&local_rat_king()))){logIt=true;index=soundSeen_.count();counters_->soundRecords.store(index,std::memory_order_relaxed);}
+        ReleaseSRWLockExclusive(&lock_);
+        if(!logIt)return;
+        Line line{};std::size_t used=0;
+        append(line,used,"ev=akimbo_probe kind=sound n=%u local=%u rk=%u comp=%08X comp_kind=%08X comp_def=%llu owner=%08X assembly=%08X flag=%u packet=",
+            index,isLocal?1U:0U,ratKing?1U:0U,h.tag,h.kind,hex(h.definition),h.owner,owner_assembly(m,h.owner),flag?1U:0U);
+        for(unsigned i=0;i<packet.size();++i)append(line,used,i?",%08X":"%08X",packet[i]);
+        emit(line,used);
+    }
+    // (e) 1206F00 from 12067C6, after the native allocation, for sequences the
+    // Akimbo FX paths did not qualify and whose owner is the local drawn weapon.
+    void fx_allocate(const Memory& m,std::uintptr_t sequence,std::uintptr_t particle,std::uintptr_t selector,
+                     std::uintptr_t valid,std::uintptr_t output,std::uint64_t now) noexcept {
+        if(!armed())return;
+        // Owner (+0x2C) and kind (+4) first: most emitters belong to other entities.
+        Header s{};std::array<std::uint32_t,2> head{};std::uint32_t owner{};
+        if(!read(m,sequence,head)||head[1]!=sequenceKind||!read(m,sequence+0x2c,owner)||!local(owner,now)
+            ||!header(m,sequence,s)||s.kind!=sequenceKind||s.owner!=owner)return;
+        std::uintptr_t asset{};std::uint64_t bytes{};
+        const bool assetRead=resolve(m,s.tag,asset)&&read(m,asset,bytes);
+        const std::uint64_t offset=assetRead&&selector>=asset&&selector-asset<bytes?selector-asset:~0ULL;
+        const auto key=mix(mix(seed,s.tag),offset);
+        bool logIt=false;unsigned index=0;
+        AcquireSRWLockExclusive(&lock_);
+        if(counters_&&fxAllocateSeen_.insert(key,local_rat_king())){logIt=true;index=fxAllocateSeen_.count();counters_->fxAllocateRecords.store(index,std::memory_order_relaxed);}
+        ReleaseSRWLockExclusive(&lock_);
+        if(!logIt)return;
+        std::array<std::uint64_t,2> pair{};std::array<std::uint8_t,4> binding{};std::uint32_t particleTag{},programTag{};
+        std::uintptr_t particleAsset{},program{};std::uint64_t programBytes{},programCount{},mapping{};std::uint8_t groups{};
+        bool validValue{};std::array<std::uint32_t,4> allocation{};
+        if(read(m,selector,pair)){
+            const auto rel=static_cast<std::int64_t>(pair[1]);
+            if(rel>-0x100000&&rel<0x100000)(void)read(m,selector+8+static_cast<std::uintptr_t>(rel)+16,binding); // elements follow the {count,kind} head
+        }
+        (void)read(m,selector+16,particleTag);
+        const bool particleOk=resolve(m,particleTag,particleAsset)&&particleAsset==particle;
+        if(read(m,particle,programTag)&&resolve(m,programTag,program)){
+            (void)read(m,program,programBytes);(void)read(m,program+0x18,programCount);
+            (void)read(m,program+0x38,mapping);(void)read(m,program+0x47,groups);
+        }
+        (void)read(m,valid,validValue);(void)read(m,output,allocation);
+        Line line{};std::size_t used=0;
+        append(line,used,"ev=akimbo_probe kind=fx_alloc n=%u seq=%08X seq_def=%llX seq_bytes=%llu owner=%08X assembly=%08X selector=%llX "
+            "sel_count=%llu binding=%u/%u/%u/%u particle=%08X particle_ok=%u program=%08X program_bytes=%llu program_count=%llu "
+            "mapping=%016llX groups=%u valid=%u alloc=%d/%d/%d/%08X",
+            index,s.tag,hex(s.definition),hex(bytes),s.owner,owner_assembly(m,s.owner),hex(offset),hex(pair[0]),
+            unsigned{binding[0]},unsigned{binding[1]},unsigned{binding[2]},unsigned{binding[3]},particleTag,particleOk?1U:0U,
+            programTag,hex(programBytes),hex(programCount),hex(mapping),unsigned{groups},validValue?1U:0U,
+            static_cast<int>(allocation[0]),static_cast<int>(allocation[1]),static_cast<int>(allocation[2]),allocation[3]);
+        emit(line,used);
+    }
+    // (e) 12701B0 from 121C643 (selected 0), after the native collect.
+    void fx_collect(const Memory& m,std::uintptr_t sequencePointer,std::uintptr_t selector,std::uintptr_t flags,
+                    std::uintptr_t groups,std::uintptr_t poses,std::uint64_t now) noexcept {
+        if(!armed())return;
+        std::uintptr_t sequence{};Header s{};std::array<std::uint32_t,2> head{};std::uint32_t owner{};
+        if(!read(m,sequencePointer,sequence)||!read(m,sequence,head)||head[1]!=sequenceKind||!read(m,sequence+0x2c,owner)
+            ||!local(owner,now)||!header(m,sequence,s)||s.kind!=sequenceKind||s.owner!=owner)return;
+        std::uintptr_t asset{};std::uint64_t bytes{};std::array<std::int64_t,2> groupBuffer{},poseBuffer{};std::uint32_t mode{};
+        const bool assetRead=resolve(m,s.tag,asset)&&read(m,asset,bytes);
+        const std::uint64_t offset=assetRead&&selector>=asset&&selector-asset<bytes?selector-asset:~0ULL;
+        (void)read(m,groups,groupBuffer);(void)read(m,poses,poseBuffer);(void)read(m,flags,mode);
+        const auto key=mix(mix(mix(mix(seed,s.tag),offset),static_cast<std::uint64_t>(groupBuffer[0])),static_cast<std::uint64_t>(poseBuffer[0]));
+        bool logIt=false;unsigned index=0;
+        AcquireSRWLockExclusive(&lock_);
+        if(counters_&&fxCollectSeen_.insert(key,local_rat_king())){logIt=true;index=fxCollectSeen_.count();counters_->fxCollectRecords.store(index,std::memory_order_relaxed);}
+        ReleaseSRWLockExclusive(&lock_);
+        if(!logIt)return;
+        std::array<std::uint64_t,2> pair{};std::array<std::uint8_t,4> binding{};std::uint32_t particleTag{};
+        std::array<std::uint16_t,3> group{};
+        if(read(m,selector,pair)){
+            const auto rel=static_cast<std::int64_t>(pair[1]);
+            if(rel>-0x100000&&rel<0x100000)(void)read(m,selector+8+static_cast<std::uintptr_t>(rel)+16,binding); // elements follow the {count,kind} head
+        }
+        (void)read(m,selector+16,particleTag);
+        if(groupBuffer[0]>0)(void)read(m,static_cast<std::uintptr_t>(groupBuffer[1]),group);
+        Line line{};std::size_t used=0;
+        append(line,used,"ev=akimbo_probe kind=fx_collect n=%u seq=%08X seq_def=%llX seq_bytes=%llu owner=%08X selector=%llX sel_count=%llu "
+            "binding=%u/%u/%u/%u particle=%08X flags=%08X groups=%lld poses=%lld group0=%u/%d/%d",
+            index,s.tag,hex(s.definition),hex(bytes),s.owner,hex(offset),hex(pair[0]),unsigned{binding[0]},unsigned{binding[1]},
+            unsigned{binding[2]},unsigned{binding[3]},particleTag,mode,static_cast<long long>(groupBuffer[0]),
+            static_cast<long long>(poseBuffer[0]),unsigned{group[0]},static_cast<int>(static_cast<std::int16_t>(group[1])),
+            static_cast<int>(static_cast<std::int16_t>(group[2])));
+        emit(line,used);
+    }
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/profile_registry.h b/Dawn/src/client/hooks/akimbo/profile_registry.h
