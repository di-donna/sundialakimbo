+bool supported_file() noexcept {
+    // The build 86657 digest; the reload cache file carries the same one.
+    constexpr const std::array<unsigned char,32>& expected=rat_king_reload::exeSha256;
+    std::array<wchar_t,32768> path{};
+    const DWORD length=GetModuleFileNameW(nullptr,path.data(),static_cast<DWORD>(path.size()));
+    if(!length || length>=path.size())return false;
+    HANDLE file=CreateFileW(path.data(),GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,nullptr);
+    if(file==INVALID_HANDLE_VALUE)return false;
+    BCRYPT_ALG_HANDLE algorithm{};BCRYPT_HASH_HANDLE hash{};bool ok=false;
+    if(BCryptOpenAlgorithmProvider(&algorithm,BCRYPT_SHA256_ALGORITHM,nullptr,0)>=0
+        && BCryptCreateHash(algorithm,&hash,nullptr,0,nullptr,0,0)>=0){
+        std::array<unsigned char,65536> chunk{};DWORD got{};bool readsOk=true;
+        for(;;){if(!ReadFile(file,chunk.data(),static_cast<DWORD>(chunk.size()),&got,nullptr)){readsOk=false;break;}
+            if(!got)break;
+            if(BCryptHashData(hash,chunk.data(),got,0)<0){readsOk=false;break;}}
+        std::array<unsigned char,32> digest{};
+        ok=readsOk && BCryptFinishHash(hash,digest.data(),static_cast<ULONG>(digest.size()),0)>=0 && digest==expected;
+    }
+    if(hash)BCryptDestroyHash(hash);
+    if(algorithm)BCryptCloseAlgorithmProvider(algorithm,0);
+    CloseHandle(file);return ok;
+}
+// ---- Runtime v4b: the reload recording cache (rat_king_reload_file.h) ------------
+// Activation thread, before any hook is attached: load and validate the file;
+// any failure leaves the store empty (the recorder re-records; the next good
+// recording overwrites the bad file).
+void load_reload_recording() noexcept {
+    auto& v6=SunriseStatusAkimboVisualsProbe.sidearmV6;
+    reloadStore.clear();
+    rat_king_reload::Info info{};
+    const bool path=core::path::artifact_file(rat_king_reload::fileName,reloadPath);
+    if(!path)reloadPath={};
+    const auto result=path?rat_king_reload::load_file(reloadPath.chars.data(),reloadImage,info):rat_king_reload::Load::io;
+    v6.fileLoadResult.store(static_cast<std::uint64_t>(result),std::memory_order_relaxed);
+    if(result==rat_king_reload::Load::loaded){
+        reloadStore.committed=reloadImage.payload;reloadStore.info=info;reloadStore.valid=reloadStore.loaded=true;
+        v6.fileLoads.fetch_add(1,std::memory_order_relaxed);
+    }
+    char line[224]{};
+    (void)std::snprintf(line,sizeof(line),"ev=akimbo stage=reload_recording result=%s reason=%s tlast=%.3f flags=%u samples=%u",
+        result==rat_king_reload::Load::loaded?"loaded":result==rat_king_reload::Load::missing?"missing":"ignored",
+        rat_king_reload::load_name(result),static_cast<double>(info.tLast),info.flags,info.samples);
+    report(result==rat_king_reload::Load::loaded||result==rat_king_reload::Load::missing?core::log::Level::info:core::log::Level::warn,line);
+}
+// Thread-pool callback: no akimbo lock, never runtime::g_lock. reloadImage.payload
+// and persistInfo belong to this writer until persistState.finish().
+void CALLBACK persist_reload_recording(PTP_CALLBACK_INSTANCE,PVOID,PTP_WORK) noexcept {
+    auto& v6=SunriseStatusAkimboVisualsProbe.sidearmV6;
+    FILETIME now{};GetSystemTimeAsFileTime(&now);
+    rat_king_reload::encode(persistInfo,(static_cast<std::uint64_t>(now.dwHighDateTime)<<32)|now.dwLowDateTime,reloadImage);
+    bool ok=reloadPath.length!=0;
+    if(ok){core::path::remove_stale_siblings(reloadPath.chars.data());ok=rat_king_reload::write_file(reloadPath.chars.data(),reloadImage);}
+    (ok?v6.fileWrites:v6.fileWriteFailures).fetch_add(1,std::memory_order_relaxed);
+    char line[160]{};
+    (void)std::snprintf(line,sizeof(line),"ev=akimbo stage=reload_recording_write result=%s tlast=%.3f flags=%u",ok?"ok":"failed",
+        static_cast<double>(persistInfo.tLast),persistInfo.flags);
+    report(ok?core::log::Level::info:core::log::Level::warn,line);
+    persistState.finish(ok);
+}
+// Animation thread, after alternatingLock is released: never blocks on I/O. No
+// work item (creation failed) or uninstalling: the copy is dropped.
+void submit_reload_recording() noexcept {
+    AcquireSRWLockShared(&persistLock);
+    persistState.submit([]() noexcept {
+        if(!persistWork||!enabled.load(std::memory_order_acquire))return false;
+        SubmitThreadpoolWork(persistWork);return true;
+    });
+    ReleaseSRWLockShared(&persistLock);
+}
+// uninstall(), or a failed install: joins a pending or running write (never
+// cancels it), then closes the work. No submit can follow (persistWork is null).
+void close_reload_recording() noexcept {
+    AcquireSRWLockExclusive(&persistLock);const PTP_WORK work=persistWork;persistWork=nullptr;ReleaseSRWLockExclusive(&persistLock);
+    if(work){WaitForThreadpoolWorkCallbacks(work,FALSE);CloseThreadpoolWork(work);}
+    persistState.close();
+}
