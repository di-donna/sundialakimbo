@@ -0,0 +1,76 @@
+#include "../src/client/hooks/akimbo/burst_driver.h"
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+
+namespace d=dawn::client::hooks::akimbo::burst_driver;
+namespace c=dawn::client::hooks::akimbo::burst_cadence;
+namespace p=dawn::client::hooks::akimbo::burst_phase;
+static unsigned checks{};
+static void check_impl(bool value,unsigned line){++checks;if(!value){std::fprintf(stderr,"failed %u line %u\n",checks,line);std::exit(1);}}
+#define check(...) check_impl((__VA_ARGS__),__LINE__)
+struct Calls {
+    unsigned activeCalls{},idleCalls{},cooldownCalls{},blockedCalls{},shots{};bool forced{},fail{};
+    float total{.4f},recovery{.15f};
+    bool active(d::Hand& h,const d::Context& ctx,d::Output& out){
+        check(ctx.root==0x10000&&ctx.participates==1);++activeCalls;
+        if(fail)return false;
+        if(h.phase.remaining==0){++shots;++h.phase.ordinal;out.flags|=1;
+            if(h.phase.ordinal==3){h.phase.phase=2;h.phase.remaining=recovery;}
+            else h.phase.remaining=.05f;}
+        return true;
+    }
+    bool idle(d::Hand&,const d::Context&,d::Output&,bool f){++idleCalls;forced=f;return !fail;}
+    bool cooldown(const d::Context&,float& t,float& r){++cooldownCalls;t=total;r=recovery;return !fail;}
+    bool blocked_idle(d::Hand&,const d::Context&,bool& active){++blockedCalls;active=true;return !fail;}
+};
+int main(){
+    const d::Context context{0x10000,.01f,.01f,.02f,0,1,{}};
+    for(unsigned phase=0;phase<=4;++phase)for(unsigned flags=0;flags<=6;flags+=2)
+        for(bool due:{false,true})for(bool blocked:{false,true}){
+            d::Hand h{{phase,2,due?0.f:.1f},flags,0};auto ctx=context;ctx.blocked=blocked;
+            d::Output out;Calls calls;check(d::body(h,ctx,out,calls));
+            if(phase==0){
+                check(calls.activeCalls==0&&calls.cooldownCalls==0);
+                if(blocked)check(calls.blockedCalls==1&&!(h.requests&2)&&out.active&&out.stop);
+                else if(flags&2)check(h.phase.phase==1&&h.phase.remaining==0&&!out.stop);
+                else check(calls.idleCalls==1&&calls.forced==bool(flags&4)&&out.stop);
+            }else if(phase==1){check(calls.activeCalls==1&&calls.shots==unsigned(due));}
+            else if(phase==2||phase==3){
+                check(calls.idleCalls==unsigned(phase==3));
+                if(phase==3)check(calls.forced);
+                if(due)check(calls.cooldownCalls==1&&h.phase.phase==4&&h.phase.remaining==.25f);
+                else check(calls.cooldownCalls==0&&!(h.requests&2));
+            }else check(due?h.phase.idle():h.phase.phase==4&&h.phase.remaining==.1f);
+        }
+    // Native phase3 recovery still runs before its timer reaches zero.
+    // Shared properties see firing on either side, independent of mount order.
+    for(unsigned l=0;l<=4;++l)for(unsigned r=0;r<=4;++r){
+        const std::array<d::Hand,2> hands{{{{l,0,.1f},0,0},{{r,0,.2f},0,0}}};
+        check(d::shared_phase(hands)==unsigned(l==1||r==1));
+    }
+    // Complete three-round native phase trace, with every interval supplied by
+    // the callback and one shared elapsed-time total across both hands.
+    c::State clock;clock.hands[1].remaining=.025f;
+    std::array<d::Hand,2> hands{};for(auto& h:hands)h.requests=2;
+    std::array<d::Output,2> outputs{};std::array<Calls,2> callbacks{};float advanced=0;
+    auto result=c::advance(clock,.8f,[&](auto ctx,const auto&){advanced+=ctx.step;return true;},
+        [&](unsigned side,auto ctx,p::Snapshot& snapshot){
+            auto i=c::index(side);auto& h=hands[i];h.phase=snapshot;const auto before=snapshot;
+            const d::Context native{0x10000,ctx.step,ctx.elapsed,ctx.remaining,0,1,{}};
+            if(!d::body(h,native,outputs[i],callbacks[i]))return c::Transition::blocked;
+            snapshot=h.phase;return snapshot==before?c::Transition::unchanged:c::Transition::changed;
+        });
+    check(result.complete&&std::abs(advanced-.8f)<.00001f);
+    check(callbacks[0].shots==3&&callbacks[1].shots==3&&clock.hands[0].idle()&&clock.hands[1].idle());
+    // A native stop output suppresses further phase bodies within this frame.
+    d::Hand stopped{{1,1,0},2,0};d::Output stop;stop.stop=1;Calls skipped;
+    check(d::body(stopped,context,stop,skipped)&&!skipped.activeCalls&&stopped.phase.ordinal==1);
+    for(float bad:{-1.f,.5f,std::numeric_limits<float>::quiet_NaN()}){
+        d::Hand h{{2,3,0},0,0};d::Output out;Calls calls;calls.recovery=bad;
+        check(!d::body(h,context,out,calls));
+    }
+    d::Hand charge{{1,0,0},2,.5f};d::Output out;Calls calls;
+    check(!d::body(charge,context,out,calls)&&!calls.activeCalls);
+    std::printf("burst native phase body: %u checks passed\n",checks);
+}
diff --git a/Dawn/unit/akimbo_burst_exit_tests.cpp b/Dawn/unit/akimbo_burst_exit_tests.cpp
