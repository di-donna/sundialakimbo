+    // announced BEFORE the call (a synchronous priority line survives a crash or hang in it).
+    unsigned firstNative_{};
+    // S2 fix (gameplay F2c): a pending press refused sturm_state stays pending (it fires
+    // if Sturm's action ends before it is stale); the refusal is counted once per press.
+    std::uint64_t sturmRefusedPress_{};std::uint64_t pressSerial_{};
+    struct Busy {std::atomic<bool>& b;~Busy(){b.store(false,std::memory_order_release);}};
+    struct Depth {Depth() noexcept {++driverDepth;}~Depth(){--driverDepth;}};
