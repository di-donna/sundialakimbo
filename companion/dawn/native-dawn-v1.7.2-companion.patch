+// Exercise the real Dawn infinite-ammo callbacks with synthetic trampolines.
+// No process attachment, native detour installation, game files or private data.
+#include "../src/client/hooks/akimbo/smg_magazines.h"
+#include "../src/client/hooks/infinite_ammo/infinite_ammo.cpp"
+#include <cstdio>
+#include <cstdlib>
+
+namespace ia=dawn::client::hooks::infinite_ammo;
+namespace ammo=dawn::client::hooks::akimbo::smg_ammo;
+namespace nf=dawn::state::activity::nightfall;
+namespace {
+bool enabledSetting{};
+unsigned checks{};
+void check(bool ok,const char* why){++checks;if(!ok){std::fprintf(stderr,"FAIL %s\n",why);std::exit(1);}}
+struct Store {
+    int rounds{26},stock{500},policy{-1};
+    bool current{true},disableInsideLoaded{};
+    unsigned loadedWrites{},reserveWrites{},published{};
+    bool valid()const noexcept{return current&&ia::reserve_override()==policy;}
+    int loaded()const noexcept{return rounds;}
+    int reserve()const noexcept{return stock;}
+    void set_loaded(int n)noexcept{(void)ia::set_magazine(this,n);}
+    void set_reserve(int n)noexcept{(void)ia::set_reserves(this,n);}
+    void publish()noexcept{++published;}
+};
+std::int64_t __fastcall loaded(void* p,std::int32_t amount){auto& s=*static_cast<Store*>(p);++s.loadedWrites;s.rounds=amount;if(s.disableInsideLoaded)enabledSetting=false;return 1;}
+std::int64_t __fastcall reserve(void* p,std::int32_t amount){auto& s=*static_cast<Store*>(p);++s.reserveWrites;s.stock=amount;return 1;}
+void setup(bool enabled){
+    enabledSetting=enabled;nf::detail::flags.store(0);ia::g_handles={};
+    ia::g_handles[ia::kReservesSlot]={reinterpret_cast<void*>(&reserve),nullptr,true};
+    ia::g_handles[ia::kMagazineSlot]={reinterpret_cast<void*>(&loaded),nullptr,true};
+}
+void run(){
+    setup(false);check(ia::reserve_override()==-1,"disabled setting exposes finite reserve policy");
+    enabledSetting=true;check(ia::reserve_override()==500,"effective enabled setter policy is explicit");
+    nf::detail::flags.store(4);check(ia::reserve_override()==-1,"activity restriction keeps ordinary finite reserves");
+    nf::detail::flags.store(0);ia::g_handles[ia::kMagazineSlot].attached=false;
+    check(ia::reserve_override()==-1,"incomplete hook installation cannot authorize supplied ammo");
+    setup(true);Store n;n.policy=ia::reserve_override();
+    check(!ammo::transfer(n,26,500,26)&&n.rounds==26&&n.stock==500&&!n.loadedWrites,
+        "reproduce regression: real override prevents an assumed finite debit from seeding the left magazine");
+    n={};n.policy=ia::reserve_override();
+    check(ammo::transfer(n,26,500,26,n.policy)&&n.rounds==52&&n.stock==500&&n.loadedWrites==1&&n.reserveWrites==1,
+        "explicit actual policy seeds both finite magazines through real loaded/reserve callbacks");
+    ammo::State s;check(s.initialize({},26,52,500,0)==0,"native combined initialized count is not seeded twice");
+    for(unsigned i=0;i<5;++i)check(s.consume(1),"infinite reserve still spends individual left rounds");
+    for(unsigned i=0;i<3;++i)check(s.consume(2),"infinite reserve still spends individual right rounds");
+    check(s.rounds[0]==21&&s.rounds[1]==23,"setting does not make hand magazines infinite");
+    n.rounds=s.total();check(s.request(true,n.policy,{.2f,.3f},2)==3,"both partial hand magazines still require R reload");
+    const int before=n.rounds,added=s.advance(200,n.policy,true);
+    check(added==5&&s.loading==2&&ammo::transfer(n,before,n.stock,added,n.policy)&&n.rounds==49&&n.stock==500,
+        "left completes independently under actual infinite reserve callbacks");
+    const int second=s.advance(300,n.policy,true);
+    check(second==3&&!s.loading&&ammo::transfer(n,49,n.stock,second,n.policy)&&n.rounds==52&&n.stock==500,
+        "right completes without disabling reserve refill or changing left rounds");
+    n={};n.stock=0;n.policy=ia::reserve_override();
+    check(ammo::transfer(n,26,0,26,n.policy)&&n.rounds==52&&n.stock==500,"enabled reserve supply can initialize a weapon that starts without reserve");
+    (void)s.initialize({},26,52,0,0);s.rounds[0]=21;s.rounds[1]=23;n.rounds=s.total();
+    check(s.request(true,n.policy,{.2f,.2f},3)==1,"actual infinite reserve policy still selects only the lower nonempty magazine");
+    check(s.consume(2)&&!s.consume(1),"other hand stays usable during supplied lower-magazine reload");
+    n.rounds=s.total();const int lowerBefore=n.rounds,lowerAdded=s.advance(200,n.policy,true);
+    check(lowerAdded==5&&ammo::transfer(n,lowerBefore,n.stock,lowerAdded,n.policy)
+        &&s.rounds[0]==26&&s.rounds[1]==22&&n.rounds==48&&n.stock==500&&!s.loading,
+        "real infinite reserve callbacks top up only selected hand while preserving the other hand's shot");
+
+    setup(false);n={};n.stock=5;n.policy=ia::reserve_override();
+    check(ammo::transfer(n,26,5,3,n.policy)&&n.rounds==29&&n.stock==2,"disabled setting preserves finite reserve conservation");
+    check(!ammo::transfer(n,29,2,3,n.policy)&&n.rounds==29&&n.stock==2,"low finite reserve cannot be mistaken for supplied ammo");
+    setup(true);nf::detail::flags.store(4);n={};n.stock=5;n.policy=ia::reserve_override();
+    check(ammo::transfer(n,26,5,3,n.policy)&&n.stock==2&&n.rounds==29,"activity-blocked feature follows the real finite callbacks");
+    setup(true);n={};n.policy=ia::reserve_override();enabledSetting=false;
+    check(!ammo::transfer(n,26,500,26,n.policy)&&!n.loadedWrites&&!n.reserveWrites,"policy change before transfer performs no writes");
+    setup(false);n={};n.stock=5;n.policy=ia::reserve_override();enabledSetting=true;
+    check(!ammo::transfer(n,26,5,3,n.policy)&&!n.loadedWrites&&!n.reserveWrites,"finite-to-supplied policy change also refuses stale transaction");
+    setup(true);n={};n.policy=ia::reserve_override();n.disableInsideLoaded=true;
+    check(!ammo::transfer(n,26,500,26,n.policy)&&n.loadedWrites==1&&!n.reserveWrites&&!n.published,
+        "policy change during setter refuses publication and performs no subsequent write");
+}
+}
+namespace dawn::client::player {Settings get()noexcept{return {enabledSetting};}}
+namespace dawn::core::log {void write(Channel,Level,std::string_view)noexcept{}}
+namespace dawn::client::patterns {
+std::byte* scan_main_image_unique(std::span<const PatternByte>,const char*)noexcept{return nullptr;}
+std::byte* resolve_relative(const std::byte*,const std::byte*)noexcept{return nullptr;}
+}
+namespace dawn::client::hooking::detour {
+bool install(std::span<const Spec>,std::span<Handle>)noexcept{return false;}
+bool uninstall(std::span<Handle>)noexcept{return true;}
+}
+int main(){run();std::printf("akimbo actual infinite-ammo integration: %u checks passed\n",checks);}
diff --git a/Dawn/unit/akimbo_magazine_tests.cpp b/Dawn/unit/akimbo_magazine_tests.cpp
