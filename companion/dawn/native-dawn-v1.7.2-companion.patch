@@ -0,0 +1,308 @@
+#pragma once
+#include "alternating.h"
+#include "hud.h"
+#include <array>
+#include <bit>
+#include <cstring>
+
+namespace dawn::client::hooks::akimbo::effects {
+using namespace presentation;
+inline constexpr float separation=.18999923943925734f;
+inline constexpr Frame leftOffset{{},{0,separation,0},1};
+// Native Malfeasance core81529057 marker60FECDD4, bone0, at file+0x8da0.
+// Attachment queries return this marker composed with the live gun root.
+inline constexpr Frame muzzle=std::bit_cast<Frame>(std::array<std::uint32_t,8>{
+    0,0,0x33800000,0x3f800000,0x3eb119d9,0x337355ca,0x3dcb2a4e,0x3f7ffffe});
+struct Sample {
+    Identity identity{};
+    std::uint64_t at{};
+    Frame right{},left{leftOffset};
+    // Source weapon bones relative to its pre-edit root, from this completed
+    // pose. The mask is exactly the moving-part mask consumed by the shader.
+    std::array<Frame,56> bones{};
+    unsigned boneCount{},moving{};
+};
+inline bool local_attachment(Frame frame) noexcept {
+    const auto scale=frame.scale;frame.scale=1;
+    return presentation::valid(frame)&&scale>.5f&&scale<2.f;
+}
+inline bool attachment_frames(const Sample& sample,const profiles::Registration& registration,
+                              unsigned role,unsigned index,bool left,Frame local,
+                              Frame& source,Frame& target) noexcept {
+    source=target=local;if(!local_attachment(local))return false;
+    const auto* binding=profiles::attachment_bone(registration.visual,role,index);
+    if(!binding)return true;
+    if(!profiles::generic(registration.adapter)||sample.boneCount!=registration.pose.weaponBoneCount
+        ||sample.boneCount>sample.bones.size()||binding->bone>=sample.boneCount||sample.moving>3
+        ||!valid(sample.bones[binding->bone]))return false;
+    const Frame bind=std::bit_cast<Frame>(binding->bind);
+    if(!valid(bind))return false;
+    source=compose(sample.bones[binding->bone],local);
+    target=(sample.moving&(left?1u:2u))?source:compose(bind,local);
+    return local_attachment(source)&&local_attachment(target);
+}
+struct State {
+    Sample sample{};
+    Identity shotIdentity{};
+    bool shotLeft{};
+    void fired(const Identity& id,bool left) noexcept {
+        shotIdentity=id;shotLeft=left;
+    }
+    bool capture(const Identity& id,Frame native,Frame rightMarker,Frame leftMarker,
+                 bool articulated,std::uint64_t now) noexcept {
+        if(!alternating_model(id.modelTag)){sample={};return false;}
+        if(!valid(native))return false;
+        Frame right=native,left=native;
+        if(articulated){
+            if(!valid(rightMarker)||!valid(leftMarker))return false;
+            right=compose(rightMarker,inverse(alternating::weaponBind3));
