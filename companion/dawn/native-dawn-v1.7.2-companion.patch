+// recoil-free firing base); never an interrupting action (draw, put-away,
+// sprint, reload). Unknown selectors (a melee, a slide, a mantle) are no stance.
+inline bool stance_action(unsigned action,ActionClock clock) noexcept {
+    return (idle_action(action)||action==actionIdleAlert||known_firing(action,clock))&&!interrupting_action(action);
+}
+// The hip hold's farthest distance from the complete recording's last knot
+// (root 72 relative to root 0; the recording's own head/tail limits, which the
+// live recording met at 18 mm / 6.9 deg).
+inline constexpr float hipKnotMeters=checkHeadTailMeters,hipKnotDegrees=checkHeadTailDegrees;
+
+// ============================================================================
+// Runtime v7 (user test of v6, 2026-09-24): "the reload is bad, return to the
+// reaper one and fix it during ADS"
+// ============================================================================
+// ---- E.2 The Reaper throw is the reload again, with the v6 ADS handling ------
