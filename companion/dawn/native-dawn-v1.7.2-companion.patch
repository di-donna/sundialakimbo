+// Headless burst transaction tests. No private assets or native detours.
+#include "../src/client/hooks/akimbo/burst.h"
+#include "../src/client/hooks/akimbo/burst_queue.h"
+#include "../src/client/hooks/akimbo/burst_runtime.h"
+#include "../src/client/hooks/akimbo/gun_cost.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#include <limits>
+
+namespace b=dawn::client::hooks::akimbo::burst;
+namespace {
+unsigned checks{};
+void check(bool value,const char* message) {
+    ++checks;if(!value){std::fprintf(stderr,"FAIL: %s\n",message);std::exit(1);}
+}
+constexpr b::Key key{0x12345678,0x22345678,0x81d40048};
+struct Magazine {
+    std::array<unsigned,2> rounds{30,30};unsigned native=60,debited{};
+    void apply(b::Settlement s) {
+        check(s.valid&&(s.side==b::left||s.side==b::right),"settlement identifies one hand");
+        auto& selected=rounds[s.side==b::left?0:1];
+        check(s.cost<=selected&&s.cost<=native,"no cross-hand or negative debit");
+        selected-=s.cost;native-=s.cost;debited+=s.cost;
+        check(native==rounds[0]+rounds[1],"native aggregate equals individual magazines");
+    }
+};
+void sequence() {
+    b::State state;Magazine magazine;
+    std::uint32_t token=0x100;
+    for(unsigned burst=0;burst<6;++burst){
+        const auto expected=burst%2?b::right:b::left;
+        for(unsigned ordinal=0;ordinal<3;++ordinal){
+            const unsigned buttons=ordinal?0:b::both;
+            auto spend=state.begin(key,ordinal,3,1,1,buttons,magazine.rounds,0);
+            check(spend.valid&&spend.side==expected,"entire native burst keeps one hand after release");
+            auto settled=state.settle(spend,true,++token);magazine.apply(settled);
+            check(settled.queued,"paid event is mapped to queue generation");
+            auto receipt=state.emission(key,token,ordinal);
+            check(receipt.valid&&receipt.side==expected,"emission retrieves its paid hand");
+            const auto total=magazine.native;
+            check(state.retire(key,receipt),"emission retires once");
+            check(!state.retire(key,receipt)&&magazine.native==total,"failed or duplicate emission cannot spend twice");
+        }
+        check(!state.begin(key,0,3,1,1,b::both,magazine.rounds,0).valid,"ordinal zero requires qualified native phase boundary");
+        check(state.leave_burst(key),"native cooldown ends burst ownership");
+    }
+    check(magazine.rounds==std::array<unsigned,2>{21,21}&&magazine.debited==18,"whole bursts alternate fairly");
+}
+void partial_and_reloading() {
+    b::State state;Magazine magazine{{2,30},32,0};
+    for(unsigned i=0;i<2;++i){
+        auto spend=state.begin(key,i,3,1,1,i?b::right:b::left,magazine.rounds,0);
+        check(spend.valid&&spend.side==b::left,"changing buttons cannot move an active burst");
+        magazine.apply(state.settle(spend,true,100+i));
+    }
+    check(!state.begin(key,2,3,1,1,b::both,magazine.rounds,0).valid,"partial magazine stops before spending opposite hand");
+    check(magazine.rounds==std::array<unsigned,2>{0,30},"partial burst conserves untouched hand");
+    check(state.leave_burst(key),"truncated native burst can enter cooldown");
+    auto right=state.begin(key,0,3,1,1,b::both,magazine.rounds,b::left);
+    check(right.valid&&right.side==b::right,"other hand can start while empty hand reloads");
+    magazine.apply(state.settle(right,true,200));
+    for(unsigned i=1;i<3;++i){
+        auto next=state.begin(key,i,3,1,1,0,magazine.rounds,b::left);
+        check(next.valid&&next.side==b::right,"unrelated reload does not interrupt active burst");
+        magazine.apply(state.settle(next,true,200+i));
+    }
+    check(magazine.rounds==std::array<unsigned,2>{0,27},"reload and other-hand burst remain independent");
+}
+void failures_and_generation() {
+    b::State state;Magazine magazine;
+    auto first=state.begin(key,0,3,1,1,b::both,magazine.rounds,0);
+    check(first.valid&&!state.begin(key,0,3,1,1,b::both,magazine.rounds,0).valid,"reentrant pre-spend check cannot issue second ticket");
+    check(!state.leave_burst(key),"phase change cannot silently erase in-flight spend");
+    check(!state.settle(first,false,0).valid,"native pre-debit rejection is free");
+    auto retry=state.begin(key,0,3,1,1,b::both,magazine.rounds,0);
+    check(retry.valid&&retry.side==first.side,"failed event retains next hand");
+    check(!state.settle(first,true,100).valid,"stale spend ticket cannot settle retry");
+    magazine.apply(state.settle(retry,true,101));
+    check(!state.begin(key,2,3,1,1,b::both,magazine.rounds,0).valid,"out-of-order native ordinal refused");
+    check(!state.begin(key,1,4,1,1,b::both,magazine.rounds,0).valid,"burst property change requires new native phase");
+    auto second=state.begin(key,1,3,1,1,0,magazine.rounds,0);
+    auto dropped=state.settle(second,true,~0u);magazine.apply(dropped);
+    check(dropped.valid&&!dropped.queued&&state.nextOrdinal==2,"native queue allocation failure still advances paid ordinal");
+    // Pointer addresses are intentionally absent from Key. A fully qualified
+    // storage relocation retains both the pending transaction and queue owner.
+    auto third=state.begin(key,2,3,1,1,0,magazine.rounds,0);
+    state.select(key);magazine.apply(state.settle(third,true,103));
+    check(state.emission(key,101,0).side==b::left,"queued hand survives logical-instance relocation");
+    auto replacement=key;++replacement.handle;state.select(replacement);
+    check(!state.emission(replacement,101,0).valid&&!state.emission(key,103,2).valid,"new native generation cannot inherit queued shots");
+    check(!state.settle(third,true,104).valid,"retired instance cannot settle again");
+}
+void costs_and_capacity() {
+    b::State state;Magazine magazine{{3,5},8,0};
+    auto first=state.begin(key,0,3,2,2,b::left,magazine.rounds,0);
+    check(first.valid,"actual multi-round cost qualifies selected hand");
+    magazine.apply(state.settle(first,true,400));
+    check(!state.begin(key,1,3,2,2,b::both,magazine.rounds,0).valid,"remaining selected ammo cannot borrow other magazine");
+    check(magazine.rounds==std::array<unsigned,2>{1,5},"exact native debit applies once");
+    state={};magazine={{200,200},400,0};
+    for(unsigned i=0;i<b::maxShots;++i){
+        auto spend=state.begin(key,i,b::maxShots,1,1,i?0:b::left,magazine.rounds,0);
+        check(spend.valid,"bounded delayed queue accepts each distinct ordinal");
+        magazine.apply(state.settle(spend,true,500+i));
+    }
+    check(state.leave_burst(key),"phase may complete with delayed emissions pending");
+    check(!state.begin(key,0,3,1,1,b::both,magazine.rounds,0).valid,"full bookkeeping queue blocks before another debit");
+    auto receipt=state.emission(key,500,0);check(state.retire(key,receipt),"draining queue releases capacity");
+    auto next=state.begin(key,0,3,1,1,b::both,magazine.rounds,0);
+    check(next.valid&&next.side==b::right,"next burst can coexist with prior queued events");
+    magazine.apply(state.settle(next,true,600));
+    check(state.emission(key,501,1).side==b::left&&state.emission(key,600,0).side==b::right,"overlapping queued bursts preserve distinct hands");
+}
+void malformed() {
+    for(unsigned shots:{0u,1u,65u,~0u}){
+        b::State state;check(!state.begin(key,0,shots,1,1,3,{30,30},0).valid,"unbounded burst definition rejected");
+    }
+    b::State state;
+    check(!state.begin({},0,3,1,1,3,{30,30},0).valid,"empty owner key rejected");
+    check(!state.begin(key,0,3,1,0,3,{30,30},0).valid,"unknown zero-cost semantics are not silently enabled");
+    check(!state.begin(key,0,3,201,1,3,{30,30},0).valid,"invalid native required-ammo value rejected");
+    check(!state.begin(key,0,3,1,1,3,{201,30},0).valid,"unqualified magazine capacity rejected");
+    check(!state.begin(key,0,3,1,1,3,{30,30},3).valid,"both reloading prevents new burst");
+    for(unsigned count:{2u,3u,7u,64u}){
+        const auto c=static_cast<float>(count);
+        check(b::finite_counts({c,c,c,c},count),"both native aim modes pin the same finite burst maximum");
+        check(b::finite_counts({0,1,c,c},count),"minimum may require held input before finite maximum");
+        check(!b::finite_counts({c,c,0,c},count),"unlimited hip-fire cannot masquerade as finite burst");
+        check(!b::finite_counts({c,c,c,0},count),"unlimited alternate-fire cannot masquerade as finite burst");
+        check(!b::finite_counts({c+1,c,c,c},count),"minimum beyond selected maximum is contradictory");
+        check(!b::finite_counts({c,c,c,c-1},count),"different alternate maximum needs separately qualified selector");
+        check(!b::finite_counts({.5f,c,c,c},count),"fractional property is not silently rounded for phase ownership");
+        check(!b::finite_counts({c,c,c,c},count+1),"content override mismatch cannot extend receipt phase");
+    }
+}
+struct Image {
+    std::vector<std::byte> bytes=std::vector<std::byte>(0x60000);
+    std::uintptr_t mutate{};unsigned reads{};
+    template<class T> void put(std::uintptr_t address,const T& value) {
+        std::memcpy(bytes.data()+address-0x10000,&value,sizeof(value));
+    }
+    static bool read(void* context,std::uintptr_t address,void* output,std::size_t size) noexcept {
+        auto& image=*static_cast<Image*>(context);
+        if(address<0x10000||address-0x10000>image.bytes.size()||size>image.bytes.size()-(address-0x10000))return false;
+        if(address==image.mutate&&++image.reads==2)image.bytes[address-0x10000]^=std::byte{1};
+        std::memcpy(output,image.bytes.data()+address-0x10000,size);return true;
+    }
+    dawn::client::hooks::akimbo::Memory memory() {return {this,&read,0x10000};}
+    static constexpr std::uintptr_t barrel=0x50000,head=barrel+0x1720,cells=0x30000;
+    Image() {
+        put<std::uintptr_t>(0x10000,0x11000);put<std::uintptr_t>(0x11000,0x12000);
+        put<std::uintptr_t>(0x12008,cells);put<unsigned>(0x12030,0x40);put<int>(0x12034,0);
+        put<unsigned>(head,1);
+    }
+    void packet(unsigned token,b::Packet p) {put(cells+token*0x40,p);}
+};
+void native_queue_scope() {
+    Image image;
+    b::Packet first{.01f,0,-1,0,.75f,0xa,0,0,2};
+    b::Packet second{.02f,0,1,1,.75f,0xa,0,0,3};
+    // Delayed events from another burst may have the same ordinal. A token,
+    // ordered snapshot and checked native pop distinguish them without guessing.
+    b::Packet third{.03f,0,-1,0,.5f,0xa,0,0,~0u};
+    image.packet(1,first);image.packet(2,second);image.packet(3,third);
+    b::Queue queue{};check(b::snapshot(image.memory(),Image::barrel,queue)&&queue.count==3,"read actual linked native packet layout");
+    b::Drain drain{key,queue};
+    image.put<unsigned>(Image::head,first.next);
+    check(drain.take(key,2,0,0,-1,.75f,false,false)==1,"drain scope identifies first event after native popped head");
+    check(drain.take(key,3,1,0,1,.75f,false,false)==2,"next event retains its own generation token");
+    check(drain.take(key,~0u,0,0,-1,.5f,false,false)==3,"repeated ordinal from another burst maps distinct token");
+    check(!drain.take(key,~0u,0,0,-1,.5f,false,false),"extra native callback cannot reuse final queue event");
+    drain={key,queue};check(!drain.take(key,1,0,0,-1,.75f,false,false),"un-popped queue cannot impersonate an emission");
+    drain={key,queue};check(!drain.take(key,2,0,0,-1,.75f,false,true),"replay cannot consume gameplay receipt");
+    drain={key,queue};auto other=key;++other.owner;
+    check(!drain.take(other,2,0,0,-1,.75f,false,false),"wrong owner cannot enter queued scope");
+    drain={key,queue};check(!drain.take(key,2,1,0,-1,.75f,false,false),"mismatched native ordinal rejected");
+    drain={key,queue};check(!drain.take(key,2,0,1,-1,.75f,false,false),"unexpected pattern continuation cannot debit again");
+    drain={key,queue};check(!drain.take(key,2,0,0,-1,.5f,false,false),"charge payload is pinned to queued event");
+    image.put<unsigned>(Image::head,1);third.next=1;image.packet(3,third);
+    check(!b::snapshot(image.memory(),Image::barrel,queue)&&!queue.count,"cyclic native list returns no partial ownership");
+    third.next=~0u;image.packet(3,third);first.delay=std::numeric_limits<float>::quiet_NaN();image.packet(1,first);
+    check(!b::snapshot(image.memory(),Image::barrel,queue),"malformed native timing refused");
+    first.delay=.01f;image.packet(1,first);image.mutate=Image::head;image.reads=0;
+    check(!b::snapshot(image.memory(),Image::barrel,queue),"concurrent head change invalidates whole snapshot");
+    image.put<unsigned>(Image::head,1);image.mutate=Image::cells+0x40;image.reads=0;
+    check(!b::snapshot(image.memory(),Image::barrel,queue),"concurrent packet mutation invalidates whole snapshot");
+    image.mutate=0;image.packet(1,first);image.put<unsigned>(Image::head,~0u);
+    check(b::snapshot(image.memory(),Image::barrel,queue)&&!queue.count,"empty native queue is an empty scope");
+    image.put<unsigned>(Image::head,1);
+    for(unsigned i=1;i<=65;++i){auto p=first;p.ordinal=(i-1)%64;p.next=i==65?~0u:i+1;image.packet(i,p);}
+    check(!b::snapshot(image.memory(),Image::barrel,queue),"more than64 borrowed events refuse before installing scope");
