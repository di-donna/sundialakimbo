+inline constexpr std::uint64_t seed=0xcbf29ce484222325ULL;
+inline std::uint64_t mix(std::uint64_t hash,std::uint64_t value) noexcept {
+    for(unsigned i=0;i<8;++i){hash^=(value>>(i*8))&0xffU;hash*=0x100000001b3ULL;}
+    return hash;
+}
+template<std::size_t N> struct Seen {
+    std::array<std::uint64_t,N> keys{};unsigned count{};
+    [[nodiscard]] bool contains(std::uint64_t key) const noexcept {
+        for(unsigned i=0;i<count;++i)if(keys[i]==key)return true;
+        return false;
+    }
+    [[nodiscard]] bool full() const noexcept {return count>=N;}
+    /** True only for a new key that still fits the budget. */
+    [[nodiscard]] bool insert(std::uint64_t key) noexcept {
+        if(count>=N||contains(key))return false;
+        keys[count++]=key;return true;
+    }
+};
+/** Two budgets for one record kind: Rat King records never draw on the other pool. */
+template<std::size_t R,std::size_t O> struct Budget {
+    Seen<R> ratKing{};Seen<O> other{};
+    [[nodiscard]] bool full(bool rk) const noexcept {return rk?ratKing.full():other.full();}
+    [[nodiscard]] bool exhausted() const noexcept {return ratKing.full()&&other.full();}
+    [[nodiscard]] bool insert(std::uint64_t key,bool rk) noexcept {return rk?ratKing.insert(key):other.insert(key);}
+    [[nodiscard]] unsigned count() const noexcept {return ratKing.count+other.count;}
+};
+using Line=std::array<char,core::log::kLineCapacity>;
+template<class... T> void append(Line& line,std::size_t& used,const char* format,T... values) noexcept {
+    if(used+1>=line.size())return;
+    const int written=std::snprintf(line.data()+used,line.size()-used,format,values...);
+    if(written>0)used=used+static_cast<std::size_t>(written)<line.size()-1?used+static_cast<std::size_t>(written):line.size()-1;
+}
+inline void emit(const Line& line,std::size_t used) noexcept {
+    if(used)core::log::write(core::log::Channel::client,core::log::Level::info,std::string_view(line.data(),used));
+}
+inline unsigned long long hex(std::uint64_t v) noexcept {return static_cast<unsigned long long>(v);}
+inline bool rat_king_model(std::uint32_t tag) noexcept {
+    for(const auto model:ratKingModels)if(model==tag)return true;
+    return false;
+}
+inline bool rat_king_packet(const SoundPacket& packet) noexcept {
+    for(unsigned i=4;i<11;++i)for(const auto part:ratKingParts)if(packet[i]==part)return true;
+    return false;
+}
+inline std::uint64_t packet_hash(const SoundPacket& packet) noexcept {
+    std::uint64_t hash=seed;for(const auto word:packet)hash=mix(hash,word);
+    return hash;
+}
+/** Assembly tag of a component owner (entity+0x4C -> assembly+4), or 0. */
+inline std::uint32_t owner_assembly(const Memory& m,std::uint32_t owner) noexcept {
+    std::uintptr_t entity{},assembly{};std::uint32_t self{},handle{},tag{};
+    return resolve(m,owner,entity)&&read(m,entity+12,self)&&self==owner&&read(m,entity+0x4c,handle)
+        &&resolve(m,handle,assembly)&&read(m,assembly+4,tag)?tag:0;
+}
+
+struct Rig {
+    std::uintptr_t animation{},controller{},skeleton{},rig{},nodeTable{};
+    std::uint32_t self{},owner{},modelOwner{},controllerHandle{};
+    std::uint32_t animationTag{},skeletonTag{},rigTag{},controllerTag{};
+    std::uint64_t animationDefinition{},skeletonDefinition{},rigDefinition{},controllerDefinition{};
+    unsigned nodes{},modelCount{},ownedModels{};bool ratKing{},privateModel{},rejected{};int file{-1};
+    std::uint64_t examinedAt{};
+    std::array<std::uint32_t,maxModels> models{},modelKinds{};
+};
+struct Job {
+    std::uintptr_t key{},animation{},controller{},skeleton{},nodeTable{};
+    std::uint32_t self{},owner{},modelOwner{},animationTag{};
+    unsigned nodes{};int file{-1};std::uint64_t at{};
+};
+struct PoseFile {
+    std::uint32_t animation{},skeleton{},rig{},controller{},modelOwner{};unsigned nodes{};bool ratKing{},used{};
+    unsigned frames{},actionFrames{},residentFrames{},lastAction{0xffffffffU},lastBase{0xffffffffU};
+    std::uint64_t lastSample{},lastResident{},calls{};bool sampled{},residentSampled{};
+};
+// One handle per pose slot, opened at the slot's first sample and closed at
+// its last one. A last sample that cannot close the file itself (it lost the
+// slot to a concurrent export of the same rig, or its pose was unreadable)
+// leaves a pending close; the next export of that rig, or reset, closes the
+// file and writes the done line. The slot is claimed with an atomic flag,
+// never a lock, so no probe lock is held across CreateFileW/WriteFile/
+// CloseHandle and no other export waits on the file system.
+struct PoseIo {HANDLE handle{INVALID_HANDLE_VALUE};bool opened{},failed{};};
+
+/** Cheap first-person filter: an animation whose own controller (+0x44) has
+ *  the first-person weapon controller kind. identify() pins the same kinds;
+ *  this filter leaves every tag open. */
+inline bool first_person(const Memory& m,std::uintptr_t animation,std::uint32_t& self) noexcept {
+    std::array<std::uint32_t,2> animationHead{},controllerHead{};std::uint32_t handle{};std::uintptr_t controller{};
+    return read(m,animation,animationHead)&&animationHead[1]==animationKind&&read(m,animation+0x44,handle)
+        &&resolve(m,handle,controller)&&read(m,controller,controllerHead)&&controllerHead[1]==controllerKind
+        &&read(m,animation+0x24,self);
+}
+/** identify() without its tag pins: same structure, any first-person rig. */
+inline bool examine(const Memory& m,std::uintptr_t animation,Rig& out) noexcept {
+    out={};Rig r{};Header a{},s{},g{},c{};
+    std::uint32_t rigHandle{},skeletonHandle{};std::uint64_t rigOffset{},skeletonOffset{};
+    if(!header(m,animation,a)||a.kind!=animationKind||!read(m,animation+0x44,r.controllerHandle)
+        ||!read(m,animation+0x888,rigHandle)||!read(m,animation+0x890,rigOffset)
+        ||!read(m,animation+0x8d8,skeletonHandle)||!read(m,animation+0x8e0,skeletonOffset)
+        ||rigOffset||skeletonOffset)return false;
+    if(!resolve(m,skeletonHandle,r.skeleton)||!header(m,r.skeleton,s)||s.self!=skeletonHandle
+        ||s.kind!=skeletonKind||s.owner!=a.owner
+        ||!resolve(m,rigHandle,r.rig)||!header(m,r.rig,g)||g.self!=rigHandle||g.kind!=rigKind||g.owner!=a.owner
+        ||!resolve(m,r.controllerHandle,r.controller)||!header(m,r.controller,c)||c.self!=r.controllerHandle
+        ||c.kind!=controllerKind||c.owner!=a.owner)return false;
+    std::uint32_t back{},selected{},count{};
+    if(!read(m,r.skeleton+0x68,back)||back!=a.self||!read(m,r.controller+0x110,selected)||selected!=a.self
+        ||!read(m,r.controller+0x124,r.modelOwner)||!read(m,r.controller+0x128,count)||!count||count>maxModels)return false;
+    std::uintptr_t definition{};std::uint64_t nodes{},relative{};
+    if(!resolve(m,s.tag,definition)||s.definition>0x1000000||definition>0x00007fffffffffffULL-s.definition-0x98)return false;
+    definition+=s.definition;
+    if(!read(m,definition+0x80,nodes)||nodes<minNodes||nodes>maxNodes||!read(m,definition+0x88,relative)
+        ||relative>0x1000000||definition>0x00007fffffffffffULL-relative-0x98)return false;
+    r.nodeTable=definition+0x98+static_cast<std::uintptr_t>(relative);r.nodes=static_cast<unsigned>(nodes);
+    for(std::uint32_t i=0;i<count;++i){
+        std::uint32_t handle{};std::uintptr_t address{};Header model{};
+        if(!read(m,r.controller+0x130+8*i,handle))return false;
+        if(handle&&handle!=0xffffffff&&resolve(m,handle,address)&&header(m,address,model)&&model.self==handle){
+            r.models[r.modelCount]=model.tag;r.modelKinds[r.modelCount]=model.kind;
