+    retargeted.cancel();check(!retargeted.loading&&!retargeted.tube[0].active()&&!retargeted.tube[1].active(),
+        "weapon swap clears both tube phases while preserving round counts");
+}
+struct Store {
+    int loadedCount{4},reserves{20};bool current{true},ignoreLoaded{};unsigned writes{};
+    bool valid()const noexcept{return current;}
+    int loaded()const noexcept{return loadedCount;}
+    int reserve()const noexcept{return reserves;}
+    void set_loaded(int value)noexcept{++writes;if(!ignoreLoaded)loadedCount=value;}
+    void set_reserve(int value)noexcept{++writes;reserves=value;}
+    void publish()const noexcept{}
