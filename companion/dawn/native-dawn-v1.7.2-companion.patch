@@ -0,0 +1,520 @@
+#pragma once
+// Rat King Akimbo runtime v4b: the recording behind the hand-over reload
+// (rat_king_pose.h C2), its file format and the pair mirror. Pure: no OS call,
+// no allocation; rat_king_reload_file.h does the file I/O. Runtime v5: the
+// recorder recalibrated on the live game (rat_king.h D.2) and its diagnostics
+// (Measure, LogGate, describe).
+//
+// The recording is the user's own game: the native pre-correction export pose
+// of reload clip 80BC865F (actions 49/97), 67 knots x 77 bones relative to root
+// 0 (rat_king.h D.1-D.2). It never ships: memory and the local cache file only.
+// The big buffers live in Store, outside rat_king_pose::State (State::reset
+// assigns a fresh State, which must never put 330 KB on the render thread's
+// stack); akimbo.cpp keeps one static Store under alternatingLock.
+#include "alternating.h"
+#include "rat_king.h"
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <iterator>
+
+namespace dawn::client::hooks::akimbo::rat_king_reload {
+namespace rk=rat_king;
+using presentation::ActionClock;
+using presentation::Frame;
+using presentation::Quat;
+using presentation::Vec;
+using presentation::blend;
+using presentation::compose;
+using presentation::inverse;
+using presentation::valid;
+
+inline constexpr unsigned knots=rk::recordKnots,bones=rk::bones;
+using KnotPose=std::array<Frame,bones>;
+struct Recording {std::array<KnotPose,knots> knot{};};
+static_assert(sizeof(Recording)==165088);
+
+// Recording flags (Info::flags, file header +12). flagHeadTail: the head was
+// sampled by recordHeadPhase and the head/tail check ran (runtime v5: a
+// complete recording without it has a back-filled head, tFirst above
+// recordHeadPhase; rat_king.h D.2).
+inline constexpr std::uint32_t flagComplete=1,flagHeadTail=2,flagProvisional=4;
+struct Info {float tFirst{},tLast{},maxGap{},duration{},speed{};std::uint32_t samples{},flags{};};
+
+// Rejection reasons (bits; the probe's recRejectMask / recLastReason).
+namespace reason {
+inline constexpr std::uint32_t identity=1,draw=2,backwards=4,restart=8,wall=16,gap=32,aim=64,invalid=128;
+inline constexpr std::uint32_t coverage=0x100,magazineRest=0x200,magazineLow=0x400,magazineOut=0x800;
+inline constexpr std::uint32_t slideRest=0x1000,slideRacked=0x2000,grip=0x4000,headTail=0x8000,frames=0x10000,notBetter=0x20000;
+// Runtime v4 final (review F7): a reload that could have been recorded (no
+// complete recording kept) declined to arm because no frame of it came in the
+// arming window (runtime v5: a first frame after recordArmPhase .10; with draw
+// / aim / invalid when frames in the window were refused).
+inline constexpr std::uint32_t late=0x40000;
+}
+
+// Runtime v5: the values behind the last finished, aborted or declined
+// recording (akimbo.cpp logs them). firstSeen: the reload's first-seen phase;
+// tFirst..samples: the recording's (tFirst -1: it never armed); structured:
+// the structure checks ran (the fields below are filled): the grip's range
+// over every key, the slide at key 0 and its largest offset in the head window
+// (keys 0..checkSlideHeadLast), the largest slide and magazine offsets inside
+// their at-rest windows, the slide at key 50 (-1: key 53 not sampled), the
+// magazine at keys 12 / 24; headTail: that check ran, with root 72's and the
+// left hand's head/tail distances and root 72's angle.
+struct Measure {
+    float firstSeen{-1},tFirst{-1},tLast{-1},maxGap{-1};unsigned samples{};
+    bool structured{},headTail{};
+    float gripMin{},gripMax{},slideHead{},slideHeadMax{},slideRest{},slideRack{-1},magazineRest{},magazineOut{},magazineLow{};
+    float headTailMeters{-1},headTailDegrees{-1},headTailHand{-1};
+};
+
+// The recording store. inProgress/previous: the recorder's knots and last
+// sample; committed/info/valid: the accepted recording the hand-over plays;
+// dirty: committed changed since the last copy for the file writer; loaded:
+// committed came from the file.
+struct Store {
+    Recording inProgress{};
+    KnotPose previous{};
+    Recording committed{};
+    Info info{};
+    bool valid{},dirty{},loaded{};
+    void clear() noexcept {info={};valid=dirty=loaded=false;}
+    [[nodiscard]] bool complete() const noexcept {return valid&&(info.flags&flagComplete)!=0;}
+    // Runtime v5: a complete recording whose head was back-filled (no head/tail
+    // check): the next complete one with a sampled head replaces it.
+    [[nodiscard]] bool improvable() const noexcept {return complete()&&(info.flags&flagHeadTail)==0;}
+};
+
+// ---- Small math -------------------------------------------------------------------
+inline Vec sub(Vec a,Vec b) noexcept {return {a.x-b.x,a.y-b.y,a.z-b.z};}
+inline float length(Vec v) noexcept {return std::sqrt(v.x*v.x+v.y*v.y+v.z*v.z);}
+inline float angle(Quat a,Quat b) noexcept {
+    const Quat q=presentation::product({-a.x,-a.y,-a.z,a.w},b);
+    return 2*std::atan2(std::sqrt(q.x*q.x+q.y*q.y+q.z*q.z),std::abs(q.w));
+}
+
+// ---- Sampling ---------------------------------------------------------------------
+// Knot interpolation at clip phase u (lerp position and scale, nlerp rotation
+// with the sign fix: presentation::blend), the same as the recorder's fill.
+struct Bracket {unsigned k{};float f{};};
+inline Bracket bracket(float u) noexcept {
+    const float x=std::clamp(std::isfinite(u)?u:0.f,0.f,1.f)*static_cast<float>(knots-1);
+    const unsigned k=std::min(static_cast<unsigned>(x),knots-2);
+    return {k,std::clamp(x-static_cast<float>(k),0.f,1.f)};
+}
+inline Frame sample(const Recording& r,unsigned bone,float u) noexcept {
+    const auto b=bracket(u);
+    return b.f<=0?r.knot[b.k][bone]:b.f>=1?r.knot[b.k+1][bone]:blend(r.knot[b.k][bone],r.knot[b.k+1][bone],b.f);
+}
+// Every bone at u, composed with root (pose space).
+inline void sample(const Recording& r,float u,Frame root,std::array<Frame,80>& out) noexcept {
+    const auto b=bracket(u);
+    const auto& a=r.knot[b.k];const auto& c=r.knot[b.k+1];
+    for(unsigned i=0;i<bones;++i)out[i]=compose(root,b.f<=0?a[i]:b.f>=1?c[i]:blend(a[i],c[i],b.f));
+}
+
+// ---- Structure checks (rat_king.h D.2) -----------------------------------------------
+inline unsigned last_knot(float tLast) noexcept {
+    return std::min(knots-1,static_cast<unsigned>(std::max(0.f,tLast)*static_cast<float>(knots-1)+1e-4f));
+}
+inline float part_offset(const KnotPose& k,unsigned bone,Frame bind) noexcept {
+    return length(sub(compose(inverse(k[rk::rootBone]),k[bone]).p,bind.p));
+}
+// The knots next to a fast event (the magazine leaving at key 10 and slammed at
+// 33, the slide home at 53) hold a blend of the samples around them: the
+// at-rest windows shrink by the recording's own sample spacing (maxGap, in
+// knots, rounded up; at most 3 with recordMaxGap).
+inline unsigned blur_knots(float maxGap) noexcept {
+    const float k=std::clamp(std::isfinite(maxGap)?maxGap:rk::recordMaxGap,0.f,rk::recordMaxGap)*static_cast<float>(knots-1);
+    return static_cast<unsigned>(std::ceil(k-1e-3f));
+}
+// headTail: the head was sampled (flagHeadTail): run the head/tail check.
+// m (optional): the measured values (Measure), for the diagnostics.
+inline std::uint32_t structure(const Recording& r,float tLast,bool headTail,float maxGap,Measure* m=nullptr) noexcept {
+    std::uint32_t why{};
+    const unsigned last=last_knot(tLast),blur=blur_knots(maxGap);
+    Measure x{};x.gripMin=1e9f;x.gripMax=-1e9f;
+    if(m){m->structured=m->headTail=false;}
+    for(unsigned k=0;k<knots;++k){
+        const auto& K=r.knot[k];
+        for(unsigned i=0;i<bones;++i)if(!valid(K[i]))return reason::frames;
+        const float magazine=part_offset(K,74,rk::weaponBind2),slide=part_offset(K,75,rk::weaponBind3);
+        if(k+blur<=rk::checkMagazineRestLast||(k>=rk::knotSlam+blur&&k<=last)){
+            x.magazineRest=std::max(x.magazineRest,magazine);
+            if(magazine>rk::checkRestMeters)why|=reason::magazineRest;
+        }
+        // Runtime v5: the slide never beyond its travel; the head (keys
+        // 0..checkSlideHeadLast) may hold it anywhere within it (the blend out
+        // of the last fire pose); at rest from the head's end (plus the blur)
+        // to key 46 and after key 52.
+        if(!(slide<=rk::checkSlideTravelMeters))why|=reason::slideRest;
+        if(k==0)x.slideHead=slide;
+        if(k<=rk::checkSlideHeadLast)x.slideHeadMax=std::max(x.slideHeadMax,slide);
+        if(k<=last&&k>rk::checkSlideHeadLast+blur&&(k+blur<rk::checkSlideFirst||k>rk::checkSlideLast+blur)){
+            x.slideRest=std::max(x.slideRest,slide);
+            if(slide>rk::checkRestMeters)why|=reason::slideRest;
+        }
+        const float grip=length(sub(K[22].p,K[24].p));
+        x.gripMin=std::min(x.gripMin,grip);x.gripMax=std::max(x.gripMax,grip);
+        if(!(grip>=rk::checkGripMin&&grip<=rk::checkGripMax))why|=reason::grip;
+    }
+    x.magazineLow=part_offset(r.knot[rk::checkMagazineLowKnot],74,rk::weaponBind2);
+    x.magazineOut=part_offset(r.knot[rk::checkMagazineOutKnot],74,rk::weaponBind2);
+    if(!(x.magazineLow>=rk::checkMagazineLowMeters))why|=reason::magazineLow;
+    if(!(x.magazineOut>=rk::checkMagazineOutMeters))why|=reason::magazineOut;
+    if(last>=rk::checkSlideSampled){
+        x.slideRack=part_offset(r.knot[rk::checkSlideKnot],75,rk::weaponBind3);
+        if(!(x.slideRack>=rk::checkSlideMeters))why|=reason::slideRacked;
+    }
+    if(headTail){
+        const auto& head=r.knot[0];const auto& tail=r.knot[knots-1];
+        x.headTailMeters=length(sub(head[rk::rootBone].p,tail[rk::rootBone].p));
+        x.headTailDegrees=angle(head[rk::rootBone].q,tail[rk::rootBone].q)*(180/3.14159265f);
+        x.headTailHand=length(sub(head[21].p,tail[21].p));
+        if(!(x.headTailMeters<=rk::checkHeadTailMeters)||!(x.headTailDegrees<=rk::checkHeadTailDegrees)
+            ||!(x.headTailHand<=rk::checkHeadTailHandMeters))why|=reason::headTail;
+    }
+    if(m){
+        m->structured=true;m->headTail=headTail;
+        m->gripMin=x.gripMin;m->gripMax=x.gripMax;m->slideHead=x.slideHead;m->slideHeadMax=x.slideHeadMax;m->slideRest=x.slideRest;
+        m->slideRack=x.slideRack;m->magazineRest=x.magazineRest;m->magazineOut=x.magazineOut;m->magazineLow=x.magazineLow;
+        m->headTailMeters=x.headTailMeters;m->headTailDegrees=x.headTailDegrees;m->headTailHand=x.headTailHand;
+    }
+    return why;
+}
