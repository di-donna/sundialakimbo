+void phases(){
+    t::Hand h;int rounds=0,reserve=10;
+    check(h.start(inputs,rounds,3,reserve),"begin opening");
+    check(!h.start(inputs,rounds,3,reserve),"a second request does not restart the hand");
+    check(!h.advance(.25,inputs,rounds,3,reserve)&&h.phase==t::Phase::Opening,"opening never fills ammunition");
+    check(!h.advance(.25,inputs,rounds,3,reserve)&&h.phase==t::Phase::Inserting&&h.seconds==1,"first insertion samples empty duration");
+    check(!h.advance(.25,inputs,rounds,3,reserve),"insertion waits for native refill event");
+    int n=h.advance(.25,inputs,rounds,3,reserve);rounds+=n;reserve-=n;
+    check(n==1&&rounds==1&&reserve==9&&h.active(),"one insertion transfers one quantum while still reloading");
+    check(!h.advance(.25,inputs,rounds,3,reserve),"refill event cannot run twice");
+    check(!h.advance(.25,inputs,rounds,3,reserve)&&h.seconds==.5&&h.elapsed==0&&!h.refilled,"next insertion samples tactical duration");
+    n=h.advance(.25,inputs,rounds,3,reserve);rounds+=n;reserve-=n;
+    check(n==1&&rounds==2,"second insertion adds only its quantum");
+    check(!h.advance(.25,inputs,rounds,3,reserve)&&h.phase==t::Phase::Inserting,"non-full tube repeats insertion");
+    n=h.advance(.25,inputs,rounds,3,reserve);rounds+=n;reserve-=n;
+    check(n==1&&rounds==3,"final insertion caps at magazine capacity");
+    check(!h.advance(.25,inputs,rounds,3,reserve)&&h.phase==t::Phase::Closing,"full tube enters native closing phase");
+    check(!h.advance(.125,inputs,rounds,3,reserve)&&h.active(),"closing still blocks this hand");
+    check(!h.advance(.125,inputs,rounds,3,reserve)&&!h.active(),"closing completes without an extra refill");
+    check(rounds+reserve==10,"all phase transitions conserve ammunition");
+}
