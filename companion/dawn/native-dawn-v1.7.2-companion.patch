+    std::memcpy(&out.tag,bytes.data(),4);std::memcpy(&out.kind,bytes.data()+4,4);std::memcpy(&out.definition,bytes.data()+8,8);
+    std::memcpy(&out.self,bytes.data()+36,4);std::memcpy(&out.owner,bytes.data()+44,4);return true;
+}
