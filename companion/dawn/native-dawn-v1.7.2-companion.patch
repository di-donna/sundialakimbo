+inline Side recover(const Side& c,bool isLeft,float e,bool fromHold,const std::array<Frame,22>& liveArm,Frame liveGun,const Basis& b) noexcept {
+    Side o{};
+    if(c.role==Role::held){
+        // In its hand: blend into the live pose while the tuck unwinds.
+        const float s=smoothstep(e/(fromHold?rk::handoverHoldSeconds:rk::handoverHeldSeconds));
+        o.arm=blend_arm(c.arm,liveArm,s);o.gun=blend(c.gun,liveGun,s);o.tuck=c.tuck*(1-s);return o;
+    }
+    float x=e;std::array<Frame,22> from=c.arm;
+    if(c.role==Role::support){
+        // A free hand in view first drops below it (what is left of a drop).
+        const float drop=rk::handoverDropSeconds*(1-std::clamp(c.tuck,0.f,1.f));
