+}
+bool native_akimbo_barrel(const Memory& m,std::uintptr_t barrel,const Identity& id) noexcept {
+    // Retain each native core and projectile. Malfeasance's gear225 key
+    // 7A12BB6B selects content variant23 and its native explosive slug.
+    // Rat King (sidearm) values are read from core 8152AEA4 / content 8152AEA5
+    // (SIDEARM-RIG.md 3.5; the same reads reproduce every pin below).
+    const auto* registration=profiles::find(id.modelTag);
+    if(!registration) return false;
+    const auto& b=registration->barrel;
+    const bool generic=generic_gun_model(id.modelTag);gun_layout::Layout layout{};
+    if(generic&&!gun_layout::event_source(m,b,layout))return false;
+    // Sturm & Drang (tests-review F10, ruling 12): never eligible for the paired
+    // native route, whatever its content reads (Sturm is fired natively once).
+    if(sturm_drang_model(id.modelTag))return false;
+    if(!b.coreTag||barrel<0x10000+0xd70||barrel>0x00007ffffffff000ULL)return false;
+    const auto coreTag=b.coreTag,contentTag=b.contentTag,contentDefinition=b.contentDefinition;
+    const auto rootDefinition=b.rootDefinition,barrelDefinition=b.barrelDefinition,coreSize=b.coreSize;
+    const auto nativeProjectile=b.projectile,barrelFlags=b.flags;
+    const auto root=barrel-0xd70;
+    Header h{},contentHeader{};std::array<std::uint32_t,4> definition{};
+    std::int64_t parent{};std::uint32_t rootHandle{},contentHandle{},index{},overrideTag{};
+    std::uint64_t rootOffset{};std::uintptr_t content{};
+    if(!header(m,root,h)||h.tag!=coreTag||h.kind!=(generic?layout.rootKind:0x80bfdfeb)||h.definition!=rootDefinition||h.owner!=id.modelOwner
+        ||!read(m,barrel,definition)||definition!=std::array<std::uint32_t,4>{coreTag,0x80803865,barrelDefinition,0}
+        ||!read(m,barrel+0x10,parent)||parent!=-0xd80
+        ||!read(m,barrel+0x98,rootHandle)||rootHandle!=h.self
+        ||!read(m,barrel+0xa0,rootOffset)||rootOffset
+        ||!read(m,root+0x8c0,contentHandle)
+        ||!component(m,contentHandle,contentTag,0x80803ac9,h.owner,content,contentHeader)
+        ||contentHeader.definition!=contentDefinition
+        ||!read(m,content+0x68,index)||!content_selection::matches(b,index)
+        ||!read(m,content+0x60,overrideTag)||overrideTag!=0xffffffff)return false;
+
+    // Pin the existing single-projectile path. In particular, do not expand a
+    // Warden reskin or a pattern-transplant experiment into four projectiles.
+    std::uintptr_t asset{},rootAsset{},prop{};std::uint64_t size{},pattern{};
+    std::uint32_t projectile{},flags{};float delay{};
+    if(!content_selection::row(m,b,index,asset,prop))return false;
+    if(!read(m,prop+0xf0,projectile)||projectile!=nativeProjectile
+        ||!read(m,prop+0x110,pattern)||(!generic&&pattern)
+        ||!resolve(m,coreTag,rootAsset,4096)||!read(m,rootAsset,size)||size!=coreSize
+        ||!read(m,rootAsset+barrelDefinition+0xb70,flags)||flags!=barrelFlags
+        ||!read(m,rootAsset+barrelDefinition+0xe60,pattern)||(!generic&&pattern)
+        ||!read(m,rootAsset+barrelDefinition+0xec8,delay)||delay!=0)return false;
+    if(generic){
+        unsigned burstOverride{};
+        // CB9440 overrides live Barrel input22 with content+140 when nonzero.
+        // A direct-event adapter must check both sources of burst selection.
+        // Content+C0 is a source-pinned six-slot sequence override, not a
+        // continuous-fire flag. The compiler resolves its firing slot and the
+        // FX collector separately pins that sequence to this exact owner.
+        if(!read(m,prop+0x140,burstOverride)||burstOverride>(finite_burst_model(id.modelTag)?64u:1u))return false;
+    }
