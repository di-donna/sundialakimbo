+// ---- The cache writer's handshake (runtime v4 final, review F1/F6) ------------------------
+// akimbo.cpp: the animation thread, under alternatingLock, calls take(): while
+// no write runs it copies a dirty committed recording into the writer's image
+// and info, clears dirty and marks the writer busy; after releasing the lock it
+// calls submit(start), start() queues the thread-pool work item (false: no
+// writer can run, no work item or uninstalling: the copy is dropped for this
+// session and busy clears). The work item owns image and info until its last
+// step, finish(ok). A failed write asks for a retry: the next take() after it
+// marks the committed recording dirty again, at most recordWriteRetries times
+// in a row, not before recordWriteRetrySeconds (a transient sharing violation,
+// a scanner holding the target, an I/O error); a written file resets the
+// count. uninstall() joins the work item, then close(). Pure: atomics only.
+struct Persist {
+    std::atomic<bool> busy{};
+    std::atomic<unsigned> outcome{};   // writer -> animation thread: 0 none, 1 written, 2 failed
+    unsigned failures{};               // failed writes in a row (animation thread)
+    double retryAt{};                  // no copy before this (animation thread)
+    // Animation thread, under the store's lock. retried: a retry was scheduled.
+    bool take(Store& s,FileImage& image,Info& info,double now,bool& retried) noexcept {
+        retried=false;
+        if(busy.load(std::memory_order_acquire))return false;
+        const unsigned result=outcome.exchange(0,std::memory_order_acq_rel);
+        if(result==1)failures=0;
+        else if(result==2&&s.valid&&failures<rk::recordWriteRetries){
+            ++failures;retryAt=now+rk::recordWriteRetrySeconds;s.dirty=true;retried=true;
+        }
+        if(!s.dirty||!s.valid||now<retryAt)return false;
+        image.payload=s.committed;info=s.info;s.dirty=false;
+        busy.store(true,std::memory_order_release);return true;
+    }
+    // After the lock (only after a true take()).
+    template<class Start> void submit(Start&& start) noexcept {
+        if(!start())busy.store(false,std::memory_order_release);
+    }
+    // The work item's last step: it releases image and info.
+    void finish(bool ok) noexcept {
+        outcome.store(ok?1U:2U,std::memory_order_release);
+        busy.store(false,std::memory_order_release);
+    }
+    // uninstall(), after the join: no write is pending or running.
+    void close() noexcept {busy.store(false,std::memory_order_release);}
+    // State reset (uninstall, after the hooks are gone).
+    void reset() noexcept {busy.store(false);outcome.store(0);failures=0;retryAt=0;}
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/rat_king_reload_file.h b/Dawn/src/client/hooks/akimbo/rat_king_reload_file.h
new file mode 100644
index 0000000000000000000000000000000000000000..e9882b5c1e66a43f5e7a71fc7ceec37008233964
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/rat_king_reload_file.h
@@ -0,0 +1,99 @@
+#pragma once
+// Rat King Akimbo runtime v4b: the local recording cache file
+// (Dawn\cache\akimbo-rat-king-reload.bin, rat_king_reload.h FileImage).
+// Never on the animation thread and never under an akimbo lock: akimbo.cpp
+// loads it in install() (before any hook is attached) and writes it from a
+// thread-pool work item, which uninstall() joins before the module goes away;
+// rat_king_reload::Persist is the handshake (a failed write is retried).
+// The write follows the content-manifest cache writer: a writer-owned sibling
+// final.PID.TID.SEQ.tmp (core::path::remove_stale_siblings clears a crashed
+// writer's), flushed, closed, reopened and compared byte for byte, then one
+// MoveFileExW replace with write-through; the sibling is deleted on failure.
+#include "rat_king_reload.h"
+#include <Windows.h>
+#include <array>
+#include <cstdint>
+#include <cstring>
+
+namespace dawn::client::hooks::akimbo::rat_king_reload {
+// Reads and validates the file at path into image (the caller's staging
+// buffer, 165,216 B). Anything but Load::loaded leaves info cleared.
+inline Load load_file(const wchar_t* path,FileImage& image,Info& info) noexcept {
+    info={};
+    if(!path)return Load::io;
+    const HANDLE file=CreateFileW(path,GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL|FILE_FLAG_SEQUENTIAL_SCAN,nullptr);
+    if(file==INVALID_HANDLE_VALUE){
+        const DWORD error=GetLastError();
+        return error==ERROR_FILE_NOT_FOUND||error==ERROR_PATH_NOT_FOUND?Load::missing:Load::io;
+    }
+    LARGE_INTEGER size{};DWORD got{};
+    Load result=Load::io;
+    if(GetFileSizeEx(file,&size)!=FALSE){
+        if(size.QuadPart!=static_cast<LONGLONG>(sizeof(FileImage)))result=Load::size;
+        else if(ReadFile(file,&image,static_cast<DWORD>(sizeof(FileImage)),&got,nullptr)!=FALSE&&got==sizeof(FileImage))
+            result=validate(image,got,info);
+    }
+    (void)CloseHandle(file);
+    return result;
+}
+
+namespace detail {
+inline volatile LONG temporaryCounter{};
+inline bool append_hex(wchar_t* path,std::size_t& length,std::size_t capacity,DWORD value) noexcept {
+    constexpr wchar_t digits[]=L"0123456789ABCDEF";
+    if(length+10>=capacity)return false;
+    path[length++]=L'.';
+    for(int shift=28;shift>=0;shift-=4)path[length++]=digits[(value>>shift)&15U];
+    path[length]=L'\0';return true;
+}
+// final.PID.TID.SEQ.tmp (the names core::path::remove_stale_siblings recognises).
+inline bool temporary_path(const wchar_t* finalPath,LONG sequence,std::array<wchar_t,32768>& out) noexcept {
+    std::size_t length=0;
+    while(finalPath[length]){if(length+1>=out.size())return false;out[length]=finalPath[length];++length;}
+    out[length]=L'\0';
+    if(!append_hex(out.data(),length,out.size(),GetCurrentProcessId())||!append_hex(out.data(),length,out.size(),GetCurrentThreadId())
+        ||!append_hex(out.data(),length,out.size(),static_cast<DWORD>(sequence))||length+5>=out.size())return false;
+    std::memcpy(out.data()+length,L".tmp",5*sizeof(wchar_t));
+    return true;
+}
+// The reopened sibling equals image byte for byte (streamed, no second 165 KB buffer).
+// Reading is shared (review F1), as the content-manifest cache reader's reopen
+// does: an indexer or a scanner reading the new sibling must not fail the write.
+inline bool same_file(const wchar_t* path,const FileImage& image) noexcept {
+    const HANDLE file=CreateFileW(path,GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL|FILE_FLAG_SEQUENTIAL_SCAN,nullptr);
+    if(file==INVALID_HANDLE_VALUE)return false;
+    LARGE_INTEGER size{};bool same=GetFileSizeEx(file,&size)!=FALSE&&size.QuadPart==static_cast<LONGLONG>(sizeof(FileImage));
+    const auto* expected=reinterpret_cast<const unsigned char*>(&image);
+    std::array<unsigned char,4096> chunk{};std::size_t offset=0;
+    while(same&&offset<sizeof(FileImage)){
+        const auto want=static_cast<DWORD>(std::min<std::size_t>(chunk.size(),sizeof(FileImage)-offset));DWORD got{};
+        same=ReadFile(file,chunk.data(),want,&got,nullptr)!=FALSE&&got==want&&!std::memcmp(chunk.data(),expected+offset,want);
+        offset+=want;
+    }
+    (void)CloseHandle(file);
+    return same&&checksum(image)==image.header.checksum;
+}
+}
+
+// Writes image (an encoded FileImage) to finalPath through a verified sibling.
+inline bool write_file(const wchar_t* finalPath,const FileImage& image) noexcept {
+    if(!finalPath||!*finalPath)return false;
+    static std::array<wchar_t,32768> temporary{}; // the writer runs one work item at a time
+    HANDLE file=INVALID_HANDLE_VALUE;
+    for(unsigned attempt=0;attempt<8&&file==INVALID_HANDLE_VALUE;++attempt){
+        if(!detail::temporary_path(finalPath,InterlockedIncrement(&detail::temporaryCounter),temporary))return false;
+        file=CreateFileW(temporary.data(),GENERIC_READ|GENERIC_WRITE,0,nullptr,CREATE_NEW,FILE_ATTRIBUTE_NORMAL|FILE_FLAG_SEQUENTIAL_SCAN,nullptr);
+        if(file==INVALID_HANDLE_VALUE&&GetLastError()!=ERROR_FILE_EXISTS)return false;
+    }
+    if(file==INVALID_HANDLE_VALUE)return false;
+    DWORD written{};
+    bool ok=WriteFile(file,&image,static_cast<DWORD>(sizeof(FileImage)),&written,nullptr)!=FALSE&&written==sizeof(FileImage);
+    ok=FlushFileBuffers(file)!=FALSE&&ok;
+    ok=CloseHandle(file)!=FALSE&&ok;
+    ok=ok&&detail::same_file(temporary.data(),image);
+    // The final name changes only after the sibling reopens as the complete image.
+    ok=ok&&MoveFileExW(temporary.data(),finalPath,MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH)!=FALSE;
+    if(!ok)(void)DeleteFileW(temporary.data());
+    return ok;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/rat_king_stretch.h b/Dawn/src/client/hooks/akimbo/rat_king_stretch.h
new file mode 100644
index 0000000000000000000000000000000000000000..a1180255b991b0065db9bf03dd85ccdc29a5aa96
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/rat_king_stretch.h
@@ -0,0 +1,181 @@
+#pragma once
+// Rat King Akimbo runtime v6: the reload kRatKingReloadStretch (1.8) times
+// slower (rat_king.h "Reload stretch"). Pure: every game read goes through
+// Memory (fail closed). akimbo.cpp's capacity_hook, the existing detour on the
+// float property getter exe+0xB8B7F0, asks owns_reload_time() for the one
+// caller that reads a reload controller's reload time, and returns
+// stretched(native) for the private Rat King Akimbo only.
+//
+// VERIFIED (text.bin build 86657 and the drawn-akimbo dump
+// retained-captures/akimbo-drawn-20260922-213453.dmp, read-only; the
+// evidence is local-evidence/rat-king-akimbo\reload-speed\data\evidence_disasm.txt):
+// - 0xD009A0 (kind 2, branch 0xD00AD5; reached from reload start through the
+//   reload-controller interface 815B8946 method 11, 0xD01A60) reads
+//   D = B8B7F0(ctrl + (loaded == 0 ? 0x140 : 0x110)) at 0xD00B5D (return
+//   0xD00B62), the only read of that property there, and builds the whole
+//   gameplay timeline from D alone: ctrl+0x178 = ticks(D), refill at .5 D
+//   (+0x180), fire allowed from .85 D (+0x190 / +0x198, 0xCF35B0), +0x1A0 at
+//   .85 D, the end at D (+0x188); it returns D, which sets the reload
+//   behaviour's countdown and the first-person clip speed 2.2 / D. So a D
+//   stretched before it is used stretches animation and gameplay together.
+// - The reload controller is embedded in the core root 8152AEA4 at +0x2710
+//   (header {8152AEA4, 80803845, 0x6490}, parent -0x2720 at +0x10, interface
+//   binding {80803844, _, root, 80803844, 0x2710} at +0x20, magazine link
+//   {root, 80803A0F, 0x24D0} at +0x1B8). Its reload-time properties are float
+//   property records at +0x110 (tactical) and +0x140 (empty): +4 the encoded
+//   current value (B8B7F0 decodes it), +0xC the root's handle, +0x10 the
+//   record's offset in the root (0x2820 / 0x2850), +0x20 {8152AEA4, 808045C4}
+//   and +0x28 the definition offset (0x6560 / 0x6578). The dump: D = 1.811 s,
+//   ctrl+0x178 = 1219165 ticks at 673200 / s.
+// - The core root's owner walk (hud::detail::rat_king_akimbo_owner, the HUD's
+//   and Rat Pack's) returns ok on the dump's Rat King Akimbo root and otherArt
+//   for native Rat King's art.
+// Not required (recorded for the log only): record +8 (1372FFCF in the dump,
+// not an immediate in the image), record +0x18 (FFFFFFFF, possibly a modifier
+// link) and the binding word ctrl+0x24 (6). A buff that changes the property
+// keeps these checks.
+// Runtime v6 review F1: whose weapon (rat_king.h "Reload stretch"). decide()
+// classifies an owned reload with Rat Pack's S5 walk (owner_player: the core
+// root's owner entity +0x3C is the player entity; the cached local player or
+// the only player is local) when given the module base, and refuses all but
+// the local player's when Players::remote is false. VERIFIED on the dump: the
+// core root's owner is the weapon entity 45FAA744 (Rat Pack's weapon script
+// has the same owner), whose parent is the player 78FAA748, the only player.
+#include "hud.h"
+#include "rat_king.h"
+#include "rat_pack.h"
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+namespace dawn::client::hooks::akimbo::rat_king_stretch {
+// ---- The read (VERIFIED; guards in akimbo.cpp supported_code) ------------------
+inline constexpr std::uintptr_t readCall=0xd00b5d,readReturn=0xd00b62;
+// ---- Layout (VERIFIED, the dump) ------------------------------------------------
+inline constexpr std::uint64_t controllerOffset=0x2710,magazineOffset=0x24d0;
+inline constexpr std::uint64_t tacticalField=0x110,emptyField=0x140;
+inline constexpr std::uint64_t tacticalDefinition=0x6560,emptyDefinition=0x6578;
+inline constexpr std::uint32_t propertyClass=0x808045c4u;
+inline constexpr std::uint32_t controllerKind=0x80803845u,controllerInterface=0x80803844u,magazineClass=0x80803a0fu;
+inline constexpr std::uint64_t controllerDefinition=0x6490;
+inline constexpr std::int64_t controllerParent=-0x2720;
+inline constexpr std::uint32_t coreKind=0x80bfdfebu;
+inline constexpr std::uint64_t coreDefinition=13616;
+// A native reload time outside this range (seconds) passes through unchanged.
+inline constexpr float minSeconds=.2f,maxSeconds=10.f;
+
+// Reasons (bits; the probe's stretchLastReason). record: not a Rat King core
+// reload-time record (the call is not a candidate); the rest: a candidate
+// refused at that step. disabled: kRatKingReloadStretchApply is false.
+// Runtime v6 review F1, only with Players::remote false: notLocal = neither the
+// cached local player nor the only player; remote = and the cached local player
+// is a live entity (another player's weapon, as far as the cache can tell).
+namespace reason {
+inline constexpr std::uint32_t record=1,controller=2,root=4,entity=8,rows=0x10,packet=0x20,changed=0x40,otherArt=0x80,value=0x100,disabled=0x200;
+inline constexpr std::uint32_t notLocal=0x400,remote=0x800;
+}
+struct Verdict {
+    bool candidate{};           // a Rat King core (8152AEA4) reload-time record (tactical or empty)
+    bool owned{};               // and the private Rat King Akimbo's (every check passed)
+    std::uint32_t reasons{};
+    std::uint64_t field{};      // 0x110 tactical / 0x140 empty (candidates)
+    std::uintptr_t root{};
+    std::uint32_t owner{};      // the core root's owner entity (owned verdicts)
+    // Diagnostics only (never checked): record +8, record +0x18, ctrl +0x24.
+    std::uint32_t recordWord{},linkWord{},bindingWord{};
+};
+
+/** Qualifies the property record the reload-time read at readReturn passes to
+ * B8B7F0. Every read fails closed; the record and the root header are read
+ * again after the owner walk. */
+inline Verdict owns_reload_time(const Memory& m,std::uintptr_t property) noexcept {
+    using namespace hud::detail;
+    Verdict v{};
+    if(property<0x10000+controllerOffset+emptyField||property>0x00007ffffffff000ULL){v.reasons|=reason::record;return v;}
+    std::array<std::byte,0x30> r{};
+    if(!read(m,property,r)){v.reasons|=reason::record;return v;}
+    const auto handle=at<std::uint32_t>(r,0xc);const auto offset=at<std::uint64_t>(r,0x10);const auto definition=at<std::uint64_t>(r,0x28);
+    v.recordWord=at<std::uint32_t>(r,8);v.linkWord=at<std::uint32_t>(r,0x18);
+    const bool tactical=offset==controllerOffset+tacticalField,empty=offset==controllerOffset+emptyField;
+    if(at<std::uint32_t>(r,0x20)!=rat_king::core||at<std::uint32_t>(r,0x24)!=propertyClass||!(tactical||empty)
+        ||definition!=(tactical?tacticalDefinition:emptyDefinition)){v.reasons|=reason::record;return v;}
+    v.candidate=true;v.field=offset-controllerOffset;
+    const std::uintptr_t controller=property-static_cast<std::uintptr_t>(v.field),root=property-static_cast<std::uintptr_t>(offset);
+    v.root=root;
+    // The reload controller embedded at root+0x2710: header, parent, interface binding, magazine link.
+    std::array<std::byte,0x38> c{};std::array<std::byte,0x10> link{};
+    if(!read(m,controller,c)||at<std::uint32_t>(c,0)!=rat_king::core||at<std::uint32_t>(c,4)!=controllerKind
+        ||at<std::uint64_t>(c,8)!=controllerDefinition||at<std::int64_t>(c,0x10)!=controllerParent
+        ||at<std::uint32_t>(c,0x20)!=controllerInterface||at<std::uint32_t>(c,0x28)!=handle||at<std::uint32_t>(c,0x2c)!=controllerInterface
+        ||at<std::uint64_t>(c,0x30)!=controllerOffset
+        ||!read(m,controller+0x1b8,link)||at<std::uint32_t>(link,0)!=handle||at<std::uint32_t>(link,4)!=magazineClass
+        ||at<std::uint64_t>(link,8)!=magazineOffset){v.reasons|=reason::controller;return v;}
+    v.bindingWord=at<std::uint32_t>(c,0x24);
+    // The core root: its header (self = the record's handle), then the private owner walk.
+    Header h{};
+    if(!header(m,root,h)||h.tag!=rat_king::core||h.kind!=coreKind||h.definition!=coreDefinition||h.self!=handle){
+        v.reasons|=reason::root;return v;
+    }
+    switch(rat_king_akimbo_owner(m,root,h)){
+    case OwnerWalk::ok:break;
+    case OwnerWalk::entity:v.reasons|=reason::entity;return v;
+    case OwnerWalk::rows:v.reasons|=reason::rows;return v;
+    case OwnerWalk::packet:v.reasons|=reason::packet;return v;
+    case OwnerWalk::changed:v.reasons|=reason::changed;return v;
+    case OwnerWalk::otherArt:v.reasons|=reason::packet|reason::otherArt;return v;
+    }
+    std::array<std::byte,0x30> again{};Header after{};
+    if(!read(m,property,again)||at<std::uint32_t>(again,0xc)!=handle||at<std::uint64_t>(again,0x10)!=offset
+        ||at<std::uint64_t>(again,0x28)!=definition||!header(m,root,after)||after!=h){v.reasons|=reason::changed;return v;}
+    v.owner=h.owner;v.owned=true;return v;
+}
+inline bool plausible(float native) noexcept {return std::isfinite(native)&&native>=minSeconds&&native<=maxSeconds;}
+inline float stretched(float native) noexcept {return native*rat_king::kRatKingReloadStretch;}
+
+// ---- Whose weapon (runtime v6 review F1) ---------------------------------------
+// none: not classified (no module base given); local: the weapon entity's parent
+// is the cached local player (a first-person akimbo's owner) or the only player;
+// remote: the cached local player is a live entity and not the parent; unknown:
+// neither can be told (no cache and several players, or an unreadable walk).
+enum class Owner : std::uint8_t {none,local,remote,unknown};
+/** Rat Pack's S5 walk (rat_pack.h qualify) from the weapon entity: its self at
+ * +0x0C, its parent (+0x3C) a live entity, then local / remote / unknown.
+ * player: the parent (0 when the walk failed). Every read fails closed
+ * (unknown). */
+inline Owner owner_player(const Memory& m,std::uintptr_t exe,std::uint32_t weaponEntity,std::uint32_t local,std::uint32_t& player) noexcept {
+    using namespace hud::detail;
+    player=0;
+    std::uintptr_t entity{},playerAddress{};std::uint32_t self{},parent{},parentSelf{};
+    if(!weaponEntity||!resolve(m,weaponEntity,entity)||!read(m,entity+rat_pack::entitySelf,self)||self!=weaponEntity
+        ||!read(m,entity+rat_pack::entityParent,parent)||!parent||!resolve(m,parent,playerAddress)
+        ||!read(m,playerAddress+rat_pack::entitySelf,parentSelf)||parentSelf!=parent)return Owner::unknown;
+    player=parent;
+    if(parent==local||(exe&&rat_pack::detail::only_player(m,exe,parent)))return Owner::local;
+    return local&&rat_pack::detail::live_entity(m,local)?Owner::remote:Owner::unknown;
+}
+// exe: the module base (0: no classification); local: Rat Pack's cached local
+// player; remote: stretch another player's (or an unknown owner's) Rat King
+// Akimbo too (akimbo.cpp kRatKingReloadStretchRemote).
+struct Players {std::uintptr_t exe{};std::uint32_t local{};bool remote{true};};
+
+/** What capacity_hook returns for the reload-time read (the caller already
+ * matched readReturn): native x kRatKingReloadStretch for the private Rat King
+ * Akimbo with a plausible native value and apply on; native otherwise.
+ * reasons: 0 when applied; for a candidate the refusal's bits (value: the
+ * native time outside minSeconds..maxSeconds; disabled: apply off; runtime v6
+ * review F1: notLocal / remote with players.remote false). owner / player: the
+ * owned reload's classification (Owner::none without players.exe). */
+struct Decision {Verdict verdict{};float value{};std::uint32_t reasons{};bool applied{};Owner owner{};std::uint32_t player{};};
+inline Decision decide(const Memory& m,std::uintptr_t property,float native,bool apply,const Players& players={}) noexcept {
+    Decision d{};d.verdict=owns_reload_time(m,property);d.value=native;
+    if(!d.verdict.candidate){d.reasons=d.verdict.reasons;return d;}
+    d.reasons=d.verdict.reasons|(plausible(native)?0U:reason::value)|(apply?0U:reason::disabled);
+    if(d.verdict.owned&&players.exe){
+        d.owner=owner_player(m,players.exe,d.verdict.owner,players.local,d.player);
+        if(!players.remote&&d.owner!=Owner::local)d.reasons|=reason::notLocal|(d.owner==Owner::remote?reason::remote:0U);
+    }
+    if(d.verdict.owned&&!d.reasons){d.value=stretched(native);d.applied=true;}
+    return d;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/rat_pack.h b/Dawn/src/client/hooks/akimbo/rat_pack.h
new file mode 100644
index 0000000000000000000000000000000000000000..5c96ab0b2fb1455393bf37c870f299f308ada0c5
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/rat_pack.h
@@ -0,0 +1,517 @@
+#pragma once
+// Rat Pack for Rat King Akimbo: "the pair counts as a pack". While the private
+// akimbo (item CF60DEE4) is held by the local player, the Rat King weapon
+// script's linked Rat Pack count reads one more than the aura reports, so one
+// damage/reload stack is active solo; real allies still add their own stacks.
+//
+// Evidence (read-only, the drawn-akimbo dump retained-captures/
+// akimbo-drawn-20260922-213453.dmp, exe base 7FF745B90000, build 86657; the
+// Rat Pack reverse-engineering notes in local-evidence/rat-king-akimbo\ratpack-re and
+// the phase-3 hook spec). VERIFIED = read in the dump and its code image.
+// INFERRED = reasoned, not visible in a dump.
+//
+// VERIFIED count chain: the Rat Pack aura script (tag 81532CA7, owned by the
+// player) variable 1 is linked into variable 68 of the Rat King weapon script
+// (tag 8152AEA6, owned by the weapon entity) through link-in slot 5; variable
+// 29 is a plain copy of 68 (bytecode 3C 00 3E 00), and both per-tick effects of
+// perk 513 fire only while variable 29 is in [1, 6]. Solo the aura writes 0.
+// Values are 16-byte vectors with the scalar in every lane (aura variable 0
+// holds (1,1,1,1) in the dump). The only writer of variable 68 is the linked-
+// variable setter at exe+0x582A60, from link propagation (return 0x5816D1)
+// and from the first sync when the link connects (return 0x5803B7, through
+// 0x5803E0's tail jump). The unlink resets (0x585A59, 0x585D11) write the
+// default 0 and stay native.
+//
+// This header is pure: every game read goes through Memory (fail closed), the
+// setter's original is a callable, and logging is a callable, so the offline
+// tests drive it with a fake Memory built from the dump bytes.
+#include "hud.h"
+#include "rat_king.h"
+#include <array>
+#include <atomic>
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+namespace dawn::client::hooks::akimbo::rat_pack {
+// ---- Hook target and accepted callers (VERIFIED, guards in supported_code) --
+inline constexpr std::uintptr_t setVariable=0x582a60;     // SetVariable(component, index, const vec4*)
+inline constexpr std::uintptr_t propagateReturn=0x5816d1; // LinkPropagate 0x5814B0, call at 0x5816CC
+inline constexpr std::uintptr_t connectReturn=0x5803b7;   // connect loop 0x580230 -> 0x5803E0 -> jmp at 0x580667
+
+// ---- Weapon script and aura (VERIFIED) ----------------------------------
+inline constexpr std::uint32_t scriptTag=0x8152aea6u,auraTag=0x81532ca7u,scriptKind=0x80809790u;
+inline constexpr std::uint64_t scriptDefinition=0x1638;
+inline constexpr std::int32_t countIndex=68,gateIndex=29;  // 68 linked count, 29 = copy of 68 (perk 513's gate)
+inline constexpr std::uint32_t countHash=0x8df0b331u,gateHash=0x7366b825u,linkNamespace=0x5f6317d5u;
+inline constexpr std::int16_t countLink=5;                // node 68's link slot
+inline constexpr std::uint32_t auraCount=0x80000001u;     // link-in source: aura variable 1 (bit 31 marks a variable)
+inline constexpr std::uint64_t auraVariables=2;
+inline constexpr float stackCap=6.f;                      // perk 513 gates on [1, 6]
+
+// ---- Layout (VERIFIED: 0x582A60, 0x5814B0, 0x5803E0 and the dump) ---------
+// Component header: +0 tag, +4 kind, +8 u64 definition offset, +0x24 self,
+// +0x2C owner. Tables are i64 self-relative offsets to {u64 count, pad,
+// entries}: variables at +0x58 (16 bytes each), link-ins at +0x98 (16 bytes:
+// source, source variable | bit 31, next, next slot). Definition = resolve(tag)
+// + definition offset: nodes at +0xE0 (0x70 bytes each, +0 name hash, +0x48
+// i16 link slot), links at +0x110 (12 bytes: namespace, name hash, variable).
+inline constexpr unsigned variablesField=0x58,linkInField=0x98,nodesField=0xe0,linksField=0x110;
+inline constexpr unsigned tableHeader=0x10,variableBytes=16,linkInBytes=16,nodeBytes=0x70,nodeLinkSlot=0x48,linkBytes=12;
+// Owner entity: +0x0C self, +0x3C parent (the player entity), +0x4C assembly.
+inline constexpr unsigned entitySelf=0x0c,entityParent=0x3c;
+
+// ---- Player array (VERIFIED: the game's own index check 0x34E830, the
+// iterator at 0x4AEDC1 and many readers of cell +0x54) ------------------------
+// bitmap = [[[exe+0x1F90E10]+8]+0x10]; cells at [exe+0x1F90E18], stride u32
+// [exe+0x1F90E20] = 0x1E0, capacity u32 [exe+0x1F90E24] = 32; cell +0x54 =
+// player entity handle. The dump: bitmap 1, cell 0 +0x54 = the player.
+inline constexpr std::uintptr_t playersRoot=0x1f90e10,playersCells=0x1f90e18,playersStride=0x1f90e20,playersCapacity=0x1f90e24;
+inline constexpr std::uint32_t playerCellBytes=0x1e0,playerCellEntity=0x54,maxPlayers=32;
+
+// Reasons: one bit per failed stage (S1..S5), plus the step that failed.
+namespace reason {
+inline constexpr std::uint32_t header=1u<<0;       // S1: not the Rat King weapon script (tag/kind/definition/self/owner)
+inline constexpr std::uint32_t definition=1u<<1;   // S2: definition nodes 68/29 or link entry 5 differ
+inline constexpr std::uint32_t link=1u<<2;         // S3: link-in slot 5 is not the aura's variable 1
+inline constexpr std::uint32_t owner=1u<<3;        // S4: the owner is not Rat King Akimbo
+inline constexpr std::uint32_t player=1u<<4;       // S5: not the local player's
+inline constexpr std::uint32_t value=1u<<8;        // S3: the written word is not aura variable 1
+inline constexpr std::uint32_t entity=1u<<9;       // S4: weapon entity or assembly
+inline constexpr std::uint32_t rows=1u<<10;        // S4: assembly rows
+inline constexpr std::uint32_t packet=1u<<11;      // S4: sound packet is not the private art (native Rat King)
+inline constexpr std::uint32_t changed=1u<<12;     // S4: the owner walk changed while it was read
+inline constexpr std::uint32_t playerEntity=1u<<13;// S5: weapon parent is not a readable entity
+inline constexpr std::uint32_t auraOwner=1u<<14;   // S5: the aura is not the weapon parent's
+inline constexpr std::uint32_t notLocal=1u<<15;    // S5: neither the cached local player nor the only player
+// Lasting failures (review R2/R3): the weapon cannot become the local akimbo.
+inline constexpr std::uint32_t otherArt=1u<<16;    // S4: the packet lists another weapon's art (native Rat King)
+inline constexpr std::uint32_t remote=1u<<17;      // S5: the cached local player is a live entity and not the parent
+inline constexpr std::uint32_t lasting=otherArt|remote;
+}
+struct Verdict {
+    bool candidate{};   // the component's tag is 8152AEA6 (recorded and logged)
+    bool structural{},akimbo{},local{},apply{};
+    std::uint32_t reasons{},self{},owner{},player{};
+    std::uintptr_t source{};   // S3: the aura's variable 1, the word the link copies into 68
+};
+
+namespace detail {
+using hud::detail::read;
+using hud::detail::resolve;
+using hud::detail::Header;
+inline bool offset(std::uintptr_t base,std::uint64_t add,std::uintptr_t& out) noexcept {
+    if(base<0x10000||base>0x00007fffffffffffULL||add>0x00007fffffffffffULL-base)return false;
+    out=base+add;return true;
+}
+// A self-relative table: base = field + i64[field]. Zero means none.
+inline bool table(const Memory& m,std::uintptr_t field,std::uintptr_t& base) noexcept {
+    std::int64_t relative{};
+    if(!read(m,field,relative)||!relative)return false;
+    base=field+static_cast<std::uintptr_t>(relative);
+    return base>=0x10000&&base<=0x00007fffffffffffULL;
+}
+inline bool table_count(const Memory& m,std::uintptr_t base,std::uint64_t& count) noexcept {
+    return read(m,base,count)&&count<=0x10000;
+}
+// solo(P): the player array holds exactly one player and it is P.
+inline bool only_player(const Memory& m,std::uintptr_t exe,std::uint32_t player) noexcept {
+    std::uintptr_t root{},allocator{},bitmap{},cells{},cell{};std::uint32_t capacity{},bits{},stride{},entity{};
+    if(!read(m,exe+playersRoot,root)||!read(m,root+8,allocator)||!read(m,allocator+0x10,bitmap)
+        ||!read(m,exe+playersCapacity,capacity)||capacity<1||capacity>maxPlayers||!read(m,bitmap,bits))return false;
+    if(capacity<32)bits&=(1u<<capacity)-1;
+    if(std::popcount(bits)!=1)return false;
+    const auto index=static_cast<std::uint32_t>(std::countr_zero(bits));
+    return read(m,exe+playersStride,stride)&&stride==playerCellBytes&&read(m,exe+playersCells,cells)
+        &&offset(cells,static_cast<std::uint64_t>(index)*playerCellBytes+playerCellEntity,cell)
+        &&read(m,cell,entity)&&entity==player;
+}
+// A live entity: the handle resolves and the entity's self (+0x0C) is it.
+inline bool live_entity(const Memory& m,std::uint32_t h) noexcept {
+    std::uintptr_t a{};std::uint32_t self{};
+    return resolve(m,h,a)&&read(m,a+entitySelf,self)&&self==h;
+}
+}
+
+/** Qualifies one SetVariable(c, 68, value) for the +1 (spec stages S1..S5).
+ * value: the source word being written (0 skips the strict source check, for
+ * a resync). local: the cached local player (0 when unknown). exe: the
+ * module base, for the player array. Every read fails closed. */
+inline Verdict qualify(const Memory& m,std::uintptr_t exe,std::uintptr_t c,std::uintptr_t value,std::uint32_t local) noexcept {
+    using namespace detail;
+    Verdict v{};
+    std::uint32_t tag{};
+    v.candidate=read(m,c,tag)&&tag==scriptTag;
+    // S1 header.
+    Header h{};
+    if(!v.candidate||!hud::detail::header(m,c,h)||h.tag!=scriptTag||h.kind!=scriptKind||h.definition!=scriptDefinition){
+        v.reasons|=reason::header;return v;
+    }
+    v.self=h.self;v.owner=h.owner;
+    // S2 definition: node 68 is the count on link slot 5, node 29 the gate
+    // variable, link entry 5 subscribes to the aura's 0x7366B825 into 68.
+    {
+        std::uintptr_t data{},def{},nodes{},links{},node{},entry{};std::uint64_t nodeCount{},linkCount{};
+        std::uint32_t countName{},gateName{};std::int16_t slot{};std::array<std::uint32_t,3> linkEntry{};
+        const bool ok=resolve(m,scriptTag,data)&&offset(data,scriptDefinition,def)
+            &&table(m,def+nodesField,nodes)&&table_count(m,nodes,nodeCount)&&nodeCount>static_cast<std::uint64_t>(countIndex)
+            &&offset(nodes,tableHeader+static_cast<std::uint64_t>(countIndex)*nodeBytes,node)
+            &&read(m,node,countName)&&countName==countHash&&read(m,node+nodeLinkSlot,slot)&&slot==countLink
+            &&read(m,nodes+tableHeader+static_cast<std::uint64_t>(gateIndex)*nodeBytes,gateName)&&gateName==gateHash
+            &&table(m,def+linksField,links)&&table_count(m,links,linkCount)&&linkCount>static_cast<std::uint64_t>(countLink)
+            &&offset(links,tableHeader+static_cast<std::uint64_t>(countLink)*linkBytes,entry)
+            &&read(m,entry,linkEntry)&&linkEntry==std::array<std::uint32_t,3>{linkNamespace,gateHash,static_cast<std::uint32_t>(countIndex)};
+        if(!ok){v.reasons|=reason::definition;return v;}
+    }
+    // S3 link source: link-in slot 5 is the aura's variable 1.
+    Header aura{};std::uintptr_t auraVariablesBase{};
+    {
+        std::uintptr_t linkIn{},auraAddress{};std::uint64_t linkInCount{},variables{};std::array<std::uint32_t,2> source{};
+        const bool ok=table(m,c+linkInField,linkIn)&&table_count(m,linkIn,linkInCount)&&linkInCount>static_cast<std::uint64_t>(countLink)
+            &&read(m,linkIn+tableHeader+static_cast<std::uint64_t>(countLink)*linkInBytes,source)&&source[1]==auraCount
+            &&resolve(m,source[0],auraAddress)&&hud::detail::header(m,auraAddress,aura)
+            &&aura.tag==auraTag&&aura.kind==scriptKind&&aura.self==source[0]
+            &&table(m,auraAddress+variablesField,auraVariablesBase)&&read(m,auraVariablesBase,variables)&&variables==auraVariables;
+        if(!ok){v.reasons|=reason::link;return v;}
+        v.source=auraVariablesBase+tableHeader+variableBytes;
+        if(value&&value!=v.source){v.reasons|=reason::link|reason::value;return v;}
+    }
+    v.structural=true;
+    // S4 owner: the weapon entity is Rat King Akimbo's (shared HUD owner walk).
+    switch(hud::detail::rat_king_akimbo_owner(m,c,h)){
+    case hud::detail::OwnerWalk::ok:v.akimbo=true;break;
+    case hud::detail::OwnerWalk::entity:v.reasons|=reason::owner|reason::entity;break;
+    case hud::detail::OwnerWalk::rows:v.reasons|=reason::owner|reason::rows;break;
+    case hud::detail::OwnerWalk::packet:v.reasons|=reason::owner|reason::packet;break;
+    case hud::detail::OwnerWalk::changed:v.reasons|=reason::owner|reason::changed;break;
+    case hud::detail::OwnerWalk::otherArt:v.reasons|=reason::owner|reason::packet|reason::otherArt;break;
+    }
+    // S5 local player: the weapon's parent owns the aura and is the local
+    // player (the cache from a drawn first-person akimbo, or the only player).
+    {
+        std::uintptr_t entityAddress{},playerAddress{};std::uint32_t entitySelfNow{},parent{},parentSelf{};
+        if(!resolve(m,h.owner,entityAddress)||!read(m,entityAddress+entitySelf,entitySelfNow)||entitySelfNow!=h.owner
+            ||!read(m,entityAddress+entityParent,parent)||!resolve(m,parent,playerAddress)
+            ||!read(m,playerAddress+entitySelf,parentSelf)||parentSelf!=parent){
+            v.reasons|=reason::player|reason::playerEntity;
+        }else{
+            v.player=parent;
+            if(aura.owner!=parent)v.reasons|=reason::player|reason::auraOwner;
+            else if(parent!=local&&!only_player(m,exe,parent)){
+                v.reasons|=reason::player|reason::notLocal;
+                // Another player's weapon, as far as the cache can tell: the
+                // local player (first-person owner) is alive and is not this parent.
+                if(local&&live_entity(m,local))v.reasons|=reason::remote;
+            }else v.local=true;
+        }
+    }
+    v.apply=v.structural&&v.akimbo&&v.local;
+    return v;
+}
+
+/** One more holder: every lane +1, capped at 6. Any lane that is not finite
+ * or is negative leaves the value unchanged and returns false. Real allies
+ * still add theirs: aura n gives n + 1 (the gate is [1, 6]). */
+inline bool bump(float (&v)[4]) noexcept {
+    for(const float x:v)if(!std::isfinite(x)||x<0)return false;
+    for(float& x:v)x=std::fmin(x+1.f,stackCap);
+    return true;
+}
+
+// Counters: the 128-byte block appended to SunriseStatusAkimboVisualsProbe.
+// calls68: accepted-caller writes of index 68; structural/akimbo/local: of
+// those, verdicts passing S1-S3 / S4 / S5; applied: +1 written; logonly:
+// would have applied (kRatPackApply=false); pendingSet: S1-S3 passed but S4
+// or S5 not yet, and the component holds an entry in the pending table (one
+// is not counted when the table is full: result=pending_full); resynced: a
+// pending +1 written later; rejected: an apply
+// verdict whose value was not finite and >= 0 (passed through); foreignWrites:
+// other callers writing the aura or index 68/29 of the weapon script
+// (diagnostics); lastReasons: the last 8152AEA6 verdict; lastNativeMilli /
+// lastAppliedMilli: x1000 (int64); lastForeignReturn: its return RVA; comp:
+// the last 8152AEA6 component; localPlayer: the player S5 last accepted.
+struct Counters {
+    std::atomic<std::uint64_t> calls68{},structural{},akimbo{},local{},applied{},logonly{},pendingSet{},resynced{};
+    std::atomic<std::uint64_t> rejected{},foreignWrites{},lastReasons{},lastNativeMilli{},lastAppliedMilli{},lastForeignReturn{},comp{},localPlayer{};
+};
+static_assert(sizeof(Counters)==128);
+
+struct Options {bool apply{},diagnostics{};};
+enum class Result : std::uint8_t {applied,logonly,pending,resynced,rejected,full};
+inline const char* result_name(Result r) noexcept {
+    switch(r){
+    case Result::applied:return "applied";
+    case Result::logonly:return "logonly";
+    case Result::pending:return "pending";
+    case Result::resynced:return "resynced";
+    case Result::full:return "pending_full";
+    default:return "rejected";
+    }
+}
+// x1000 as int64 in a u64 counter; a value that is not finite reads INT64_MIN.
+inline constexpr std::uint64_t notFiniteMilli=0x8000000000000000ULL;
+inline std::uint64_t milli(float x) noexcept {
+    if(!std::isfinite(x))return notFiniteMilli;
+    const double clamped=std::fmax(-1e12,std::fmin(1e12,static_cast<double>(x)));
+    return static_cast<std::uint64_t>(static_cast<std::int64_t>(std::llround(clamped*1000.0)));
+}
+// Pending +1s (review R2): a small table instead of one slot, so another
+// player's Rat King weapon script (native, or someone else's akimbo: it passes
+// S1-S3 here too) can never take the local akimbo's place. A new component
+// takes a free entry; when the table is full it displaces only an entry whose
+// failure is lasting (unless its own is too) or whose component is gone, and
+// otherwise waits for its next index-68 write (result=pending_full).
+inline constexpr unsigned pendingSlots=8;
+// Retries (review R3): a waiting component is retried at every accepted write
+// during its first freeRetries retries and for graceMs after it was registered,
+// then at most once per resyncIntervalMs. A lasting failure (reason::lasting:
+// native Rat King's art, or another live player's weapon) is throttled from the
+// start, so it costs one walk per interval. A new local player (set_local)
+// lets every entry retry at its next write.
+inline constexpr unsigned freeRetries=8;
+inline constexpr std::uint64_t graceMs=1000,resyncIntervalMs=100;
+// Foreign-writer lines: one per distinct key, at most this many per session.
+inline constexpr unsigned foreignSlots=128;
+
+/** The hook's state: the pending table, the local-player cache, the last
+ * reported verdict and the foreign-writer dedupe table. */
+class Runtime {
+public:
+    void set_local(std::uint32_t player) noexcept {
+        if(local_.exchange(player,std::memory_order_relaxed)!=player)
+            for(auto& e:pending_)e.tried.store(0,std::memory_order_relaxed);
+    }
+    [[nodiscard]] std::uint32_t local() const noexcept {return local_.load(std::memory_order_relaxed);}
+    [[nodiscard]] bool pending(std::uintptr_t c) const noexcept {return find(c)!=nullptr;}
+    [[nodiscard]] unsigned pending_count() const noexcept {
+        unsigned n=0;
+        for(const auto& e:pending_)n+=e.component.load(std::memory_order_acquire)>claiming;
+        return n;
+    }
+    void reset() noexcept {
+        for(auto& e:pending_){
+            e.component.store(0);e.self.store(0);e.retries.store(0);e.lasting.store(false);e.busy.store(false);e.since.store(0);e.tried.store(0);
+        }
+        local_.store(0);lastReport_.store(0);
+        for(auto& slot:foreignSeen_)slot.store(0);
+    }
+    /** One SetVariable call. caller: return address RVA. now: milliseconds.
+     * next(component, index, value) is the original; it runs exactly once,
+     * plus once more for index 68 when a pending +1 is resynced. */
+    template<class Next,class Log>
+    std::uint64_t write(const Memory& m,std::uintptr_t exe,std::uintptr_t caller,void* component,std::int32_t index,
+                        const void* value,Options options,Counters& counters,std::uint64_t now,Next&& next,Log&& log) noexcept {
+        const auto c=reinterpret_cast<std::uintptr_t>(component);
+        if(caller!=propagateReturn&&caller!=connectReturn){
+            // Deliberately native: unlink resets, reflection and every other
+            // caller. A reset of a pending component's count ends its wait.
+            if(index==countIndex&&clear(c)&&options.diagnostics){
+                char line[160]{};
+                (void)std::snprintf(line,sizeof(line),"ev=akimbo stage=ratpack ret=%llX comp=%p index=68 result=pending_cleared",
+                                    static_cast<unsigned long long>(caller),reinterpret_cast<const void*>(c));
+                log(static_cast<const char*>(line));
+            }
+            if(options.diagnostics)foreign(m,caller,c,index,reinterpret_cast<std::uintptr_t>(value),counters,log);
+            return next(component,index,value);
+        }
+        if(index!=countIndex){
+            const auto result=next(component,index,value);
+            if(find(c))resync(m,exe,caller,c,options,counters,now,next,log);
+            return result;
+        }
+        counters.calls68.fetch_add(1,std::memory_order_relaxed);
+        const auto v=qualify(m,exe,c,reinterpret_cast<std::uintptr_t>(value),local_.load(std::memory_order_relaxed));
+        record(v,c,counters);
+        if(v.apply){
+            // This write carries the count itself: nothing is left to resync.
+            (void)clear(c);
+            float out[4]{};float native=NAN;
+            if(read_value(m,reinterpret_cast<std::uintptr_t>(value),out)){
+                native=out[0];counters.lastNativeMilli.store(milli(native),std::memory_order_relaxed);
+                if(bump(out)){
+                    if(options.apply){
+                        counters.applied.fetch_add(1,std::memory_order_relaxed);
+                        counters.lastAppliedMilli.store(milli(out[0]),std::memory_order_relaxed);
+                        report(caller,c,v,native,Result::applied,log);
+                        alignas(16) float aligned[4]{out[0],out[1],out[2],out[3]};
+                        return next(component,index,static_cast<const void*>(aligned));
+                    }
+                    counters.logonly.fetch_add(1,std::memory_order_relaxed);
+                    report(caller,c,v,native,Result::logonly,log);
+                    return next(component,index,value);
+                }
+            }
+            counters.rejected.fetch_add(1,std::memory_order_relaxed);
+            report(caller,c,v,native,Result::rejected,log);
+        }else if(v.structural){
+            float native[4]{NAN,NAN,NAN,NAN};(void)read_value(m,reinterpret_cast<std::uintptr_t>(value),native);
+            const bool held=enlist(m,c,v.self,(v.reasons&reason::lasting)!=0,now);
+            if(held)counters.pendingSet.fetch_add(1,std::memory_order_relaxed);
+            report(caller,c,v,native[0],held?Result::pending:Result::full,log);
+        }else (void)clear(c); // no longer the aura's count: nothing to resync
+        return next(component,index,value);
+    }
+
+private:
+    // One waiting component. component: 0 free, claiming while an entry is
+    // being filled (never a component address), else the component; the other
+    // fields are written before it is published. busy: a retry is walking it.
+    static constexpr std::uintptr_t claiming=1;
+    struct Pending {
+        std::atomic<std::uintptr_t> component{};
+        std::atomic<std::uint32_t> self{},retries{};
+        std::atomic<bool> lasting{},busy{};
+        std::atomic<std::uint64_t> since{},tried{};
+    };
+    struct Busy {
+        std::atomic<bool>& flag;
+        ~Busy() {flag.store(false,std::memory_order_release);}
+    };
+    static bool read_value(const Memory& m,std::uintptr_t address,float (&out)[4]) noexcept {
+        std::array<float,4> value{};
+        if(!address||!hud::detail::read(m,address,value))return false;
+        std::memcpy(out,value.data(),sizeof(out));return true;
+    }
+    void record(const Verdict& v,std::uintptr_t c,Counters& counters) noexcept {
+        if(v.structural)counters.structural.fetch_add(1,std::memory_order_relaxed);
+        if(v.akimbo)counters.akimbo.fetch_add(1,std::memory_order_relaxed);
+        if(v.local){counters.local.fetch_add(1,std::memory_order_relaxed);counters.localPlayer.store(v.player,std::memory_order_relaxed);}
+        if(v.candidate){counters.lastReasons.store(v.reasons,std::memory_order_relaxed);counters.comp.store(c,std::memory_order_relaxed);}
+    }
+    const Pending* find(std::uintptr_t c) const noexcept {
+        if(c<=claiming)return nullptr;
+        for(const auto& e:pending_)if(e.component.load(std::memory_order_acquire)==c)return &e;
+        return nullptr;
+    }
+    Pending* find(std::uintptr_t c) noexcept {return const_cast<Pending*>(static_cast<const Runtime*>(this)->find(c));}
+    static void fill(Pending& e,std::uint32_t self,bool lasting,std::uint64_t now) noexcept {
+        e.self.store(self,std::memory_order_relaxed);e.lasting.store(lasting,std::memory_order_relaxed);
+        e.since.store(now,std::memory_order_relaxed);e.tried.store(0,std::memory_order_relaxed);e.retries.store(0,std::memory_order_relaxed);
+    }
+    // The component is still the weapon script it was registered as.
+    static bool alive(const Memory& m,std::uintptr_t c,std::uint32_t self) noexcept {
+        hud::detail::Header h{};
+        return hud::detail::header(m,c,h)&&h.tag==scriptTag&&h.self==self;
+    }
+    // Registers (or refreshes) c; false when the table is full of entries it may not displace.
+    bool enlist(const Memory& m,std::uintptr_t c,std::uint32_t self,bool lasting,std::uint64_t now) noexcept {
+        if(c<=claiming)return false;
+        if(auto* e=find(c)){fill(*e,self,lasting,now);return true;}
+        const auto take=[&](Pending& e,std::uintptr_t held) noexcept {
+            if(!e.component.compare_exchange_strong(held,claiming,std::memory_order_acq_rel))return false;
+            fill(e,self,lasting,now);
+            e.component.store(c,std::memory_order_release);
+            return true;
+        };
+        for(auto& e:pending_)if(take(e,0))return true;
+        for(auto& e:pending_){
+            const auto held=e.component.load(std::memory_order_acquire);
+            if(held<=claiming)continue;
+            if(((!lasting&&e.lasting.load(std::memory_order_relaxed))||!alive(m,held,e.self.load(std::memory_order_relaxed)))&&take(e,held))return true;
+        }
+        return false;
+    }
+    bool clear(std::uintptr_t c) noexcept {
+        if(c<=claiming)return false;
+        bool cleared=false;
+        for(auto& e:pending_){
+            std::uintptr_t expected=c;
+            if(e.component.load(std::memory_order_acquire)==c&&e.component.compare_exchange_strong(expected,0,std::memory_order_acq_rel))cleared=true;
+        }
+        return cleared;
+    }
+    static bool throttled(const Pending& e,std::uint64_t now) noexcept {
+        const auto tried=e.tried.load(std::memory_order_relaxed);
+        if(!tried||now<tried||now-tried>=resyncIntervalMs)return false;
+        if(e.lasting.load(std::memory_order_relaxed))return true;
+        const auto since=e.since.load(std::memory_order_relaxed);
+        return e.retries.load(std::memory_order_relaxed)>=freeRetries&&!(now>=since&&now-since<graceMs);
+    }
+    // A pending +1, retried from inside an accepted write to the same
+    // component (the game's own write point, same thread). The value written
+    // is the aura's word + 1, the same value an apply writes, so a late,
+    // repeated or concurrent resync can never add a second +1. The entry is
+    // released once the +1 is written or the component is gone.
+    template<class Next,class Log>
+    void resync(const Memory& m,std::uintptr_t exe,std::uintptr_t caller,std::uintptr_t c,Options options,
+                Counters& counters,std::uint64_t now,Next& next,Log& log) noexcept {
+        Pending* e=find(c);
+        if(!e||e->busy.exchange(true,std::memory_order_acquire))return;
+        const Busy hold{e->busy};
+        if(e->component.load(std::memory_order_acquire)!=c||throttled(*e,now))return;
+        e->tried.store(now?now:1,std::memory_order_relaxed);e->retries.fetch_add(1,std::memory_order_relaxed);
+        const auto self=e->self.load(std::memory_order_relaxed);
+        const auto v=qualify(m,exe,c,0,local_.load(std::memory_order_relaxed));
+        if(v.candidate)counters.lastReasons.store(v.reasons,std::memory_order_relaxed);
+        if(v.local)counters.localPlayer.store(v.player,std::memory_order_relaxed);
+        std::uintptr_t mine=c;
+        // A freed or reused component leaves the table.
+        if(!v.structural||v.self!=self){(void)e->component.compare_exchange_strong(mine,0,std::memory_order_acq_rel);return;}
+        if(!v.apply){
+            if(e->component.load(std::memory_order_acquire)==c)e->lasting.store((v.reasons&reason::lasting)!=0,std::memory_order_relaxed);
+            return;
+        }
+        (void)e->component.compare_exchange_strong(mine,0,std::memory_order_acq_rel);
+        float count[4]{};
+        if(!read_value(m,v.source,count)){counters.rejected.fetch_add(1,std::memory_order_relaxed);report(caller,c,v,NAN,Result::rejected,log);return;}
+        const float native=count[0];
+        counters.lastNativeMilli.store(milli(native),std::memory_order_relaxed);
+        if(!bump(count)){counters.rejected.fetch_add(1,std::memory_order_relaxed);report(caller,c,v,native,Result::rejected,log);return;}
+        if(!options.apply){counters.logonly.fetch_add(1,std::memory_order_relaxed);report(caller,c,v,native,Result::logonly,log);return;}
+        alignas(16) float aligned[4]{count[0],count[1],count[2],count[3]};
+        (void)next(reinterpret_cast<void*>(c),countIndex,static_cast<const void*>(aligned));
+        counters.resynced.fetch_add(1,std::memory_order_relaxed);
+        counters.lastAppliedMilli.store(milli(count[0]),std::memory_order_relaxed);
+        report(caller,c,v,native,Result::resynced,log);
+    }
+    // One line per change of (component, native value, verdict), and of the
+    // accepted caller, so a link connect (5803B7) always shows.
+    template<class Log>
+    void report(std::uintptr_t caller,std::uintptr_t c,const Verdict& v,float native,Result result,Log& log) noexcept {
+        std::uint64_t key=0xcbf29ce484222325ULL;
+        const auto mix=[&key](std::uint64_t x) noexcept {key=(key^x)*0x100000001b3ULL;};
+        mix(caller);mix(c);mix(std::bit_cast<std::uint32_t>(native));mix(static_cast<std::uint64_t>(result));mix(v.reasons);mix(v.player);
+        if(lastReport_.exchange(key,std::memory_order_relaxed)==key)return;
+        char line[224]{};
+        (void)std::snprintf(line,sizeof(line),"ev=akimbo stage=ratpack ret=%llX comp=%p owner=%08X parent=%08X native=%.2f result=%s reasons=%X",
+                            static_cast<unsigned long long>(caller),reinterpret_cast<const void*>(c),v.owner,v.player,
+                            static_cast<double>(native),result_name(result),v.reasons);
+        log(static_cast<const char*>(line));
+    }
+    // Diagnostics: other writers of the aura, or of index 68/29 of the weapon
+    // script. One line per distinct (return address, tag, index, value).
+    template<class Log>
+    void foreign(const Memory& m,std::uintptr_t caller,std::uintptr_t c,std::int32_t index,std::uintptr_t value,
+                 Counters& counters,Log& log) noexcept {
+        std::uint32_t tag{};
+        if(!c||!hud::detail::read(m,c,tag))return;
+        if(tag!=auraTag&&!(tag==scriptTag&&(index==countIndex||index==gateIndex)))return;
+        counters.foreignWrites.fetch_add(1,std::memory_order_relaxed);
+        counters.lastForeignReturn.store(caller,std::memory_order_relaxed);
+        float x{};const bool readable=value&&hud::detail::read(m,value,x);
+        std::uint64_t key=0xcbf29ce484222325ULL;
+        const auto mix=[&key](std::uint64_t y) noexcept {key=(key^y)*0x100000001b3ULL;};
+        mix(caller);mix(tag);mix(static_cast<std::uint32_t>(index));mix(readable?std::bit_cast<std::uint32_t>(x):0x1ffffffffULL);
+        if(!key)key=1;
+        bool fresh=false;
+        for(unsigned i=0;i<foreignSlots&&!fresh;++i){
+            auto& slot=foreignSeen_[(key+i)%foreignSlots];
+            std::uint64_t seen=slot.load(std::memory_order_relaxed);
+            if(!seen&&slot.compare_exchange_strong(seen,key,std::memory_order_relaxed))fresh=true;
+            else if(seen==key)return;
+        }
+        if(!fresh)return; // table full: the session's foreign-line budget is spent
+        char line[192]{};
+        (void)std::snprintf(line,sizeof(line),"ev=akimbo stage=ratpack kind=foreign ret=%llX tag=%08X index=%d comp=%p v=%.3f%s",
+                            static_cast<unsigned long long>(caller),tag,index,reinterpret_cast<const void*>(c),
+                            readable?static_cast<double>(x):0.0,readable?"":" unreadable=1");
+        log(static_cast<const char*>(line));
+    }
+    std::array<Pending,pendingSlots> pending_{};
+    std::atomic<std::uint32_t> local_{};
+    std::atomic<std::uint64_t> lastReport_{};
+    std::array<std::atomic<std::uint64_t>,foreignSlots> foreignSeen_{};
+};
+}
