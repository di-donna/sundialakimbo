+    ImFontConfig config{};config.SizePixels=20;auto* font=io.Fonts->AddFontDefaultVector(&config);
+    unsigned char* pixels{};int width{},height{};io.Fonts->GetTexDataAsRGBA32(&pixels,&width,&height);
+    io.Fonts->SetTexID(1);
+    for(const auto size:std::array<ImVec2,5>{{{640,360},{1280,720},{1920,1080},{3440,1440},{3840,2160}}}){
+        io.DisplaySize=size;io.DeltaTime=1.f/60;
+        ImGui::NewFrame();
+        h::AmmoLayout layout{};check(h::ammo_layout(0,0,size.x,size.y,layout),"draw layout accepted");
+        for(unsigned side=0;side<2;++side){
+            h::AmmoText text{};check(h::ammo_text(published,side,text),"text ready");
+            const float room=layout.cards[side].right-layout.cards[side].left-layout.padding*2;
+            fits(font,layout.labelFont,text.label.data(),room,"real font hand label fits");
+            fits(font,layout.countFont,text.count.data(),room,"real font max capacity fits");
+            fits(font,layout.statusFont,text.status.data(),room,"real font reload status fits");
+        }
+        check(h::draw_ammo(true),"production draw submits generated counters");
+        ImGui::Render();const auto* data=ImGui::GetDrawData();
+        check(data&&data->Valid&&data->CmdListsCount==1&&data->TotalVtxCount>100,"actual draw contains both text counters and bars");
+        check(!io.WantCaptureMouse&&!io.WantCaptureKeyboard,"ammo draw never captures input");
+        for(int list=0;list<data->CmdListsCount;++list)for(const auto& vertex:data->CmdLists[list]->VtxBuffer){
