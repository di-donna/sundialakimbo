index 0000000000000000000000000000000000000000..ac5f6c2c761609828883985322b04bbce9106929
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/burst_phase_guards.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstring>
+namespace dawn::client::hooks::akimbo::burst_phase_guards {
+struct Entry {std::uintptr_t rva;std::size_t bytes;std::array<unsigned char,16> expected;};
+// Exact build86657 bytes from the supported mapped image. Protected entries
+// begin with pinned jumps, not disassembler-inferred instructions past them.
+inline constexpr std::array<Entry,10> entries{{
+    {0xccb8c0,5,{0xe9,0x6a,0x66,0x52,0x05}},
+    {0xd09a30,5,{0xe9,0x22,0x54,0x7c,0x07}},
+    {0xcbe710,13,{0x44,0x8b,0x81,0x98,0,0,0,0x4c,0x8b,0xc9,0x41,0x8b,0xc0}},
+    {0xcbf240,12,{0x48,0x89,0x5c,0x24,0x20,0x55,0x56,0x57,0x41,0x55,0x41,0x56}},
+    {0xcc5080,15,{0x48,0x89,0x5c,0x24,0x08,0x48,0x89,0x6c,0x24,0x10,0x48,0x89,0x74,0x24,0x18}},
+    {0xcd0530,5,{0xe9,0xe0,0xac,0x6c,0}},
+    {0xcb0110,15,{0x4c,0x8b,0xdc,0x55,0x57,0x41,0x56,0x48,0x83,0xec,0x70,0x80,0x7a,0x15,0}},
+    {0xcb3bb0,15,{0x48,0x89,0x5c,0x24,0x08,0x48,0x89,0x6c,0x24,0x10,0x48,0x89,0x74,0x24,0x18}},
+    {0xcd1660,14,{0x40,0x53,0x48,0x83,0xec,0x20,0x48,0x8b,0xd9,0x48,0x8d,0x54,0x24,0x30}},
+    {0xcb7ff0,13,{0x48,0x89,0x5c,0x24,0x08,0x57,0x48,0x83,0xec,0x50,0x48,0x8b,0xf9}}
+}};
+inline constexpr std::array<std::array<std::uint32_t,2>,9> calls{{
+    {0xd09a60,0xcbe710},{0xccbc31,0xcbf240},{0xccba08,0xcb7ff0},
+    {0xccba49,0xcc5080},{0xccbc1d,0xcc5080},{0xccbb5b,0xcd0530},
+    {0xccbbb9,0xcb0110},{0xccbb2d,0xcb3bb0},{0xccbb7a,0xcd1660}
+}};
+template<class Read> bool validate(Read&& read) noexcept {
+    for(const auto& entry:entries){std::array<unsigned char,16> actual{};
+        if(!read(entry.rva,actual.data(),entry.bytes)||std::memcmp(actual.data(),entry.expected.data(),entry.bytes))return false;
+    }
+    for(const auto& call:calls){std::array<unsigned char,5> expected{0xe8},actual{};
+        const auto relative=static_cast<std::int32_t>(call[1]-call[0]);std::memcpy(expected.data()+1,&relative,4);
+        if(!read(call[0]-5,actual.data(),actual.size())||actual!=expected)return false;
+    }
+    return true;
+}
+}
