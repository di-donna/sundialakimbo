+            ||!replace(barrel()+0x1710,&before.ordinal,&after.ordinal,4))return false;
+        return phase(observed)&&observed==after;
+    }
+    bool apply(const burst_trigger::Plan& plan) noexcept {
+        if(!plan.valid||plan.pins!=pins||!plan.count||plan.count>plan.writes.size()||!current())return false;
+        // Validate the entire expected write-set before the first mutation. A
+        // failed owner/read/write stops the session; never restore stale storage.
+        for(std::size_t i=0;i<plan.count;++i){const auto& w=plan.writes[i];std::array<std::byte,8> bytes{};
+            if(!w.bytes||w.bytes>8||!local_read(nullptr,w.address,bytes.data(),w.bytes)||bytes!=w.before)return false;
+        }
+        for(std::size_t i=0;i<plan.count;++i){const auto& w=plan.writes[i];
+            if(!replace(w.address,w.before.data(),w.after.data(),w.bytes))return false;
+        }
