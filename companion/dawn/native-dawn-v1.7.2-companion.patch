+// the808045C4 float records accepted by B8B7F0. Source definitions are pinned
+// and live headers must still match before either native evaluator is called.
+inline bool qualify(const Memory& memory,const profiles::Barrel& profile,
+                    std::uintptr_t barrel,Expressions& output) noexcept {
+    output={};using hud::detail::read;using hud::detail::resolve;
+    if(barrel<0x10000||barrel>0x00007fffffffffffULL-0x16d8)return false;
+    std::uintptr_t asset{},after{};std::uint64_t bytes{};
+    if(!resolve(memory,profile.coreTag,asset)||!read(memory,asset,bytes)||bytes!=profile.coreSize
+        ||profile.barrelDefinition>bytes||bytes-profile.barrelDefinition<0xd9c)return false;
+    Expressions result{barrel+0x1690,barrel+0x16c0,0};
+    if(!read(memory,asset+profile.barrelDefinition+0xd98,result.fallback)||result.fallback!=1)return false;
+    for(unsigned i=0;i<2;++i){
+        const unsigned sourceAt=0x2480+i*0x30;unsigned definition{};
+        std::array<std::byte,24> source{},live{};
+        if(!gun_layout::component(memory,asset,profile.coreSize,profile.coreTag,sourceAt,
+                0x808089f6,0x808089f5,-0x16a0-static_cast<std::int64_t>(i)*0x30,definition)
+            ||definition>bytes||bytes-definition<0x60||!constant_unit(memory,asset,profile.coreSize,definition)
+            ||!read(memory,asset+sourceAt,source)||!read(memory,barrel+0x1690+i*0x30,live)
+            ||source!=live)return false;
+    }
+    if(!resolve(memory,profile.coreTag,after)||after!=asset)return false;
+    output=result;return true;
+}
+inline bool unit(float debit,float required,unsigned fallback) noexcept {
+    // Native rounding supports broader expression results. Direct adapter10
+    // currently accounts one round, so accept only exact one or its proven
+    // minus-one source fallback; fractional, free and multi-cost events need
+    // the pre-debit transaction path rather than late aggregate reconciliation.
+    return fallback==1&&(debit==1.f||debit==-1.f)&&(required==1.f||required==-1.f);
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/gun_layout.h b/Dawn/src/client/hooks/akimbo/gun_layout.h
new file mode 100644
index 0000000000000000000000000000000000000000..a04d7b44b53faa1b4ce4d6010e013559a54a6f66
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/gun_layout.h
@@ -0,0 +1,98 @@
+#pragma once
+// Typed common-gun storage, resolved from the registered immutable core. The
+// definition offsets differ among families; runtime component offsets do not.
+// This does not grant firing/pose compatibility to a registration by itself.
+#include "hud.h"
+
+namespace dawn::client::hooks::akimbo::gun_layout {
+struct Layout {
+    unsigned rootKind{},rootInterface{},magazineDefinition{},reloadKind{},reloadInterface{},reloadDefinition{};
+    bool operator==(const Layout&)const=default;
+    bool ordinary_reload()const noexcept{return reloadKind==0x80803845&&reloadInterface==0x80803844;}
+};
+inline bool root_interface(unsigned kind,unsigned& out) noexcept {
+    switch(kind){
+    case 0x80bfdfeb:out=0x80bfdfea;return true;
+    case 0x80c1c533:out=0x80c1c534;return true;
+    case 0x80c22c04:out=0x80feb848;return true;
+    default:out=0;return false;
+    }
+}
+inline bool reload_interface(unsigned kind,unsigned& out) noexcept {
+    switch(kind){
+    case 0x80803845:out=0x80803844;return true;
+    case 0x80803843:out=0x80803842;return true;
+    default:out=0;return false;
+    }
+}
+inline bool component(const Memory& m,std::uintptr_t asset,unsigned bytes,unsigned owner,
+    unsigned at,unsigned kind,unsigned concrete,std::int64_t parent,unsigned& definition) noexcept {
+    using hud::detail::read;
+    std::array<unsigned,4> instance{},back{};std::int64_t actualParent{};
+    if(at>bytes||bytes-at<24||!read(m,asset+at,instance)||instance[0]!=owner||instance[1]!=kind
+        ||instance[3]||instance[2]<0x27b0||(instance[2]&7u)||instance[2]>bytes||bytes-instance[2]<16
+        ||!read(m,asset+at+16,actualParent)||actualParent!=parent
+        ||!read(m,asset+instance[2],back)||back!=std::array<unsigned,4>{owner,concrete,at,0})return false;
+    definition=instance[2];return true;
+}
+inline bool source(const Memory& m,const profiles::Barrel& barrel,Layout& out) noexcept {
+    using hud::detail::read;using hud::detail::resolve;
+    out={};std::uintptr_t asset{},after{};std::uint64_t bytes{},afterBytes{},rootRelative{};unsigned rootKind{},reloadKind{};
+    if(!profiles::valid_tag(barrel.coreTag)||barrel.coreSize<0x27b0||barrel.coreSize>0x1000000
+        ||!resolve(m,barrel.coreTag,asset)||!read(m,asset,bytes)||bytes!=barrel.coreSize
+        ||!read(m,asset+0x84,rootKind)||!read(m,asset+0x2794,reloadKind))return false;
+    Layout result{};result.rootKind=rootKind;result.reloadKind=reloadKind;
+    unsigned rootDefinition{};
+    if(!root_interface(rootKind,result.rootInterface)||!reload_interface(reloadKind,result.reloadInterface)
+        ||!component(m,asset,barrel.coreSize,barrel.coreTag,0x80,rootKind,result.rootInterface,0,rootDefinition)
+        ||rootDefinition!=barrel.rootDefinition||!read(m,asset+0x18,rootRelative)||rootRelative!=rootDefinition-0x18u
+        ||!component(m,asset,barrel.coreSize,barrel.coreTag,0x2550,0x8080384b,0x80803a0f,-0x24e0,result.magazineDefinition)
+        ||!component(m,asset,barrel.coreSize,barrel.coreTag,0x2790,reloadKind,result.reloadInterface,-0x2720,result.reloadDefinition)
+        ||!resolve(m,barrel.coreTag,after)||after!=asset||!read(m,asset,afterBytes)||afterBytes!=bytes)return false;
+    out=result;return true;
+}
+// Common gun events accept ordinary and tube storage. Tube magazines still
+// require the separate checked phase/property reader before publication.
+// Charge controllers need their own state machine.
+inline bool event_source(const Memory& m,const profiles::Barrel& barrel,Layout& out) noexcept {
+    if(!source(m,barrel,out))return false;
+    std::uintptr_t asset{};unsigned definition{};
+    if(!hud::detail::resolve(m,barrel.coreTag,asset)
+        ||!component(m,asset,barrel.coreSize,barrel.coreTag,0x6f0,0x808043d8,0x808043da,-0x680,definition)
+        ||!component(m,asset,barrel.coreSize,barrel.coreTag,0xcd0,0x8080388b,0x8080388a,-0xc60,definition)
+        ||!component(m,asset,barrel.coreSize,barrel.coreTag,0xdf0,0x80803865,0x80803889,-0xd80,definition)
+        ||definition!=barrel.barrelDefinition)return false;
+    for(const unsigned offset:{0x2bf0u,0x2d10u}){
+        std::array<unsigned,2> tag{};
+        if(offset<=barrel.coreSize-8&&(!hud::detail::read(m,asset+offset,tag)
+            ||tag==std::array<unsigned,2>{barrel.coreTag,0x80803abe}))return false;
+    }
+    return true;
+}
+// 80803A08 callback815B8944 maps Barrel inputs through186A430:
+// instance+0xE0+input*0x30. Inputs22..25 are the four burst-count lanes.
+inline bool bullet_properties(const Memory& m,const profiles::Barrel& barrel,std::uintptr_t root,
+    unsigned rootHandle,std::array<std::uintptr_t,4>& out) noexcept {
+    out={};std::uintptr_t asset{};std::uint64_t bytes{};
+    if(!rootHandle||rootHandle==0xffffffff||!hud::detail::resolve(m,barrel.coreTag,asset)
+        ||!hud::detail::read(m,asset,bytes)||bytes!=barrel.coreSize||bytes<24)return false;
+    for(unsigned i=0;i<4;++i){
+        const auto offset=0x1270u+i*0x30;std::array<std::byte,0x30> record{};
+        if(!hud::detail::read(m,root+offset,record)||hud::detail::at<unsigned>(record,0xc)!=rootHandle
+            ||hud::detail::at<std::uint64_t>(record,0x10)!=offset
+            ||hud::detail::at<unsigned>(record,0x20)!=barrel.coreTag
+            ||hud::detail::at<unsigned>(record,0x24)!=0x808045c4)return false;
+        const auto definition=hud::detail::at<std::uint64_t>(record,0x28);
+        if(!definition||(definition&7u)||definition>bytes-24)return false;
+        out[i]=root+offset;
+    }
+    return true;
+}
+inline bool single_round_values(const std::array<float,4>& values) noexcept {
+    // Zero is native automatic firing's sentinel; one is a discrete round.
+    // Perks can change these live values after compilation, so the native
+    // event gate rechecks every lane rather than trusting a weapon family.
+    for(float value:values)if(value!=0.f&&value!=1.f)return false;
+    return true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/hand_merge.h b/Dawn/src/client/hooks/akimbo/hand_merge.h
new file mode 100644
index 0000000000000000000000000000000000000000..9614d83f70b6cd704a4c64cbf9a68626cd1626ab
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/hand_merge.h
@@ -0,0 +1,153 @@
+#pragma once
+#include "smg_signals.h"
+#include "export_filter.h"
+#include "presentation.h"
+#include "smg_placement.h"
+#include <array>
+#include <cstring>
+
+namespace dawn::client::hooks::akimbo::hand_merge {
+using presentation::Frame;
+struct Completed {
+    Identity identity{};
+    std::uintptr_t job{},poses{};
+    std::uint64_t at{};
+};
+// Caller holds jobsLock. A completed frame can supply several armor draws;
+// querying does not consume it. Every arena-job reuse invalidates it first.
+class Registry {
+    std::array<Completed,32> entries_{};
+    Identity identity_{};
+    unsigned next_{};
+public:
+    void clear() noexcept {entries_={};identity_={};next_=0;}
+    void erase(std::uintptr_t job) noexcept {for(auto& e:entries_)if(e.job==job)e={};}
+    void publish(Completed e) noexcept {
+        if(!e.job||!e.poses||!separated_model(e.identity.modelTag))return;
+        if(e.identity!=identity_){clear();identity_=e.identity;}
+        for(auto& old:entries_)if(old.job==e.job||old.poses==e.poses)old={};
+        entries_[next_]=e;next_=(next_+1)%entries_.size();
+    }
+    bool find(std::uintptr_t job,std::uintptr_t poses,std::uint64_t now,Completed& out) const noexcept {
+        out={};
+        for(const auto& e:entries_)if(job&&e.job==job&&e.poses==poses&&now>=e.at&&now-e.at<=1000){out=e;return true;}
+        return false;
+    }
+};
+template<class T> bool read(const Memory& m,std::uintptr_t p,T& v) noexcept {
+    return m.read&&p>=0x10000&&p<=0x00007fffffffffffULL-sizeof(T)&&m.read(m.context,p,&v,sizeof(v));
+}
+template<class T,std::size_t N> T at(const std::array<std::byte,N>& b,std::size_t offset) noexcept {
+    T v{};std::memcpy(&v,b.data()+offset,sizeof(v));return v;
+}
+inline bool separate(std::uintptr_t a,std::size_t an,std::uintptr_t b,std::size_t bn) noexcept {
+    return a>=0x10000&&b>=0x10000&&a<=0x00007fffffffffffULL-an&&b<=0x00007fffffffffffULL-bn
+        &&(a+an<=b||b+bn<=a);
+}
+struct Patch {std::uintptr_t output{};std::array<Frame,25> resident{};};
+struct WeaponPatch {std::uintptr_t output{};Frame root{};std::array<Frame,55> remaining{};unsigned count{1};};
+static_assert(offsetof(WeaponPatch,remaining)==offsetof(WeaponPatch,root)+sizeof(Frame));
+// Native merges the procedural tail, but the whole resident FK prefix was
+// cached before our completed pose. Preserve all original FK children; the
+// appended marker is the last resident bone, not necessarily local bone1.
+inline bool weapon_frames(std::uint32_t tag,const Frame* full,const Frame* body,unsigned bones,WeaponPatch& patch) noexcept {
+    patch={};const unsigned resident=weapon_resident_bones(tag),marker=marker_bone(tag)-72;
+    if(!full||!body||bones<2||bones>56||!resident||resident>=bones||marker>=bones)return false;
+    for(unsigned i=0;i<bones;++i){
+        if(!smg_placement::valid_completed(tag,full[i],72+i,full[0].scale))return false;
+        // The dedicated FK marker still contains a native physical frame in
+        // the cached prefix; only its completed counterpart is scale encoded.
+        if(generic_gun_model(tag)&&i==marker){if(!presentation::valid(body[i]))return false;}
+        else if(!smg_placement::valid_completed(tag,body[i],72+i,body[0].scale))return false;
+    }
+    unsigned moving{};
+    if(!smg::marker_mask(full[marker].scale/full[0].scale,moving)
+        ||std::memcmp(body+resident,full+resident,(bones-resident)*sizeof(Frame)))return false;
+    patch.root=full[0];std::copy_n(full+1,resident-1,patch.remaining.begin());patch.count=resident;return true;
+}
+// Rigs whose single-marker export moves weapon root 72: IKELOS (placement and
+// quiet root) and Rat King (quiet right root). Both have the 5-bone
+// weapon-local skeleton, so their weapon render record holds bones 72..76.
+inline constexpr bool moves_weapon_root(std::uint32_t tag) noexcept {return smg_model(tag)||sidearm_model(tag);}
+// The completed pose must still carry this frame's scale-coded marker(s):
+// the single family-D marker of IKELOS, Rat King and Sturm & Drang (bone 77,
+// written on every mode-4 frame by sturm_drang_pose.h), else Thorn's two.
+// Sturm & Drang never moves root 72, so prepare_weapon above never runs for it.
+template<std::size_t N> inline bool completed_marker(const Identity& id,const std::array<Frame,N>& full) noexcept {
+    if(N<pose_bones(id.modelTag))return false;
+    unsigned moving{};
+    if(single_marker_model(id.modelTag))return smg::marker_mask(full[marker_bone(id.modelTag)].scale/full[72].scale,moving);
+    return !(std::abs(full[75].scale/full[72].scale-1.03125f)>.0001f)
+        &&!(std::abs(full[72+alternating_left_bone(id.modelTag)].scale/full[72].scale-1.03125f)>.0001f);
+}
+// IKELOS's five-bone weapon record has offset72/range2. Native 1227980
+// copies only bones73..76. Its root was cached before the completed pose,
+// leaving the bolts displaced by the placement delta and using stale recoil.
+// Rat King's record is the same shape (INFERRED from the shared 5-bone
+// weapon-local skeleton; CAPTURE: +0x18==5 and +0x78==0x01020048 at 1227980).
+inline bool prepare_weapon(const Memory& memory,const Completed& completed,std::uintptr_t context,
+                           std::uintptr_t model,std::uintptr_t destination,WeaponPatch& patch) noexcept {
+    patch={};std::array<std::byte,0x48> c{};std::array<std::byte,0x80> m{};std::array<std::byte,0x28> d{};
+    const unsigned total=pose_bones(completed.identity.modelTag),bones=total-72;
+    if(total<74||total>128)return false;
+    if(!moves_weapon_root(completed.identity.modelTag)||!read(memory,context,c)||!read(memory,model,m)||!read(memory,destination,d)
+        ||model==destination||at<std::uintptr_t>(c,0)!=completed.job||at<std::uintptr_t>(c,8)!=completed.poses
+        ||at<unsigned>(c,0x10)!=total||at<unsigned>(c,0x20)!=4||at<unsigned>(m,0x18)!=bones||at<unsigned>(d,0x18)!=bones
+        ||at<std::uintptr_t>(m,0x70)!=destination||at<unsigned>(m,0x78)!=0x01020048)return false;
+    const unsigned resident=weapon_resident_bones(completed.identity.modelTag);
+    if(!resident||resident>=bones)return false;
+    const std::array<std::uint16_t,4> starts{0,25,72,static_cast<std::uint16_t>(72+resident)},counts{25,47,static_cast<std::uint16_t>(resident),static_cast<std::uint16_t>(bones-resident)};
+    for(unsigned i=0;i<4;++i){const auto o=0x24+i*8;
+        if(at<std::uint16_t>(c,o)!=i||at<std::uint16_t>(c,o+2)!=starts[i]||at<std::uint16_t>(c,o+4)!=counts[i]
+            ||(at<std::uint16_t>(c,o+6)&1U)!=(i%2==0?1U:0U))return false;
+    }
+    const auto output=at<std::uintptr_t>(d,0x20),primary=at<std::uintptr_t>(m,0x20);
+    if(!separate(output,bones*sizeof(Frame),completed.poses,total*sizeof(Frame))||!separate(output,bones*sizeof(Frame),primary,bones*sizeof(Frame))
+        ||!completed_thorn_render_job(memory,completed.identity,completed.job,completed.poses))return false;
+    std::array<Frame,56> full{},body{};
+    if(!memory.read||!memory.read(memory.context,completed.poses+72*sizeof(Frame),full.data(),bones*sizeof(Frame))
+        ||!memory.read(memory.context,output,body.data(),bones*sizeof(Frame)))return false;
+    if(!weapon_frames(completed.identity.modelTag,full.data(),body.data(),bones,patch)
+        ||!still_current(memory,completed.identity)){patch={};return false;}
+    patch.output=output;return true;
+}
+// 1227980 copies only nonresident FP bones 25..71 into the body's second
+// render record. Its resident wrist/hand bones were copied earlier, before
+// the full alternating pose existed. Complete that same merge after native
+// code returns, before 1227ED0 applies the model transform and skins it.
+// Weapon-offset and rigid-relative branches deliberately do not match.
+inline bool prepare(const Memory& memory,const Completed& completed,std::uintptr_t context,
+                    std::uintptr_t model,std::uintptr_t destination,Patch& patch) noexcept {
+    patch={};std::array<std::byte,0x48> c{};std::array<std::byte,0x80> m{};
+    std::array<std::byte,0x28> d{};
+    if(!separated_model(completed.identity.modelTag)||!read(memory,context,c)||!read(memory,model,m)
+        ||!read(memory,destination,d)||model==destination
+        ||at<std::uintptr_t>(c,0)!=completed.job||at<std::uintptr_t>(c,8)!=completed.poses
+        ||at<unsigned>(c,0x10)!=pose_bones(completed.identity.modelTag)||at<unsigned>(c,0x20)!=4
+        ||at<unsigned>(m,0x18)!=72||at<unsigned>(d,0x18)!=72
+        ||at<std::uintptr_t>(m,0x70)!=destination
+        ||at<std::uint8_t>(m,0x78)||at<std::uint8_t>(m,0x79)||at<std::uint8_t>(m,0x7a)
+        ||at<std::uint8_t>(m,0x7b)!=1)return false;
+    const auto procedural=static_cast<std::uint16_t>(weapon_procedural_start(completed.identity.modelTag));
+    const std::array<std::uint16_t,4> starts{0,25,72,procedural},counts{25,47,static_cast<std::uint16_t>(procedural-72),static_cast<std::uint16_t>(pose_bones(completed.identity.modelTag)-procedural)};
+    for(unsigned i=0;i<4;++i){const auto o=0x24+i*8;
+        if(at<std::uint16_t>(c,o)!=i||at<std::uint16_t>(c,o+2)!=starts[i]
+            ||at<std::uint16_t>(c,o+4)!=counts[i]||(at<std::uint16_t>(c,o+6)&1U)!=(i%2==0?1U:0U))return false;
+    }
+    const auto output=at<std::uintptr_t>(d,0x20),primary=at<std::uintptr_t>(m,0x20);
+    if(!separate(output,72*sizeof(Frame),completed.poses,pose_bones(completed.identity.modelTag)*sizeof(Frame))
+        ||!separate(output,72*sizeof(Frame),primary,72*sizeof(Frame))
+        ||!completed_thorn_render_job(memory,completed.identity,completed.job,completed.poses))return false;
+    std::array<Frame,128> full{};std::array<Frame,72> body{};
+    if(!memory.read||!memory.read(memory.context,completed.poses,full.data(),pose_bones(completed.identity.modelTag)*sizeof(Frame))||!read(memory,output,body))return false;
+    for(unsigned i=0;i<pose_bones(completed.identity.modelTag);++i)if(!smg_placement::valid_completed(completed.identity.modelTag,full[i],i,full[72].scale))return false;
+    for(const auto& f:body)if(!presentation::valid(f))return false;
+    if(!completed_marker(completed.identity,full)
+        ||std::memcmp(body.data()+25,full.data()+25,47*sizeof(Frame))!=0)return false;
+    std::memcpy(patch.resident.data(),body.data(),sizeof(patch.resident));
+    constexpr unsigned armBones[]{12,14,15,17,19,20,21,22,23,24};
+    for(const auto bone:armBones)patch.resident[bone]=full[bone];
+    if(!still_current(memory,completed.identity)){patch={};return false;}
+    patch.output=output;return true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/hud.h b/Dawn/src/client/hooks/akimbo/hud.h
new file mode 100644
index 0000000000000000000000000000000000000000..c83b067103bcb8bac3e41ebc9da74047a0097931
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/hud.h
@@ -0,0 +1,228 @@
+#pragma once
+#include "identity.h"
+#include "rat_king.h"
+#include <cstring>
+
+namespace dawn::client::hooks::akimbo::hud {
+namespace detail {
+template<class T> bool read(const Memory& m,std::uintptr_t a,T& out) noexcept {
+    return m.read&&a>=0x10000&&a<=0x00007fffffffffffULL-sizeof(T)
+        &&m.read(m.context,a,&out,sizeof(out));
+}
+template<class T,std::size_t N> T at(const std::array<std::byte,N>& b,unsigned o) noexcept {
+    T v{};std::memcpy(&v,b.data()+o,sizeof(v));return v;
+}
+inline bool resolve(const Memory& m,std::uint32_t h,std::uintptr_t& a) noexcept {
+    if(!h||h==0xffffffff)return false;
+    std::uintptr_t wrapper{},table{};
+    if(!read(m,m.tablesSlot,wrapper)||!read(m,wrapper,table))return false;
+    const auto sh=static_cast<std::int32_t>(h)>>13;
+    const auto pool=((static_cast<std::uint64_t>(static_cast<std::int64_t>(sh))|0xffc0000ULL)>>18)
+        &(static_cast<std::uint32_t>(sh)&0xffffU);
+    if(pool>=4096)return false;
+    std::array<std::byte,64> meta{};if(!read(m,table+pool*64,meta))return false;
+    const auto stride=at<std::uint32_t>(meta,48);const auto mask=at<std::int32_t>(meta,52);
+    const auto cells=at<std::uintptr_t>(meta,8);
+    if(!stride||stride>1048576||(mask!=0&&mask!=-1))return false;
+    const auto offset=static_cast<std::uint32_t>((h&8191)*stride);
+    if(cells>0x00007fffffffffffULL-offset-8)return false;
+    const auto cell=cells+offset;std::uintptr_t delta{};if(!read(m,cell+8,delta))return false;
+    a=cell-(static_cast<std::uintptr_t>(static_cast<std::intptr_t>(mask))&delta);
+    return a>=0x10000&&a<=0x00007fffffffffffULL;
+}
+// Rat King Akimbo's private 01ba parents (slots 1,0,5,3,21) and its HUD row
+// key (037e:123 row 95, the private item hash). Both are rat_king.h's values,
+// never a copy: a re-emitted plan changes them in one place only.
+inline constexpr const std::array<std::uint32_t,5>& ratKingAkimboParents=rat_king::parents;
+inline constexpr std::uint32_t ratKingAkimboKey=rat_king::item;
+// Packet words 4..10 hold each private parent exactly once and nothing else.
+// Their order within the packet is not captured yet, so any order qualifies.
+inline bool rat_king_akimbo_parts(const std::array<std::uint32_t,7>& parts) noexcept {
+    unsigned seen=0,empty=0;
+    for(const auto part:parts){
+        if(part==0xffffffff){++empty;continue;}
+        unsigned index=0;
+        while(index<ratKingAkimboParents.size()&&ratKingAkimboParents[index]!=part)++index;
+        if(index==ratKingAkimboParents.size()||(seen&(1U<<index)))return false;
+        seen|=1U<<index;
+    }
+    return seen==0x1f&&empty==2;
+}
+struct Header {
+    std::uint32_t tag{},kind{},self{},owner{};std::uint64_t definition{};
+    bool operator==(const Header&) const = default;
+};
+inline bool header(const Memory& m,std::uintptr_t a,Header& out) noexcept {
+    std::array<std::byte,48> b{};std::uintptr_t self{};
+    if(!read(m,a,b))return false;
+    out={at<std::uint32_t>(b,0),at<std::uint32_t>(b,4),at<std::uint32_t>(b,36),
+        at<std::uint32_t>(b,44),at<std::uint64_t>(b,8)};
+    return out.owner&&out.owner!=0xffffffff&&resolve(m,out.self,self)&&self==a;
+}
+inline std::uint32_t key_for_parts(const SoundPacket& packet) noexcept {
+    // Private art parents from assembly-report.json, also validated by the
+    // accepted sound selector. Native single-weapon parents do not match.
+    constexpr std::array<std::uint32_t,7> thorn{0xffffffff,0x80b74ca9,0xffffffff,0xffffffff,0x80b74cab,0xffffffff,0x80b74caa};
+    constexpr std::array<std::uint32_t,7> ace{0x80b74cac,0x80b74cad,0xffffffff,0x80b74cae,0x80b74caf,0xffffffff,0x80b74cb0};
+    constexpr std::array<std::uint32_t,7> lastWord{0x80b74cb7,0x80b74cb4,0xffffffff,0x80b74cb8,0x80b74cb5,0xffffffff,0x80b74cb6};
+    constexpr std::array<std::uint32_t,7> malfeasance{0xffffffff,0x80b74cb9,0xffffffff,0xffffffff,0x80b74cba,0xffffffff,0x80b74cbb};
+    // IKELOS: the live packet (read-only capture 2026-09-26, sound 80BC117E)
+    // lists CBC before CBD; the assembly-report order had them swapped.
+    constexpr std::array<std::uint32_t,7> ikelos{0x80b74cbc,0x80b74cbd,0xffffffff,0x80b74cbe,0x80b74cbf,0x80b74cc1,0x80b74cc0};
+    std::array<std::uint32_t,7> parts{};std::memcpy(parts.data(),packet.data()+4,sizeof(parts));
+    if(parts==ikelos)return 0xe8933a94;
+    if(parts==thorn)return 0x46e42225;
+    if(parts==ace)return 0x855fa0ca;
+    if(parts==lastWord)return 0xeb0f0a93;
+    if(parts==malfeasance)return 0xe11f693e;
+    if(rat_king_akimbo_parts(parts))return ratKingAkimboKey;
+    unsigned body=0,part=0,sight=0;
+    for(auto p:parts){
+        if(p==0xffffffff)continue;
+        if(p==0x80b74ca3)++body;
+        else if(p==0x80b74ca4)++part;
+        else if(p==0x80b74ca5||p==0x81a295c8||p==0x81a295cc||p==0x81a295d0||p==0x81a295d4||p==0x81a295d8)++sight;
+        else return 0;
+    }
+    return body==1&&part==1&&sight==1?0xb7add953:0;
+}
+// Rat King Akimbo owner walk, shared by the HUD (sidearm content 8152AEA5,
+// select_sidearm) and Rat Pack (weapon script 8152AEA6, rat_pack.h). The
+// component c (header already validated by the caller) belongs to an owner
+// entity (self at +0x0C, assembly at +0x4C) whose assembly uses asset
+// 80BBDC90. The asset rows must hold exactly one row with c's tag, at c and
+// with c's header, and exactly one sidearm sound component 80BBDC8E (kind
+// 80803F47, definition 568, c's owner) whose packet lists the private parents.
+// Both headers, the owner entity, the assembly and the packet are re-read
+// after the walk. The result names the first step that failed; otherArt is a
+// packet that already lists another weapon's art (native Rat King), packet one
+// that is unreadable or not complete yet (only private parts and empty words).
+enum class OwnerWalk : std::uint8_t {ok,entity,rows,packet,changed,otherArt};
+// A part in words 4..10 that is neither empty (0xFFFFFFFF, or 0 before it is
+// written) nor one of the private parents: another weapon's art.
+inline bool other_art(const SoundPacket& packet) noexcept {
+    for(unsigned i=4;i<11;++i){
+        const auto part=packet[i];
+        if(part==0xffffffff||!part)continue;
+        bool mine=false;
+        for(const auto parent:ratKingAkimboParents)mine=mine||parent==part;
+        if(!mine)return true;
+    }
+    return false;
+}
+inline OwnerWalk rat_king_akimbo_owner(const Memory& m,std::uintptr_t component,const Header& c) noexcept {
+    constexpr std::uint32_t soundTag=rat_king::soundComponent,assemblyTag=rat_king::assembly;
+    std::uintptr_t entity{},assembly{},asset{};std::uint32_t ownerSelf{},assemblyHandle{},assetTag{};
+    if(!resolve(m,c.owner,entity)||!read(m,entity+12,ownerSelf)||ownerSelf!=c.owner
+        ||!read(m,entity+0x4c,assemblyHandle)||!resolve(m,assemblyHandle,assembly)
+        ||!read(m,assembly+4,assetTag)||assetTag!=assemblyTag||!resolve(m,assetTag,asset))return OwnerWalk::entity;
+    std::uint64_t bytes{},count{},relative{};
+    if(!read(m,asset,bytes)||bytes<48||bytes>0x100000
+        ||!read(m,asset+16,count)||!count||count>128
+        ||!read(m,asset+24,relative)||relative>bytes-0x28||count*12>bytes-0x28-relative)return OwnerWalk::rows;
+    std::uintptr_t sound{};unsigned components=0,sounds=0;
+    for(unsigned i=0;i<count;++i){
+        std::array<std::uint32_t,3> row{};
+        if(!read(m,asset+0x28+relative+i*12,row))return OwnerWalk::rows;
+        if(row[0]!=c.tag&&row[0]!=soundTag)continue;
+        if(row[2]>0x100000||assembly>0x00007fffffffffffULL-row[2])return OwnerWalk::rows;
+        const auto address=assembly+row[2];Header h{};
+        if(!header(m,address,h)||h.tag!=row[0]||h.owner!=c.owner)return OwnerWalk::rows;
+        if(row[0]==c.tag){if(address!=component||h!=c)return OwnerWalk::rows;++components;}
+        else {if(h.kind!=0x80803f47||h.definition!=568)return OwnerWalk::rows;sound=address;++sounds;}
+    }
+    if(components!=1||sounds!=1)return OwnerWalk::rows;
+    Header soundBefore{};SoundPacket packet{};
+    if(!header(m,sound,soundBefore)||!read(m,sound+0x30,packet))return OwnerWalk::packet;
+    if(key_for_parts(packet)!=ratKingAkimboKey)return other_art(packet)?OwnerWalk::otherArt:OwnerWalk::packet;
+    Header after{},soundAfter{};SoundPacket now{};
+    std::uint32_t entityNow{},assemblyNow{},assetNow{};
+    if(!header(m,component,after)||after!=c||!header(m,sound,soundAfter)||soundAfter!=soundBefore
+        ||!read(m,entity+12,entityNow)||entityNow!=ownerSelf
+        ||!read(m,entity+0x4c,assemblyNow)||assemblyNow!=assemblyHandle
+        ||!read(m,assembly+4,assetNow)||assetNow!=assetTag
+        ||!read(m,sound+0x30,now)||now!=packet)return OwnerWalk::changed;
+    return OwnerWalk::ok;
+}
+}
+
+/** Rat King Akimbo on sidearm content 8152AEA5 variant 10. Same owner walk as
+ * select(): the content's own assembly must hold exactly this content and one
+ * sidearm sound component 80BBDC8E whose packet lists the private art. The
+ * native key is 814CE1A0 (INFERRED from variant 10 +0xE0) or a generic key;
+ * each maps to the private row only for this owner. */
+inline bool select_sidearm(const Memory& m,std::uintptr_t content,std::uint32_t original,
+                           std::uint32_t& selected) noexcept {
+    using namespace detail;
+    selected=original;
+    constexpr std::uint32_t contentTag=0x8152aea5,variantIndex=10;
+    if(original!=0x814ce1a0&&original!=0x3eb02f1a&&original!=0x811c9dc5)return false;
+    Header c{};std::uint32_t variant{},overrideTag{};
+    if(!header(m,content,c)||c.tag!=contentTag||c.kind!=0x80803ac9||c.definition!=1096
+        ||!read(m,content+0x60,overrideTag)||overrideTag!=0xffffffff
+        ||!read(m,content+0x68,variant)||variant!=variantIndex
+        ||rat_king_akimbo_owner(m,content,c)!=OwnerWalk::ok)return false;
+    // The walk re-read the headers, owner, assembly and packet; re-read this
+    // content's own selection after it too.
+    std::uint32_t variantNow{},overrideNow{};
+    if(!read(m,content+0x68,variantNow)||variantNow!=variant
+        ||!read(m,content+0x60,overrideNow)||overrideNow!=overrideTag)return false;
+    selected=ratKingAkimboKey;return true;
+}
+/** C9E280 writes a HUD key into its caller's output. Qualify that content
+ * component's own art packet, including stowed/newly equipped weapons. Never
+ * depend on the previous first-person animation or change a shared property. */
+inline bool select(const Memory& m,std::uintptr_t content,std::uint32_t original,
+                   std::uint32_t& selected) noexcept {
+    using namespace detail;
+    // Rat King Akimbo has its own content, sound component and gate; every
+    // other content falls through to the unchanged paired-weapon path below.
+    if(select_sidearm(m,content,original,selected))return true;
+    selected=original;Header c{};std::uintptr_t entity{},assembly{},asset{};
+    std::uint32_t ownerSelf{},assemblyHandle{},assetTag{},variant{},overrideTag{};
+    const bool smg=original==0x27fa7d0f;
+    const unsigned contentTag=smg?0x8152c7c5:0x8152905a,soundTag=smg?0x80bc117e:0x80bbd8a5;
+    if((!smg&&original!=0x811c9dc5&&original!=0xf4e81edf)||!header(m,content,c)||c.tag!=contentTag
+        ||c.kind!=0x80803ac9||c.definition!=(smg?1032u:1832u)
+        ||!read(m,content+0x60,overrideTag)||overrideTag!=0xffffffff
+        ||!read(m,content+0x68,variant)||(smg?variant!=13:(variant!=2&&variant!=3&&variant!=23&&variant!=35))
+        ||!resolve(m,c.owner,entity)||!read(m,entity+12,ownerSelf)||ownerSelf!=c.owner
+        ||!read(m,entity+0x4c,assemblyHandle)||!resolve(m,assemblyHandle,assembly)
+        ||!read(m,assembly+4,assetTag)||!resolve(m,assetTag,asset))return false;
+    std::uint64_t bytes{},count{},relative{};
+    if(!read(m,asset,bytes)||bytes<48||bytes>0x100000
+        ||!read(m,asset+16,count)||!count||count>128
+        ||!read(m,asset+24,relative)||relative>bytes-0x28||count*12>bytes-0x28-relative)return false;
+    std::uintptr_t sound{};unsigned contents=0,sounds=0;
+    for(unsigned i=0;i<count;++i){
+        std::array<std::uint32_t,3> row{};
+        if(!read(m,asset+0x28+relative+i*12,row))return false;
+        if(row[0]!=contentTag&&row[0]!=soundTag)continue;
+        if(row[2]>0x100000||assembly>0x00007fffffffffffULL-row[2])return false;
+        const auto address=assembly+row[2];Header h{};
+        if(!header(m,address,h)||h.tag!=row[0]||h.owner!=c.owner)return false;
+        if(row[0]==contentTag){if(address!=content||h!=c)return false;++contents;}
+        else {if(h.kind!=0x80803f47||h.definition!=568)return false;sound=address;++sounds;}
+    }
+    if(contents!=1||sounds!=1)return false;
+    Header soundBefore{};SoundPacket packet{};
+    if(!header(m,sound,soundBefore)||!read(m,sound+0x30,packet))return false;
+    const auto key=key_for_parts(packet);
+    if(!key||key==ratKingAkimboKey||smg!=(key==0xe8933a94)||variant!=(key==0xe8933a94?13u:key==0xeb0f0a93?2u:key==0x46e42225?3u:key==0xe11f693e?23u:35u))return false;
+    // Native C9E280 returns Last Word's unique key for variant2; the other
+    // supported variants return the generic key. Keep overrides and native
+    // single-weapon art untouched, even when this key belongs to Last Word.
+    if(original!=(key==0xe8933a94?0x27fa7d0fu:key==0xeb0f0a93?0xf4e81edfu:0x811c9dc5u))return false;
+    // Revalidate generation, selection, and art after the bounded owner walk.
+    Header after{},soundAfter{};SoundPacket now{};
+    std::uint32_t entityNow{},assemblyNow{},variantNow{},overrideNow{},assetNow{};
+    if(!header(m,content,after)||after!=c||!header(m,sound,soundAfter)||soundAfter!=soundBefore
+        ||!read(m,entity+12,entityNow)||entityNow!=ownerSelf
+        ||!read(m,entity+0x4c,assemblyNow)||assemblyNow!=assemblyHandle
+        ||!read(m,assembly+4,assetNow)||assetNow!=assetTag
+        ||!read(m,content+0x68,variantNow)||variantNow!=variant
+        ||!read(m,content+0x60,overrideNow)||overrideNow!=overrideTag
+        ||!read(m,sound+0x30,now)||now!=packet)return false;
+    selected=key;return true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/hud_ammo.h b/Dawn/src/client/hooks/akimbo/hud_ammo.h
new file mode 100644
index 0000000000000000000000000000000000000000..6a5b0326ce9ee8074f78a4de2436a1e9842b236d
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/hud_ammo.h
@@ -0,0 +1,154 @@
+#pragma once
+#include "hud_geometry.h"
+#include "smg_magazines.h"
+#include "content_selection.h"
+#include <algorithm>
+#include <cstdio>
+
+namespace dawn::client::hooks::akimbo::hud {
+// Copied under the magazine lock, then validated against the current native
+// owner. This never reads the relaxed diagnostic counters to build a display.
+struct AmmoHand {
+    int rounds{},capacity{};
+    bool reloading{};
+    float progress{};
+};
+struct AmmoSnapshot {
+    std::uint32_t model{},owner{};
+    std::array<AmmoHand,2> hands{};
+    std::uint32_t iconKey{};
+};
+// The native icon geometry can remain cached while the weapon keeps drawing.
+// A presentation sample instead belongs to one exact live first-person owner.
+// Access to this record is protected by the caller's HUD lock.
+struct AmmoPresentation {
+    std::uint32_t model{},owner{},controller{};
+    std::uint64_t at{};
+    void observe(const Identity& id,std::uint64_t now) noexcept {
+        *this={};
+        if(!smg_model(id.modelTag)||!id.modelOwner||id.modelOwner==0xffffffff
+            ||!id.controllerHandle||id.controllerHandle==0xffffffff||!now)return;
+        model=id.modelTag;owner=id.modelOwner;controller=id.controllerHandle;at=now;
+    }
+    bool fresh(const Identity& id,std::uint64_t now) const noexcept {
+        return at&&now>=at&&now-at<=100&&model==id.modelTag
+            &&owner==id.modelOwner&&controller==id.controllerHandle;
+    }
+};
+inline bool ammo_snapshot(const Identity& id,const smg_ammo::State& state,AmmoSnapshot& out) noexcept {
+    out={};
+    if(!smg_model(id.modelTag)||!state.initialized||state.updating||!id.modelOwner
+        ||state.native.modelTag!=id.modelTag||state.native.owner!=id.modelOwner
+        ||!state.native.handle||state.native.handle==0xffffffff
+        ||state.native.root<0x10000||state.native.magazine!=state.native.root+0x24d0
+        ||state.capacity<1||state.capacity>200||(state.loading&~3u))return false;
+    AmmoSnapshot result{id.modelTag,id.modelOwner,{}};
+    for(unsigned i=0;i<2;++i){
+        if(state.rounds[i]<0||state.rounds[i]>state.capacity)return false;
+        auto& hand=result.hands[i];
+        hand={state.rounds[i],state.capacity,(state.loading&(1u<<i))!=0,0};
+        if(hand.reloading){
+            if(!std::isfinite(state.elapsed[i])||!std::isfinite(state.duration[i])
+                ||state.elapsed[i]<0||state.duration[i]<.2f||state.duration[i]>15)return false;
+            hand.progress=std::clamp(state.elapsed[i]/state.duration[i],0.f,1.f);
+        }
+    }
+    out=result;return true;
+}
+
+// C9E280 selects the content variant's HUD icon key at row+E0. Resolve that
+// key from this magazine's exact content owner; no inventory/item whitelist.
+inline bool ammo_native_key(const Memory& m,const Identity& id,std::uintptr_t root,
+                            std::uint32_t& out) noexcept {
+    using namespace detail;out=0;
+    const auto* entry=profiles::find(id.modelTag);
+    if(!entry||!smg_model(id.modelTag))return false;
+    const auto& b=entry->barrel;
+    unsigned rootKind=0x80bfdfeb;
+    if(generic_gun_model(id.modelTag)){gun_layout::Layout layout{};if(!gun_layout::source(m,b,layout))return false;rootKind=layout.rootKind;}
+    Header before{},contentHeader{},after{},contentAfter{};
+    unsigned contentHandle{},contentNow{},variant{},overrideTag{},variantNow{},overrideNow{};
+    std::uintptr_t content{},asset{},row{};
+    if(!header(m,root,before)||before.tag!=b.coreTag||before.kind!=rootKind
+        ||before.definition!=b.rootDefinition||before.owner!=id.modelOwner
+        ||!read(m,root+0x8c0,contentHandle)||!resolve(m,contentHandle,content)
+        ||!header(m,content,contentHeader)||contentHeader.self!=contentHandle
+        ||contentHeader.owner!=id.modelOwner||contentHeader.tag!=b.contentTag
+        ||contentHeader.kind!=0x80803ac9||contentHeader.definition!=b.contentDefinition
+        ||!read(m,content+0x68,variant)||!content_selection::matches(b,variant)
+        ||!read(m,content+0x60,overrideTag)||overrideTag!=0xffffffff
+        ||!content_selection::row(m,b,variant,asset,row))return false;
+    unsigned key{};
+    if(!read(m,row+0xe0,key)||!key||key==0xffffffff
+        ||!header(m,root,after)||after!=before
+        ||!header(m,content,contentAfter)||contentAfter!=contentHeader
+        ||!read(m,root+0x8c0,contentNow)||contentNow!=contentHandle
+        ||!read(m,content+0x68,variantNow)||variantNow!=variant
+        ||!read(m,content+0x60,overrideNow)||overrideNow!=overrideTag)return false;
+    out=key;return true;
+}
+
+// The existing native icon draw supplies diagnostic evidence only: its
+// geometry may be cached, so it is not a per-frame HUD visibility signal.
+// Only the exact vtable/call site/table binding qualifies.
+inline bool ammo_icon_key(const Memory& m,std::uintptr_t base,std::uintptr_t caller,
+                          std::uintptr_t widget,std::uint32_t& out) noexcept {
+    out=0;
+    if(!base||caller!=base+0x13b823d||widget<0x10000||widget>0x00007fffffffffffFULL-0x1d8)return false;
+    std::uintptr_t vtable{},again{};std::array<unsigned,2> binding{},bindingAgain{};
+    if(!detail::read(m,widget,vtable)||vtable!=base+0x1c871b0
+        ||!detail::read(m,widget+0x1d0,binding)||binding[0]!=0x80efc07b
+        ||!binding[1]||binding[1]==0xffffffff
+        ||!detail::read(m,widget,again)||again!=vtable
+        ||!detail::read(m,widget+0x1d0,bindingAgain)||bindingAgain!=binding)return false;
+    out=binding[1];return true;
+}
+struct AmmoVisibility {
+    struct Seen {std::uint32_t key{};std::uint64_t at{};};
+    std::array<Seen,16> entries{};unsigned cursor{};
+    void observe(std::uint32_t key,std::uint64_t now) noexcept {
+        if(!key||key==0xffffffff||!now)return;
+        for(auto& entry:entries)if(entry.key==key){entry.at=now;return;}
+        entries[cursor++%entries.size()]={key,now};
+    }
+    bool visible(std::uint32_t key,std::uint64_t now) const noexcept {
+        if(!key||key==0xffffffff)return false;
+        for(const auto& entry:entries)if(entry.key==key&&entry.at&&now>=entry.at&&now-entry.at<=100)return true;
+        return false;
+    }
+};
+struct AmmoText {
+    std::array<char,16> label{},count{};
+    std::array<char,24> status{};
+};
+inline bool ammo_text(const AmmoSnapshot& snapshot,unsigned index,AmmoText& out) noexcept {
+    out={};if(index>1||!smg_model(snapshot.model)||!snapshot.owner)return false;
+    const auto& hand=snapshot.hands[index];
+    if(hand.capacity<1||hand.capacity>200||hand.rounds<0||hand.rounds>hand.capacity
+        ||!std::isfinite(hand.progress)||hand.progress<0||hand.progress>1)return false;
+    (void)std::snprintf(out.label.data(),out.label.size(),"%s",index?"R  RIGHT":"L  LEFT");
+    (void)std::snprintf(out.count.data(),out.count.size(),"%d / %d",hand.rounds,hand.capacity);
+    if(hand.reloading)(void)std::snprintf(out.status.data(),out.status.size(),"RELOADING %u%%",static_cast<unsigned>(hand.progress*100));
+    else (void)std::snprintf(out.status.data(),out.status.size(),"%s",hand.rounds?"READY":"EMPTY");
+    return true;
+}
+struct AmmoLayout {
+    std::array<Rectangle,2> cards{};
+    float scale{},labelFont{},countFont{},statusFont{},padding{};
+};
+inline bool ammo_layout(float x,float y,float width,float height,AmmoLayout& out) noexcept {
+    out={};
+    if(!std::isfinite(x)||!std::isfinite(y)||!std::isfinite(width)||!std::isfinite(height)
+        ||std::abs(x)>65536||std::abs(y)>65536||width<640||height<360||width>16384||height>16384)return false;
+    // Use the central 16:9 safe area on ultrawide screens. The panel is above
+    // the weapon/ability rows, not on top of their native aggregate/reserves.
+    const float safeWidth=std::min(width,height*16.f/9.f);
+    const float scale=std::clamp(std::min(safeWidth/1920.f,height/1080.f),.75f,3.f);
+    const float left=x+(width-safeWidth)*.5f+safeWidth*.17f;
+    const float cardWidth=152*scale,cardHeight=84*scale,gap=10*scale,top=y+height*.78f-cardHeight;
+    if(left+cardWidth*2+gap>x+width-12*scale||top+cardHeight>y+height-12*scale)return false;
+    out={{{{left,left+cardWidth,top,top+cardHeight},
+           {left+cardWidth+gap,left+cardWidth*2+gap,top,top+cardHeight}}},scale,14*scale,25*scale,12*scale,9*scale};
+    return true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/hud_draw.h b/Dawn/src/client/hooks/akimbo/hud_draw.h
new file mode 100644
index 0000000000000000000000000000000000000000..6ad176bf7a0c008386085b18ad5e29ef51a53102
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/hud_draw.h
@@ -0,0 +1,41 @@
+#pragma once
+#include "akimbo.h"
+#include "hud_ammo.h"
+#include <imgui.h>
+#include <cfloat>
+
+namespace dawn::client::hooks::akimbo::hud {
+inline float fit_ammo_font(ImFont* font,float desired,float room,const char* text) noexcept {
+    const float width=font->CalcTextSizeA(desired,FLT_MAX,0,text).x;
+    return width>room?desired*room/width:desired;
+}
+// Called inside Dawn's existing ImGui frame. It creates no window, takes no
+// input and owns no graphics resources or native game widget allocations.
+inline bool draw_ammo(bool visible) noexcept {
+    AmmoSnapshot snapshot{};
+    if(!visible||!read_ammo_hud(snapshot))return false;
+    const auto* viewport=ImGui::GetMainViewport();AmmoLayout layout{};
+    if(!viewport||!ammo_layout(viewport->Pos.x,viewport->Pos.y,viewport->Size.x,viewport->Size.y,layout))return false;
+    std::array<AmmoText,2> text{};
+    if(!ammo_text(snapshot,0,text[0])||!ammo_text(snapshot,1,text[1]))return false;
+    auto* draw=ImGui::GetBackgroundDrawList();
+    auto* font=ImGui::GetFont();
+    for(unsigned i=0;i<2;++i){
+        const auto& card=layout.cards[i];const auto& hand=snapshot.hands[i];
+        const auto accent=i?IM_COL32(237,242,248,255):IM_COL32(111,216,239,255);
+        const auto stateColor=hand.reloading?IM_COL32(255,208,112,255):hand.rounds?accent:IM_COL32(255,143,143,255);
+        draw->AddRectFilled({card.left,card.top},{card.right,card.bottom},IM_COL32(12,18,25,202),4*layout.scale);
+        draw->AddRectFilled({card.left,card.top},{card.right,card.top+2*layout.scale},accent);
+        const float left=card.left+layout.padding;
+        const float room=card.right-left-layout.padding;
+        draw->AddText(font,fit_ammo_font(font,layout.labelFont,room,text[i].label.data()),{left,card.top+8*layout.scale},accent,text[i].label.data());
+        draw->AddText(font,fit_ammo_font(font,layout.countFont,room,text[i].count.data()),{left,card.top+26*layout.scale},IM_COL32(255,255,255,255),text[i].count.data());
+        draw->AddText(font,fit_ammo_font(font,layout.statusFont,room,text[i].status.data()),{left,card.top+57*layout.scale},stateColor,text[i].status.data());
+        const float barTop=card.bottom-7*layout.scale,barRight=card.right-layout.padding;
+        draw->AddRectFilled({left,barTop},{barRight,barTop+2*layout.scale},IM_COL32(80,88,96,160));
+        const float amount=hand.reloading?hand.progress:static_cast<float>(hand.rounds)/static_cast<float>(hand.capacity);
+        draw->AddRectFilled({left,barTop},{left+(barRight-left)*amount,barTop+2*layout.scale},stateColor);
+    }
+    return true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/hud_geometry.h b/Dawn/src/client/hooks/akimbo/hud_geometry.h
new file mode 100644
index 0000000000000000000000000000000000000000..b83f1cca7ea57cbdfb8d41b2937200d234de5303
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/hud_geometry.h
@@ -0,0 +1,54 @@
+#pragma once
+#include "hud.h"
+#include <cmath>
+
+namespace dawn::client::hooks::akimbo::hud {
+// The native HUD fits every texture into an authored rectangle. Increasing
+// texture dimensions preserves that rectangle and does not enlarge the icons.
+inline constexpr float pairDisplayScale=1.5f;
+// IKELOS sits in the energy slot, whose element glyph follows the icon: at
+// 1.5 the right SMG ran under the glyph (user capture 2026-09-26: pair right
+// edge at left+72.4*scale px, glyph at left+96), so its pair grows less.
+inline constexpr float smgPairDisplayScale=1.2f;
+inline constexpr std::uint32_t smgPairKey=0xe8933a94;
+struct Rectangle {
+    float left{},right{},top{},bottom{};
+    bool operator==(const Rectangle&) const = default;
+};
+static_assert(sizeof(Rectangle)==16);
+
+inline bool enlarge_pair(Rectangle& rect,float scale=pairDisplayScale) noexcept {
+    if(!std::isfinite(rect.left)||!std::isfinite(rect.right)
+        ||!std::isfinite(rect.top)||!std::isfinite(rect.bottom))return false;
+    const float width=rect.right-rect.left,height=rect.bottom-rect.top;
+    if(width<0.25f||width>1024.0f||height<0.25f||height>512.0f
+        ||std::fabs(rect.left)>8192.0f||std::fabs(rect.top)>8192.0f)return false;
+    // Keep the pair's left edge and vertical center in place. Additional width
+    // uses the existing space before the ammo count, with no glyph distortion.
+    const float extraHeight=height*(scale-1.0f)*0.5f;
+    rect.right=rect.left+width*scale;
+    rect.top-=extraHeight;
+    rect.bottom+=extraHeight;
+    return true;
+}
+
+inline bool select_geometry(const Memory& m,std::uintptr_t base,
+    std::uintptr_t caller,std::uintptr_t widget,Rectangle& rect,
+    std::uint32_t& selectedKey) noexcept {
+    // 13B7F10 is the native icon widget draw. Its main image calls 13486B0
+    // at 13B8238, then copies the returned rectangle into its draw command.
+    // Other consumers of the shared rectangle helper remain untouched.
+    if(!base||caller!=base+0x13b823d||widget<0x10000
+        ||widget>0x00007fffffffffffULL-0x1d8)return false;
+    std::array<std::uint32_t,2> binding{},again{};
+    std::uintptr_t vtable{},vtableAgain{};
+    if(!detail::read(m,widget,vtable)||vtable!=base+0x1c871b0
+        ||!detail::read(m,widget+0x1d0,binding)||binding[0]!=0x80efc07b
+        ||(binding[1]!=0x46e42225&&binding[1]!=0x855fa0ca&&binding[1]!=0xb7add953&&binding[1]!=0xeb0f0a93&&binding[1]!=0xe11f693e&&binding[1]!=smgPairKey
+            &&binding[1]!=detail::ratKingAkimboKey))return false;
+    Rectangle enlarged=rect;
+    if(!enlarge_pair(enlarged,binding[1]==smgPairKey?smgPairDisplayScale:pairDisplayScale)||!detail::read(m,widget+0x1d0,again)||again!=binding
+        ||!detail::read(m,widget,vtableAgain)||vtableAgain!=vtable)return false;
+    rect=enlarged;selectedKey=binding[1];return true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/hud_native.cpp b/Dawn/src/client/hooks/akimbo/hud_native.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..30e77ab047c8847906b6ebebf249ddf0f88a83f2
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/hud_native.cpp
@@ -0,0 +1,323 @@
+#include "hud_native.h"
+#include "akimbo.h"
+#include <Windows.h>
+#include <intrin.h>
+#include <atomic>
+#include <cstring>
+#include "../../hooking/call_gate.h"
+#include "../../hooking/detour.h"
+#include "../../../core/logging/log.h"
+
+namespace dawn::client::hooks::akimbo::hud::native {
+namespace {
+using Update=void(__fastcall*)(void*,void*);
+using Compare=bool(__fastcall*)(void*,const char16_t*,const char16_t*,unsigned);
+using Copy=void*(__fastcall*)(void*,const char16_t*,std::size_t);
+using Layout=void*(__fastcall*)(void*,unsigned char,const void*,const void*,const void*,float,std::uint16_t,unsigned char,const void*,const void*);
+using Draw=void(__fastcall*)(void*,void*,void*);
+using Dirty=void(__fastcall*)(void*,bool);
+using Invalidate=void(__fastcall*)(void*);
+using Submit=void(__fastcall*)(void*,const void*,const float*,const void*,int,const float*,const float*,const void*);
+std::atomic<Update> nextUpdate{};
+std::atomic<Compare> nextCompare{};
+std::atomic<Copy> nextCopy{};
+std::atomic<Layout> nextLayout{};
+std::atomic<Draw> nextDraw{};
+std::atomic<Submit> nextSubmit{};
+std::array<hooking::detour::Handle,6> handles{};
+hooking::CallGate gate{};
+std::atomic<bool> installed{};
+std::uintptr_t imageBase{};
+Memory memory{};
+thread_local Routing routing{};
+thread_local DrawOverride* currentDraw{};
+SRWLOCK renderedLock=SRWLOCK_INIT;
+struct Rendered {unsigned model{},owner{},layers{};std::uint64_t at[2]{};};
+Rendered lastRendered{};
+std::array<std::atomic<unsigned>,profiles::kGeneratedLimit> reported{};
+std::atomic<unsigned> geometryReported{};
+bool read_memory(void*,std::uintptr_t address,void* out,std::size_t bytes) noexcept {
+    __try {std::memcpy(out,reinterpret_cast<const void*>(address),bytes);return true;}
+    __except(EXCEPTION_EXECUTE_HANDLER){return false;}
+}
+void note(const AmmoSnapshot& snapshot,unsigned bit,const char* stage) noexcept {
+    const auto index=profiles::generated.generated_index(snapshot.model);
+    if(index>=reported.size()||(reported[index].fetch_or(bit,std::memory_order_relaxed)&bit))return;
+    char line[208]{};
+    (void)std::snprintf(line,sizeof(line),
+        "ev=akimbo_generated stage=native_ammo_hud result=%s model=%08X owner=%08X left=%d right=%d loading=%u",
+        stage,snapshot.model,snapshot.owner,snapshot.hands[0].rounds,snapshot.hands[1].rounds,
+        (snapshot.hands[0].reloading?1u:0u)|(snapshot.hands[1].reloading?2u:0u));
+    core::log::write(core::log::Channel::client,core::log::Level::info,line);
+}
+void note_style(const AmmoSnapshot& snapshot,float shift,unsigned layer) noexcept {
+    const unsigned mask=(snapshot.hands[0].reloading?1u:0u)|(snapshot.hands[1].reloading?2u:0u);
+    const auto index=profiles::generated.generated_index(snapshot.model);const unsigned bit=8u<<(mask+layer*4);
+    if(index>=reported.size()||(reported[index].fetch_or(bit,std::memory_order_relaxed)&bit))return;
+    char line[192]{};
+    (void)std::snprintf(line,sizeof(line),
+        "ev=akimbo_generated stage=native_ammo_style result=submitted model=%08X owner=%08X layer=%u loading=%u shift_y=%g digits_tint=red native_alpha=preserved",
+        snapshot.model,snapshot.owner,layer,mask,static_cast<double>(shift));
+    core::log::write(core::log::Channel::client,core::log::Level::info,line);
+}
+void note_retained(const AmmoSnapshot* snapshot,unsigned layer,std::uint8_t state,bool pending,
+                   const PairText& actual,float shift) noexcept {
+    if(snapshot){
+        Text newest{};
+        if(state==8&&!pending&&format(*snapshot,newest)&&newest==actual.text)return;
+        const auto index=profiles::generated.generated_index(snapshot->model);const unsigned bit=4096u<<layer;
+        if(index>=reported.size()||(reported[index].fetch_or(bit,std::memory_order_relaxed)&bit))return;
+    }else if(geometryReported.fetch_or(1u<<layer,std::memory_order_relaxed)&(1u<<layer))return;
+    char line[256]{};
+    (void)std::snprintf(line,sizeof(line),
+        "ev=akimbo_native_hud stage=style result=retained_layout layer=%u state=%u pending_job=%u tint=%u model=%08X owner=%08X shown_left=%d shown_right=%d shift_y=%g",
+        layer,static_cast<unsigned>(state),pending?1u:0u,snapshot?1u:0u,snapshot?snapshot->model:0,
+        snapshot?snapshot->owner:0,actual.rounds[0],actual.rounds[1],static_cast<double>(shift));
+    core::log::write(core::log::Channel::client,core::log::Level::info,line);
+}
+// Native callbacks can propagate SEH to their game caller. Finally blocks keep
+// TLS and the hook gate balanced even when /EHsc does not unwind C++ objects.
+void invoke_update(Update original,void* widget,void* context,Override* scope) noexcept {
+    const auto saved=routing.enter(scope);
+    __try {original(widget,context);}
+    __finally {routing.leave(saved);}
+}
+void invalidate(void* widget) noexcept {
+    const auto saved=routing.enter(nullptr);
+    __try {reinterpret_cast<Invalidate>(imageBase+0x1371e70)(widget);}
+    __finally {routing.leave(saved);}
+}
+void publish(void* widget,bool redraw) noexcept {
+    const auto saved=routing.enter(nullptr);
+    __try {
+        reinterpret_cast<Dirty>(imageBase+0x135aea0)(widget,true);
+        // A reload tint can change without any text/round-count change. Ask the
+        // native renderer to rebuild this owned counter's cached draw commands.
+        if(redraw)reinterpret_cast<Dirty>(imageBase+0x135af70)(widget,true);
+    }
+    __finally {routing.leave(saved);}
+}
+bool source_current(const Override* scope) noexcept {
+    std::uintptr_t source{};Text text{};
+    return scope&&scope->apply&&direct_source(memory,scope->widget,source,text)&&source==scope->source;
+}
+void update_impl(void* widget,void* context) noexcept {
+    Override scope{};Binding binding{};AmmoSnapshot snapshot{};Text sourceText{};std::uintptr_t source{};
+    // This structural heartbeat is deliberately independent of ammo readiness.
+    // It bootstraps an equip and observes R/state changes with unchanged totals.
+    const auto address=reinterpret_cast<std::uintptr_t>(widget);
+    const bool heartbeat=gate.accepting()&&routing.depth==0&&bind(memory,imageBase,address,0,binding);
+    const bool direct=heartbeat&&direct_source(memory,address,source,sourceText);
+    if(direct&&read_ammo_hud(snapshot)&&replacement_key(snapshot.iconKey)
+        &&snapshot.iconKey==binding.iconKey&&format(snapshot,scope.text)){
+        scope.widget=address;scope.source=source;scope.apply=true;
+        note(snapshot,1u,"selected");
+    }
+    Text desired{};
+    // A cached listener can skip the original comparison even after a native
+    // update pulse. Use the exact native text-change invalidation only when the
+    // desired text differs. Restoring stock text also restores its native font.
+    if(direct&&refresh_text(memory,address,scope,sourceText,desired)){
+        if(hooking::await_original(nextCompare)(reinterpret_cast<void*>(address+0x230),
+            desired.data.data(),desired.data.data()+desired.length,0))invalidate(widget);
+    }
+    // An ineligible nested update cannot inherit its caller's override. Only
+    // the native update owns the stack text; listener publication sees no TLS.
+    invoke_update(hooking::await_original(nextUpdate),widget,context,&scope);
+    // 135BDB0 clears 0200/0400 before calling this virtual update. The native
+    // publisher sets them again and queues the existing branch/listener; it
+    // does not allocate a widget or retain our pointer beyond this callback.
+    Binding after{};
+    if(heartbeat&&routing.depth==0&&bind(memory,imageBase,address,0,after)&&same_binding(binding,after))publish(widget,scope.apply);
+}
+__declspec(noinline) void __fastcall update_hook(void* widget,void* context) noexcept {
+    hooking::call_gate_detail::enter(gate);
+    __try {update_impl(widget,context);}
+    __finally {hooking::call_gate_detail::leave(gate);}
+}
+__declspec(noinline) bool __fastcall compare_hook(void* destination,const char16_t* first,
+                                                const char16_t* last,unsigned mode) noexcept {
+    hooking::CallGate::Scope call(gate);
+    const auto caller=reinterpret_cast<std::uintptr_t>(_ReturnAddress());
+    if(call.accepts_side_effects()&&compare_route(routing.current,imageBase,caller,
+        reinterpret_cast<std::uintptr_t>(destination),reinterpret_cast<std::uintptr_t>(first),
+        reinterpret_cast<std::uintptr_t>(last))&&source_current(routing.current)){
+        first=routing.current->text.data.data();last=first+routing.current->text.length;
+    }
+    return hooking::await_original(nextCompare)(destination,first,last,mode);
+}
+__declspec(noinline) void* __fastcall copy_hook(void* output,const char16_t* first,std::size_t length) noexcept {
+    hooking::CallGate::Scope call(gate);
+    if(call.accepts_side_effects()&&copy_route(routing.current,imageBase,
+        reinterpret_cast<std::uintptr_t>(_ReturnAddress()),reinterpret_cast<std::uintptr_t>(first),length)
+        &&source_current(routing.current)){
+        first=routing.current->text.data.data();length=routing.current->text.length;
+    }
+    // 127C6D0 allocates native storage and copies length+1 UTF16 code units.
+    // No stack pointer survives this call; native refcounts own the result.
+    return hooking::await_original(nextCopy)(output,first,length);
+}
+__declspec(noinline) void* __fastcall layout_hook(void* output,unsigned char revision,
+    const void* first,const void* second,const void* third,float leading,std::uint16_t size,
+    unsigned char flags,const void* font,const void* style) noexcept {
+    hooking::CallGate::Scope call(gate);
+    if(call.accepts_side_effects()&&layout_route(routing.current,imageBase,
+        reinterpret_cast<std::uintptr_t>(_ReturnAddress()))&&source_current(routing.current))size=font_size(size);
+    return hooking::await_original(nextLayout)(output,revision,first,second,third,leading,size,flags,font,style);
+}
+void invoke_draw(void* widget,void* context,void* commands,DrawOverride* scope) noexcept {
+    auto* previous=currentDraw;currentDraw=scope;
+    __try {hooking::await_original(nextDraw)(widget,context,commands);}
+    __finally {currentDraw=previous;}
+}
+void draw_impl(void* widget,void* context,void* commands) noexcept {
+    DrawOverride scope{};
+    const auto address=reinterpret_cast<std::uintptr_t>(widget);
+    std::uintptr_t source{};Text sourceText{};
+    // The native draw intentionally retains its prior +240 layout while a new
+    // number is built. Qualify the current widget here; inspect the layout that
+    // is actually passed to the submit callback, not a pre-draw pointer/string.
+    if(gate.accepting()&&bind(memory,imageBase,address,0,scope.binding)
+        &&direct_source(memory,address,source,sourceText)){
+        scope.widget=address;scope.layer=scope.binding.layer;scope.apply=true;
+    }
+    invoke_draw(widget,context,commands,&scope);
+    if(!scope.submittedTint)return;
+    const auto& snapshot=scope.submittedSnapshot;
+    const auto now=GetTickCount64();
+    AcquireSRWLockExclusive(&renderedLock);
+    if(lastRendered.model!=snapshot.model||lastRendered.owner!=snapshot.owner)
+        lastRendered={snapshot.model,snapshot.owner,0,{}};
+    lastRendered.layers|=1u<<scope.layer;lastRendered.at[scope.layer]=now;
+    ReleaseSRWLockExclusive(&renderedLock);
+    note(snapshot,2u<<scope.layer,scope.layer?"shadow_draw_callback":"foreground_draw_callback");
+}
+__declspec(noinline) void __fastcall draw_hook(void* widget,void* context,void* commands) noexcept {
+    hooking::call_gate_detail::enter(gate);
+    __try {draw_impl(widget,context,commands);}
+    __finally {hooking::call_gate_detail::leave(gate);}
+}
+__declspec(noinline) void __fastcall submit_hook(void* commands,const void* transform,const float* offset,
+    const void* layout,int alignment,const float* color,const float* clip,const void* effects) noexcept {
+    hooking::CallGate::Scope call(gate);
+    const auto next=hooking::await_original(nextSubmit);
+    StyledLayout styled{};std::array<float,2> offsetCopy{},shifted{};std::array<float,4> colorCopy{};
+    std::uintptr_t ownedLayout{};Binding binding{};PairText visible{};AmmoSnapshot snapshot{};
+    const auto submittedLayout=reinterpret_cast<std::uintptr_t>(layout);
+    if(call.accepts_side_effects()&&currentDraw&&currentDraw->apply
+        &&detail::read(memory,currentDraw->widget+0x240,ownedLayout)&&submit_route(currentDraw,imageBase,
+        reinterpret_cast<std::uintptr_t>(_ReturnAddress()),reinterpret_cast<std::uintptr_t>(transform),
+        submittedLayout,ownedLayout)
+        &&bind(memory,imageBase,currentDraw->widget,0,binding)&&same_binding(currentDraw->binding,binding)
+        &&layout_text(memory,submittedLayout,visible)){
+        // Only tint needs fresh weapon/ammo data. A recognized retained paired
+        // layout keeps its own offset during async updates and stock restoration.
+        const bool tint=read_ammo_hud(snapshot)&&replacement_key(snapshot.iconKey)
+            &&snapshot.iconKey==binding.iconKey&&tint_valid(snapshot,visible);
+        if(detail::read(memory,reinterpret_cast<std::uintptr_t>(offset),offsetCopy)&&pair_offset(visible,offsetCopy,shifted)){
+            const bool colored=tint&&detail::read(memory,reinterpret_cast<std::uintptr_t>(color),colorCopy)
+                &&style_layout(memory,submittedLayout,offsetCopy,colorCopy,&snapshot,visible.text,styled);
+            // The native writer copies glyph rectangles and each style RGBA to
+            // its command arena synchronously; no temporary address survives.
+            // Optional tint failure cannot move a recognized retained pair back
+            // down: submit its original native layout with only the local offset.
+            next(commands,transform,shifted.data(),colored?styled.header.data():layout,alignment,color,clip,effects);
+            if(colored){
+                currentDraw->submittedSnapshot=snapshot;currentDraw->submittedTint=true;
+                note_style(snapshot,shifted[1]-offsetCopy[1],currentDraw->layer);
+            }else if(tint){
+                note(snapshot,2048u,"tint_declined_retained_geometry");
+            }
+            std::uint8_t state{};std::uintptr_t job{};
+            (void)detail::read(memory,currentDraw->widget+0x122,state);
+            (void)detail::read(memory,currentDraw->widget+0x248,job);
+            note_retained(colored?&snapshot:nullptr,currentDraw->layer,state,job!=0,visible,shifted[1]-offsetCopy[1]);
+            return;
+        }
+    }
+    next(commands,transform,offset,layout,alignment,color,clip,effects);
+}
+bool idle() noexcept {return gate.idle();}
+template<std::size_t N> bool matches(std::uintptr_t rva,const std::array<unsigned char,N>& wanted) noexcept {
+    std::array<unsigned char,N> got{};
+    const bool readable=read_memory(nullptr,imageBase+rva,got.data(),got.size());
+    if(readable&&got==wanted)return true;
+    std::array<char,N*2+1> expected{},actual{};
+    for(std::size_t i=0;i<N;++i){
+        (void)std::snprintf(expected.data()+i*2,3,"%02X",static_cast<unsigned>(wanted[i]));
+        (void)std::snprintf(actual.data()+i*2,3,"%02X",static_cast<unsigned>(got[i]));
+    }
+    char line[256]{};
+    (void)std::snprintf(line,sizeof(line),
+        "ev=akimbo_native_hud stage=guard result=%s rva=%llX bytes=%zu expected=%s actual=%s",
+        readable?"mismatch":"unreadable",static_cast<unsigned long long>(rva),N,expected.data(),actual.data());
+    core::log::write(core::log::Channel::client,core::log::Level::warn,line);
+    return false;
+}
+}
+bool rendered(unsigned model,unsigned owner) noexcept {
+    const auto now=GetTickCount64();
+    AcquireSRWLockShared(&renderedLock);const auto seen=lastRendered;ReleaseSRWLockShared(&renderedLock);
+    return seen.model==model&&seen.owner==owner&&seen.layers==3
+        &&now>=seen.at[0]&&now>=seen.at[1]&&now-seen.at[0]<=100&&now-seen.at[1]<=100;
+}
+bool install() noexcept {
+    if(installed.load(std::memory_order_acquire))return gate.accepting();
+    imageBase=reinterpret_cast<std::uintptr_t>(GetModuleHandleW(nullptr));memory={nullptr,&read_memory,0};
+    if(!imageBase
+        ||!matches(0x136cd40,std::array<unsigned char,20>{0x4c,0x8b,0xdc,0x55,0x41,0x55,0x49,0x8d,0xab,0x98,0xf3,0xff,0xff,0x48,0x81,0xec,0x58,0x0d,0,0})
+        ||!matches(0x127f470,std::array<unsigned char,22>{0x48,0x89,0x5c,0x24,0x18,0x55,0x56,0x41,0x57,0x48,0x83,0xec,0x20,0x48,0x8b,0xda,0x41,0xbf,0,0,0,0})
+        ||!matches(0x127c6d0,std::array<unsigned char,24>{0x48,0x89,0x5c,0x24,0x10,0x48,0x89,0x6c,0x24,0x18,0x56,0x48,0x83,0xec,0x20,0x49,0x8b,0xf0,0x48,0x8b,0xea,0x48,0x8b,0xd9})
+        ||!matches(0x127b7f0,std::array<unsigned char,20>{0x48,0x89,0x5c,0x24,0x08,0x48,0x89,0x74,0x24,0x10,0x57,0x48,0x83,0xec,0x20,0xf2,0x41,0x0f,0x10,0})
+        ||!matches(0x136c200,std::array<unsigned char,24>{0x48,0x8b,0xc4,0x55,0x53,0x56,0x57,0x41,0x56,0x41,0x57,0x48,0x8d,0xa8,0xb8,0xfe,0xff,0xff,0x48,0x81,0xec,0x18,0x02,0})
+        ||!matches(0x1278640,std::array<unsigned char,12>{0x40,0x56,0x57,0x41,0x54,0x48,0x81,0xec,0xd0,0,0,0})
+        ||!matches(0x135aea0,std::array<unsigned char,9>{0x84,0xd2,0x74,0x5f,0x53,0x48,0x83,0xec,0x20})
+        ||!matches(0x135af70,std::array<unsigned char,13>{0x84,0xd2,0x74,0x4f,0x53,0x48,0x83,0xec,0x20,0x0f,0xb7,0x41,0x1e})
+        ||!matches(0x1371e70,std::array<unsigned char,12>{0x40,0x53,0x48,0x83,0xec,0x20,0x8b,0x81,0xa8,0,0,0}))return false;
+    const std::array specs{
+        hooking::detour::Spec{reinterpret_cast<void*>(imageBase+0x136cd40),reinterpret_cast<void*>(&update_hook)},
+        hooking::detour::Spec{reinterpret_cast<void*>(imageBase+0x127f470),reinterpret_cast<void*>(&compare_hook)},
