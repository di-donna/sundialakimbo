+void magazine_integration(){
+    using a::smg_ammo::State;
+    const a::smg_ammo::Native owner{0x100000,0x1024d0,0x2001,0x2002,0x81a2990a};
+    State s;int reserve=20;
+    (void)s.initialize(owner,4,8,0,0);s.tubeMode=true;s.rounds[0]=0;
+    check(s.request_tube(true,reserve,inputs,3)==1&&s.loading==1,"policy3 selects only the lower tube");
+    check(!s.request_tube(true,reserve,inputs,3),"holding R cannot restart tube opening");
+    check(!s.advance(100,reserve,true)&&s.rounds[0]==0,"tube cannot fall through to whole-magazine advance");
+    const int total=s.total()+reserve;int shots=0;
+    for(unsigned now=100;now<=1500;now+=100){
+        reserve-=s.advance_tube(now,reserve,true,inputs);
+        if(now%300==0&&s.consume(2))++shots;
+        check(s.total()+reserve+shots==total,"real State conserves opposite-hand shots during shell transfer");
+        check(s.loading==1&&s.tube[0].active(),"one shell does not report the tube reload finished");
+    }
+    check(s.rounds[0]==1&&s.rounds[1]==0&&reserve==19&&shots==4,"left inserted once while right independently spent all rounds");
+    for(unsigned now=1600;now<=4000;now+=100)reserve-=s.advance_tube(now,reserve,true,inputs);
+    check(s.rounds[0]==4&&!s.loading&&!s.tube[0].active()&&reserve==16,"complete tube pays only its four insertions and closing");
+    (void)s.initialize(owner,4,0,0,0);s.tubeMode=true;reserve=2;
+    check(s.request_tube(true,reserve,inputs,3)==3,"both empty tubes retain the policy3 exception");
+    for(unsigned now=100;now<=2500;now+=100)reserve-=s.advance_tube(now,reserve,true,inputs);
+    check(s.rounds[0]==1&&s.rounds[1]==1&&!reserve&&!s.loading,"simultaneous per-shell events share scarce reserve without duplication");
+    (void)s.initialize(owner,4,8,0,0);s.tubeMode=true;s.rounds[0]=0;reserve=20;
+    check(s.request_tube(true,reserve,inputs,3)==1,"queued-spend fixture selects left");
+    for(unsigned now=100;now<=1500;now+=100){
+        check(!s.advance_tube(now,reserve,true,inputs,1.f,false),"queued native spend cannot be overwritten by tube transfer");
+        s.defer_native(now,2,2,false,now);
+    }
+    check(s.tube[0].phase==t::Phase::Inserting&&!s.tube[0].refilled&&s.tube[0].elapsed==s.tube[0].seconds,
+        "prepaid native events retain a single due tube insertion");
+    check(s.reconcile(s.total(),4)&&s.loading==1,"canceled unchanged native queue preserves the due insertion");
+    check(s.advance_tube(1600,reserve,true,inputs)==1&&s.rounds[0]==1,"settled queue transfers exactly one pending shell");
+    const auto left=s.tube[0];s.lastSide=2;
+    check(s.reconcile(s.total()-1,4)&&s.loading==1&&s.tube[0].phase==left.phase&&s.tube[0].elapsed==left.elapsed,
+        "opposite native debit cannot cancel or restart the tube phase");
