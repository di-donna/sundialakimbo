+    result=id;return true;
+}
+bool copied_thorn_render_job(const Memory& memory,const Identity& id,
+                             std::uintptr_t source,std::uintptr_t copy) noexcept {
+    if(!source||!copy||source==copy||!separated_model(id.modelTag)||!still_current(memory,id))return false;
+    std::array<std::byte,0x180> a{},b{};std::array<std::uint64_t,2> controls{};
+    if(!get(memory,source,a)||!get(memory,copy,b)||a!=b||!render_layout(id,b))return false;
+    const auto frozen=at<std::uintptr_t>(b,0xa0);
+    // Captured native 81579415 control header after F620F0 relocation. A
+    // returned allocation without the completed copy is not a render job.
+    return frozen!=id.animation+0x50&&get(memory,frozen,controls)
+        &&controls==control_header(id.modelTag)
+        &&still_current(memory,id);
+}
+bool completed_thorn_render_job(const Memory& memory,const Identity& id,
+                                std::uintptr_t copy,std::uintptr_t output) noexcept {
+    std::array<std::byte,0x180> b{};std::array<std::uint64_t,2> controls{};
+    if(!get(memory,copy,b)||!render_layout(id,b)||at<std::uintptr_t>(b,0xe0)!=output)return false;
+    const auto frozen=at<std::uintptr_t>(b,0xa0);
+    return frozen!=id.animation+0x50&&get(memory,frozen,controls)
+        &&controls==control_header(id.modelTag)
+        &&still_current(memory,id);
+}
+bool correct_export(const Memory& memory,const Identity& id,Pass pass,std::uintptr_t ranges,
+                    std::uintptr_t outputs,unsigned* selection,Pose* poses) noexcept {
+    Ranges rs{};std::array<std::uintptr_t,4> out{};unsigned mode{};
+    if (!poses || !get(memory,reinterpret_cast<std::uintptr_t>(selection),mode) || (mode!=0 && mode!=4)
+        || !get(memory,ranges,rs) || rs.count!=4 || !get(memory,outputs,out)) return false;
+    const auto procedural=static_cast<std::uint16_t>(weapon_procedural_start(id.modelTag));
+    const std::array<std::uint16_t,4> starts{0,25,72,procedural},counts{25,47,static_cast<std::uint16_t>(procedural-72),static_cast<std::uint16_t>(pose_bones(id.modelTag)-procedural)};
+    for (unsigned i=0;i<4;++i) if (rs.records[i].index!=i || rs.records[i].start!=starts[i] || rs.records[i].count!=counts[i]) return false;
+    if (!(rs.records[0].flags&1) || !(rs.records[2].flags&1)) return false;
+    const unsigned nonresident=mode==4?2U:0U;
+    if ((rs.records[1].flags&3U)!=nonresident || (rs.records[3].flags&3U)!=nonresident) return false;
+    std::uintptr_t nodes{};
+    if (pass==Pass::first) {
+        std::uint32_t bones{},controls{};
+        if (ranges<0xac || !get(memory,ranges-0xac,bones) || bones!=pose_bones(id.modelTag)
+            || !get(memory,ranges-0x9c,controls) || controls!=pose_controls(id.modelTag) || !get(memory,ranges-0xa4,nodes)) return false;
+    } else {
+        std::uint64_t bones{};std::uintptr_t skeleton{},rig{};
+        if (mode || ranges<16 || !get(memory,ranges+0x28,bones) || bones!=pose_bones(id.modelTag)
+            || !get(memory,ranges+0x30,nodes) || !get(memory,ranges-8,skeleton) || skeleton!=id.skeleton
+            || !get(memory,ranges-16,rig) || rig!=id.rig) return false;
+    }
+    if (nodes!=id.nodes) return false;
+    if (mode==4) {
+        if (out[0]<0x10000 || out[0]>0x00007fffffffffffULL-pose_bones(id.modelTag)*32
+            || out[1]!=out[0]+800 || out[2]!=out[0]+2304 || out[3]!=out[0]+procedural*32) return false;
+    } else if (out[0]!=id.skeleton+0x1c0 || out[1] || out[2]!=id.skeleton+0x500 || out[3]) return false;
+    // The pose is aligned only after the identity is still current.
+    if (!still_current(memory,id) || !(sidearm_model(id.modelTag)?align_sidearm_pose(poses,mode)
+        :sturm_drang_model(id.modelTag)?align_sturm_drang_pose(poses,mode)
+        :smg_model(id.modelTag)?align_smg(memory,id,poses,mode):align_dual_pose(poses,mode))) return false;
+    if (mode==4) *selection=0;
+    return true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/export_filter.h b/Dawn/src/client/hooks/akimbo/export_filter.h
