index 0000000000000000000000000000000000000000..87e1bdb13eab1d5ebfe1adf822cf9e23cc384637
--- /dev/null
+++ b/Dawn/unit/akimbo_burst_exit_tests.cpp
@@ -0,0 +1,88 @@
+#include "../src/client/hooks/akimbo/burst_exit.h"
+#include <cstdio>
+#include <cstdlib>
+
+namespace a=dawn::client::hooks::akimbo;
+namespace b=a::burst;
+namespace r=b::runtime;
+static unsigned checks{};
+static void check_impl(bool value,unsigned line){++checks;if(!value){std::fprintf(stderr,"failed check %u at %u\n",checks,line);std::exit(1);}}
+#define check(...) check_impl((__VA_ARGS__),__LINE__)
+static constexpr b::Key key{0x1234,0x8152c7c3,0x81d40001};
+struct Fixture {
+    a::smg_ammo::State mag{};r::Owner owner{};r::Phase phase{};
+    Fixture(){
+        mag.native={0x50000,0x524e0,key.handle,key.owner,key.model};mag.initialized=true;mag.capacity=200;
+        mag.rounds[0]=27;mag.rounds[1]=19;mag.elapsed[0]=.2f;mag.elapsed[1]=.3f;
+        mag.duration[0]=1.2f;mag.duration[1]=1.3f;mag.loading=2;mag.reloadPending=true;
+        owner.select(key);phase.native=mag.native;phase.side=b::left;phase.count=3;phase.revision=1;phase.qualified=true;
+    }
+};
+int main(){
+    r::ExitDebit absent;check(absent.callback_complete());
+    absent.rejected=true;check(!absent.callback_complete()); // A refused callback is not absence.
+    Fixture semanticLoss;const auto savedRounds=semanticLoss.mag.total();
+    check(!r::begin_exit(semanticLoss.owner,semanticLoss.mag,absent,semanticLoss.phase,savedRounds));
+    check(semanticLoss.mag.total()==savedRounds&&!semanticLoss.mag.updating&&!semanticLoss.owner.busy);
+    Fixture incomplete;r::ExitDebit pending;check(r::begin_exit(incomplete.owner,incomplete.mag,pending,incomplete.phase,46));
+    check(!pending.callback_complete());check(r::settle_exit(incomplete.owner,incomplete.mag,pending,46,true));
+    check(pending.callback_complete());pending.rejected=true;check(!pending.callback_complete());
+    for(unsigned side:{b::left,b::right})for(unsigned count=2;count<=64;++count)for(int rounds=0;rounds<=200;++rounds){
+        Fixture f;f.phase.side=side;f.phase.count=count;const auto i=side==b::left?0u:1u;
+        f.mag.rounds[i]=rounds;const auto other=f.mag.rounds[1-i];const int total=f.mag.total();
+        const int reported=(f.mag.loading&side)?0:rounds,remainder=reported%static_cast<int>(count);
+        r::ExitDebit d;check(r::begin_exit(f.owner,f.mag,d,f.phase,total));
+        check(d.hand==rounds&&d.reported==reported&&d.remainder==remainder&&d.loading==2&&f.mag.updating&&f.owner.busy);
+        r::ExitDebit nested;check(!r::begin_exit(f.owner,f.mag,nested,f.phase,total));
+        check(r::settle_exit(f.owner,f.mag,d,total-remainder,true));
+        check(f.mag.rounds[i]==rounds-remainder&&f.mag.rounds[1-i]==other&&f.mag.total()==total-remainder);
+        check(!f.mag.updating&&!f.owner.busy&&!f.owner.failed&&f.mag.loading==2&&f.mag.reloadPending);
+        check(f.mag.elapsed[0]==.2f&&f.mag.elapsed[1]==.3f&&f.mag.duration[0]==1.2f&&f.mag.duration[1]==1.3f);
+        check(!r::settle_exit(f.owner,f.mag,d,total-remainder,true));
+    }
+    // A queued, already-paid shot survives leaving its finite phase. There is
+    // no second ammunition cost at emission or receipt retirement.
+    Fixture queued;queued.mag.rounds[0]=5;
+    auto spend=queued.owner.begin(b::left,0,3,1,1,{6,19},0);check(spend.valid);
+    b::Queued packet{0x12345,0x30000,{0,0,-1,0,0,0,0,0,~0u}};
+    check(queued.owner.settle(spend,true,&packet).queued);
+    const auto receipt=queued.owner.find(packet.token);r::ExitDebit debit;
+    check(r::begin_exit(queued.owner,queued.mag,debit,queued.phase,24));
+    check(r::settle_exit(queued.owner,queued.mag,debit,22,true));
+    check(queued.owner.find(packet.token).receipt.valid&&queued.owner.retire(receipt)&&queued.mag.rounds[0]==3);
+    Fixture interrupted;interrupted.mag.rounds[0]=98;interrupted.mag.loading=1;
+    spend=interrupted.owner.begin(b::left,0,3,1,1,{99,19},0);check(spend.valid);
+    check(interrupted.owner.settle(spend,true,&packet).queued);
+    const auto paid=interrupted.owner.find(packet.token);r::ExitDebit canceled;
+    check(r::begin_exit(interrupted.owner,interrupted.mag,canceled,interrupted.phase,117));
+    check(canceled.hand==98&&canceled.reported==0&&canceled.remainder==0&&canceled.loading==1);
+    check(r::settle_exit(interrupted.owner,interrupted.mag,canceled,117,true));
+    check(interrupted.mag.rounds[0]==98&&interrupted.mag.rounds[1]==19&&interrupted.mag.loading==1);
+    check(interrupted.owner.find(packet.token).receipt.valid&&interrupted.owner.retire(paid)&&interrupted.mag.rounds[0]==98);
+    Fixture changedLoading;r::ExitDebit staleLoading;
+    check(r::begin_exit(changedLoading.owner,changedLoading.mag,staleLoading,changedLoading.phase,46));
+    changedLoading.mag.loading=1;
+    check(!r::settle_exit(changedLoading.owner,changedLoading.mag,staleLoading,46,true));
+    check(changedLoading.owner.failed&&changedLoading.mag.rounds[0]==27&&changedLoading.mag.rounds[1]==19);
+    // Native setter refusal, wrong delta, relocation, generation replacement and
+    // intervening revisions must not guess a hand debit or alter a new owner.
+    for(unsigned fault=0;fault<7;++fault){
+        Fixture f;f.mag.rounds[0]=5;r::ExitDebit d;check(r::begin_exit(f.owner,f.mag,d,f.phase,24));
+        if(fault==2){f.mag.native.root+=0x10000;f.mag.native.magazine+=0x10000;f.mag.updating=false;++f.mag.revision;}
+        if(fault==3){auto next=key;++next.handle;f.owner.select(next);}
+        if(fault==4)++f.mag.revision;
+        if(fault==5)++f.owner.revision;
+        const int loaded=fault==0?24:(fault==1?21:22);
+        check(!r::settle_exit(f.owner,f.mag,d,loaded,fault!=6));
+        check(f.mag.rounds[0]==5&&f.mag.rounds[1]==19&&f.mag.elapsed[1]==.3f&&f.mag.loading==2);
+        check(fault==3?!f.owner.failed:f.owner.failed);
+    }
+    for(unsigned bad=0;bad<8;++bad){
+        Fixture f;r::ExitDebit d;
+        if(bad==0)f.mag.prepaid=true;if(bad==1)f.mag.updating=true;if(bad==2)f.owner.busy=true;
+        if(bad==3)f.phase.side=3;if(bad==4)f.phase.count=1;if(bad==5)f.phase.qualified=false;
+        if(bad==6)f.mag.rounds[0]=201;
+        check(!r::begin_exit(f.owner,f.mag,d,f.phase,bad==7?45:f.mag.total())&&!d.valid);
+    }
+    std::printf("burst exit debit: %u checks passed\n",checks);
+}
diff --git a/Dawn/unit/akimbo_burst_order_tests.cpp b/Dawn/unit/akimbo_burst_order_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b48ae47009fde11aea97d1252a55add62db2e935
--- /dev/null
+++ b/Dawn/unit/akimbo_burst_order_tests.cpp
@@ -0,0 +1,58 @@
+#include "../src/client/hooks/akimbo/burst_order.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+namespace a=dawn::client::hooks::akimbo;
+namespace d=a::burst_driver;
+namespace c=a::burst_cadence;
+static unsigned checks{};
+static void check_impl(bool value,unsigned line){++checks;if(!value){std::fprintf(stderr,"failed%u line%u\n",checks,line);std::exit(1);}}
+#define check(...) check_impl((__VA_ARGS__),__LINE__)
+struct Shot {unsigned side{},ordinal{};float at{};};
+int main(){
+    for(unsigned last=0;last<=2;++last)for(unsigned held=0;held<=3;++held){
+        d::Order order{last};std::array<d::Hand,2> h{};
+        for(unsigned i=0;i<2;++i)h[i].requests=(held&(1u<<i))?2u:0u;
+        const auto expected=held==3?(last==1?2u:1u):held;
+        for(unsigned side=1;side<=2;++side)check(order.may_start(side,h)==(side==expected));
+        if(expected){check(order.started(expected,h)&&order.last==expected);h[c::index(expected)].phase={1,0,.1f};
+            check(!order.may_start(c::opposite(expected),h));}
+    }
+    // Eight complete native bursts, alternating hand while recovery overlaps.
+    // The peer starts at the prior burst's last shot, never after its recovery.
+    for(float frame:{.01f,.025f,.1f,.8f}){
+        std::array<d::Hand,2> hands{};for(auto& h:hands)h.requests=2;
+        c::State clock;d::Order order;std::vector<Shot> shots;unsigned starts=0;float now=0,shared=0;
+        const unsigned frames=static_cast<unsigned>(1.6f/frame+.5f);
+        for(unsigned f=0;f<frames;++f){
+            auto result=c::advance(clock,frame,[&](auto ctx,const auto&){shared+=ctx.step;return true;},
+                [&](unsigned side,auto ctx,a::burst_phase::Snapshot& snapshot){
+                    const auto i=c::index(side);for(unsigned n=0;n<2;++n)hands[n].phase=clock.hands[n];
+                    hands[i].phase=snapshot;const auto before=snapshot;
+                    if(snapshot.phase==0){
+                        if(starts>=8||!order.started(side,hands))return c::Transition::unchanged;
+                        ++starts;snapshot.phase=1;return c::Transition::changed;
+                    }
+                    if(snapshot.remaining>0)return c::Transition::unchanged;
+                    if(snapshot.phase==1){
+                        shots.push_back({side,snapshot.ordinal,now+ctx.elapsed});++snapshot.ordinal;
+                        if(snapshot.ordinal==3){snapshot.phase=4;snapshot.remaining=.1f;return c::Transition::changed_wake;}
+                        snapshot.remaining=.05f;
+                    }else snapshot={};
+                    check(snapshot!=before);return c::Transition::changed;
+                });
+            check(result.complete&&!clock.failed);now+=frame;
+        }
+        check(starts==8&&shots.size()==24&&std::abs(now-shared)<.00002f);
+        for(unsigned burst=0;burst<8;++burst){
+            const auto side=burst%2?2u:1u;
+            for(unsigned round=0;round<3;++round){const auto& shot=shots[burst*3+round];
+                check(shot.side==side&&shot.ordinal==round);
+                check(std::abs(shot.at-(burst*.1f+round*.05f))<.00002f);}
+        }
+    }
+    // Peer recovery does not block a ready hand; a peer active burst does.
+    std::array<d::Hand,2> h{};h[0].requests=2;h[1].phase={2,3,.2f};d::Order order{1};
+    check(order.may_start(1,h));h[1].phase.phase=1;check(!order.may_start(1,h));
+    std::printf("burst ordering: %u checks passed\n",checks);
+}
diff --git a/Dawn/unit/akimbo_burst_phase_tests.cpp b/Dawn/unit/akimbo_burst_phase_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..773a85bb5154aa6b7e2b3a23b496554ae9e6dbf0
--- /dev/null
+++ b/Dawn/unit/akimbo_burst_phase_tests.cpp
@@ -0,0 +1,74 @@
+#include "../src/client/hooks/akimbo/burst_phase.h"
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+
+namespace b=dawn::client::hooks::akimbo::burst_phase;
+static unsigned checks{};
+static void check(bool value,const char* message){++checks;if(!value)throw std::runtime_error(message);}
+struct Image {
+    std::array<std::byte,0x1800> bytes{};
+    unsigned reads{},mutateAt{};
+    template<class T> void put(std::size_t at,T value){std::memcpy(bytes.data()+at,&value,sizeof(value));}
+    void mount(b::Snapshot s){put(b::phaseOffset,static_cast<std::uint8_t>(s.phase));put(b::remainingOffset,s.remaining);put(b::ordinalOffset,s.ordinal);}
+    bool read(std::uintptr_t address,void* output,std::size_t size){
+        if(address<0x10000||address-0x10000>bytes.size()||size>bytes.size()-(address-0x10000))return false;
+        if(++reads==mutateAt)put(b::ordinalOffset,55u);
+        std::memcpy(output,bytes.data()+address-0x10000,size);return true;
+    }
+};
+int main(){try{
+    const b::Address origin{{0x1234,0x5678,0x81d00001},0x10000};
+    Image image;image.put(0x1700,std::uint64_t(0x123456789abcdef0));image.put(0x1720,0x13572468u);
+    image.put(0x1708,.5f);image.put(0x170c,.25f);image.put(0x1044,.125f);image.put(0x1050,.75f);
+    const auto read=[&](std::uintptr_t a,void* o,std::size_t n){return image.read(a,o,n);};
+    b::Snapshot snap{};
+    check(b::read(read,origin.barrel,snap)&&snap.idle(),"idle native snapshot rejected");
+    b::Bank bank;check(bank.initialize(origin,snap),"idle generation not adopted");
+    for(unsigned ordinal=0;ordinal<64;++ordinal){
+        for(unsigned side=1;side<=2;++side){
+            const auto previous=bank.lane[side==1?1:0];const auto resident=bank.resident;
+            const auto lease=bank.begin(origin,side,resident);check(lease.valid,"qualified lane could not mount");
+            check(!bank.begin(origin,side,resident).valid,"nested phase transaction accepted");
+            const auto shared=image.bytes;image.mount(lease.mount);
+            // Model the actual native phase1 post-shot observation: the native
+            // interval is retained, not divided because another hand is held.
+            const b::Snapshot result{1,ordinal+1,side==1?.08f:.12f};image.mount(result);
+            check(b::read(read,origin.barrel,snap)&&snap==result,"native phase result did not round trip");
+            check(bank.finish(lease,origin,snap),"qualified result was not committed");
+            check(bank.lane[side==1?1:0]==previous,"one hand changed the other native timing history");
+            check(bank.lane[side-1].remaining==(side==1?.08f:.12f),"within-burst interval was scaled");
+            check(!bank.finish(lease,origin,snap),"phase result committed twice");
+            bool sharedUnchanged=true;
+            for(std::size_t i=0;i<image.bytes.size();++i){
+                if(i==b::phaseOffset||(i>=b::remainingOffset&&i<b::remainingOffset+4)
+                    ||(i>=b::ordinalOffset&&i<b::ordinalOffset+4))continue;
+                sharedUnchanged&=image.bytes[i]==shared[i];
+            }
+            check(sharedUnchanged,"mount changed shared epoch, queue, auxiliary state or property data");
+        }
+    }
+    auto idle=bank;check(!idle.initialize(origin,{1,1,.1f}),"active native burst was cloned into both lanes");
+    auto lease=bank.begin(origin,1,bank.resident);const auto durable=bank.lane;
+    const b::Address moved{origin.key,0x20000};
+    check(bank.relocate(moved,bank.resident),"fully qualified logical relocation rejected");
+    check(bank.lane==durable&&!bank.busy,"relocation erased timings or retained active pointer lease");
+    check(!bank.finish(lease,origin,{1,2,.02f}),"old address transaction published after relocation");
+    lease=bank.begin(moved,1,bank.resident);check(lease.valid,"relocated lane not usable");
+    check(!bank.abort(lease,lease.mount),"abort claimed unrestored native state");
+    check(bank.abort(lease,lease.before),"restored native state could not abort");
+    auto changed=moved;++changed.key.handle;
+    check(!bank.relocate(changed,bank.resident),"different native generation inherited old cadence");
+    check(!bank.begin(moved,1,{0,0,0}).valid,"unexpected external phase state accepted");
+    for(const auto bad:{b::Snapshot{5,1,0},b::Snapshot{1,65,0},b::Snapshot{1,1,-1},
+        b::Snapshot{1,1,std::numeric_limits<float>::quiet_NaN()},b::Snapshot{1,1,61}}){
+        image.mount(bad);check(!b::read(read,origin.barrel,snap),"malformed native scalar state accepted");
+        check(snap==b::Snapshot{},"failed read leaked partial state");
+    }
+    image.mount({1,2,.08f});image.reads=0;image.mutateAt=4;
+    check(!b::read(read,origin.barrel,snap),"native phase mutation between reads accepted");
+    check(!b::read(read,0,snap),"null barrel snapshot accepted");
+    check(!b::read(read,0x00007fffffffffffULL,snap),"overflowing barrel snapshot accepted");
+    std::printf("PASS %u burst scalar-bank transaction checks; native phase integration remains gated.\n",checks);return 0;
+}catch(const std::exception& error){std::fprintf(stderr,"FAIL %s\n",error.what());return 1;}}
diff --git a/Dawn/unit/akimbo_burst_session_tests.cpp b/Dawn/unit/akimbo_burst_session_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6b12dc9e072ef27edfab0bbcd01d5057aff05d9f
--- /dev/null
+++ b/Dawn/unit/akimbo_burst_session_tests.cpp
@@ -0,0 +1,251 @@
+#include "../src/client/hooks/akimbo/burst_session.h"
+#include "../src/client/hooks/akimbo/burst_runtime.h"
+#include "../src/client/hooks/akimbo/burst_exit.h"
+#include "../src/client/hooks/akimbo/burst_phase_guards.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+namespace a=dawn::client::hooks::akimbo;
+namespace b=a::burst;
+namespace t=a::burst_trigger;
+namespace p=a::burst_phase;
+namespace d=a::burst_driver;
+namespace s=a::burst_session;
+namespace r=b::runtime;
+static unsigned checks{};
+static void test(bool v,unsigned line){++checks;if(!v){std::fprintf(stderr,"failed %u line %u\n",checks,line);std::exit(1);}}
+#define check(...) test((__VA_ARGS__),__LINE__)
+struct Native {
+    t::Pins pins{{0x2001,0x2002,0x81d40048},0x100000,0x200000,0x8152c120,0x8000,0x3000};
+    t::View v{{0,1,1},{0,0,1,0,0,0,0},0x81,0x41};
+    p::Snapshot physical{};
+    s::State state{};
+    a::smg_ammo::State mag{};r::Owner receipts{};
+    std::vector<std::pair<unsigned,float>> shots{};
+    float sharedTime{},frameStart{},lastTime{};
+    float rate{.05f};
+    unsigned sharedCalls{},finalCalls{},triggerCalls{},exits{},token{0x5000},operation{},failAt{};
+    std::vector<std::pair<float,unsigned>> sharedZero{};
+    bool valid{true},blocked{},callbackReentry{},lastSharedZero{};
+    Native(){
+        check(state.initialize(pins,v,physical));
+        mag.native={pins.root,pins.root+0x24d0,pins.key.handle,pins.key.owner,pins.key.model};
+        mag.initialized=true;mag.capacity=100;mag.rounds[0]=mag.rounds[1]=100;receipts.select(pins.key);
+    }
+    bool guard(){if(++operation==failAt)valid=false;return valid;}
+    bool view(t::View& out){if(!guard())return false;out=v;return v.valid();}
+    bool phase(p::Snapshot& out){if(!guard())return false;out=physical;return physical.valid();}
+    bool mount_phase(p::Snapshot before,p::Snapshot after){if(!guard()||physical!=before||!after.valid())return false;physical=after;return true;}
+    bool apply(const t::Plan& plan){
+        if(!guard()||!plan.valid||plan.pins!=pins||plan.config!=v.config)return false;
+        const auto tr=pins.root+t::triggerOffset,bar=pins.root+t::barrelOffset;
+        struct Field {std::uintptr_t at;void* data;std::size_t size;};
+        std::array<Field,7> fields{{{tr+0xe0,&v.lane.held,1},{tr+0xf8,&v.triggerFlags,1},
+            {tr+0x100,&v.lane.feedbackUntil,8},{tr+0x10c,&v.lane.previousInput,4},{tr+0x110,&v.lane.edge,1},
+            {bar+0xf50,&v.barrelFlags,2},{bar+0xf54,&v.lane.charge,4}}};
+        for(unsigned i=0;i<plan.count;++i){const auto& w=plan.writes[i];bool found=false;
+            for(const auto& f:fields)if(f.at==w.address&&f.size==w.bytes){found=true;if(std::memcmp(f.data,w.before.data(),w.bytes))return false;}
+            if(!found)return false;
+        }
+        for(unsigned i=0;i<plan.count;++i)for(auto& f:fields)if(f.at==plan.writes[i].address)
+            std::memcpy(f.data,plan.writes[i].after.data(),f.size);
+        v.lane.request=v.barrelFlags&t::requestMask;v.lane.feedback=bool(v.triggerFlags&t::feedbackMask);
+        return guard();
+    }
+    void request(unsigned value){v.lane.request=static_cast<std::uint16_t>(value);v.barrelFlags=static_cast<std::uint16_t>((v.barrelFlags&~6u)|value);}
+    bool trigger(unsigned,const t::Input& input){
+        if(!guard())return false;++triggerCalls;const bool held=input[0x20]!=std::byte{};
+        if(callbackReentry)check(!s::trigger(state,*this,input,3)&&!s::update(state,*this,.01f));
+        if(!held)v.lane.edge=1;
+        if(held&&(v.config.hipSelector==0||v.lane.edge)){request(v.lane.request|2);if(v.config.hipSelector==1)v.lane.edge=0;}
+        else if(!held&&v.config.hipSelector==0)request(v.lane.request&~2u);
+        v.lane.held=held;return guard();
+    }
+    bool context(const a::burst_cadence::Context& at,d::Context& out){
+        out={pins.root,at.step,at.elapsed,at.remaining,static_cast<std::uint8_t>(blocked),1,{}};return guard();
+    }
+    bool shared(const d::Context& at,bool& active){
+        if(!guard())return false;check(physical.remaining==0);
+        if(at.step==0){const std::pair<float,unsigned> mark{frameStart+at.elapsed,physical.phase};
+            if(lastSharedZero&&!sharedZero.empty()&&sharedZero.back()==mark)std::fprintf(stderr,"duplicate zero shared frame=%.9g elapsed=%.9g phase=%u\n",frameStart,at.elapsed,physical.phase);
+            check(!lastSharedZero||sharedZero.empty()||sharedZero.back()!=mark);sharedZero.push_back(mark);}
+        lastSharedZero=at.step==0;
+        sharedTime+=at.step;++sharedCalls;active=true;return guard();
+    }
+    bool finalize(d::Output output,unsigned requests){
+        if(!guard())return false;++finalCalls;check(output.valid()&&v.lane.request==requests);
+        if(output.flags)request(v.lane.request&~2u); // Real CBF240 prefix.
+        request(requests); // Scoped restoration before the shared native tail.
+        return guard();
+    }
+    bool exited(unsigned side){if(!guard())return false;++exits;return receipts.leave(side);}
+    bool interval(float& out){out=rate;return guard();}
+    bool available(unsigned& out){out=mag.available();return guard();}
+    struct Calls {
+        Native& n;unsigned side;
+        bool active(d::Hand& hand,const d::Context& at,d::Output& out){
+            if(!n.guard())return false;
+            if(hand.phase.remaining==0){
+                const auto i=side==b::left?0u:1u;
+                if(n.mag.rounds[i]==0||n.mag.loading&side){
+                    // Real CD0530 failed-shot branch invokes CB5DF0, which
+                    // reads this scoped getter and debits its native modulo.
+                    r::Phase selected{};selected.native=n.mag.native;selected.side=side;
+                    selected.count=3;selected.revision=1;selected.qualified=true;
+                    r::Transaction rejected;check(!r::reserve(n.receipts,n.mag,rejected,selected,hand.phase.ordinal,1,n.mag.total()));
+                    r::ExitDebit exit;const int loaded=n.mag.total();
+                    check(r::begin_exit(n.receipts,n.mag,exit,selected,loaded));
+                    const int nativeDebit=exit.reported%3;
+                    check(r::settle_exit(n.receipts,n.mag,exit,loaded-nativeDebit,true)&&exit.callback_complete());
+                    hand.phase.phase=2;hand.phase.remaining=.1f;
+                }
+                else {
+                    r::Phase phase{};phase.native=n.mag.native;phase.side=side;phase.count=3;phase.revision=1;phase.qualified=true;
+                    r::Transaction tx;check(r::reserve(n.receipts,n.mag,tx,phase,hand.phase.ordinal,1,n.mag.total()));
+                    const b::Queued queued{++n.token,0x30000,{0,0,-1,hand.phase.ordinal,0,0,0,0,~0u}};
+                    check(r::settle(n.receipts,n.mag,tx,n.mag.total()-1,true,&queued));
+                    const auto event=n.receipts.find(queued.token);check(event.receipt.valid&&event.receipt.side==side);
+                    check(n.receipts.retire(event)); // Emission has no second ammo cost.
+                    n.shots.push_back({side,n.frameStart+at.elapsed});++hand.phase.ordinal;out.flags|=1;
+                    if(n.v.config.hipSelector==1)hand.requests&=~2u;
+                    if(hand.phase.ordinal==3){hand.phase.phase=2;hand.phase.remaining=.1f;}else hand.phase.remaining=n.rate;
+                }
+            }
+            n.physical=hand.phase;n.request(hand.requests);return n.guard();
+        }
+        bool idle(d::Hand& hand,const d::Context&,d::Output&,bool){n.physical=hand.phase;n.request(hand.requests);return n.guard();}
+        bool cooldown(const d::Context&,float& total,float& recovery){total=.2f;recovery=.1f;return n.guard();}
+        bool blocked_idle(d::Hand& hand,const d::Context&,bool& active){check(!(hand.requests&2));n.request(hand.requests);active=false;return n.guard();}
+    };
+    Calls calls(unsigned side){return {*this,side};}
+    bool tick(float dt,unsigned held){
+        t::Input input{};input[0x20]=std::byte{1};const auto untouched=input;
+        if(!s::trigger(state,*this,input,held))return false;check(input==untouched);
+        frameStart=lastTime;if(!s::update(state,*this,dt))return false;lastTime+=dt;return true;
+    }
+};
+int main(){
+    // Both hook targets and native call return sites are mandatory. Mutating
+    // any pinned instruction byte or losing a read refuses attachment.
+    struct Segment {std::uintptr_t at;std::size_t size;std::array<unsigned char,16> bytes;};
+    std::vector<Segment> guards;
+    for(const auto& e:a::burst_phase_guards::entries)guards.push_back({e.rva,e.bytes,e.expected});
+    for(const auto& c:a::burst_phase_guards::calls){Segment e{c[0]-5,5,{0xe8}};
+        const auto rel=static_cast<std::int32_t>(c[1]-c[0]);std::memcpy(e.bytes.data()+1,&rel,4);guards.push_back(e);}
+    unsigned refuse=~0u;
+    const auto read=[&](std::uintptr_t at,void* out,std::size_t bytes){
+        for(unsigned i=0;i<guards.size();++i)if(guards[i].at==at&&guards[i].size==bytes&&i!=refuse){
+            std::memcpy(out,guards[i].bytes.data(),bytes);return true;}return false;
+    };
+    check(a::burst_phase_guards::validate(read));
+    for(unsigned i=0;i<guards.size();++i){
+        refuse=i;check(!a::burst_phase_guards::validate(read));refuse=~0u;
+        for(unsigned byte=0;byte<guards[i].size;++byte){guards[i].bytes[byte]^=1;
+            check(!a::burst_phase_guards::validate(read));guards[i].bytes[byte]^=1;}
+    }
+    // Production session plans, phase clocks, request publication, debit tickets
+    // and paid emissions are exercised together against mutable native storage.
+    for(float dt:{.01f,.025f,.1f,.8f}){
+        Native n;n.callbackReentry=true;check(n.tick(dt,3));
+        for(unsigned i=1;i<static_cast<unsigned>(.8f/dt+.5f);++i)check(n.tick(dt,3));
+        check(n.shots.size()==6&&n.exits==2&&n.mag.rounds[0]==97&&n.mag.rounds[1]==97);
+        for(unsigned i=0;i<6;++i){check(n.shots[i].first==(i<3?b::left:b::right));
+            check(std::abs(n.shots[i].second-static_cast<float>(i)*.05f)<.00001f);
+            if(i)check(n.shots[i].second>n.shots[i-1].second);}
+        check(std::abs(n.sharedTime-.8f)<.00001f&&n.finalCalls==static_cast<unsigned>(.8f/dt+.5f));
+        check(!n.receipts.failed&&!n.mag.updating&&n.state.phases[0].idle()&&n.state.phases[1].idle());
+        // Holding a semiauto trigger does not create another edge; releasing one
+        // hand rearms only that hand, despite physical aggregate publication.
+        check(n.tick(.01f,2)&&n.tick(.4f,3));check(n.shots.size()==9&&n.mag.rounds[0]==94&&n.mag.rounds[1]==97);
+    }
+    for(unsigned held:{b::left,b::right}){
+        Native n;check(n.tick(.4f,held));check(n.shots.size()==3);
+        for(const auto& shot:n.shots)check(shot.first==held);
+        check(n.mag.rounds[held==b::left?0:1]==97&&n.mag.rounds[held==b::left?1:0]==100);
+    }
+    // Whole bursts keep unhalved spacing even in a long frame or at a very
+    // small valid native interval. There is no simultaneous boundary pair.
+    for(float rate:{1.e-12f,1.e-6f,.05f,.2f}){
+        Native n;n.rate=rate;check(n.tick(60,3)&&n.shots.size()==6);
+        for(unsigned i=1;i<n.shots.size();++i){
+            check(n.shots[i].second>n.shots[i-1].second);
+            check(std::abs((n.shots[i].second-n.shots[i-1].second)-rate)<std::max(1.e-17f,rate*.00001f));
+        }
+        check(std::abs(n.sharedTime-60)<.0001f&&n.mag.total()==194);
+    }
+    Native boundary;boundary.mag.rounds[0]=1;check(boundary.tick(.8f,3));
+    check(boundary.shots.size()==4&&boundary.shots[0].first==b::left&&boundary.shots[1].first==b::right);
+    check(boundary.shots[1].second>boundary.shots[0].second&&boundary.mag.rounds[0]==0&&boundary.mag.rounds[1]==97);
+    Native delayed;check(delayed.tick(0,3)&&delayed.shots.empty());check(delayed.tick(.4f,3)&&delayed.shots.size()==6);
+    Native release;check(release.tick(.025f,3)&&release.tick(.025f,1)); // Right releases while queued.
+    check(release.tick(.35f,3)&&release.shots.size()==6); // Repress cannot splice a second pending right burst.
+    for(float invalid:{0.f,-1.f,std::numeric_limits<float>::quiet_NaN()}){
+        Native n;n.rate=invalid;check(!n.tick(.4f,3)&&n.state.failed);
+        check(n.shots.size()==1&&n.mag.total()==199); // The accepted native debit is not undone.
+    }
+    // Native reload/empty readiness affects only the requested hand; the other
+    // hand can complete a full burst, preserving opposite magazine bookkeeping.
+    Native reload;reload.mag.loading=1;reload.mag.elapsed[0]=.75f;reload.mag.duration[0]=1.5f;
+    check(reload.tick(.4f,3));check(reload.shots.size()==3&&reload.mag.rounds[0]==100&&reload.mag.rounds[1]==97);
+    check(reload.mag.loading==1&&reload.mag.elapsed[0]==.75f&&reload.mag.duration[0]==1.5f);
+    check(reload.state.phases[0].idle()&&reload.exits==1); // No left start/failed-shot modulo.
+    // A request captured before reload begins must also be checked immediately
+    // before idle->active. Semi-auto release intentionally retains its request.
+    Native pendingReload;t::Input pendingInput{};pendingInput[0x20]=std::byte{1};
+    check(s::trigger(pendingReload.state,pendingReload,pendingInput,3));
+    pendingReload.mag.loading=1;check(s::update(pendingReload.state,pendingReload,.4f));
+    check(pendingReload.shots.size()==3&&pendingReload.mag.rounds[0]==100&&pendingReload.mag.rounds[1]==97);
+    check(pendingReload.state.phases[0].idle()&&pendingReload.state.triggers.lanes[0].request==2);
+    // Reload can interrupt an already active hand. Its native cleanup sees no
+    // available ammunition, preserving 98%3 instead of discarding two rounds;
+    // the opposite gun still completes its independent burst immediately.
+    Native interrupted;interrupted.mag.rounds[0]=99;check(interrupted.tick(.025f,3));
+    check(interrupted.shots.size()==1&&interrupted.mag.rounds[0]==98);
+    interrupted.mag.loading=1;interrupted.mag.elapsed[0]=.7f;interrupted.mag.duration[0]=1.5f;
+    check(interrupted.tick(.4f,3)&&interrupted.shots.size()==4);
+    check(interrupted.mag.rounds[0]==98&&interrupted.mag.rounds[1]==97&&interrupted.mag.loading==1);
+    check(interrupted.mag.elapsed[0]==.7f&&interrupted.mag.duration[0]==1.5f&&!interrupted.receipts.failed);
+    Native blocked;blocked.blocked=true;check(blocked.tick(.1f,3));check(blocked.shots.empty());
+    check(!blocked.state.triggers.lanes[0].request&&!blocked.state.triggers.lanes[1].request);
+    // Qualification loss at every callback/plan boundary permanently stops this
+    // session, without resetting magazines or retrying paid native events.
+    Native baseline;check(baseline.tick(.4f,3));const auto operations=baseline.operation;
+    for(unsigned fault=1;fault<=operations;++fault){
+        Native n;n.failAt=fault;check(!n.tick(.4f,3)&&n.state.failed);
+        const std::array<int,2> counts{n.mag.rounds[0],n.mag.rounds[1]};const auto shots=n.shots.size();const auto writes=n.operation;
+        check(!n.tick(.4f,3)&&n.mag.rounds[0]==counts[0]&&n.mag.rounds[1]==counts[1]&&n.shots.size()==shots&&n.operation==writes);
+        check(n.mag.total()==200-static_cast<int>(shots));
+    }
+    // Exact qualified relocation preserves pending opposite input and an active
+    // burst's ordinal/timer. A stale address or a different generation cannot.
+    Native moving;check(moving.tick(.025f,3));const auto phases=moving.state.phases;const auto lanes=moving.state.triggers.lanes;
+    const auto handoff=moving.state.handoff;auto next=moving.pins;next.root+=0x10000;next.source+=0x10000;
+    check(moving.state.relocate(next,moving.v,moving.physical));moving.pins=next;
+    moving.mag.native.root=next.root;moving.mag.native.magazine=next.root+0x24d0;
+    check(moving.state.phases==phases&&moving.state.triggers.lanes==lanes&&moving.state.handoff==handoff&&moving.tick(.375f,3));
+    check(moving.shots.size()==6&&moving.mag.total()==194);
+    auto wrong=next;++wrong.key.handle;check(!moving.state.relocate(wrong,moving.v,moving.physical));
+    // Paid queues have already changed each magazine. Even with a nonempty
+    // queue, tick must accept equality and refuse an unexplained extra debit or
+    // refund rather than route it through the single-shot prepaid heuristic.
+    for(int left=0;left<=100;++left)for(int right=0;right<=100;right+=10){
+        moving.mag.rounds[0]=left;moving.mag.rounds[1]=right;
+        check(r::aggregate_matches(moving.mag,left+right,100));
+        check(!r::aggregate_matches(moving.mag,left+right+1,100));
+        check(!r::aggregate_matches(moving.mag,left+right-1,100));
+        moving.mag.prepaid=true;check(!r::aggregate_matches(moving.mag,left+right,100));moving.mag.prepaid=false;
+    }
+    // A ninth logical weapon may not evict any active ordinal sequence or paid
+    // receipt. An entirely retired owner can be reused without losing a shot.
+    r::Book book;std::array<r::Event,8> paid{};
+    for(unsigned i=0;i<8;++i){auto k=moving.pins.key;k.handle+=i+1;auto* owner=book.slot(k);check(owner!=nullptr);
+        const auto spend=owner->begin(b::left,0,3,1,1,{10,10},0);check(spend.valid);
+        const b::Queued q{0x8000+i,0x30000,{0,0,-1,0,0,0,0,0,~0u}};
+        check(owner->settle(spend,true,&q).queued);paid[i]=owner->find(q.token);check(owner->leave(b::left)&&!owner->retired());
+    }
+    auto nextKey=moving.pins.key;nextKey.handle+=100;check(book.slot(nextKey)==nullptr);
+    for(unsigned i=0;i<8;++i)check(book.owners[i].find(paid[i].receipt.token).receipt.valid);
+    check(book.owners[3].retire(paid[3])&&book.owners[3].retired());check(book.slot(nextKey)==&book.owners[3]);
+    std::printf("burst native session: %u checks passed\n",checks);
+}
