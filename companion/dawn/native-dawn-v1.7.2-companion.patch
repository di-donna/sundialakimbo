+            else {
+                if(!recovering){idleAt=now;recovering=true;}
+                if(now<idleAt)return false;
+                // The captured native fire clip lasts .8 seconds. Never
+                // release the quiet gun partway through a firing action.
+                // Only blend back after idle has persisted for 100 ms; a
+                // subsequent shot cancels this recovery immediately.
+                weight=1-smoothstep((static_cast<float>(now-idleAt)-100)/120);
+                if(weight<=0){hasShot=false;recovering=false;}
+            }
+        }
+        if(idle&&!hasShot){
+            rendered={};released={};
