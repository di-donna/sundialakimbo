+            for(unsigned at=0x14;at<=0x2c;at+=4){const auto x=detail::at<float>(copy,at);if(!std::isfinite(x)||std::abs(x)>4096)return false;}
+            if(applyTint&&column&&tint->hands[side].reloading){
+                const auto originalStyle=detail::at<std::uintptr_t>(copy,0x30);
+                auto& style=out.styles[index];
+                // Null style uses a different renderer sentinel. Its color is
+                // not assumed to equal the caller's RGBA.
+                if(originalStyle<0x10000||!detail::read(m,originalStyle,style))return false;
+                auto rgba=color;
+                if(detail::at<unsigned>(style,0x18))rgba=detail::at<std::array<float,4>>(style,0x1c);
+                for(unsigned i=0;i<4;++i)if(!std::isfinite(rgba[i])||rgba[i]<0||rgba[i]>(i==3?1.f:16.f))return false;
+                const float brightness=std::max({rgba[0],rgba[1],rgba[2]});
+                rgba[0]=brightness;rgba[1]=brightness*.1f;rgba[2]=brightness*.1f;
+                // Preserve intensity and alpha, including a black shadow; a
+                // pre-existing green/blue UI tint must still become red.
+                store(style,0x18,1u);store(style,0x1c,rgba);
+                store(copy,0x30,reinterpret_cast<std::uintptr_t>(style.data()));
+            }
+            previous=glyph;glyph=detail::at<std::uintptr_t>(copy,0x38);
+        }
+        if(glyph!=glyphHead||previous!=detail::at<std::uintptr_t>(out.lines[side],8))return false;
+        const auto localHead=reinterpret_cast<std::uintptr_t>(out.lines[side].data());
+        store(out.lines[side],0,reinterpret_cast<std::uintptr_t>(out.glyphs[first].data())+0x38);
+        store(out.lines[side],8,reinterpret_cast<std::uintptr_t>(out.glyphs[index-1].data())+0x38);
+        for(unsigned i=first;i<index;++i){
+            store(out.glyphs[i],0x38,i+1<index?reinterpret_cast<std::uintptr_t>(out.glyphs[i+1].data())+0x38:localHead);
+            store(out.glyphs[i],0x40,i>first?reinterpret_cast<std::uintptr_t>(out.glyphs[i-1].data())+0x38:localHead);
+        }
+        line=detail::at<std::uintptr_t>(out.lines[side],0x30);
+        if(!side)++character; // The newline has no glyph record.
+    }
+    if(line!=lineHead||character!=text.length)return false;
+    const auto localLineHead=reinterpret_cast<std::uintptr_t>(out.header.data())+0xc0;
+    store(out.header,0xc0,reinterpret_cast<std::uintptr_t>(out.lines[0].data())+0x30);
+    store(out.lines[0],0x30,reinterpret_cast<std::uintptr_t>(out.lines[1].data())+0x30);
+    store(out.lines[1],0x30,localLineHead);
+    // The writer allocates on every non-null style POINTER TRANSITION, including
+    // glyphs later clipped. A slot for EVERY glyph is a safe upper bound; counting
+    // unique colors/styles would underallocate when pointers recur across runs.
+    store(out.header,0xe8,static_cast<std::uint64_t>(total));
+    out.offset={offset[0],offset[1]-static_cast<float>(size)};
+    out.glyphCount=total;
+    return true;
+}
+inline bool style_layout(const Memory& m,std::uintptr_t address,const std::array<float,2>& offset,
+                         const std::array<float,4>& color,const AmmoSnapshot& tint,const Text& text,
+                         StyledLayout& out) noexcept {
+    return style_layout(m,address,offset,color,&tint,text,out);
+}
+[[nodiscard]] bool install() noexcept;
+[[nodiscard]] bool uninstall() noexcept;
+[[nodiscard]] bool rendered(unsigned model,unsigned owner) noexcept;
+}
