+inline constexpr std::array<unsigned,4> smokeSelectors{0x20d0,0x2340,0x2800,0x2a70};
+inline constexpr std::array<std::uint32_t,4> smokeParticles{0x80ef26a0,0x80ef26a7,0x80ef26b1,0x80ef26b6};
+inline bool smoke_selector(const Memory& m,const Sequence& s,std::uintptr_t selector,
+                           std::uint32_t& particle) noexcept {
