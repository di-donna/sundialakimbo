@@ -0,0 +1,115 @@
+// Isolated charge decisions/ownership; no native charge hooks are installed.
+#include "../src/client/hooks/akimbo/charge.h"
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+namespace c=dawn::client::hooks::akimbo::charge;
+namespace {
+unsigned checks{};
+void check(bool value,const char* message){
+    ++checks;if(!value){std::fprintf(stderr,"FAIL: %s\n",message);std::exit(1);}
+}
+c::Sample sample(c::Mode mode=c::Mode::Release){
+    c::Sample s{};s.mode=mode;s.held=true;s.earlyRelease=true;s.overdrawRelease=true;
+    s.chargeTime=1;s.holdTime=7;s.overdrawTime=0;return s;
+}
+void native_sequences(){
+    auto s=sample();
+    auto d=c::update(s);check(d.qualified&&d.start&&!d.advance&&d.next==c::Phase::Charging,"start restores retained time without advancing");
+    s.phase=d.next;s.before=.4f;s.after=.5f;s.preCharge=.4f;
+    d=c::update(s);check(d.advance&&!d.release&&d.output==0,"charging has zero output despite sampled progress");
+    s.held=false;d=c::update(s);
+    check(d.release&&!d.advance&&d.output==.4f&&d.next==c::Phase::Idle,"bow early release uses pre-update fraction");
+    s=sample(c::Mode::Automatic);s.earlyRelease=false;s.phase=c::Phase::Charging;s.held=false;
+    d=c::update(s);check(d.cancel&&!d.release&&d.output==0,"fusion early release cancels without a shot");
+    s.held=true;s.after=1;s.before=.9f;s.preCharge=.9f;d=c::update(s);
+    check(d.next==c::Phase::Ready&&!d.release,"reaching charge does not fire in same pass");
+    s.phase=d.next;s.before=1;s.preCharge=1;d=c::update(s);
+    check(d.release&&d.output==1&&!d.advance,"fusion ready automatically releases");
+    s.thirdFlag=true;d=c::update(s);check(d.cancel&&!d.release,"native third argument suppresses ready fusion release");
+    s=sample();s.phase=c::Phase::Ready;s.before=8;s.after=8;s.preCharge=1;
+    d=c::update(s);check(d.next==c::Phase::Ready&&d.advance,"bow hold threshold is strict greater-than");
+    s.after=8.01f;d=c::update(s);check(d.next==c::Phase::Overdrawing,"bow overdraw begins after hold threshold");
+    s.phase=d.next;s.before=8.01f;s.after=8.02f;d=c::update(s);
+    check(d.next==c::Phase::Overdrawn&&!d.release,"overdraw transitions before auto-release pass");
+    s.phase=d.next;s.before=8.02f;d=c::update(s);
+    check(d.release&&!d.advance,"bow overdraw flag releases from state6");
+    s.overdrawRelease=false;d=c::update(s);check(!d.release,"overdraw release is definition-qualified");
+    s.held=false;check(c::update(s).release,"button release remains valid without overdraw flag");
+    s=sample(c::Mode::Timed);s.holdTime=0;s.phase=c::Phase::Ready;s.before=1;s.after=2;
+    d=c::update(s);check(!d.release&&!d.advance,"mode0 does not invent elapsed advancement at ready");
+    s.before=1.001f;check(c::update(s).release,"1KV mode0 accepts existing charge overshoot");
+    s=sample();s.phase=c::Phase::Charging;s.fullChargeAllowed=false;s.after=2;
+    check(c::update(s).next==c::Phase::Charging,"fraction-limited bow cannot enter ready");
+    s.phase=c::Phase::Ready;check(c::update(s).next==c::Phase::Charging,"ready bow returns to charging on dynamic fraction cap");
+    s.phase=c::Phase::Overdrawing;check(c::update(s).next==c::Phase::Charging,"overdrawing bow returns to charging on cap");
+    s.phase=c::Phase::Charging;s.held=false;s.continueOnRelease=true;s.after=.5f;
+    d=c::update(s);check(d.advance&&!d.release&&!d.cancel,"definition continue flag overrides raw button release");
+    for(const auto phase:{c::Phase::Charging,c::Phase::Ready}){
+        s=sample();s.phase=c::pause(phase);s.held=false;s.before=4;s.after=8;
+        d=c::update(s);check(d.next==phase&&!d.advance&&!d.release,"paused native phase resumes without advancing or emitting");
+    }
+    s=sample();s.phase=c::Phase::EffectWait;check(!c::update(s).resetElapsed,"pending native effect prevents idle reset");
+    s.effectGone=true;d=c::update(s);check(d.resetElapsed&&d.next==c::Phase::Idle,"only qualified effect retirement resets wait phase");
+    s.phase=c::Phase::Recovering;check(!c::update(s).qualified,"unintegrated recovery path fails closed");
+}
+void boundaries(){
+    for(unsigned mode:{0u,2u,3u})for(unsigned phase=0;phase<9;++phase)
+    for(unsigned flags=0;flags<128;++flags){
+        auto s=sample(static_cast<c::Mode>(mode));s.phase=static_cast<c::Phase>(phase);
+        s.held=(flags&1)!=0;s.thirdFlag=(flags&2)!=0;s.continueOnRelease=(flags&4)!=0;
+        s.earlyRelease=(flags&8)!=0;s.overdrawRelease=(flags&16)!=0;
+        s.fullChargeAllowed=(flags&32)!=0;s.effectGone=(flags&64)!=0;
+        s.before=9;s.after=10;s.preCharge=.625f;
+        const auto d=c::update(s);
+        check(!(d.cancel&&d.release),"a decision cannot both release and cancel");
+        check(!d.release||(d.qualified&&d.next==c::Phase::Idle&&d.output==s.preCharge),"release retains exact sampled charge");
+        check(d.release||d.output==0,"every non-release has zero native output");
+        check(d.qualified==(phase!=8),"only implemented native phases qualify");
+        const auto cancellation=c::cancellation(s);
+        const bool ready=phase==2||phase==4||phase==5||phase==6;
+        check(cancellation.release==(ready&&(mode==0||(mode==2&&!s.thirdFlag))),"native cancellation jump-table mode predicate");
+        check(cancellation.active==(phase!=0&&phase!=7),"native cancellation active-state predicate");
+        check(!cancellation.active||cancellation.release!=cancellation.replaceEffect,"one cancellation effect ownership path");
+    }
+    auto s=sample();
+    for(float bad:{-1.f,std::numeric_limits<float>::infinity(),std::numeric_limits<float>::quiet_NaN()}){
+        s.preCharge=bad;check(!c::update(s).qualified&&!c::cancellation(s).qualified,"invalid progress rejects update and cancellation");
+    }
+    s=sample();s.preCharge=1.01f;check(!c::update(s).qualified,"charge above one rejects");
+    s=sample();s.chargeTime=0;check(!c::update(s).qualified,"zero charge duration is not fabricated");
+    s=sample();s.mode=static_cast<c::Mode>(1);check(!c::update(s).qualified,"unobserved mode1 remains unsupported");
+    s=sample();s.phase=static_cast<c::Phase>(9);check(!c::update(s).qualified,"unknown native phase rejects");
+    s=sample();s.chargeTime=std::numeric_limits<float>::max();s.holdTime=s.chargeTime;
+    check(!c::update(s).qualified,"overflowing duration sum rejects");
+}
+void ownership(){
+    constexpr c::Key key{0x12345678,0x22345678,0x81d40048};
+    c::Releases releases;check(releases.bind(key),"logical owner binds");
+    auto s=sample();s.phase=c::Phase::Charging;s.held=false;s.preCharge=.25f;
+    const auto left=releases.reserve(key,c::Side::Left,c::update(s));check(bool(left),"left reserves its own partial bow release");
+    check(!releases.available(key,c::Side::Left)&&releases.available(key,c::Side::Right),"left pending release does not block right hand");
+    s.preCharge=.75f;const auto right=releases.reserve(key,c::Side::Right,c::update(s));
+    check(bool(right)&&right.serial!=left.serial,"simultaneous releases have distinct tickets");
+    check(!releases.take(left)&&!releases.take(right),"unaccepted native release cannot emit");
+    auto forged=left;forged.side=c::Side::Right;check(!releases.settle(forged,true),"ticket cannot transfer hand");
+    forged=left;forged.charge=.9f;check(!releases.settle(forged,true),"ticket cannot change charge fraction");
+    check(releases.settle(right,true)&&releases.settle(left,true),"native completion order does not change ownership");
+    const auto emittedRight=releases.take(right),emittedLeft=releases.take(left);
+    check(emittedRight==right&&emittedLeft==left,"out-of-order emissions preserve both hand fractions");
+    check(!releases.take(left)&&!releases.settle(left,true),"retired release cannot emit twice");
+    const auto rejected=releases.reserve(key,c::Side::Left,c::update(s));
+    check(releases.settle(rejected,false)&&releases.available(key,c::Side::Left),"rejected native release retires reservation");
+    const auto pending=releases.reserve(key,c::Side::Left,c::update(s));check(releases.settle(pending,true),"old owner has pending accepted release");
+    auto newKey=key;++newKey.handle;check(releases.bind(newKey),"new logical generation binds");
+    check(!releases.take(pending)&&!releases.available(key,c::Side::Left),"new owner rejects old generation emission");
+    check(releases.bind(key),"same handle value can later return");
+    const auto renewed=releases.reserve(key,c::Side::Left,c::update(s));
+    check(renewed.serial>pending.serial&&!releases.settle(pending,true),"ticket serial survives owner changes and handle reuse");
+    check(!releases.reserve(key,static_cast<c::Side>(2),c::update(s)),"invalid side rejects");
+    c::Decision fake{};fake.release=true;check(!releases.reserve(key,c::Side::Right,fake),"unqualified decision cannot reserve");
+    check(!releases.bind({}),"invalid owner cannot bind");
+    check(releases.settle(renewed,true)&&!releases.settle(renewed,false),"accepted release cannot be overwritten by a later callback");
+}
+}
+int main(){native_sequences();boundaries();ownership();std::printf("charge prototype: %u checks passed\n",checks);}
