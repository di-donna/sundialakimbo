+                else{entered.valid=true;for(unsigned i=0;i<rk::bones;++i)entered.relative[i]=blend(snapshot.relative[i],hip.relative[i],e);frozen=&entered;}
+            }
+            out.guns=reload_pose(p,base,*frozen,v,w,hold,b,out.parts);out.active=true;
+            // A recovery after a shot shows only the firing gun's parts once they were at rest.
+            if(reload.mode==Mode::recovering)out.mask=partsMask.apply(fireMask,out.mask,out.parts);
+            else partsMask.start(out.parts);
+            const unsigned phase=phase_of(v);
+            // Phase entries count forward progress only (a held cancel unwinds backwards).
+            if((reload.phase==~0U||phase>reload.phase)&&(reload.mode!=Mode::recovering||reload.cancel!=Cancel::held)){
+                report.phaseEntered=phase;reload.phase=phase;
+            }
+            if(reload.v<rk::reloadSwap&&v>=rk::reloadSwap)report.swapped=true;
+            reload.v=v;report.reload=true;report.v=v;report.w=w;report.phase=phase;
+        }else if(reload.mode==Mode::idle&&!native)snapshot.take(base);
+        return out;
+    }
+private:
+    void start(float t,const std::array<Frame,80>& p,Report& report) noexcept {
+        // Only with no hold yet (the first posed frame after a reset) is the
+        // reload's own first frame taken; otherwise the kept hold is used.
+        if(!snapshot.valid)snapshot.take(p);
+        reload={};reload.mode=Mode::synced;reload.start=reload.native=t;reload.v=0;
+        // Runtime v7: the caller's hip hold and ADS choice for this throw.
+        hipHold=armedHip&&armedHip->valid;if(hipHold)hip=*armedHip;
+        suppress=armedSuppress;blendIn=armedSpan;
+        report.started=true;
+    }
+    // The sequence leaves the native clock at reload.v: a cancel (recovery), or
+    // the clip's normal end when at or after reloadCompletePhase (counted as
+    // completed; the few frames of settle left still blend smoothly).
+    void cancel(double now,Report& report) noexcept {
+        const float at=std::max(reload.v,0.f);
+        const float w=ease(at,rk::reloadSettleStart,1); // the synced weight at this phase
+        reload.mode=Mode::recovering;reload.cancelAt=now;reload.cancelV=at;reload.cancelW=w;reload.overlap=0;reload.lastNow=now;
+        reload.cancel=at<=rk::reloadRelease?Cancel::held:at<rk::reloadRiseStart?Cancel::thrown:at<rk::reloadRiseEnd?Cancel::rising:Cancel::late;
+        if(reload.cancel==Cancel::held){reload.riseAt=0;reload.endAt=rk::cancelHeldSeconds;}
+        else{
+            reload.riseAt=recovery_seconds(at,std::max(at,rk::reloadRiseStart));
+            reload.endAt=std::max(recovery_seconds(at,std::max(at,rk::reloadFlourishEnd)),reload.riseAt+rk::cancelSettleSeconds*(1-w));
+        }
+        if(at>=rk::reloadCompletePhase)report.completed=true;
+        else{report.cancelled=true;report.cancelV=at;}
+    }
+    // v<0: no procedural reload this frame; w: weight of the live pose in the base.
+    void advance(bool native,float t,bool draw,double now,const std::array<Frame,80>& p,float& v,float& w,Report& report) noexcept {
+        if(reload.mode==Mode::synced){
+            if(native&&t+rk::reloadPhaseRestart>=reload.native){
+                reload.native=std::max(reload.native,t);
+                v=std::clamp((reload.native-reload.start)/std::max(1-reload.start,1e-3f),0.f,1.f);
+                if(v>=1){reload.mode=Mode::idle;reload.phase=~0U;report.completed=true;v=-1;}
+                else w=ease(v,rk::reloadSettleStart,1);
+            }else cancel(now,report);
+        }
+        if(reload.mode==Mode::recovering){
+            const float e=static_cast<float>(std::max(0.0,now-reload.cancelAt));
+            // A native reload running again: the target eases to the hold.
+            const float dt=static_cast<float>(std::clamp(now-reload.lastNow,0.0,.1));reload.lastNow=now;
+            reload.overlap=std::clamp(reload.overlap+(native?dt:-dt)/rk::cancelOverlapSeconds,0.f,1.f);
+            bool done{};
+            if(reload.cancel==Cancel::held){
+                const float s=smoothstep(e/rk::cancelHeldSeconds);
+                v=reload.cancelV*(1-s);w=s;done=e>=rk::cancelHeldSeconds;
+            }else{
+                v=recovery_v(reload.cancelV,e);
+                w=reload.cancelW+(1-reload.cancelW)*smoothstep((e-reload.riseAt)/std::max(reload.endAt-reload.riseAt,1e-3f));
+                done=e>=reload.endAt;
+            }
+            // With a native reload running, stay on the hold until the target is
+            // fully the hold, so the next throw starts where this one ends.
+            if(done&&(!native||reload.overlap>=1)){reload.mode=Mode::idle;reload.phase=~0U;v=-1;w=0;}
+        }
+        if(reload.mode==Mode::idle&&native&&!draw&&!report.completed&&t<=1-rk::reloadMinRemaining){
+            start(t,p,report);v=0;w=0;
+        }
+    }
+};
+
+// The seam, checked at compile time: a replacement reload must satisfy it.
+template<class T> concept ReloadSeam=requires(T r,const T c,std::array<Frame,80>& p,const std::array<Frame,80>& base,
+                                              bool native,float t,bool draw,double now,const Basis& b,Report& report){
+    {r.reset()} noexcept;{r.draw_edge()} noexcept;{c.busy()} noexcept->std::same_as<bool>;
+    {r.frame(p,base,native,t,draw,now,b,report)} noexcept->std::same_as<ReloadFrame>;
+};
+static_assert(ReloadSeam<ThrowReload>);
+
+// ---- C2. Hand-over reload (runtime v4b, rat_king.h D.3) ------------------------------
+// Poses are built in pose space from the live root 0: the recording and the
+// kept hold are both relative to it (as the throw's hold), so camera, body and
+// ADS movement stay live. Each side is an arm (the 22 alternating:: bones), a
+// gun and a tuck: the fraction of (tuckPitchDegrees, tuckYawDegrees) swinging
+// arm bones 1..21, and the gun while held, about the upper-arm joint.
+namespace rr=rat_king_reload;
+// Window ends in v for the recorded-span speed k (each window starts where the
+// previous one ends; S and R overlap: the left gun is parked during RA).
+struct Windows {float la,lh,lb,sDrop,sRegrip,sTuckLeft,ra,rh,rb,eDrop,eHome,eRegrip,eRise,slamLeft,slamRight;};
+inline constexpr Windows windows(float k) noexcept {
+    Windows w{};
+    const float visible=(rk::uGone-rk::uStart)/k,back=(rk::handoverLeave-rk::uLow)/k,slam=(rk::uSlam-rk::uLow)/k;
+    w.la=visible;w.lh=w.la+rk::handoverHiddenSpan;w.lb=w.lh+back;              // L: left gun
+    w.sDrop=w.lb+rk::handoverDropSpan;w.sRegrip=w.sDrop+rk::handoverRegripSpan; // S: swap
+    w.sTuckLeft=w.sRegrip+rk::handoverTuckLeftSpan;
+    w.ra=w.sRegrip+visible;w.rh=w.ra+rk::handoverHiddenSpan;w.rb=w.rh+back;     // R: right gun
+    w.eDrop=w.rb+rk::handoverDropSpan;w.eHome=w.rb+rk::handoverHomeSpan;        // E: end
+    w.eRegrip=w.eDrop+rk::handoverEndRegripSpan;w.eRise=w.eRegrip+rk::handoverRiseSpan;
+    w.slamLeft=w.lh+slam;w.slamRight=w.rh+slam;
+    return w;
+}
+inline constexpr Windows plan=windows(rk::handoverSpeed);
+// Both guns up before reload_5 with margin; faster plays only shorten it.
+static_assert(plan.eRise<=rk::handoverBothUpLimit&&windows(2.f).eRise<plan.eRise&&plan.eHome<plan.eRise
+    &&plan.sTuckLeft<plan.ra&&plan.eRise<rk::handoverSettleStart&&plan.slamLeft<=plan.lb&&plan.slamRight<=plan.rb
+    &&plan.sRegrip+rk::handoverRightRiseSpan<plan.ra);
+// Runtime v6: both guns up before the gameplay fire-ready point (.85 of the
+// stretched reload) by handoverFireReadyMargin; the entry blend ends before the
+// right gun's tuck does. Runtime v6 review F3: both guns up at the native clip's
+// reload_5 (.803). Review F2/F8 (accepted): the native refill (.5) leads the
+// right gun's slam by at most .05 of the reload.
+static_assert(plan.eRise+rk::handoverFireReadyMargin<=rk::reloadFireReady&&rk::handoverBlendInMax<rk::handoverTuckSpan
+    &&plan.eRise>=rk::reloadMarker5-.005f&&plan.eRise<=rk::reloadMarker5+.005f
+    &&plan.slamRight>rk::reloadRefill&&plan.slamRight-rk::reloadRefill<=.05f&&plan.slamLeft<rk::reloadRefill);
+// Report::window (and the probe's handoverWindowMask bits).
+enum : unsigned {windowLeftA,windowLeftHidden,windowLeftB,windowSwap,windowRightA,windowRightHidden,windowRightB,
+                 windowEnd,windowHold,windowSettle,windowRecovery};
+// Clip phase of the recorded track x = v - (its start) into L or R: uStart..uGone
+// at speed k, the hidden uGone..uLow compressed to handoverHiddenSpan, then
+// uLow..handoverLeave at speed k.
+inline float recorded_u(float x,float k) noexcept {
+    const float visible=(rk::uGone-rk::uStart)/k;
+    if(x<visible)return rk::uStart+k*std::max(x,0.f);
+    if(x<visible+rk::handoverHiddenSpan)return rk::uGone+(rk::uLow-rk::uGone)*(x-visible)/rk::handoverHiddenSpan;
+    return std::min(rk::uLow+k*(x-visible-rk::handoverHiddenSpan),rk::handoverLeave);
+}
+// Tucks and drops accelerate out of the view (ease-in: slow while the hand is
+// still in view, fast once it is below); rises decelerate into it (ease-out:
+// fast while hidden, slow as the gun arrives), as the throw's rise.
+inline float down(float x,float a,float b) noexcept {const float t=std::clamp((x-a)/(b-a),0.f,1.f);return t*t;}
+inline float up(float x,float a,float b) noexcept {const float t=std::clamp((x-a)/(b-a),0.f,1.f);return 1-(1-t)*(1-t);}
+enum class Role:unsigned char {held,hidden,support};
+// held: the gun rides in this hand (tucked with it). hidden: the gun is parked
+// and the hand is below the view (arm = the drawn arm). support: the gun is
+// parked and the free hand works in view (brings a magazine, or drops).
+struct Side {std::array<Frame,22> arm{};Frame gun{};float tuck{};bool held{true};Role role{Role::held};};
+struct Sequence {Side right{},left{};std::array<Frame,3> parts{};unsigned mask{rk::staticPairMask},window{};float u{-1};};
+inline constexpr std::array<Frame,3> restParts{rk::weaponBind2,rk::weaponBind3,rk::weaponBind4};
+inline std::array<Frame,22> arm_of(const std::array<Frame,80>& p,bool isLeft) noexcept {
+    std::array<Frame,22> a{};const auto* arm=arm_bones(isLeft);
+    for(unsigned i=0;i<22;++i)a[i]=p[arm[i]];
+    return a;
+}
+inline std::array<Frame,22> blend_arm(const std::array<Frame,22>& a,const std::array<Frame,22>& b,float t) noexcept {
+    std::array<Frame,22> o{};
+    for(unsigned i=0;i<22;++i)o[i]=t<=0?a[i]:t>=1?b[i]:blend(a[i],b[i],t);
+    return o;
+}
+inline Quat tuck_rotation(bool isLeft,float fraction,const Basis& b) noexcept {
+    const float outward=isLeft?1.f:-1.f; // the side's direction along the camera's left axis
+    return product(axis_angle(b.up,outward*radians(rk::tuckYawDegrees)*fraction),axis_angle(b.left,radians(rk::tuckPitchDegrees)*fraction));
+}
+inline void swing(std::array<Frame,22>& arm,Frame* gun,bool isLeft,float fraction,const Basis& b) noexcept {
+    if(!(fraction>0))return;
+    const Quat r=tuck_rotation(isLeft,fraction,b);const Vec pivot=arm[1].p;
+    for(unsigned i=1;i<22;++i)arm[i]=about(arm[i],r,pivot);
+    if(gun)*gun=about(*gun,r,pivot);
+}
+inline std::array<Frame,22> tucked(std::array<Frame,22> arm,bool isLeft,float fraction,const Basis& b) noexcept {
+    swing(arm,nullptr,isLeft,fraction,b);return arm;
+}
+// A gun parked by a full tuck of its hold (below and behind the view).
+inline Frame parked(std::array<Frame,22> arm,Frame gun,bool isLeft,const Basis& b) noexcept {
+    swing(arm,&gun,isLeft,1,b);return gun;
+}
+inline void drawn(const Side& s,bool isLeft,const Basis& b,std::array<Frame,22>& arm,Frame& gun) noexcept {
+    arm=s.arm;gun=s.gun;swing(arm,s.held?&gun:nullptr,isLeft,s.tuck,b);
+}
+inline Side moved(const Side& s,Frame delta) noexcept {
+    Side o=s;for(auto& f:o.arm)f=compose(delta,f);o.gun=compose(delta,o.gun);return o;
+}
+// Runtime v5, the head slide (rat_king.h D.3): L's parts and mask at recorded
+// phase u. Until the parts were shown at rest (headRested, kept by the caller:
+// the frame after one whose shown parts were at rest), the pair shows THIS
+// reload's parts, the live native 74/75/76 relative to root 72 (live: the pose
+// on screen without the reload), easing to rest by uHeadRest, under the entry
+// mask (the gun(s) that showed them on the frame before the hand-over). Then
+// mask 1: the slide at rest and the mirrored recorded magazine, blended in from
+// rest over uHeadRest..uHeadIn (the clip's magazine is at its bind to key 10).
+// The recorded slide is never shown: its head is the reload it was recorded
+// on (empty or tactical) and the played keys otherwise hold it at rest.
+inline std::array<Frame,3> left_parts(float u,Frame recordedMagazine,const std::array<Frame,80>& live,unsigned entryMask,bool headRested,unsigned& mask) noexcept {
+    if(!headRested){
+        mask=entryMask>=rk::leftMoves&&entryMask<=rk::staticPairMask?entryMask:rk::leftMoves;
+        const Frame back=inverse(live[rk::rootBone]);const float a=ease(u,rk::uStart,rk::uHeadRest);
+        std::array<Frame,3> out{};
+        for(unsigned i=0;i<3;++i)out[i]=blend(compose(back,live[rk::carriedBones[i]]),restParts[i],a);
+        return out;
+    }
+    mask=rk::leftMoves;
+    return {blend(rk::weaponBind2,recordedMagazine,ease(u,rk::uHeadRest,rk::uHeadIn)),rk::weaponBind3,rk::weaponBind4};
+}
+
+// The synced hand-over at native phase v. rec: the recording; root: the live
+// root 0; hold: the kept hip hold in pose space (aligned: its left arm holds
+// the copy; review F4: the recording is hip, so its mirror plane is the hip
