index 0000000000000000000000000000000000000000..3a432f920fe3c6e39e10eaf86b12abdf20b5f15e
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/sturm_drang_diagnostics.h
@@ -0,0 +1,55 @@
+#pragma once
+// Sturm & Drang Akimbo S1: the three counter blocks appended to the read-only
+// export SunriseStatusAkimboVisualsProbe (akimbo.cpp) by the ONE v10 layout
+// (INTEGRATION-S1 ruling 10): v9/1112 prefix unchanged byte for byte, then
+//   +1112 the hand block   (112 bytes, sturm_drang_pose.h, filled by export_hook)
+//   +1224 the ammo block   (128 bytes, design-ammo 7.4; builder 2)
+//   +1352 the firing block (128 bytes, design-firing 7.2 + the install state)
+// = v10/1480. u64 counters, relaxed atomics, never a gate. read_counters.py v10
+// decodes the three blocks by these names in this order.
+#include <atomic>
+#include <cstdint>
+
+struct AkimboSturmDrangHandCounters {
+    // poses: mode-4 frames the S&D pose layer wrote. markersOk: of those, frames
+    // whose p[77]/p[72] scale decodes as a family-D marker (the shader's own test;
+    // equals poses). maskLast: the last written marker mask (1 = Drang's slide
+    // cycles). isolatedFrames / isolationStarts / releaseFrames: the quiet left
+    // root during Sturm's own actions (66/68/59, a clock signature, or a Sturm shot
+    // < 0.8 s), its starts and its 100 ms + 120 ms release frames. restFallbacks:
+    // isolations that started before any idle calibration (Thorn rest frames).
+    // kickFrames / slideFrames / loweredFrames: Drang's kick, slide cycle and
+    // reload lowering. rejected: S&D mode-4 frames the pose layer refused
+    // (invalid input, a quiet displacement over its guard, time backwards).
+    // alignRejected: S&D mode-4 exports correct_export refused (the native left
+    // hand is then drawn on Sturm). unknownLast: the last selector outside the
+    // known S&D set | its clock base << 32 (the melee selector, [C]).
+    // drangOnSturmOnset: Drang shots within 50 ms of a native Sturm fire onset
+    // (66/68) with no Sturm emission near it (INTEGRATION-S1 ruling 12: must stay 0).
+    std::atomic<std::uint64_t> poses{},markersOk{},maskLast{},isolatedFrames{},isolationStarts{},releaseFrames{},restFallbacks{},
+        kickFrames{},slideFrames{},loweredFrames{},rejected{},alignRejected{},unknownLast{},drangOnSturmOnset{};
+};
+static_assert(sizeof(AkimboSturmDrangHandCounters)==112);
+struct AkimboSturmDrangAmmoCounters {
+    // design-ammo 7.4, filled by builder 2's ammo lines. lastPacked:
+    // loaded | reserve << 16 | capacity << 32 | D (ms) << 48.
+    std::atomic<std::uint64_t> spends{},spendUnchanged{},spendMismatch{},gateEmpty{},gateCanFireFalse{},
+        reloadStarts{},reloadTransfers{},reloadRounds{},reloadReadies{},reloadCancelled{},reloadFallbackD{},
+        fxPosts{},dryFires{},hudDrangQueries{},hudDrangLast{},lastPacked{};
+};
+static_assert(sizeof(AkimboSturmDrangAmmoCounters)==128);
+struct AkimboSturmDrangFiringCounters {
+    // installState: sturm_drang::runtime::InstallBit mask (the guard groups that
+    // passed, the kill file, the H1 attach result). The rest are builder 2's
+    // driver counters (design-firing 7.2): h1Calls on the armed S&D Sturm
+    // barrel, h1Verdict (1 ticking, 2 sparse, 3 none), keepAwakeTrue (forced
+    // returns), presses, shots (confirmed emissions), emitFailed (ok == false),
+    // okNoProjectile, refusals and refuseLast (the last Refuse code), latchMask
+    // (bit n = latch Ln), threadRefusals (native ammo/FX work refused off the
+    // pinned driver thread, ruling 3), nativeSturmShots / nativeDrangShots
+    // (native emissions of the cached barrels seen by firing_hook), damageEvents
+    // (the Drang-window damage feed) and discoveries (accepted discoveries).
+    std::atomic<std::uint64_t> installState{},h1Calls{},h1Verdict{},keepAwakeTrue{},presses{},shots{},emitFailed{},okNoProjectile{},
+        refusals{},refuseLast{},latchMask{},threadRefusals{},nativeSturmShots{},nativeDrangShots{},damageEvents{},discoveries{};
+};
+static_assert(sizeof(AkimboSturmDrangFiringCounters)==128);
diff --git a/Dawn/src/client/hooks/akimbo/sturm_drang_discovery.h b/Dawn/src/client/hooks/akimbo/sturm_drang_discovery.h
new file mode 100644
index 0000000000000000000000000000000000000000..f96a332718558afb2d021ccb8b56785ab85d8b58
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/sturm_drang_discovery.h
@@ -0,0 +1,376 @@
+#pragma once
+// Sturm & Drang Akimbo: the read-only discovery of the player's Sturm (drawn,
+// core 81529057, content variant 10) and Drang (energy slot, core 8152AEA4,
+// content 8152AEA5, variant 3 or -1 while holstered, owner assembly 80BBC101),
+// the S&D private model 81A29A19 and the active-weapon component. Ported
+// unchanged from the reviewed A0b tree (w5-a0-fix; W4 F5: pointer-width cell
+// offsets, the whole pool span checked, pool metadata and the cell read twice;
+// P0: the variant key is at content record+0x10). Rat King (same core 8152AEA4)
+// is never taken for Drang: its owner assembly is 80BBDC90 and its variant 10
+// (INTEGRATION-S1 ruling 11). The per-shot revalidation (builder 2) also
+// requires content+0x68 == 3 exactly.
+// Pure: Memory supplies read(address,out,size) and clock(); at runtime that is
+// sturm_drang::CheckedMemory (sturm_drang_memory.h, exact-length RPM), never a
+// catch-all SEH copy (W4 F1).
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+namespace dawn::client::hooks::akimbo::sturm_drang::discovery {
+constexpr std::uintptr_t maxAddress=0x00007fffffffffffULL;
+inline bool range(std::uintptr_t a,std::size_t n) {return a>=0x10000&&n&&a<=maxAddress&&n-1<=maxAddress-a;}
+struct Header {std::uint32_t tag{},kind{},self{},owner{};std::uint64_t definition{};bool operator==(const Header&)const=default;};
