+        image.put(array+16,static_cast<unsigned char>(nativeSelector.binding));
+        if(nativeSelector.inputs==2){image.put(array+17,static_cast<unsigned char>(7));check(!fe::selector(memory,sequence,selectorAddress,item),"changed endpoint binding accepted");image.put(array+17,static_cast<unsigned char>(profile.visual.fx.endpointBinding));}
