+#pragma once
+#include "hud.h"
+
+namespace dawn::client::hooks::akimbo::content_selection {
+// C9D8C0 uses an unsigned comparison after sign-extending the runtime index.
+// With the bounded nonnegative count, every u32 index >= count selects +80.
+// Descriptor MAX explicitly pins that default branch, never an arbitrary row.
+inline bool matches(const profiles::Barrel& b,std::uint32_t index) noexcept {
+    return b.variant==0xffffffffu?index>=b.propertyCount:index==b.variant&&index<b.propertyCount;
+}
+inline bool row(const Memory& m,const profiles::Barrel& b,std::uint32_t index,
+                std::uintptr_t& asset,std::uintptr_t& selected) noexcept {
+    using hud::detail::read;using hud::detail::resolve;
+    asset=selected=0;
+    if(b.contentSize>0x1000000||b.contentDefinition>b.contentSize||(b.contentDefinition&7u)
+        ||b.contentSize-b.contentDefinition<0x270||b.propertyCount>4096||!matches(b,index))return false;
+    std::uintptr_t owner{};std::uint64_t bytes{},count{},relative{},headerCount{};std::uint32_t kind{};
+    if(!resolve(m,b.contentTag,owner)||owner>0x00007fffffffffffULL-b.contentSize
+        ||!read(m,owner,bytes)||bytes!=b.contentSize
+        ||!read(m,owner+b.contentDefinition+0x240,count)||count!=b.propertyCount)return false;
+    std::uintptr_t first{};
+    if(count){
+        if(!read(m,owner+b.contentDefinition+0x248,relative)
+            ||relative>bytes-b.contentDefinition-0x258
+            ||count*448>bytes-b.contentDefinition-0x258-relative)return false;
+        const auto header=owner+b.contentDefinition+0x248+static_cast<std::uintptr_t>(relative);
+        // Same forward table and typed header checked by the compiler. Empty
+        // arrays do not dereference an unused or sentinel relative pointer.
+        if(header<owner+b.contentDefinition+0x270||!read(m,header,headerCount)||headerCount!=count
+            ||!read(m,header+8,kind)||kind!=0x80803acf)return false;
+        first=header+16;
+    }
+    const auto result=b.variant==0xffffffffu?owner+b.contentDefinition+0x80:first+std::uintptr_t(index)*448;
+    std::uint64_t again{},countAgain{},relativeAgain{};std::uintptr_t ownerAgain{};
+    if(!resolve(m,b.contentTag,ownerAgain)||ownerAgain!=owner
+        ||!read(m,owner,again)||again!=bytes||!read(m,owner+b.contentDefinition+0x240,countAgain)||countAgain!=count
+        ||(count&&(!read(m,owner+b.contentDefinition+0x248,relativeAgain)||relativeAgain!=relative)))return false;
+    asset=owner;selected=result;return true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/effects.h b/Dawn/src/client/hooks/akimbo/effects.h
