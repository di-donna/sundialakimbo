+    return burst_native::invoke_shot(scope,barrel,mode,elapsed,ordinal,charge,output);
+}
+__declspec(noinline) bool __fastcall burst_check_hook(void* barrel,int required) noexcept {
+    Invocation invocation;const auto next=nextBurstCheck.load(std::memory_order_acquire);
+    const auto caller=reinterpret_cast<std::uintptr_t>(_ReturnAddress()),address=reinterpret_cast<std::uintptr_t>(barrel);
+    auto* scope=burst_native::spendScope;
+    if(!enabled.load(std::memory_order_acquire))return next(barrel,required);
+    if(!scope||address!=scope->barrel){
+        if(finite_burst_owned(address)||finite_burst_candidate(address))return false;
+        return next(barrel,required);
+    }
+    if(caller!=moduleBase+0xcb781d||required!=1||scope->transaction.spend.valid||!burst_native::current(scope->phase,address))
+        return burst_native::rejected_phase("check_scope");
