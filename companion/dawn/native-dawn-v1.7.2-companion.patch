+    if(!array(definition+0x10,4,1,0x80800009,codeAt)||!array(definition+0x20,1,16,0x80800090,constantsAt)
+        ||!read(memory,codeAt,program)||program!=std::array<unsigned char,4>{0x34,0,0x3e,0}
+        ||!read(memory,constantsAt,values))return false;
+    for(float value:values)if(value!=values[0]||(value!=-1.f&&value!=1.f))return false;
+    // No auxiliary expression inputs or linked reference entity may replace
+    // the constant. This makes unit cost a source contract, not a guess from
+    // an earlier input-frame sample before native spends its ammunition.
+    return read(memory,asset+definition+0x40,code)&&code==std::array<std::uint64_t,2>{0,0}
+        &&read(memory,asset+definition+0x50,constants)&&constants==std::array<std::uint64_t,2>{0,0x811c9dc5};
+}
