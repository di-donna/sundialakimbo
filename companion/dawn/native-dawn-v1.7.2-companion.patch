+    // drawn and the native (pre-edit) right root of the same posed frame
+    // (rat_king_pose::Report). Bone 72 moves with the firing base, the kick and
+    // the reload, so the FX follow the drawn guns, not the native recoil.
+    // INFERRED (the IKELOS precedent, smg.h): native attachments are composed
+    // with the pre-edit root. Thrown guns fly up to about 2.6 m (pairReach).
+    static constexpr float pairReach=4.f;
+    bool capture_pair(const Identity& id,Frame native,Frame right,Frame left,std::uint64_t now) noexcept {
+        if(!sidearm_model(id.modelTag)||!valid(native)||!valid(right)||!valid(left))return false;
+        const Sample next{id,now,compose(inverse(native),right),compose(inverse(native),left)};
+        const auto reachable=[](Frame f){return f.p.x*f.p.x+f.p.y*f.p.y+f.p.z*f.p.z<pairReach*pairReach;};
+        if(!valid(next.right)||!valid(next.left)||!reachable(next.right)||!reachable(next.left))return false;
