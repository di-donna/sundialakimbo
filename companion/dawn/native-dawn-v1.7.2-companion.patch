+namespace dawn::client::hooks::akimbo::effects {
+// Read-only diagnostic at native12119C0. The packet is owned by the frame
+// arena; this code never changes it, its buffers, or any render state.
+struct DrawPacket {
+    std::uint64_t expressions{},expressionData{},parameters{},records{},poses{};
+    std::uint32_t sequence{},definition{},flags{},other{};
+    float fade{};
+    std::uint16_t count{};
+    std::uint8_t stride{},parameterBytes{},targets{},valid{},kind{};
+    std::array<std::byte,13> padding{};
+};
+static_assert(sizeof(DrawPacket)==0x50);
+struct DrawFrame {Frame pose{};std::array<float,16> matrix{};};
+static_assert(sizeof(DrawFrame)==96);
+inline bool draw_frame(const Memory& m,std::uintptr_t packet,const DrawPacket& p,
+                       unsigned index,std::uintptr_t matrix,DrawFrame& out) noexcept {
+    out={};
+    if(packet<0x10000||packet>0x00007fffffffff0000ULL||(packet&15)
+        ||p.flags!=0x12011||p.targets!=2||p.valid!=2||index>=2
+        ||!((p.parameterBytes==112&&p.stride==3)||(p.parameterBytes==128&&p.stride==4)
+            ||(p.parameterBytes==48&&p.stride==4)||(p.parameterBytes==80&&p.stride==5))
+        ||p.parameters!=packet+0x50||p.records!=p.parameters+p.parameterBytes
+        ||p.poses!=p.records+64)return false;
+    DrawFrame result{};std::uint32_t particles{};
+    if(!read(m,p.records+index*32+8,particles)||!particles||particles>4096
+        ||!read(m,p.poses+index*32,result.pose)||!world_frame(result.pose)
+        ||!read(m,matrix,result.matrix))return false;
+    for(float v:result.matrix)if(!std::isfinite(v)||std::abs(v)>1000000)return false;
+    out=result;return true;
+}
+}
