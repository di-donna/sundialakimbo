+    const bool retry=emission&&address==emission->barrel;
+    if(!enabled.load(std::memory_order_acquire))return next(barrel,packet,front);
+    if(!paid&&!retry){
+        if(finite_burst_owned(address)||finite_burst_candidate(address))return false;
+        return next(barrel,packet,front);
+    }
+    burst::Packet source{};burst::Queue before{},after{};burst::Queued added{};
+    const bool callerOk=paid?caller==moduleBase+0xcb7c32&&!front:
+        front&&(caller==moduleBase+0xcb4b70||caller==moduleBase+0xcb4c1d);
