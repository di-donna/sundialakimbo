+    void cancel(double now,Report& report) noexcept {
+        const float at=std::max(play.v,0.f);
+        start_tail(now);
+        play.mode=Handover::Mode::recovering;play.cancelAt=play.lastNow=now;play.cancelV=at;play.overlap=0;
+        auto& r=play.recovery;
+        r.right=play.shown.right;r.left=play.shown.left;r.parts=play.shown.parts;r.mask=play.shown.mask;
+        r.fromHold=play.shown.window>=windowHold;r.rested=false;r.firing.start(play.shown.parts);
+        r.seconds=std::max({recovery_seconds(r.right,r.fromHold),recovery_seconds(r.left,r.fromHold),
+                            r.mask!=rk::staticPairMask?rk::handoverHeldSeconds:0.f});
+        if(at>=rk::reloadCompletePhase)report.completed=report.handoverCompleted=true;
+        else{report.cancelled=report.handoverCancelled=true;report.cancelV=at;}
+    }
+    // A frame that cannot be posed: the recording is dropped (the recorder
+    // re-arms), nothing is written this frame and the throw may take over.
+    void fail(double now,Report& report,ReloadFrame& out) noexcept {
+        if(play.mode==Handover::Mode::synced)start_tail(now);
+        play={};out={};out.skip=true;report.handoverFailed=true;
+        if(store)store->clear();
+    }
+    // false: the hand-over is idle after this call (nothing posed).
+    bool step(std::array<Frame,80>& p,const std::array<Frame,80>& base,bool native,float t,bool draw,double now,const Basis& b,Report& report,ReloadFrame& out) noexcept {
+        float v=-1,w=0;
+        if(play.mode==Handover::Mode::synced){
+            if(native&&!draw&&t+rk::reloadPhaseRestart>=play.native){
+                play.native=std::max(play.native,t);
+                v=std::clamp((play.native-play.start)/std::max(1-play.start,1e-3f),0.f,1.f);
+                if(v>=1){start_tail(now);play.mode=Handover::Mode::idle;report.completed=report.handoverCompleted=true;return false;}
+            }else cancel(now,report);
+        }
+        const Frame root=p[0],back=inverse(root);
+        const Snapshot& held=hold_snapshot();
+        std::array<Frame,80> hold{};
+        for(unsigned i=0;i<rk::bones;++i)hold[i]=compose(root,held.relative[i]);
+        Sequence q{};
+        if(play.mode==Handover::Mode::synced){
+            if(!store||!store->valid||!held.valid||!fallback.snapshot.valid){fail(now,report,out);return true;}
+            std::array<Frame,80> entry{};
+            for(unsigned i=0;i<rk::bones;++i)entry[i]=compose(root,fallback.snapshot.relative[i]);
+            q=sequence(v,store->committed,root,hold,entry,base,b,rk::handoverSpeed,play.entryMask,play.headRested,play.blendIn);
+            // Runtime v5: the head ends on the frame after one that showed the parts at rest.
+            if(parts_offset(q.parts)<=rk::partRestMeters)play.headRested=true;
+            w=ease(v,rk::handoverSettleStart,rk::handoverSettleEnd);
+            // Runtime v6: the ADS centring leaves with the entry blend and stays out while the native
+            // reload plays (the settle included); it comes back after the reload (start_tail).
+            play.ads=ease(v,0,play.blendIn);
+            play.v=v;
+            play.shown=q;play.shown.right=moved(q.right,back);play.shown.left=moved(q.left,back);
+        }else{
+            const float e=static_cast<float>(std::max(0.0,now-play.cancelAt));
+            // A native reload running again: the target eases to the hold (as the throw's recovery).
+            const float dt=static_cast<float>(std::clamp(now-play.lastNow,0.0,.1));play.lastNow=now;
+            play.overlap=std::clamp(play.overlap+(native?dt:-dt)/rk::cancelOverlapSeconds,0.f,1.f);
+            const bool partsDone=play.recovery.mask==rk::staticPairMask||play.recovery.rested;
+            if(e>=play.recovery.seconds&&partsDone&&(!native||play.overlap>=1)){
+                // Ended on the hold under a restarted native reload: the next reload starts from it.
+                if(native)fallback.snapshot=held;
+                play.mode=Handover::Mode::idle;return false;
+            }
+            // The live target: the pose on screen without the reload (review F3: the
+            // recoil-free firing base after a shot, never the native fire clip).
+            auto target=base;
+            if(play.overlap>0){
+                for(const bool isLeft:{false,true})for(unsigned i=0;i<22;++i){const auto bone=arm_bones(isLeft)[i];target[bone]=blend(target[bone],hold[bone],play.overlap);}
+                target[rk::rootBone]=blend(target[rk::rootBone],hold[rk::rootBone],play.overlap);
+                for(const auto bone:rk::carriedBones)target[bone]=blend(target[bone],hold[bone],play.overlap);
+            }
+            const Frame liveRoot=target[rk::rootBone],liveBack=inverse(liveRoot);
+            auto& r=play.recovery;
+            q.right=recover(moved(r.right,root),false,e,r.fromHold,arm_of(target,false),liveRoot,b);
+            q.left=recover(moved(r.left,root),true,e,r.fromHold,arm_of(target,true),compose(liveRoot,pairSpacing),b);
+            q.parts=recovery_parts(r,e,{compose(liveBack,target[74]),compose(liveBack,target[75]),compose(liveBack,target[76])},q.mask);
+            // After a shot only the firing gun shows the live parts, once the shared ones were at rest.
+            q.mask=r.firing.apply(fireMask,q.mask,q.parts);
+            q.window=windowRecovery;v=play.cancelV;w=smoothstep(e/std::max(r.seconds,1e-3f));
+        }
+        std::array<Frame,22> arm{};
+        drawn(q.right,false,b,arm,out.guns.right);for(unsigned i=0;i<22;++i)p[arm_bones(false)[i]]=arm[i];
+        drawn(q.left,true,b,arm,out.guns.left);for(unsigned i=0;i<22;++i)p[arm_bones(true)[i]]=arm[i];
+        out.guns.attached=true;out.guns.rightHeld=q.right.held;out.guns.leftHeld=q.left.held;
+        out.parts=q.parts;out.mask=q.mask;out.active=true;
+        bool ok=valid(out.guns.right)&&valid(out.guns.left);
+        for(const bool isLeft:{false,true})for(unsigned i=0;i<22;++i)ok=ok&&valid(p[arm_bones(isLeft)[i]]);
+        for(const auto& part:out.parts)ok=ok&&valid(part);
+        if(!ok){fail(now,report,out);return true;}
+        play.windowMask|=1U<<q.window;
+        report.reload=report.handover=true;report.v=v;report.w=w;report.window=q.window;
+        report.entrySpan=play.blendIn;
+        return true;
+    }
+};
+static_assert(ReloadSeam<HandoverReload>);
+// The reload the pose layer runs: swap this one line to replace it (ThrowReload
+// alone is the runtime v4a reload).
+using Reloader=HandoverReload;
+
+// ---- State --------------------------------------------------------------------------
+// The native moving parts' offset from their binds relative to root 72
+// (translation plus 0.1 m per radian): what a gun shows, or drops when its
+// mask bit clears.
+inline float part_offset(const std::array<Frame,80>& p) noexcept {
+    const Frame back=inverse(p[rk::rootBone]);float worst=0;
+    for(const auto& [bone,bind]:{std::pair{74u,rk::weaponBind2},std::pair{75u,rk::weaponBind3}}){
+        const Frame part=compose(back,p[bone]);
+        worst=std::max(worst,length(sub(part.p,bind.p))+.1f*angle_between(part.q,bind.q));
+    }
+    return worst;
+}
+struct State {
+    Identity identity{};
+    Kick kick{};
+    Base firingBase{};
+    Reloader reloader{};
+    bool drawing{};
+    // The mask shown by the previous posed frame (3 when nothing was written:
+    // the fallback moves both guns' parts) and its native part offset.
+    unsigned shownMask{rk::staticPairMask};float shownPart{};
+    // Runtime v6 diagnostics (Report aim*, adsRootShift / adsFrameShift).
+    AimTrace aimTrace{};AdsGeometry adsGeometry{};
+    void reset(const Identity& id) noexcept {*this={};identity=id;}
+    void select(const Identity& id) noexcept {if(id!=identity)reset(id);}
+    // A successful native shot from one gun (firing hook, after finish()).
+    void fired(const Identity& id,bool left,double now) noexcept {
+        select(id);if(sidearm_model(id.modelTag)&&std::isfinite(now))kick.add_shot(left,now);
+    }
+    [[nodiscard]] double last_shot(double now) const noexcept {return kick.last(now);}
+    // Rewrites one completed render pose (mode 4) of the private sidearm rig.
+    // data holds the aligned native pose (correct_export ran align_sidearm_pose).
+    // controller is controller+0x70 (pose -> camera space). now: seconds from a
+    // monotonic high-resolution clock (the firing hook uses the same clock).
+    // aim: the native camera aim of this frame (0 hip .. 1 ADS; fov_hook).
+    // raw: the native pre-correction pose of this export (77 frames, copied
+    // before correct_export; the hand-over's recorder reads it) and store: the
+    // recording store (rat_king_reload.h), both optional: without a store the
+    // reload is always the throw.
+    bool pose(const Identity& id,void* data,unsigned mode,unsigned action,ActionClock clock,
+              double now,Frame controller,Report& report,float aim=0,const void* raw=nullptr,rat_king_reload::Store* store=nullptr) noexcept {
+        report={};
+        if constexpr(requires{reloader.recording();}){
+            // An identity change aborts a running recording (State is reset).
+            if(id!=identity&&reloader.recording()){report.recEvent=3;report.recReasons=rat_king_reload::reason::identity;
+                if constexpr(requires{reloader.progress();})report.recMeasure=reloader.progress();}
+        }
+        select(id);
+        if(!sidearm_model(id.modelTag)||mode!=4||!data||!std::isfinite(now))return false;
+        std::array<Frame,80> p{};std::memcpy(p.data(),data,rk::bones*sizeof(Frame));
+        for(unsigned i=0;i<rk::bones;++i)if(!valid(p[i]))return false;
+        if(!valid(controller))return false;
+        if constexpr(requires{reloader.observe(store,static_cast<const Frame*>(raw),aim,clock,action);})
+            reloader.observe(store,static_cast<const Frame*>(raw),aim,clock,action);
+        const bool draw=rk::draw_action(action);
+        if(draw&&!drawing)reloader.draw_edge();
+        drawing=draw;
+        float t{};const bool native=rk::reload_clock(action,clock,t);
+        // Runtime v6 review F4: a reload selector or clock base the reload clock refuses (counted by akimbo.cpp).
+        report.reloadRejected=!native&&(rk::reload_selector(action)||rk::reload_selector(clock.base));
+        aimTrace.feed(native,t,action,clock,aim,report);
+        adsGeometry.feed(aim,native||reloader.busy(),p[0],controller,report);
+        const auto live=p;
+        report.nativeRoot=live[rk::rootBone];report.rightGun=live[rk::rootBone];report.leftGun=compose(live[rk::rootBone],pairSpacing);report.sampled=true;
+        const float part=part_offset(live);report.partMeters=part;
+        // A. Firing base. A reload sequence keeps it released, except once a
+        // known fire selector has ended it (review F3): the native fire clip
+        // then plays under the reload's recovery, whose target is this base.
+        auto base=live;BaseFrame baseFrame{};
+        const bool firingSelector=rk::known_firing(action,clock);
+        const bool interrupt=native||rk::interrupting_action(action)||(reloader.busy()&&!firingSelector);
+        const bool other=!interrupt&&!firingSelector&&!rk::idle_action(action);
+        const bool built=firingBase.update(live,{now,kick.last(now),aim,interrupt,other},base,baseFrame);
+        report.engaged=built&&baseFrame.weight>0;report.baseStarted=baseFrame.started;report.baseBroke=baseFrame.broke;report.baseWeight=baseFrame.weight;
+        if(report.engaged){
+            report.recoilMeters=length(sub(live[rk::rootBone].p,base[rk::rootBone].p));
+            report.recoilRadians=angle_between(live[rk::rootBone].q,base[rk::rootBone].q);
+        }else base=live;
+        // B. Reload seam.
+        const Basis b=basis(controller);
+        if constexpr(requires{reloader.firing(0U);})
+            reloader.firing(report.engaged?(kick.last_left(now)?rk::leftMoves:rk::rightMoves):0U);
+        if constexpr(requires{reloader.entry(0U);})reloader.entry(shownMask);
+        const ReloadFrame r=reloader.frame(p,base,native,t,draw,now,b,report);
+        // While a native reload plays, the base's "pose on screen" is the reload's
+        // hold (Base::seed leaves a base that still runs, a release, alone).
+        if constexpr(requires{reloader.hold();}){
+            if(native)if(const Snapshot* h=reloader.hold())firingBase.seed(h->relative);
+        }
+        report.recoveryBase=r.active&&report.engaged&&!native;
+        const auto keep=[&](bool written,unsigned mask){
+            const unsigned effective=written?mask:rk::staticPairMask;
+            if(effective!=shownMask){report.switched=true;report.switchPartMeters=std::max(shownPart,part);}
+            shownMask=effective;shownPart=part;
+        };
+        if(r.skip||(!r.active&&!built)){keep(false,0);return false;}
+        Frame rightGun{},leftGun{};std::array<Frame,3> parts{};bool attached=true,rightHeld=true,leftHeld=true;
+        if(r.active){rightGun=r.guns.right;leftGun=r.guns.left;attached=r.guns.attached;rightHeld=r.guns.rightHeld;leftHeld=r.guns.leftHeld;parts=r.parts;}
+        else{
+            p=base;rightGun=p[rk::rootBone];leftGun=compose(rightGun,pairSpacing);
+            for(unsigned k=0;k<3;++k)parts[k]=compose(inverse(live[rk::rootBone]),live[rk::carriedBones[k]]);
+        }
+        // C. Kick: only on a gun that is in its hand.
+        const float kickRight=attached&&rightHeld?kick.amount(false,now):0,kickLeft=attached&&leftHeld?kick.amount(true,now):0;
+        report.kick=kickRight>0||kickLeft>0;
+        // The no-marker fallback is this exact pair at the art's spacing; runtime v7b
+        // writes every frame when the pair is widened (rat_king.h pairWiden).
+        const bool idle=!r.active&&!report.kick&&!report.engaged;
+        if(idle&&!(rk::pairWiden>0)){keep(false,0);return false;}
+        // D. Runtime v7b: the pair pairWiden wider, symmetric about its midpoint, along
+        // the camera's left axis: each arm moves rigidly with its gun.
+        if(rk::pairWiden>0){
+            for(const bool isLeft:{false,true}){
+                const Vec d=mul(b.left,(isLeft?.5f:-.5f)*rk::pairWiden);
+                const auto* arm=arm_bones(isLeft);
+                for(unsigned i=0;i<22;++i)p[arm[i]].p=add(p[arm[i]].p,d);
+                Frame& gun=isLeft?leftGun:rightGun;gun.p=add(gun.p,d);
+            }
+        }
+        for(const bool isLeft:{false,true}){
+            const float amount=isLeft?kickLeft:kickRight;
+            if(!(amount>0))continue;
+            Frame& gun=isLeft?leftGun:rightGun;
+            const Frame kicked=compose(gun,kick_frame(amount)),delta=compose(kicked,inverse(gun));
+            if(!kick_arm(p,isLeft,delta)){const auto* arm=arm_bones(isLeft);for(unsigned i=0;i<22;++i)p[arm[i]]=compose(delta,p[arm[i]]);}
+            gun=kicked;
+        }
+        // The right gun is drawn by its native bones: root 72 and the carried
+        // 74/75/76 (never scale-coded) follow it.
+        p[rk::rootBone]=rightGun;
+        for(unsigned k=0;k<3;++k)p[rk::carriedBones[k]]=compose(rightGun,parts[k]);
+        // Single marker (RECIPE 4b): the left copy's root; the mask names the
+        // gun whose moving parts follow the native clip (a reload's own mask:
+        // both for the throw, the loading gun's for the hand-over).
+        // (runtime v7b: an idle frame, written only for the width, moves both guns' parts as the no-marker pair did)
+        const unsigned mask=r.active?r.mask:idle?rk::staticPairMask:kick.last_left(now)?rk::leftMoves:rk::rightMoves;
+        Frame marker=compose(leftGun,inverse(pairSpacing));
+        marker.scale=p[rk::rootBone].scale*smg::marker_scale(mask);
+        p[rk::markerBone]=compose(marker,rk::weaponBind1);
+        for(unsigned i=0;i<rk::bones;++i)if(!valid(p[i])){keep(false,0);return false;}
+        std::memcpy(data,p.data(),rk::bones*sizeof(Frame));
+        keep(true,mask);
+        report.written=true;report.mask=mask;report.rightGun=rightGun;report.leftGun=leftGun;return true;
+    }
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/rat_king_reload.h b/Dawn/src/client/hooks/akimbo/rat_king_reload.h
