@@ -0,0 +1,214 @@
+#include "inventory.h"
+#include <cmath>
+#include <cstring>
+
+namespace dawn::client::hooks::akimbo::inventory {
+namespace {
+template<class T> bool get(const Memory& m,std::uintptr_t a,T& v) noexcept {
+    return m.read&&a>=0x10000&&a<=0x00007fffffffffffULL-sizeof(T)&&m.read(m.context,a,&v,sizeof(T));
+}
+template<class T,std::size_t N> T at(const std::array<std::byte,N>& b,unsigned o) noexcept {
+    T v{};std::memcpy(&v,b.data()+o,sizeof(T));return v;
+}
+bool resolve(const Memory& m,std::uint32_t h,std::uintptr_t& a) noexcept {
+    if(!h||h==0xffffffff)return false;
+    std::uintptr_t w{},t{};
+    if(!get(m,m.tablesSlot,w)||!get(m,w,t))return false;
+    const auto sh=static_cast<std::int32_t>(h)>>13;
+    const auto pool=((static_cast<std::uint64_t>(static_cast<std::int64_t>(sh))|0xffc0000ULL)>>18)
+                    &(static_cast<std::uint32_t>(sh)&0xffffU);
+    if(pool>=4096)return false;
+    std::array<std::byte,64> b{};if(!get(m,t+pool*64,b))return false;
+    const auto stride=at<std::uint32_t>(b,48);const auto mask=at<std::int32_t>(b,52);
+    const auto cells=at<std::uintptr_t>(b,8);
+    if(!stride||stride>1048576||(mask!=0&&mask!=-1))return false;
+    const auto offset=static_cast<std::uint32_t>((h&8191U)*stride);
+    if(cells>0x00007fffffffffffULL-offset-8)return false;
+    const auto cell=cells+offset;std::uintptr_t delta{};if(!get(m,cell+8,delta))return false;
+    a=cell-(static_cast<std::uintptr_t>(static_cast<std::intptr_t>(mask))&delta);
+    return a>=0x10000&&a<=0x00007fffffffffffULL;
+}
+struct Header {std::uint32_t tag{},kind{},self{},owner{};std::uint64_t definition{};};
+bool header(const Memory& m,std::uintptr_t a,Header& h) noexcept {
+    std::array<std::byte,48> b{};std::uintptr_t self{};
+    if(!get(m,a,b))return false;
+    h={at<std::uint32_t>(b,0),at<std::uint32_t>(b,4),at<std::uint32_t>(b,36),at<std::uint32_t>(b,44),at<std::uint64_t>(b,8)};
+    return h.owner&&h.owner!=0xffffffff&&resolve(m,h.self,self)&&self==a;
+}
+bool link(const Memory& m,std::uintptr_t ref,std::uintptr_t& a) noexcept {
+    std::uint32_t h{};std::uint64_t offset{};
+    if(!get(m,ref,h)||!get(m,ref+8,offset)||offset>0x100000||!resolve(m,h,a)
+        ||a>0x00007fffffffffffULL-offset)return false;
+    a+=static_cast<std::uintptr_t>(offset);return true;
+}
+bool component_in_entity(const Memory& m,std::uintptr_t entity,std::uint32_t owner,
+                          std::uint32_t tag,std::uintptr_t& result) noexcept {
+    std::uint32_t handle{},assetTag{};std::uintptr_t assembly{},asset{};
+    std::uint64_t bytes{},count{},rel{};
+    if(!get(m,entity+0x4c,handle)||!resolve(m,handle,assembly)||!get(m,assembly+4,assetTag)
+        ||!resolve(m,assetTag,asset)||!get(m,asset,bytes)||bytes<48||bytes>0x100000
+        ||!get(m,asset+0x10,count)||!count||count>128||!get(m,asset+0x18,rel)
+        ||rel>bytes-0x28||count*12>bytes-0x28-rel)return false;
+    unsigned matches=0;
+    for(unsigned i=0;i<count;++i){
+        std::array<std::uint32_t,3> row{};
+        if(!get(m,asset+0x28+rel+i*12,row))return false;
+        if(row[0]!=tag)continue;
+        Header h{};
+        if(row[2]>0x100000||!header(m,assembly+row[2],h)||h.tag!=tag||h.owner!=owner)return false;
+        result=assembly+row[2];++matches;
+    }
+    return matches==1;
+}
+std::uint32_t private_model(const SoundPacket& packet) noexcept {
+    constexpr std::array<std::uint32_t,7> thorn{0xffffffff,0x80b74ca9,0xffffffff,0xffffffff,0x80b74cab,0xffffffff,0x80b74caa};
+    constexpr std::array<std::uint32_t,7> ace{0x80b74cac,0x80b74cad,0xffffffff,0x80b74cae,0x80b74caf,0xffffffff,0x80b74cb0};
+    std::array<std::uint32_t,7> parts{};std::memcpy(parts.data(),packet.data()+4,sizeof(parts));
+    if(parts==thorn)return 0x81a295e0;
+    if(parts==ace)return 0x81a295fd;
+    unsigned body=0,part=0,sight=0;
+    for(auto p:parts){
+        if(p==0xffffffff)continue;
+        if(p==0x80b74ca3)++body;
+        else if(p==0x80b74ca4)++part;
+        else if(p==0x80b74ca5||p==0x81a295c8||p==0x81a295cc||p==0x81a295d0||p==0x81a295d4||p==0x81a295d8)++sight;
+        else return 0;
+    }
+    return body==1&&part==1&&sight==1?0x81a2958a:0;
+}
+bool rest_pose(const Memory& m,std::uint32_t tag,std::uint64_t def,unsigned count,unsigned bone,Pose& pose) noexcept {
+    std::uintptr_t asset{};std::uint64_t bytes{},n{},rel{};
+    if(bone>=count||!resolve(m,tag,asset)||!get(m,asset,bytes)||bytes>0x100000||bytes<def+0xa8
+        ||!get(m,asset+def+0x90,n)||n!=count||!get(m,asset+def+0x98,rel)
+        ||rel>bytes-def-0xa8||n*32>bytes-def-0xa8-rel)return false;
+    return get(m,asset+def+0xa8+rel+bone*32,pose)&&valid_pose(pose);
+}
+bool render_layout(const Memory& m,const Identity& id,std::uintptr_t context) noexcept {
+    std::array<std::byte,0xf0> b{};
+    if(!get(m,context,b))return false;
+    constexpr std::array<std::uint16_t,8> ranges{0,0,1,3,1,1,7,2};
+    const auto out=at<std::uintptr_t>(b,0xe0);
+    return at<std::uint32_t>(b,0)==2 && at<std::uint32_t>(b,0x10)==8
+        && at<std::uintptr_t>(b,0x18)==id.nodes && at<std::uint32_t>(b,0xb8)==8
+        && at<std::uint32_t>(b,0xbc)==2
+        && at<std::array<std::uint16_t,8>>(b,0xc0)==ranges
+        && out>=0x10000 && out<=0x00007fffffffffffULL-256
+        && at<std::uintptr_t>(b,0xe8)==out+32;
+}
+std::array<float,3> rotate(const std::array<float,4>& q,const std::array<float,3>& v) noexcept {
+    const std::array<float,3> c{q[1]*v[2]-q[2]*v[1],q[2]*v[0]-q[0]*v[2],q[0]*v[1]-q[1]*v[0]};
+    return {v[0]+2*(q[3]*c[0]+q[1]*c[2]-q[2]*c[1]),
+            v[1]+2*(q[3]*c[1]+q[2]*c[0]-q[0]*c[2]),
+            v[2]+2*(q[3]*c[2]+q[0]*c[1]-q[1]*c[0])};
+}
+}
+bool valid_pose(const Pose& p) noexcept {
+    float n=0;for(auto v:p.q){if(!std::isfinite(v))return false;n+=v*v;}
+    for(auto v:p.ts)if(!std::isfinite(v)||std::abs(v)>1000)return false;
+    return n>.98f&&n<1.02f&&p.ts[3]>.98f&&p.ts[3]<1.02f;
+}
+Pose compose(const Pose& a,const Pose& b) noexcept {
+    const auto& x=a.q;const auto& y=b.q;Pose p{};
+    p.q={x[3]*y[0]+x[0]*y[3]+x[1]*y[2]-x[2]*y[1],x[3]*y[1]+x[1]*y[3]+x[2]*y[0]-x[0]*y[2],
+         x[3]*y[2]+x[2]*y[3]+x[0]*y[1]-x[1]*y[0],x[3]*y[3]-x[0]*y[0]-x[1]*y[1]-x[2]*y[2]};
+    float n=0;for(auto v:p.q)n+=v*v;n=1/std::sqrt(n);for(auto& v:p.q)v*=n;
+    auto v=rotate(a.q,{b.ts[0]*a.ts[3],b.ts[1]*a.ts[3],b.ts[2]*a.ts[3]});
+    p.ts={a.ts[0]+v[0],a.ts[1]+v[1],a.ts[2]+v[2],a.ts[3]*b.ts[3]};return p;
+}
+Pose inverse(const Pose& p) noexcept {
+    Pose q{{-p.q[0],-p.q[1],-p.q[2],p.q[3]}, {0,0,0,1/p.ts[3]}};
+    auto v=rotate(q.q,{-p.ts[0]*q.ts[3],-p.ts[1]*q.ts[3],-p.ts[2]*q.ts[3]});
+    q.ts[0]=v[0];q.ts[1]=v[1];q.ts[2]=v[2];return q;
+}
+bool palette_pose(const Pose& handWorld,const Pose& handRest,const Pose& gripRest,
+                   const Pose& spareRest,Pose& result) noexcept {
+    if(!valid_pose(handWorld)||!valid_pose(handRest)||!valid_pose(gripRest)||!valid_pose(spareRest))return false;
+    auto grip=compose(compose(handWorld,inverse(handRest)),gripRest);
+    // The inverse-bind multiplication downstream must cancel the scaled rest
+    // translation too. Scale the grip before composing the spare's bind pose.
+    grip.ts[3]*=16;result=compose(grip,spareRest);return true;
+}
+bool identify(const Memory& m,std::uintptr_t animation,Identity& result) noexcept {
+    result={};Identity id{};Header a{},s{},b{},preview{},sound{};
+    std::uint32_t controller{},self{},parentSelf{},bone{},bodyTag{},bodyKind{};
+    std::uintptr_t back{},bodyAnimation{};std::uint64_t count{},rel{};SoundPacket packet{};
+    if(!header(m,animation,a)||a.tag!=0x80b4685f||a.kind!=0x808036cf||a.definition!=0xe98
+        ||!get(m,animation+0x44,controller)||controller!=0xffffffff
+        ||!link(m,animation+0x8d8,id.skeleton)||!header(m,id.skeleton,s)
+        ||s.tag!=0x80b9ead2||s.kind!=0x80808546||s.definition!=0x250||s.owner!=a.owner
+        ||!link(m,id.skeleton+0x68,back)||back!=animation
+        ||!resolve(m,a.owner,id.entity)||!get(m,id.entity+12,self)||self!=a.owner
+        ||!get(m,id.entity+0x38,bone)||bone!=24||!get(m,id.entity+0x3c,id.parentOwner)
+        ||!resolve(m,id.parentOwner,id.parent)||!get(m,id.parent+12,parentSelf)||parentSelf!=id.parentOwner
+        ||!get(m,id.entity+0x10,bodyTag)||bodyTag!=0x80c22410
+        ||!get(m,id.entity+0x2c,bodyKind)||bodyKind!=0x80808545
+        ||!link(m,id.entity+0x28,id.body)||!header(m,id.body,b)
+        ||b.tag!=0x80c22410||b.kind!=0x80808546||b.definition!=0x550||b.owner!=id.parentOwner
+        ||!link(m,id.body+0x68,bodyAnimation)||!header(m,bodyAnimation,preview)
+        ||preview.tag!=0x80b468cf||preview.kind!=0x808036cf||preview.owner!=b.owner
+        ||!component_in_entity(m,id.entity,a.owner,0x80bbd8a5,id.sound)||!header(m,id.sound,sound)
+        ||sound.kind!=0x80803f47||!get(m,id.sound+0x30,packet)||(id.model=private_model(packet))==0)return false;
+    std::uintptr_t asset{};
+    if(!resolve(m,s.tag,asset)||!get(m,asset+0x2d0,count)||count!=8
+        ||!get(m,asset+0x2d8,rel)||rel!=0x78)return false;
+    id.nodes=asset+0x360;
+    id.animation=animation;id.animationHandle=a.self;id.skeletonHandle=s.self;id.bodyHandle=b.self;id.owner=a.owner;
+    id.spare=id.model==0x81a295fd?4:3;
+    // Parent entity's current child must still be this inventory weapon.
+    std::uint32_t child{};if(!get(m,id.parent+0x44,child)||child!=id.owner)return false;
+    result=id;return true;
+}
+bool identify_render_source(const Memory& m,std::uintptr_t animation,
+                            std::uintptr_t context,Identity& result) noexcept {
+    result={};Identity id{};std::uintptr_t controls{};
+    if(!identify(m,animation,id)||!render_layout(m,id,context)
+        ||!get(m,context+0xa0,controls)||controls!=animation+0x50)return false;
+    result=id;return true;
+}
+bool copied_render_job(const Memory& m,const Identity& expected,std::uintptr_t source,
+                       std::uintptr_t copy) noexcept {
+    if(!source||!copy||source==copy)return false;
+    Identity id{};std::array<std::byte,0x180> a{},b{};
+    if(!identify(m,expected.animation,id)||id!=expected||!render_layout(m,id,copy)
+        ||!get(m,source,a)||!get(m,copy,b)||a!=b)return false;
+    const auto controls=at<std::uintptr_t>(b,0xa0);
+    std::array<std::byte,16> header{};
+    // F620F0 must have successfully frozen the preview controls before the
+    // native 0x180-byte copy. An allocation returned without that copy fails.
+    return controls!=id.animation+0x50 && get(m,controls,header)
+        && at<std::uint32_t>(header,0)==0x80b4685f
+        && at<std::uint32_t>(header,4)==0x808036e9
+        && at<std::uint64_t>(header,8)==0x12d8;
+}
+bool correct_export(const Memory& m,const Identity& expected,std::uintptr_t ranges,
+                     std::uintptr_t outputs,unsigned mode,void* poses) noexcept {
+    if(mode!=4||!poses||ranges<0xbc)return false;
+    struct Range {std::uint16_t index,start,count,flags;};
+    struct Ranges {std::uint32_t count;std::array<Range,2> rows;};
+    Ranges rs{};std::array<std::uintptr_t,2> out{};std::uintptr_t nodes{};std::uint32_t count{};
+    if(!get(m,ranges,rs)||rs.count!=2||!get(m,outputs,out)||out[0]<0x10000
+        ||out[0]>0x00007fffffffffffULL-256||out[1]!=out[0]+32
+        ||rs.rows[0].index!=0||rs.rows[0].start!=0||rs.rows[0].count!=1||rs.rows[0].flags!=3
+        ||rs.rows[1].index!=1||rs.rows[1].start!=1||rs.rows[1].count!=7||rs.rows[1].flags!=2
+        ||!get(m,ranges-0xac,count)||count!=8||!get(m,ranges-0xa4,nodes)||nodes!=expected.nodes)return false;
+    Identity id{};if(!identify(m,expected.animation,id)||id!=expected)return false;
+    std::array<std::uint64_t,2> cache{};Pose bodyWorld{},hand{},right{},renderRight{},handRest{},gripRest{},spareRest{},replacement{};
+    if(!get(m,id.body+0x140,cache)||cache!=std::array<std::uint64_t,2>{25,40}
+        ||!get(m,id.body+0xb0,bodyWorld)||!get(m,id.body+0x180+21*32,hand)
+        ||!get(m,id.body+0x180+24*32,right)||!get(m,out[0],renderRight)
+        ||!valid_pose(bodyWorld)||!valid_pose(hand)||!valid_pose(right)||!valid_pose(renderRight)
+        ||!rest_pose(m,0x80c22410,0x550,72,21,handRest)||!rest_pose(m,0x80c22410,0x550,72,23,gripRest)
+        ||!rest_pose(m,0x80b9ead2,0x250,8,id.spare,spareRest))return false;
+    const auto expectedRight=compose(bodyWorld,right);
+    float distance=0,dot=0;
+    for(unsigned i=0;i<3;++i){const float d=expectedRight.ts[i]-renderRight.ts[i];distance+=d*d;}
+    for(unsigned i=0;i<4;++i)dot+=expectedRight.q[i]*renderRight.q[i];
+    if(distance>.0025f||std::abs(dot)<.995f)return false;
+    const auto handWorld=compose(bodyWorld,hand);
+    if(!palette_pose(handWorld,handRest,gripRest,spareRest,replacement))return false;
+    Identity after{};if(!identify(m,id.animation,after)||after!=id)return false;
+    // Only the known unused, nonresident bone in this caller-owned render batch
+    // changes. Native cached animation, the actor, and the original half remain.
+    std::memcpy(static_cast<std::byte*>(poses)+id.spare*32,&replacement,sizeof(replacement));return true;
+}
+}
