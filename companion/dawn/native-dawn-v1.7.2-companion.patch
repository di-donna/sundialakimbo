+#pragma once
+// Build-86657 adapter registrations. This is an owned, publish-once registry,
+// not a loader or a declaration that an arbitrary art graph is compatible.
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <type_traits>
+#include <bit>
+#include <cmath>
+
+namespace dawn::client::hooks::akimbo {
+enum class RigClass : std::uint8_t { none, handCannon, smg, sidearm, genericGun };
+namespace profiles {
+inline constexpr std::uint32_t kSchemaVersion = 5;
+inline constexpr std::uint32_t kGameBuild = 86657;
+inline constexpr std::size_t kGeneratedLimit = 64;
+
+// Stable wire IDs. Legacy-only adapters cannot be selected by generated input.
+enum class Adapter : std::uint32_t {
+    warden = 1, thorn = 2, ace = 3, firstCurse = 4, lastWord = 5,
+    malfeasance = 6, ikelos = 7, ratKing = 8, sturmDrang = 9, genericGun = 10, finiteBurst = 11,
+};
+[[nodiscard]] constexpr bool generic(Adapter adapter) noexcept {
+    return adapter==Adapter::genericGun||adapter==Adapter::finiteBurst;
+}
+struct Barrel {
+    std::uint32_t coreTag{}, contentTag{}, contentDefinition{}, rootDefinition{};
+    std::uint32_t barrelDefinition{}, coreSize{}, variant{}, projectile{};
+    std::uint32_t contentSize{}, propertyCount{}, flags{};
+    bool operator==(const Barrel&) const = default;
+};
+struct RigBinding {
+    std::uint32_t animation{}, skeleton{}, rig{};
+    bool operator==(const RigBinding&) const = default;
+};
+struct FxSelector {
+    std::uint32_t offset{},particle{},binding{},inputs{},markers{},groups{},program{},programBytes{},role{};
+    bool operator==(const FxSelector&) const = default;
+};
+struct Fx {
+    std::uint32_t tag{},bytes{},definition{},endpointBinding{};
+    std::array<FxSelector,32> selectors{};
+    std::size_t count{};
+    bool operator==(const Fx&) const = default;
+};
+struct MarkerGroup {
+    std::array<std::array<std::uint32_t,8>,6> frames{};
+    std::size_t count{};
+    bool operator==(const MarkerGroup&) const = default;
+};
+struct MarkerBone {
+    std::uint32_t role{},index{},bone{};
+    std::array<std::uint32_t,8> bind{};
+    bool operator==(const MarkerBone&) const = default;
+};
+struct Visual {
+    std::array<std::uint32_t,8> muzzle{},eject{};
+    std::uint32_t tracerTag{},tracerDefinition{};
+    Fx fx{};
+    std::array<MarkerGroup,14> additional{};
+    std::size_t additionalCount{};
+    std::array<MarkerBone,86> markerBones{};
+    std::size_t markerBoneCount{};
+    bool operator==(const Visual&) const = default;
+};
+struct GunPose {
+    std::uint32_t weaponBoneCount{},markerBone{};
+    std::array<std::uint32_t,8> markerBind{};
+    std::uint32_t controlCount{},animationBytes{};
+    bool operator==(const GunPose&) const = default;
+};
+struct Registration {
+    std::uint32_t modelTag{};
+    Adapter adapter{};
+    Barrel barrel{};
+    RigBinding binding{};
+    Visual visual{};
+    std::uint32_t gapMillimeters{360};
+    // Wire policy 1 preserves empty-only reloads; 2 tops up every non-full hand.
+    std::uint32_t reloadPolicy{1};
+    GunPose pose{};
+    bool operator==(const Registration&) const = default;
+};
+struct Rig {
+    RigClass kind{};
+    std::uint32_t animation{}, skeleton{}, rig{}, bones{}, marker{};
+};
+inline constexpr std::array<Rig,3> kRigs{{
+    {RigClass::handCannon,0x81579415,0x80bc8623,0x80bc8624,80,75},
+    {RigClass::smg,0x8152c7cd,0x80bc1000,0x80bc1001,77,75},
+    {RigClass::sidearm,0x8161f90f,0x80bbdb9c,0x80bbdb9d,77,73},
+}};
+[[nodiscard]] constexpr Rig rig_for(Adapter adapter) noexcept {
+    if(generic(adapter))return {RigClass::genericGun};
+    if(adapter==Adapter::ikelos) return kRigs[1];
+    if(adapter==Adapter::ratKing) return kRigs[2];
+    auto value=kRigs[0];
+    if(adapter==Adapter::sturmDrang) value.marker=77;
+    return value;
+}
+[[nodiscard]] constexpr RigBinding legacy_binding(Adapter adapter) noexcept {
+    const auto value=rig_for(adapter);return {value.animation,value.skeleton,value.rig};
+}
+[[nodiscard]] constexpr Rig rig_for(const Registration& entry) noexcept {
+    auto value=rig_for(entry.adapter);
+    value.animation=entry.binding.animation;value.skeleton=entry.binding.skeleton;value.rig=entry.binding.rig;
+    if(generic(entry.adapter)){value.bones=72+entry.pose.weaponBoneCount;value.marker=72+entry.pose.markerBone;}
+    return value;
+}
+[[nodiscard]] constexpr Rig rig_for_animation(std::uint32_t animation) noexcept {
+    for(const auto& rig:kRigs) if(rig.animation==animation) return rig;
+    return {};
+}
+[[nodiscard]] constexpr Barrel legacy_barrel(Adapter adapter) noexcept {
+    if(adapter==Adapter::ratKing)
+        return {0x8152aea4,0x8152aea5,1096,13616,17536,35808,10,0x80bbdc54,15121,24,0x10};
+    if(adapter==Adapter::ikelos)
+        return {0x8152c7c3,0x8152c7c5,1032,13408,17328,34944,13,0xffffffff,13956,22,0x10};
+    if(adapter==Adapter::lastWord)
+        return {0x81a6aa45,0x8152905a,1832,14784,18704,37920,2,0x80bc876d,27876,47,0x14};
+    if(adapter==Adapter::thorn || adapter==Adapter::malfeasance)
+        return {0x81529057,0x8152905a,1832,14240,18160,36848,
+            adapter==Adapter::malfeasance?23u:3u,
+            adapter==Adapter::malfeasance?0x80ef28e0u:0x80bbc0feu,27876,47,0x14};
+    return {};
+}
+inline constexpr std::array<Registration,9> kLegacy{{
+    {0x81a2958a,Adapter::warden,{},legacy_binding(Adapter::warden)},
+    {0x81a295e0,Adapter::thorn,legacy_barrel(Adapter::thorn),legacy_binding(Adapter::thorn)},
+    {0x81a295fd,Adapter::ace,{},legacy_binding(Adapter::ace)},
+    {0x81a2961a,Adapter::firstCurse,{},legacy_binding(Adapter::firstCurse)},
+    {0x81a29815,Adapter::lastWord,legacy_barrel(Adapter::lastWord),legacy_binding(Adapter::lastWord)},
+    {0x81a29897,Adapter::malfeasance,legacy_barrel(Adapter::malfeasance),legacy_binding(Adapter::malfeasance)},
+    {0x81a2990a,Adapter::ikelos,legacy_barrel(Adapter::ikelos),legacy_binding(Adapter::ikelos)},
+    {0x81a29990,Adapter::ratKing,legacy_barrel(Adapter::ratKing),legacy_binding(Adapter::ratKing)},
+    {0x81a29a19,Adapter::sturmDrang,{},legacy_binding(Adapter::sturmDrang)},
+}};
+[[nodiscard]] constexpr const Registration* legacy(std::uint32_t tag) noexcept {
+    for(const auto& entry:kLegacy) if(entry.modelTag==tag) return &entry;
+    return nullptr;
+}
+[[nodiscard]] constexpr bool generated_adapter(Adapter adapter) noexcept {
+    return adapter==Adapter::thorn || adapter==Adapter::malfeasance
+        || adapter==Adapter::lastWord || adapter==Adapter::ikelos || adapter==Adapter::ratKing || generic(adapter);
+}
+[[nodiscard]] constexpr bool valid_tag(std::uint32_t tag) noexcept {
+    return tag>=0x80000000u && tag!=0xffffffffu;
+}
+[[nodiscard]] constexpr bool private_core_tag(std::uint32_t tag) noexcept {
+    if(tag<0x80800000u||tag==0xffffffffu)return false;
+    const auto package=(tag-0x80800000u)>>13,entry=tag&0x1fffu;
+    // Build86657's verified runtime append and authored standalone window.
+    // An emitted stock overlay alone does not make inherited entries private.
+    return (package==0x01bbu&&entry>=6468u)||(package>=0x0aa0u&&package<=0x0cffu);
+}
+[[nodiscard]] inline bool valid_frame(const std::array<std::uint32_t,8>& bits) noexcept {
+    const auto values=std::bit_cast<std::array<float,8>>(bits);
+    for(const auto value:values)if(!std::isfinite(value))return false;
+    const float norm=values[0]*values[0]+values[1]*values[1]+values[2]*values[2]+values[3]*values[3];
+    return norm>.96f&&norm<1.04f&&std::abs(values[4])<3&&std::abs(values[5])<3&&std::abs(values[6])<3
+        &&values[7]>.95f&&values[7]<1.05f;
+}
+[[nodiscard]] inline bool valid_attachment_frame(const std::array<std::uint32_t,8>& bits) noexcept {
+    auto unscaled=bits;unscaled[7]=0x3f800000;
+    const auto scale=std::bit_cast<float>(bits[7]);
+    return valid_frame(unscaled)&&scale>.5f&&scale<2.f;
+}
+[[nodiscard]] inline bool valid_visual(const Visual& v) noexcept {
+    const auto& f=v.fx;
+    if(!valid_attachment_frame(v.muzzle)||!valid_attachment_frame(v.eject)||!valid_tag(v.tracerTag)
+        ||!v.tracerDefinition||v.tracerDefinition>0x1000000||(v.tracerDefinition&7u)
+        ||!valid_tag(f.tag)||f.bytes<24||f.bytes>0x1000000||(f.definition&7u)
+        ||f.definition>f.bytes-16||f.endpointBinding>255||!f.count||f.count>f.selectors.size()
+        ||v.additionalCount>v.additional.size()||v.markerBoneCount>v.markerBones.size())return false;
+    for(std::size_t i=0;i<v.additionalCount;++i){
+        const auto& group=v.additional[i];if(!group.count||group.count>group.frames.size())return false;
+        for(std::size_t j=0;j<group.count;++j)if(!valid_attachment_frame(group.frames[j]))return false;
+    }
+    for(std::size_t i=0;i<v.markerBoneCount;++i){
+        const auto& b=v.markerBones[i];
+        if(!b.bone||b.bone>=56||!valid_frame(b.bind)||!b.role||b.role>2+v.additionalCount
+            ||(b.role<=2?b.index!=0:b.index>=v.additional[b.role-3].count))return false;
+        for(std::size_t j=0;j<i;++j)if(v.markerBones[j].role==b.role&&v.markerBones[j].index==b.index)return false;
+    }
+    bool muzzle=false;
+    for(std::size_t i=0;i<f.count;++i){
+        const auto& s=f.selectors[i];
+        if((s.offset&7u)||s.offset>f.bytes-24||!valid_tag(s.particle)||!valid_tag(s.program)
+            ||!s.programBytes||s.programBytes>0x1000000||s.binding>255||s.binding==f.endpointBinding
+            ||(s.inputs!=1&&s.inputs!=2)||s.markers<1||s.markers>6||s.groups<s.inputs||s.groups>3
+            ||s.role<1||s.role>2+v.additionalCount||(s.role<=2&&s.markers!=1)
+            ||(s.role>=3&&v.additional[s.role-3].count>s.markers))return false;
+        for(std::size_t j=0;j<i;++j)if(f.selectors[j].offset==s.offset)return false;
+        muzzle|=s.role==1;
+    }
+    return muzzle;
+}
+[[nodiscard]] inline bool valid_pose(const GunPose& p) noexcept {
+    if(!valid_frame(p.markerBind))return false;
+    const auto bind=std::bit_cast<std::array<float,8>>(p.markerBind);
+    const auto norm=bind[0]*bind[0]+bind[1]*bind[1]+bind[2]*bind[2]+bind[3]*bind[3];
+    return std::abs(norm-1.f)<=.00002f&&std::abs(bind[7]-1.f)<=.000002f
+        &&p.weaponBoneCount>=3&&p.weaponBoneCount<=56&&p.markerBone>=1&&p.markerBone<p.weaponBoneCount-1
+        &&p.controlCount>=70&&p.controlCount<=72+p.weaponBoneCount
+        &&p.animationBytes>=0x100&&p.animationBytes<=0x1000000&&!(p.animationBytes&7u);
+}
+// Bounded ranges prove every subtraction used by the pinned barrel reader is
+// defined. Runtime identity still checks the actual owner, sizes, variant,
+// single-projectile pattern, root handle generation and the exact registration.
+[[nodiscard]] inline bool valid(const Registration& entry) noexcept {
+    if(!valid_tag(entry.modelTag) || legacy(entry.modelTag)
+        || entry.modelTag==0x81a29991 || entry.modelTag==0x81a29a1b || entry.modelTag==0x81a29a1d
+        || !generated_adapter(entry.adapter)
+        || entry.gapMillimeters<50 || entry.gapMillimeters>800
+        || (entry.reloadPolicy<1 || entry.reloadPolicy>3)) return false;
+    const auto& binding=entry.binding;
+    if(!valid_tag(binding.animation)||!valid_tag(binding.skeleton)||!valid_tag(binding.rig)
+        ||binding.animation==binding.skeleton||binding.animation==binding.rig||binding.skeleton==binding.rig
+        ||entry.modelTag==binding.animation||entry.modelTag==binding.skeleton||entry.modelTag==binding.rig) return false;
+    for(const auto& old:kLegacy) if(binding.animation==old.binding.animation
+        && (binding!=old.binding || rig_for(entry.adapter).kind!=rig_for(old.adapter).kind)) return false;
+    const auto& b=entry.barrel;
+    if(entry.adapter==Adapter::finiteBurst&&!private_core_tag(b.coreTag))return false;
+    if(!valid_tag(b.coreTag) || !valid_tag(b.contentTag) || b.coreTag==b.contentTag
+        || entry.modelTag==b.coreTag || entry.modelTag==b.contentTag
+        || b.coreSize>0x1000000 || b.contentSize>0x1000000
+        || !b.rootDefinition || (b.rootDefinition&7u) || (b.barrelDefinition&7u)
+        || (b.contentDefinition&7u) || b.rootDefinition>b.coreSize
+        || b.coreSize-b.rootDefinition<0x8d0 || b.barrelDefinition>b.coreSize
+        || b.coreSize-b.barrelDefinition<0xecc || b.contentDefinition>b.contentSize
+        || b.contentSize-b.contentDefinition<0x270
+        || b.propertyCount>4096
+        || (!generic(entry.adapter)&&(!b.propertyCount||b.variant==0xffffffffu))
+        || (b.variant!=0xffffffffu&&b.variant>=b.propertyCount)
+        || std::uint64_t(b.propertyCount)*448>b.contentSize-b.contentDefinition-0x258
+        || (!valid_tag(b.projectile) && b.projectile!=0xffffffffu)) return false;
+    const auto expectedFlags=entry.adapter==Adapter::ikelos || entry.adapter==Adapter::ratKing?0x10u:0x14u;
+    if(!generic(entry.adapter)&&b.flags!=expectedFlags) return false;
+    for(const auto& rig:kRigs)
+        if(entry.modelTag==rig.animation || entry.modelTag==rig.skeleton || entry.modelTag==rig.rig) return false;
+    if(entry.adapter==Adapter::ikelos||generic(entry.adapter)){
+        if(!valid_visual(entry.visual)||(entry.adapter==Adapter::ikelos&&(entry.visual.additionalCount||entry.visual.markerBoneCount
+            ||!valid_frame(entry.visual.muzzle)||!valid_frame(entry.visual.eject))))return false;
+    }
+    else if(entry.visual!=Visual{})return false;
+    if(generic(entry.adapter)){
+        if(!valid_pose(entry.pose))return false;
+        for(std::size_t i=0;i<entry.visual.markerBoneCount;++i){
+            const auto bone=entry.visual.markerBones[i].bone;
+            if(bone>=entry.pose.weaponBoneCount||bone==entry.pose.markerBone)return false;
+        }
+    }
+    else if(entry.pose!=GunPose{})return false;
+    return true;
+}
+[[nodiscard]] inline const MarkerBone* attachment_bone(const Visual& visual,unsigned role,unsigned index=0) noexcept {
+    for(std::size_t i=0;i<visual.markerBoneCount;++i)
+        if(visual.markerBones[i].role==role&&visual.markerBones[i].index==index)return &visual.markerBones[i];
+    return nullptr;
+}
+enum class PublishResult {
+    published, wrongSchema, wrongBuild, empty, tooMany, invalidEntry,
+    duplicateModel, conflictingRig, conflictingVisual, alreadyPublished,
+};
+// Validate without constructing a second owned registry. The parser uses this
+// same check before publication; "published" here means the input is eligible.
+[[nodiscard]] inline PublishResult check_entries(std::uint32_t schema,std::uint32_t build,
+                                                 std::span<const Registration> entries) noexcept {
+    if(schema!=kSchemaVersion) return PublishResult::wrongSchema;
+    if(build!=kGameBuild) return PublishResult::wrongBuild;
+    if(entries.empty()) return PublishResult::empty;
+    if(entries.size()>kGeneratedLimit) return PublishResult::tooMany;
+    for(std::size_t i=0;i<entries.size();++i) {
+        if(!valid(entries[i])) return PublishResult::invalidEntry;
+        for(std::size_t j=0;j<i;++j) {
+            if(entries[i].modelTag==entries[j].modelTag) return PublishResult::duplicateModel;
+            if(entries[i].binding.animation==entries[j].binding.animation
+                &&(entries[i].binding!=entries[j].binding
+                   ||rig_for(entries[i].adapter).kind!=rig_for(entries[j].adapter).kind
+                   ||entries[i].pose!=entries[j].pose)) return PublishResult::conflictingRig;
+            if(entries[i].visual.fx.tag&&entries[i].visual.fx.tag==entries[j].visual.fx.tag
+                &&entries[i].visual.fx!=entries[j].visual.fx)return PublishResult::conflictingVisual;
+        }
+    }
+    return PublishResult::published;
+}
+// No reset/replacement API: hooks can keep references through all native calls.
+// Publication owns a copy; caller buffers may be released or mutated immediately.
+class Registry final {
+    std::array<Registration,kGeneratedLimit> entries_{};
+    std::size_t count_{};
+    // 0 = unpublished, 1 = writer owns storage, 2 = immutable publication.
+    std::atomic<unsigned> state_{};
+public:
+    Registry() = default;
+    Registry(const Registry&) = delete;
+    Registry& operator=(const Registry&) = delete;
+    [[nodiscard]] PublishResult publish(std::uint32_t schema,std::uint32_t build,
+                                        std::span<const Registration> entries) noexcept {
+        const auto checked=check_entries(schema,build,entries);
+        if(checked!=PublishResult::published)return checked;
+        unsigned expected=0;
+        if(!state_.compare_exchange_strong(expected,1,std::memory_order_acquire))
+            return PublishResult::alreadyPublished;
+        for(std::size_t i=0;i<entries.size();++i) entries_[i]=entries[i];
+        count_=entries.size();
+        state_.store(2,std::memory_order_release);
+        return PublishResult::published;
+    }
+    [[nodiscard]] const Registration* find(std::uint32_t tag) const noexcept {
+        if(const auto* entry=legacy(tag)) return entry;
+        if(state_.load(std::memory_order_acquire)!=2) return nullptr;
+        for(std::size_t i=0;i<count_;++i) if(entries_[i].modelTag==tag) return &entries_[i];
+        return nullptr;
+    }
+    [[nodiscard]] std::size_t size() const noexcept {
+        return state_.load(std::memory_order_acquire)==2?count_:0;
+    }
+    [[nodiscard]] bool has_adapter(Adapter adapter) const noexcept {
+        if(state_.load(std::memory_order_acquire)!=2)return false;
+        for(std::size_t i=0;i<count_;++i)if(entries_[i].adapter==adapter)return true;
+        return false;
+    }
+    // The production loader requires adapter11 core tags to belong to emitted
+    // artifacts. This private root can therefore be recognized before its
+    // presented model exists, without intercepting the stock donor's root.
+    [[nodiscard]] bool finite_core(std::uint32_t tag) const noexcept {
+        if(state_.load(std::memory_order_acquire)!=2)return false;
+        for(std::size_t i=0;i<count_;++i)
+            if(entries_[i].adapter==Adapter::finiteBurst&&entries_[i].barrel.coreTag==tag)return true;
+        return false;
+    }
+    [[nodiscard]] std::size_t generated_index(std::uint32_t tag) const noexcept {
+        if(state_.load(std::memory_order_acquire)==2)
+            for(std::size_t i=0;i<count_;++i)if(entries_[i].modelTag==tag)return i;
+        return kGeneratedLimit;
+    }
+    [[nodiscard]] Rig rig(std::uint32_t animation) const noexcept {
+        if(const auto old=rig_for_animation(animation);old.kind!=RigClass::none) return old;
+        if(state_.load(std::memory_order_acquire)!=2) return {};
+        for(std::size_t i=0;i<count_;++i) if(entries_[i].binding.animation==animation) return rig_for(entries_[i]);
+        return {};
+    }
+    [[nodiscard]] const Fx* visual_sequence(std::uint32_t tag) const noexcept {
+        if(state_.load(std::memory_order_acquire)!=2)return nullptr;
+        for(std::size_t i=0;i<count_;++i)if(entries_[i].visual.fx.tag==tag)return &entries_[i].visual.fx;
+        return nullptr;
+    }
+};
+inline Registry generated;
+[[nodiscard]] inline constexpr const Registration* find(std::uint32_t tag) noexcept {
+    if(std::is_constant_evaluated()) return legacy(tag);
+    return generated.find(tag);
+}
+[[nodiscard]] inline constexpr bool is(std::uint32_t tag,Adapter adapter) noexcept {
+    const auto* entry=find(tag);return entry && entry->adapter==adapter;
+}
+// A few retained presentation adapters key calibrated behavior by legacy model.
+// Resolve that behavior only after the real generated identity has passed its
+// gates; do not replace Identity.modelTag (it is part of the lifetime identity).
+[[nodiscard]] inline constexpr std::uint32_t behavior_tag(std::uint32_t tag) noexcept {
+    const auto* entry=find(tag);if(!entry) return tag;
+    for(const auto& old:kLegacy) if(old.adapter==entry->adapter) return old.modelTag;
+    return tag;
+}
