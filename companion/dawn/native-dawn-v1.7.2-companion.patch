+            (reinterpret_cast<void*>(barrel()),&context);return current();
+    }
+    bool invoke_trigger(InputScope& scope) noexcept {
+        auto* previous=inputScope;inputScope=&scope;bool result=false;
+        __try {result=nextTrigger.load(std::memory_order_acquire)(reinterpret_cast<void*>(selected.native.root+0xc50),duration);}
+        __finally {inputScope=previous;}
+        triggerResult|=result;return !failed&&scope.calls==1&&current();
+    }
+    bool trigger(unsigned,const burst_trigger::Input& input) noexcept {
+        if(!current()||inputScope||!nextTrigger.load(std::memory_order_acquire))return false;
+        InputScope scope{this,&input};return invoke_trigger(scope);
+    }
+    bool invoke_final(FinalScope& scope) noexcept {
