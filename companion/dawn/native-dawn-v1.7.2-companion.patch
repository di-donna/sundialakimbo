+inline constexpr const char* partNames[]{"sturm_root","drang_root","active","model","equipment","content","links"};
+struct Relocation {
+    unsigned moved{},movedMask{},lostMask{};const char* lost{};   // lost: the first part that failed (nullptr: every part resolved)
+    [[nodiscard]] bool ok() const {return lost==nullptr;}
+};
+[[nodiscard]] inline const char* part_name(unsigned bit) {
+    for(unsigned i=0;i<7;++i)if(bit==(1U<<i))return partNames[i];
+    return "?";
+}
