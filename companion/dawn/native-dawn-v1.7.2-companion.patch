+    }
+    bool interval(float& out) noexcept {
+        if(!current())return false;
+        out=nextInterval.load(std::memory_order_acquire)(reinterpret_cast<void*>(barrel()));
+        return current()&&std::isfinite(out)&&out>0&&out<=60;
+    }
+    bool available(unsigned& mask) noexcept {
+        smg_ammo::State magazine{};
+        if(!current()||!magazine_snapshot(selected.identity,magazine)
+            ||magazine.native!=selected.native||magazine.prepaid||!current())return false;
+        mask=magazine.available();return true;
+    }
+    bool capture(burst_driver::Hand& hand) noexcept {
+        burst_trigger::View observed{};
+        if(!phase(hand.phase)||!view(observed))return false;
+        hand.requests=observed.lane.request;hand.charge=observed.lane.charge;return hand.valid();
+    }
+    bool invoke_active(unsigned side,const burst_driver::Context& context,burst_driver::Output& output) noexcept {
+        auto selectedHand=selected;selectedHand.side=side;
+        burst::runtime::ExitDebit debit{};
+        const auto* previous=burst::runtime::phase;auto* oldExit=burst::runtime::phaseExit;
+        burst::runtime::phase=&selectedHand;burst::runtime::phaseExit=&debit;
