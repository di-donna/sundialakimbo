+inline bool constant_unit(const Memory& memory,std::uintptr_t asset,unsigned bytes,unsigned definition) noexcept {
+    using hud::detail::read;
+    std::array<std::uint64_t,2> code{},constants{},header{};std::array<float,4> values{};
+    std::array<unsigned char,4> program{};
+    const auto array=[&](unsigned field,unsigned count,unsigned stride,unsigned kind,std::uintptr_t& address) {
+        std::array<std::uint64_t,2> pair{};
+        if(field>bytes||bytes-field<24||!read(memory,asset+field,pair)||pair[0]!=count
+            ||pair[1]>bytes-field-24||count*stride>bytes-field-24-pair[1])return false;
+        address=asset+field+24+pair[1];
+        return read(memory,address-16,header)&&header==std::array<std::uint64_t,2>{count,kind};
+    };
