--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/smg_magazines.h
@@ -0,0 +1,326 @@
+#pragma once
+#include "hud.h"
+#include "gun_layout.h"
+#include "presentation.h"
+#include "tube_reload.h"
+#include "../infinite_ammo/infinite_ammo.h"
+#include <algorithm>
+#include <array>
+
+namespace dawn::client::hooks::akimbo::smg_ammo {
+using hud::detail::read;
+using hud::detail::resolve;
+using hud::detail::header;
+struct Native {
+    std::uintptr_t root{},magazine{};
+    unsigned handle{},owner{},modelTag{};
+    bool operator==(const Native&) const=default;
+};
+// A live component can move without changing its generation-bearing handle.
+// This key is only for retaining magazine state after locate() has qualified
+// the replacement storage. Native transactions still require exact pointers.
+inline bool same_instance(const Native& a,const Native& b) noexcept {
+    return a.handle&&a.handle!=~0u&&a.owner&&a.owner!=~0u&&a.modelTag&&a.modelTag!=~0u
+        &&a.handle==b.handle&&a.owner==b.owner&&a.modelTag==b.modelTag;
+}
+inline void begin_input_pass(std::uint32_t modelTag,Native& active) noexcept {
+    if(!profiles::legacy(modelTag))active={};
+}
+inline bool qualify(const Memory& m,const Identity& id,std::uintptr_t magazine,Native& out) noexcept {
+    out={};if(!smg_model(id.modelTag)||magazine<0x10000+0x24d0)return false;
+    const auto* profile=profiles::find(id.modelTag);gun_layout::Layout layout{};
+    if(!profile||!gun_layout::source(m,profile->barrel,layout))return false;
+    const auto root=magazine-0x24d0;
+    hud::detail::Header h{};std::array<unsigned,4> def{};std::int64_t parent{};
+    unsigned handle{};std::uint64_t offset{};
+    if(!header(m,root,h)||h.owner!=id.modelOwner||h.kind!=layout.rootKind||h.definition!=profile->barrel.rootDefinition
+        ||!read(m,magazine,def)||def!=std::array<unsigned,4>{profile->barrel.coreTag,0x8080384b,layout.magazineDefinition,0}
+        ||!read(m,magazine+16,parent)||parent!=-0x24e0
+        ||!read(m,root+0xd70+0xf60,handle)||handle!=h.self
+        ||!read(m,root+0xd70+0xf68,offset)||offset!=0x24d0
+        ||!native_akimbo_barrel(m,root+0xd70,id))return false;
+    out={root,magazine,h.self,h.owner,id.modelTag};return true;
+}
+inline bool unchanged(const Memory& m,const Native& n) noexcept {
+    hud::detail::Header h{};gun_layout::Layout layout{};
+    const auto* profile=profiles::find(n.modelTag);
+    return profile&&smg_model(n.modelTag)
+        &&gun_layout::source(m,profile->barrel,layout)
+        &&n.magazine==n.root+0x24d0&&header(m,n.root,h)&&h.tag==profile->barrel.coreTag
+        &&h.kind==layout.rootKind&&h.definition==profile->barrel.rootDefinition&&h.self==n.handle&&h.owner==n.owner;
+}
+inline bool locate(const Memory& m,const Identity& id,Native& out) noexcept {
+    out={};if(!smg_model(id.modelTag))return false;
+    const auto* profile=profiles::find(id.modelTag);if(!profile)return false;
+    std::uintptr_t entity{},assembly{},asset{};unsigned owner{},handle{},tag{};
+    std::uint64_t bytes{},count{},relative{};
+    if(!resolve(m,id.modelOwner,entity)||!read(m,entity+12,owner)||owner!=id.modelOwner
+        ||!read(m,entity+0x4c,handle)||!resolve(m,handle,assembly)
+        ||!read(m,assembly+4,tag)||!resolve(m,tag,asset)||!read(m,asset,bytes)
+        ||bytes<48||bytes>0x100000||!read(m,asset+16,count)||!count||count>128
+        ||!read(m,asset+24,relative)||relative>bytes-0x28||count*12>bytes-0x28-relative)return false;
+    unsigned found=0;Native result{};
+    for(unsigned i=0;i<count;++i){
+        std::array<unsigned,3> row{};if(!read(m,asset+0x28+relative+i*12,row))return false;
+        if(row[0]!=profile->barrel.coreTag)continue;
+        if(row[2]>0x100000||!qualify(m,id,assembly+row[2]+0x24d0,result))return false;
+        ++found;
+    }
+    if(found!=1||!still_current(m,id))return false;
+    out=result;return true;
+}
+struct ReloadProperties {std::uintptr_t tactical{},empty{};};
+// These are the same native tactical/empty records read by D009A0. Their
+// definitions may relocate; ownership, record type and root offsets may not.
+inline bool reload_properties(const Memory& m,const Native& n,ReloadProperties& out) noexcept {
+    out={};const auto* profile=profiles::find(n.modelTag);gun_layout::Layout layout{};
+    if(!profile||!unchanged(m,n)||!gun_layout::source(m,profile->barrel,layout)||!layout.ordinary_reload())return false;
+    std::array<std::byte,0x38> controller{};std::array<unsigned,4> link{};
+    if(!read(m,n.root+0x2710,controller)
+        ||hud::detail::at<unsigned>(controller,0)!=profile->barrel.coreTag
+        ||hud::detail::at<unsigned>(controller,4)!=0x80803845
+        ||hud::detail::at<std::uint64_t>(controller,8)!=layout.reloadDefinition
+        ||hud::detail::at<std::int64_t>(controller,0x10)!=-0x2720
+        ||hud::detail::at<unsigned>(controller,0x20)!=0x80803844
+        ||hud::detail::at<unsigned>(controller,0x28)!=n.handle
+        ||hud::detail::at<unsigned>(controller,0x2c)!=0x80803844
+        ||hud::detail::at<std::uint64_t>(controller,0x30)!=0x2710
+        ||!read(m,n.root+0x28c8,link)||link!=std::array<unsigned,4>{n.handle,0x80803a0f,0x24d0,0})return false;
+    std::uintptr_t asset{};std::uint64_t bytes{};
+    if(!resolve(m,profile->barrel.coreTag,asset)||!read(m,asset,bytes)||bytes<24||bytes>0x1000000)return false;
+    const auto controllerDefinition=hud::detail::at<std::uint64_t>(controller,8);
+    if(!controllerDefinition||controllerDefinition%8||controllerDefinition>bytes-16)return false;
+    for(const auto offset:{0x2820u,0x2850u}){
+        std::array<std::byte,0x30> record{};
+        if(!read(m,n.root+offset,record)||hud::detail::at<unsigned>(record,0xc)!=n.handle
+            ||hud::detail::at<std::uint64_t>(record,0x10)!=offset
+            ||hud::detail::at<unsigned>(record,0x20)!=profile->barrel.coreTag
+            ||hud::detail::at<unsigned>(record,0x24)!=0x808045c4)return false;
+        const auto definition=hud::detail::at<std::uint64_t>(record,0x28);
+        if(!definition||definition%8||definition>bytes-24)return false;
+    }
+    if(!unchanged(m,n))return false;
+    out={n.root+0x2820,n.root+0x2850};return true;
+}
+// Transfer only new rounds. Native getters/setters preserve the engine's
+// encoding and notifications. Refuse changed baselines; if the loaded setter
+// fails without another change, undo our reserve debit before returning.
+template<class N> bool transfer(N& n,int loaded,int reserve,int amount,int forcedReserve=-1) noexcept {
+    if((forcedReserve!=-1&&forcedReserve!=infinite_ammo::kReserveOverride)
+        ||loaded<0||loaded>400||reserve<0||reserve>100000||amount<0
+        ||amount>(forcedReserve<0?reserve:forcedReserve)||amount>400-loaded
+        ||!n.valid()||n.loaded()!=loaded||n.reserve()!=reserve)return false;
+    if(!amount)return true;
+    // Dawn's existing infinite-ammo module intentionally restores reserves to
+    // 500 in both setters. Its active policy is captured/rechecked by valid();
+    // do not infer permission from an unexpected reserve value. Its magazine
+    // setter keeps our finite loaded amount and supplies the requested reserve.
+    if(forcedReserve>=0){
+        n.set_loaded(loaded+amount);
+        if(!n.valid()||n.loaded()!=loaded+amount||n.reserve()!=forcedReserve)return false;
+        n.publish();return true;
+    }
+    n.set_reserve(reserve-amount);
+    if(!n.valid())return false;
+    const int r=n.reserve(),l=n.loaded();
+    if(r!=reserve-amount||l!=loaded)return false;
+    n.set_loaded(loaded+amount);
+    if(!n.valid())return false;
+    const int afterLoaded=n.loaded(),afterReserve=n.reserve();
+    if(afterLoaded==loaded+amount&&afterReserve==reserve-amount){n.publish();return true;}
+    if(afterLoaded==loaded&&afterReserve==reserve-amount){n.set_reserve(reserve);if(n.valid())n.publish();}
+    return false;
+}
+struct State {
+    Native native{};int capacity{},rounds[2]{};
+    unsigned loading{};bool initialized{},reloadHeld{},updating{},reloadPending{},prepaid{};
+    unsigned lastSide{};
+    unsigned prepaidToken{},prepaidSide{};
+    std::uint64_t revision{};
+    std::uint64_t lastTick{};
+    float elapsed[2]{},duration[2]{};
+    bool tubeMode{};
+    tube_reload::Hand tube[2]{};
+    // Seed the second magazine from reserves. A serialized combined count is
+    // split without creating additional ammunition after a respawn/rebuild.
+    int initialize(Native n,int cap,int loaded,int reserve,std::uint64_t now) noexcept {
+        if(cap<1||cap>200||loaded<0||loaded>cap*2||reserve<0||reserve>100000)return -1;
+        *this={};native=n;capacity=cap;initialized=true;lastTick=now;
+        rounds[1]=std::min(loaded,cap);
+        if(loaded>cap){rounds[0]=loaded-cap;return 0;}
+        rounds[0]=std::min(cap,reserve);return rounds[0];
+    }
+    int total() const noexcept {return rounds[0]+rounds[1];}
+    unsigned available() const noexcept {
+        return (rounds[0]>0&&!(loading&1)?1u:0)|(rounds[1]>0&&!(loading&2)?2u:0);
+    }
+    unsigned filter(unsigned held) const noexcept {return initialized?held&available():held&3;}
+    unsigned firing_mask(unsigned held) const noexcept {return prepaid?prepaidSide&available():filter(held);}
+    // CB7901 spends before CC6010 queues the emission; CCF7C3/CC99EF remove
+    // barrel+1720 immediately before CB48C0 calls our firing hook. Keep those
+    // rounds assigned by the eventual ticket, not a second input-pass debit.
+    // Retain the triggering hand even if the physical buttons change meanwhile.
+    void defer_native(unsigned token,unsigned held,unsigned last,bool reload,std::uint64_t now) noexcept {
+        if(!prepaid||prepaidToken!=token){
+            const auto allowed=filter(held);prepaidSide=allowed==3?(last==1?2u:1u):allowed;
+            prepaid=true;prepaidToken=token;
+        }
+        reloadPending|=reload&&!reloadHeld;reloadHeld=reload;lastTick=now;++revision;
+    }
+    bool consume(unsigned side) noexcept {
+        if(!initialized||(side!=1&&side!=2)||!(available()&side)||(prepaid&&side!=prepaidSide))return false;
+        --rounds[side==1?0:1];lastSide=side;prepaid=false;prepaidSide=prepaidToken=0;++revision;return true;
+    }
+    // Native spending runs outside the emission hook. At the next input pass,
+    // reconcile its actual combined store before planning any reserve transfer.
+    // A confirmed shot is already represented by consume(), so equal totals
+    // do nothing. Refunds/pickups and external spending must never be overwritten
+    // by an older cached total. Preserve the other hand whenever possible.
+    bool reconcile(int loaded,int cap) noexcept {
+        if(!initialized||cap<1||cap>200||loaded<0||loaded>cap*2)return false;
+        // This path runs only after the native queue no longer qualifies.
+        // Cancellation/refund can leave the total unchanged without consume().
+        // Retire that reservation while retaining an R press deferred behind it.
+        const bool deferred=reloadPending;
+        const unsigned debitSide=prepaid?prepaidSide:lastSide;
+        if(prepaid){prepaid=false;prepaidSide=prepaidToken=0;++revision;}
+        if(cap!=capacity){cancel();reloadPending=deferred;capacity=cap;}
+        int delta=loaded-total();
+        if(!delta&&rounds[0]<=cap&&rounds[1]<=cap)return true;
+        unsigned changed=0;
+        const unsigned first=(delta<0?debitSide:lastSide)==1?0:1;
+        for(unsigned step=0;step<2;++step){const unsigned i=first^step;
+            if(delta>0){const int add=std::min(delta,std::max(0,cap-rounds[i]));rounds[i]+=add;delta-=add;if(add)changed|=1u<<i;}
+            else if(delta<0){const int take=std::min(-delta,rounds[i]);rounds[i]-=take;delta+=take;if(take)changed|=1u<<i;}
+        }
+        // A capacity decrease can move existing rounds between hands, but must
+        // not discard them or create an implicit reserve charge.
+        for(unsigned i=0;i<2;++i)if(rounds[i]>cap){rounds[1-i]+=rounds[i]-cap;rounds[i]=cap;changed=3;}
+        // A canceled prepaid event affects its reserved hand. Do not restart
+        // or cancel the other hand's independently running reload timer.
+        loading&=~changed;
+        for(unsigned i=0;i<2;++i)if(changed&(1u<<i)){elapsed[i]=duration[i]=0;tube[i].cancel();}
+        ++revision;return delta==0&&total()==loaded;
+    }
+    unsigned request_mask(bool held,int reserve,unsigned eligible,unsigned policy) noexcept {
+        const bool rising=(held&&!reloadHeld)||reloadPending;reloadHeld=held;reloadPending=false;
+        if(!initialized||!rising||reserve<1||(policy!=1&&policy!=2&&policy!=3))return 0;
+        unsigned selected=eligible&3;
+        if(policy==3){
+            // R selects one magazine, with simultaneous reloads reserved for
+            // a pair whose magazines are both empty. A fresh R may add the
+            // second empty hand without restarting an existing reload timer.
+            if(loading&&(rounds[0]||rounds[1]))return 0;
+            for(unsigned i=0;i<2;++i)if(rounds[i]>=capacity)selected&=~(1u<<i);
+            if(selected==3&&(rounds[0]||rounds[1]))selected=rounds[0]<=rounds[1]?1u:2u;
+        }
+        unsigned started=0;
+        for(unsigned i=0;i<2;++i){const unsigned bit=1u<<i;
+            if((selected&bit)&&rounds[i]<capacity&&(policy!=1||!rounds[i])&&!(loading&bit)){
+                loading|=bit;started|=bit;
+            }
+        }
+        if(started)++revision;
+        return started;
+    }
+    unsigned request(bool held,int reserve,const std::array<float,2>& seconds,unsigned policy) noexcept {
+        unsigned eligible=0;
+        for(unsigned i=0;i<2;++i)if(!tubeMode&&std::isfinite(seconds[i])&&seconds[i]>=.2f&&seconds[i]<=15)eligible|=1u<<i;
+        const auto started=request_mask(held,reserve,eligible,policy);
+        for(unsigned i=0;i<2;++i)if(started&(1u<<i)){elapsed[i]=0;duration[i]=seconds[i];}
+        return started;
+    }
+    unsigned request_tube(bool held,int reserve,const tube_reload::Inputs& values,unsigned policy) noexcept {
+        const auto started=request_mask(held,reserve,tubeMode&&tube_reload::valid(values)?3u:0u,policy);
+        for(unsigned i=0;i<2;++i)if(started&(1u<<i)){
+            if(!tube[i].start(values,rounds[i],capacity,reserve)){loading&=~(1u<<i);continue;}
+            elapsed[i]=0;duration[i]=static_cast<float>(tube[i].seconds);
+        }
+        return started&loading;
+    }
+    unsigned request(bool held,int reserve,float seconds) noexcept {
+        return request(held,reserve,{seconds,seconds},1);
+    }
+    int advance(std::uint64_t now,int reserve,bool focused,float rate=1.f,bool transferReady=true) noexcept {
+        if(!initialized||tubeMode||reserve<0)return 0;
+        const auto delta=now>=lastTick?now-lastTick:0;lastTick=now;
+        if(!focused||delta>250||!std::isfinite(rate)||rate<.1f||rate>10.f)return 0;
+        int spent=0;
+        for(unsigned i=0;i<2;++i){const unsigned bit=1u<<i;if(!(loading&bit))continue;
+            elapsed[i]+=static_cast<float>(delta)*.001f*rate;
+            if(elapsed[i]+.00001f<duration[i]||!transferReady)continue;
+            const int amount=std::min(std::max(0,capacity-rounds[i]),std::max(0,reserve-spent));
+            rounds[i]+=amount;spent+=amount;loading&=~bit;
+        }
+        ++revision;
+        return spent;
+    }
+    int advance_tube(std::uint64_t now,int reserve,bool focused,const tube_reload::Inputs& values,
+        float rate=1.f,bool transferReady=true) noexcept {
+        if(!initialized||!tubeMode||reserve<0)return 0;
+        const auto delta=now>=lastTick?now-lastTick:0;lastTick=now;
+        if(!focused||delta>250||!std::isfinite(rate)||rate<.1f||rate>10.f||!tube_reload::valid(values))return 0;
+        int spent=0;
+        for(unsigned i=0;i<2;++i){const unsigned bit=1u<<i;if(!(loading&bit))continue;
+            const int amount=tube[i].advance(static_cast<double>(delta)*.001*rate,values,
+                rounds[i],capacity,std::max(0,reserve-spent),transferReady);
+            rounds[i]+=amount;spent+=amount;
+            elapsed[i]=static_cast<float>(tube[i].elapsed);duration[i]=static_cast<float>(tube[i].seconds);
+            if(!tube[i].active())loading&=~bit;
+        }
+        ++revision;return spent;
+    }
+    void cancel() noexcept {loading=0;reloadHeld=reloadPending=prepaid=false;prepaidSide=prepaidToken=0;elapsed[0]=elapsed[1]=0;tube[0].cancel();tube[1].cancel();++revision;}
+    float hidden(unsigned side) const noexcept {
+        if((side!=1&&side!=2)||!(loading&side))return 0;
+        const auto i=side==1?0:1;const float t=elapsed[i]/duration[i];
+        return presentation::smoothstep(t/.2f)*(1-presentation::smoothstep((t-.72f)/.28f));
+    }
+};
+inline State recover_failed_transfer(const State& before,const Native& native,int capacity,
+    std::uint64_t now,bool current,int loaded) noexcept {
+    State candidate=before;
+    // A failed exact-address guard may mean this same instance just moved.
+    // Retain its durable state inactive until locate() qualifies replacement
+    // storage. Cancel/reconcile only when this native address is still current.
+    if(current)candidate.cancel();
+    // Do not repeat an initial reserve charge after a partially failed transfer.
+    if(!candidate.initialized)(void)candidate.initialize(native,capacity,0,0,now);
+    if(current)(void)candidate.reconcile(loaded,capacity);
+    return candidate;
+}
+inline bool ready(const Memory& m,const Identity& id,const State* state) noexcept {
+    if(!state||!state->initialized||state->updating||state->native.owner!=id.modelOwner)return false;
+    if(profiles::legacy(id.modelTag))return true;
+    return state->native.modelTag==id.modelTag&&unchanged(m,state->native);
+}
+inline unsigned filter(const Memory& m,const Identity& id,const State* state,unsigned held) noexcept {
+    if(ready(m,id,state))return state->filter(held);
+    // Legacy registrations retain their original fallback. A generated pair
+    // cannot spend a native single magazine while independent state is absent.
+    return profiles::legacy(id.modelTag)?held:0;
+}
+struct Book {
+    std::array<State,8> entries{};unsigned cursor{};
+    State* find(const Native& n) noexcept {
+        for(auto& s:entries)if(s.initialized&&s.native==n)return &s;
+        return nullptr;
+    }
+    const State* find(const Native& n) const noexcept {
+        for(const auto& s:entries)if(s.initialized&&s.native==n)return &s;
+        return nullptr;
+    }
+    State& slot(const Native& n) noexcept {
+        if(auto* s=find(n))return *s;
+        // n comes from the complete current-owner/typed-component locate().
+        // Preserve counts, reload clocks and queued-shot ownership when the
+        // engine moves this same instance. Retire an in-flight old-pointer
+        // transaction; its exact native/revision checks cannot publish here.
+        for(auto& s:entries)if(s.initialized&&same_instance(s.native,n)){
+            s.native=n;s.updating=false;++s.revision;return s;
+        }
+        auto& s=entries[cursor++%entries.size()];s={};return s;
+    }
+    void cancel_except(const Native& n) noexcept {for(auto& s:entries)if(!same_instance(s.native,n))s.cancel();}
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/smg_placement.h b/Dawn/src/client/hooks/akimbo/smg_placement.h
new file mode 100644
index 0000000000000000000000000000000000000000..5e2232f70be33ca103c4ca0e4bd5060bdd0e2a59
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/smg_placement.h
@@ -0,0 +1,44 @@
+#pragma once
+#include "identity.h"
+#include "presentation.h"
+#include "smg_signals.h"
+
+namespace dawn::client::hooks::akimbo::smg_placement {
+using presentation::Frame;
+using presentation::Vec;
+inline float gap(std::uint32_t model) noexcept {
+    const auto* entry=profiles::find(model);
+    if(!entry||!smg_model(model))return 0;
+    if(profiles::legacy(model))return .36f;
+    return entry->gapMillimeters>=50&&entry->gapMillimeters<=800
+        ?static_cast<float>(entry->gapMillimeters)/1000.f:0;
+}
+// Geometry keeps the native pivot at0 and the copied pivot at+gap in weapon Y.
+// Generated full poses move their midpoint onto camera Y=0. Camera Z/depth and
+// the native animated rotation are preserved; each complete arm follows its gun.
+// The resident/procedural pass only mirrors grips and never applies placement.
+inline bool full_shift(std::uint32_t model,Frame native,Frame view,Vec& shift) noexcept {
+    shift={};const float width=gap(model);
+    if(!width||!presentation::valid(native))return false;
+    if(profiles::legacy(model)) {shift=presentation::rotate(native.q,{0,-.08f,0});return true;}
+    if(!presentation::valid(view))return false;
+    const auto camera=presentation::compose(view,native);
+    if(!std::isfinite(camera.p.y)||std::abs(camera.p.y)>1.5f)return false;
+    const auto cameraInverse=presentation::inverse(view);
+    const auto center=presentation::rotate(cameraInverse.q,{0,-camera.p.y/view.scale,0});
+    shift=presentation::add(center,presentation::rotate(native.q,{0,-width*native.scale*.5f,0}));
+    return std::isfinite(shift.x)&&std::isfinite(shift.y)&&std::isfinite(shift.z)
+        &&std::abs(shift.x)<2&&std::abs(shift.y)<2&&std::abs(shift.z)<2;
+}
+// The marker's deliberate shader signal multiplies its physical bone scale.
+// Validate the decoded physical frame for generated profiles; the root and all
+// other bones retain the original finite/unit-quaternion/near-unit-scale checks.
+inline bool valid_completed(std::uint32_t model,Frame frame,unsigned bone,float rootScale) noexcept {
+    if(!profiles::legacy(model)&&smg_model(model)&&bone==marker_bone(model)){
+        unsigned mask{};
+        if(!(rootScale>.95f&&rootScale<1.05f)||!smg::marker_mask(frame.scale/rootScale,mask))return false;
+        frame.scale/=smg::marker_scale(mask);
+    }
+    return presentation::valid(frame);
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/smg_signals.h b/Dawn/src/client/hooks/akimbo/smg_signals.h
new file mode 100644
index 0000000000000000000000000000000000000000..7351711bec586d21fd3b73c9f99986725342bd58
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/smg_signals.h
@@ -0,0 +1,15 @@
+#pragma once
+#include <cmath>
+
+namespace dawn::client::hooks::akimbo::smg {
+// Four exactly representable scales on the unweighted weapon bone3. The
+// private shaders decode the hand mask without new bones or vertex channels.
+inline constexpr float marker_base=1.03515625f,marker_step=1.f/512;
+inline constexpr float marker_scale(unsigned mask) noexcept {return marker_base+marker_step*(mask&3);}
+inline bool marker_mask(float value,unsigned& mask) noexcept {
+    if(!std::isfinite(value)||value<marker_base-.0001f||value>marker_scale(3)+.0001f)return false;
+    const auto code=static_cast<unsigned>((value-marker_base)/marker_step+.5f);
+    if(code>3||std::abs(value-marker_scale(code))>.0001f)return false;
+    mask=code;return true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/smg_tracer.h b/Dawn/src/client/hooks/akimbo/smg_tracer.h
new file mode 100644
index 0000000000000000000000000000000000000000..a32cdf51fb475b3088f9aa44df55887fda4dcdca
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/smg_tracer.h
@@ -0,0 +1,64 @@
+#pragma once
+#include "firing_effects.h"
+
+namespace dawn::client::hooks::akimbo::smg_tracer {
+using presentation::Frame;
+using presentation::Vec;
+using effects::read;
+inline bool point(Vec v) noexcept {
+    return std::isfinite(v.x)&&std::isfinite(v.y)&&std::isfinite(v.z)
+        &&std::abs(v.x)<1000000&&std::abs(v.y)<1000000&&std::abs(v.z)<1000000;
+}
+inline bool within_distance(Vec a,Vec b,float radius) noexcept {
+    const auto d=presentation::add(a,presentation::mul(b,-1));
+    return point(a)&&point(b)&&d.x*d.x+d.y*d.y+d.z*d.z<=radius*radius;
+}
+// B0 is the world camera frame; 70 is the native eye offset. Their
+// composition with the completed gun agrees with the native world muzzle
+// in the C4 VM_READ capture. gun already includes its private placement.
+inline bool muzzle(const Memory& m,const Identity& id,Frame gun,Vec& out) noexcept {
+    Frame view{},camera{};
+    if(!smg_model(id.modelTag)||!presentation::valid(gun)
+        ||!read(m,id.controller+0x70,view)||!presentation::valid(view)
+        ||!read(m,id.controller+0xb0,camera)||!point(camera.p))return false;
+    Frame localCamera=camera;localCamera.p={};
+    if(!presentation::valid(localCamera))return false;
+    Frame local=firing_effects::ikelosMuzzle;
+    if(!profiles::legacy(id.modelTag)){
+        const auto* registration=profiles::find(id.modelTag);if(!registration)return false;
+        local=std::bit_cast<Frame>(registration->visual.muzzle);if(!effects::local_attachment(local))return false;
+    }
+    const auto world=presentation::compose(presentation::compose(camera,view),presentation::compose(gun,local));
+    if(!within_distance(world.p,camera.p,3)||!still_current(m,id))return false;
+    out=world.p;return true;
+}
+struct Scope {Identity identity{};Vec muzzle{};std::uint64_t at{};unsigned side{};bool ready{};};
+struct Patch {std::uintptr_t address{};Vec before{},after{};};
+// CF2380 initializes each native projectile, including pooled reuse. Its
+// +180 point feeds CE1FC0 -> 58CF60 (visual FX parameter12). CE1FC0 blends
+// the visual offset away as the bullet travels. +100, instance transforms,
+// velocity, collision results and the native creation packet stay untouched.
+inline bool prepare(const Memory& m,std::uintptr_t projectile,const Scope& scope,
+                    std::uint64_t now,Patch& out) noexcept {
+    out={};hud::detail::Header h{},after{};unsigned firingOwner{};
+    std::array<float,4> visual{},physical{};unsigned char enabled{},count{};
+    unsigned tracerTag=0x8152c7f4,tracerDefinition=6064;
+    if(!profiles::legacy(scope.identity.modelTag)){
+        const auto* registration=profiles::find(scope.identity.modelTag);if(!registration)return false;
+        tracerTag=registration->visual.tracerTag;tracerDefinition=registration->visual.tracerDefinition;
+    }
+    if(!scope.ready||!smg_model(scope.identity.modelTag)||(scope.side!=1&&scope.side!=2)
+        ||now<scope.at||now-scope.at>100||!point(scope.muzzle)
+        ||!hud::detail::header(m,projectile,h)||h.tag!=tracerTag||h.kind!=0x8080388f
+        ||h.definition!=tracerDefinition||h.owner==scope.identity.modelOwner
+        ||!read(m,projectile+0x11c,firingOwner)||firingOwner!=scope.identity.modelOwner
+        ||!read(m,projectile+0x190,enabled)||enabled!=1
+        ||!read(m,projectile+0x1c0,count)||count!=1
+        ||!read(m,projectile+0x180,visual)||visual[3]!=1
+        ||!read(m,projectile+0x100,physical)||physical[3]!=1)return false;
+    const Vec before{visual[0],visual[1],visual[2]},ray{physical[0],physical[1],physical[2]};
+    if(!within_distance(before,scope.muzzle,2)||!within_distance(ray,scope.muzzle,3)
+        ||!still_current(m,scope.identity)||!hud::detail::header(m,projectile,after)||after!=h)return false;
+    out={projectile+0x180,before,scope.muzzle};return true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/sturm_drang.cpp b/Dawn/src/client/hooks/akimbo/sturm_drang.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f4fb17f2f173681085b936b999aa5057547dcccd
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/sturm_drang.cpp
@@ -0,0 +1,367 @@
+// Sturm & Drang Akimbo S1: the runtime side of the S&D driver (design-firing S1
+// + design-ammo P0, INTEGRATION-S1 rulings 1-14). The logic lives in the pure,
+// tested headers (sturm_drang_firing.h, sturm_drang_ammo.h, sturm_drang_driver.h);
+// this file binds them to the game:
+//  - RuntimeNative: the driver's native side. Reads: checked_read and
+//    discovery::Reader<CheckedMemory> only (ruling 2). Calls (guarded by the S&D
+//    groups, sturm_drang_guards.h): A1F4C0 collector, CB3FC0 rate, CC29C0
+//    disabled, CB1710 can-fire (diagnostic group), CCA120 spend, CAEB50 add,
+//    CC7BF0 set reserve and 3F9030 publish (ammo group, CC7BF0 through its
+//    guarded call sites as the baseline does), CBCD00 reserve (baseline guard),
+//    CB75F0 FX (fx group); the trampolines nextFiring / nextMagazine /
+//    nextCapacity (never the hooks: no recursion, no pairing).
+//  - RuntimeEnv: the input pass's side (343C30 mouse sample, the pump, the
+//    active-weapon reads, the trigger and cache publication under SRW locks
+//    that are never held across a native call: runtime::LockScope).
+//  - The observers (firing_hook's S&D branch, projectile_init_hook,
+//    magazine_hook, the damage feed).
+#include "sturm_drang.h"
+#include "akimbo.h"
+#include "sturm_drang_driver.h"
+#include "sturm_drang_memory.h"
+#include "../../../core/logging/log.h"
+#include <Windows.h>
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#pragma comment(lib,"user32.lib")   // GetCursorInfo (the press's cursor evidence)
+
+namespace dawn::client::hooks::akimbo::sturm_drang {
+namespace {
+using Collect=std::int32_t(__fastcall*)(void*,std::int32_t,void*,void*,const std::uint32_t*,bool);   // A1F4C0
+using Rate=float(__fastcall*)(void*);                                                               // CB3FC0
+using RootBool=bool(__fastcall*)(void*);                                                            // CC29C0
+using CanFire=bool(__fastcall*)(void*,std::int32_t);                                                // CB1710
+using Consume=void(__fastcall*)(void*,std::int32_t);                                                // CCA120
+using AddRounds=std::int32_t(__fastcall*)(void*,std::int32_t,bool);                                 // CAEB50
+using SetReserve=std::int64_t(__fastcall*)(void*,int);                                              // CC7BF0
+using Publish=void(__fastcall*)(std::uint32_t);                                                     // 3F9030
+using FxPost=void(__fastcall*)(void*,std::int32_t,const void*);                                     // CB75F0
+using MouseSample=std::uintptr_t(__fastcall*)();                                                    // 343C30
+inline constexpr std::uintptr_t rvaCollect=0xa1f4c0,rvaRate=0xcb3fc0,rvaDisabled=0xcc29c0,rvaCanFire=0xcb1710,
+    rvaConsume=0xcca120,rvaAdd=0xcaeb50,rvaSetReserve=0xcc7bf0,rvaPublish=0x3f9030,rvaFx=0xcb75f0,rvaReserve=0xcbcd00,
+    rvaMouse=0x343c30,rvaMouseA=0x2420130,rvaMouseB=0x242c8c0,rvaKey13d0=0x2092a88,rvaKey1320=0x1fa01d0;
+inline constexpr std::uintptr_t fireReturn=0xcb4a9e,projectileCallerA=0xcf0dde,projectileCallerB=0xcf21cc,hudCallerA=0xcbdc05,hudCallerB=0xcbba47;
+
+NativeApi api{};
+std::atomic<double> clockScale{};
+double seconds() noexcept {
+    LARGE_INTEGER c{};return QueryPerformanceCounter(&c)!=FALSE?static_cast<double>(c.QuadPart)*clockScale.load(std::memory_order_relaxed):0.0;
+}
+void write_line(LogLevel level,const char* text) noexcept {
+    core::log::write(core::log::Channel::client,level==LogLevel::warn?core::log::Level::warn:core::log::Level::info,text);
+}
+Shared shared{};
+// The trigger and the cache, published by the input pass (main thread) and
+// copied by the driver. The locks guard plain copies only (LockScope marks them).
+SRWLOCK inputLock=SRWLOCK_INIT,cacheLock=SRWLOCK_INIT;
+Trigger publishedTrigger{};
+std::uint64_t publishedGeneration{};
+discovery::Snapshot publishedCache{};
+// The emission scope (design-firing 6.1): projectile_init_hook on the emitting thread.
+struct ShotScope {Observation obs{};};
+thread_local ShotScope* shotScope{};
+
+template<class F> F native(std::uintptr_t rva) noexcept {return reinterpret_cast<F>(api.base+rva);}
+discovery::Reader<CheckedMemory> reader(CheckedMemory& m) noexcept {return discovery::Reader<CheckedMemory>(m,api.base);}
+
+struct RuntimeNative {
+    CheckedMemory memory{};
+    runtime::DriverThread* pinned{};
+    [[nodiscard]] double now() const noexcept {return seconds();}
+    [[nodiscard]] std::uint32_t thread() const noexcept {return GetCurrentThreadId();}
+    [[nodiscard]] bool native_allowed() const noexcept {return api.base!=0&&runtime::native_call_allowed();}
+    runtime::Session& session() const noexcept {return runtime::session();}
+    Signals& signals() const noexcept {return sturm_drang::signals();}
+    AkimboSturmDrangFiringCounters& firing() const noexcept {return firing_counters();}
+    AkimboSturmDrangAmmoCounters& ammo() const noexcept {return ammo_counters();}
+    void log(LogLevel level,const char* text) const noexcept {write_line(level,text);}
+    bool cache(std::uint64_t generation,discovery::Snapshot& out) const noexcept {
+        const runtime::LockScope held;
+        AcquireSRWLockShared(&cacheLock);
+        const bool ok=generation&&publishedGeneration==generation;if(ok)out=publishedCache;
