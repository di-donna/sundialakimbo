+template<class Read> unsigned check(Read&& read,std::uintptr_t base) noexcept {
+    unsigned failed=0;
+    for(const auto& s:sites){
+        std::array<std::uint8_t,96> actual{};
+        if(s.length==0||s.length>actual.size()||!read(base+s.rva,actual.data(),static_cast<std::size_t>(s.length))
+            ||std::memcmp(actual.data(),s.bytes.data(),s.length)!=0)failed|=bit(s.group);
+    }
+    std::array<std::uint8_t,16> row{};std::uint64_t target{};std::uint32_t message{},flags{};
+    if(!read(base+handlerRow.rva,row.data(),row.size()))failed|=bit(Group::driver);
+    else{
+        std::memcpy(&target,row.data(),8);std::memcpy(&message,row.data()+8,4);std::memcpy(&flags,row.data()+12,4);
+        if(target!=base+handlerRow.target||message!=handlerRow.message||flags!=handlerRow.flags)failed|=bit(Group::driver);
+    }
+    return allGroups&~failed;
+}
+// Groups whose sites every row lists (a table sanity check for the tests).
+inline constexpr unsigned listed() noexcept {unsigned m=0;for(const auto& s:sites)m|=bit(s.group);return m;}
+static_assert(listed()==allGroups,"every guard group has at least one site");
+}
+namespace dawn::client::hooks::akimbo::sturm_drang::runtime {
+// The whole install decision (tests-review F4), pure so the unit tests run it on
+// a synthetic image: the guard groups from the checked reader, the kill file
+// (present only when its path resolved), then plan(). akimbo.cpp's
+// sturm_drang_install() keeps only the file probe, the Detours attach and the log.
+struct InstallDecision {Plan plan{};unsigned groups{};bool killResolved{},killPresent{};};
+template<class Read> [[nodiscard]] InstallDecision install_plan(Read&& read,std::uintptr_t base,bool killResolved,bool killPresent) noexcept {
+    InstallDecision d{};
+    d.groups=guards::check(read,base);d.killResolved=killResolved;d.killPresent=killResolved&&killPresent;
+    d.plan=plan(kSturmDrang,d.groups,d.killPresent);
+    return d;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/sturm_drang_memory.h b/Dawn/src/client/hooks/akimbo/sturm_drang_memory.h
new file mode 100644
index 0000000000000000000000000000000000000000..f3e8a008d51279c2418c42d6cff8c75b4a2353f0
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/sturm_drang_memory.h
@@ -0,0 +1,52 @@
+#pragma once
+// Sturm & Drang Akimbo S1: the checked reader (INTEGRATION-S1 ruling 2; W4
+// review F1). Every S&D-specific read of game memory - the guard groups, the
+// discovery and its per-shot revalidation, the ammo pins, the export branch's
+// selector/clock words - is an exact-length ReadProcessMemory(GetCurrentProcess())
+// copy: no catch-all SEH memcpy (a guard page is never consumed, its protection
+// never changed), a partial copy is a failure, nothing is retried or "repaired".
+// W4's adversarial test is re-run on this code (sturm_drang_scaffold_tests).
+//
+// Handles are resolved only through the discovery Reader (sturm_drang_discovery.h:
+// pointer-width cell offsets, the whole pool span, pool metadata read twice),
+// never through hud::detail::resolve (W4 F5).
+#include <Windows.h>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace dawn::client::hooks::akimbo::sturm_drang {
+inline constexpr std::uintptr_t maxUserAddress=0x00007fffffffffffULL;
+// A non-empty range inside the user address space, without wrap-around.
+[[nodiscard]] inline constexpr bool readable_range(std::uintptr_t address,std::size_t size) noexcept {
+    return size!=0&&address>=0x10000&&address<=maxUserAddress&&size-1<=maxUserAddress-address;
+}
+// Totals for the diagnostics (relaxed; never a gate).
+struct ReadStats {std::atomic<std::uint64_t> reads{},faults{};};
+inline ReadStats readStats{};
+[[nodiscard]] inline bool checked_read(std::uintptr_t address,void* output,std::size_t size) noexcept {
+    readStats.reads.fetch_add(1,std::memory_order_relaxed);
+    SIZE_T copied=0;
+    if(!output||!readable_range(address,size)
+        ||ReadProcessMemory(GetCurrentProcess(),reinterpret_cast<LPCVOID>(address),output,size,&copied)==FALSE
+        ||copied!=size){
+        readStats.faults.fetch_add(1,std::memory_order_relaxed);return false;
+    }
+    return true;
+}
+template<class T> [[nodiscard]] bool checked_get(std::uintptr_t address,T& value) noexcept {
+    return checked_read(address,&value,sizeof(T));
+}
+// akimbo::Reader-shaped adapter (identity.h Memory), for S&D code that takes a Memory.
+[[nodiscard]] inline bool checked_reader(void*,std::uintptr_t address,void* output,std::size_t size) noexcept {
+    return checked_read(address,output,size);
+}
+// The discovery's Memory concept: read(address, out, size) and clock() (QPC ticks).
+struct CheckedMemory {
+    [[nodiscard]] bool read(std::uintptr_t address,void* output,std::size_t size) noexcept {return checked_read(address,output,size);}
+    [[nodiscard]] std::uint64_t clock() const noexcept {
+        LARGE_INTEGER counter{};
+        return QueryPerformanceCounter(&counter)!=FALSE?static_cast<std::uint64_t>(counter.QuadPart):0;
+    }
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/sturm_drang_pose.h b/Dawn/src/client/hooks/akimbo/sturm_drang_pose.h
new file mode 100644
index 0000000000000000000000000000000000000000..441fcbd3d92925e2deb135851895219c1b9a938c
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/sturm_drang_pose.h
@@ -0,0 +1,415 @@
+#pragma once
+// Sturm & Drang Akimbo (item 0xD7B8B759, private model 0x81A29A19, art v5c) on
+// the 80-bone hand-cannon rig: the left hand on Drang (design-hand.md with the
+// critique-hand fixes and the INTEGRATION-S1 rulings 6-9).
+//
+// Sturm (right) is 100 % native: root 72, its arm, recoil, reload and moving
+// parts are never written. Drang (left) is the flagged copy the family-D
+// single-marker vertex shader draws from weapon bone 5 (full-pose bone 77):
+// scale code 1.03515625+mask/512 (smg_signals.h); mask bit 0 = Drang's magazine
+// (lane 2 -> p[74]) and slide (lane 6 -> p[78]) follow those bones relative to
+// root 72, clear = at bind on Drang. The copy body is drawn at marker o S with
+// S = the art's spacing (0, 0.18999924, 0) (rat_king_pose::pairSpacing).
+//
+// Per mode-4 frame (correct_export has already mirrored the right arm onto the
+// static pair's Drang, align_sturm_drang_pose):
+//  1. quiet left root while Sturm's own action plays (fire 66/68, reload 59, the
+//     same clips by clock signature, or < 0.8 s after a Sturm shot): Thorn's
+//     neutral hold relative to common root 0 with the calibrated idle
+//     articulation; released after 100 ms of idle over a 120 ms smoothstep,
+//     at once on an interrupt (draw/put-away/sprint);
+//  2. Drang's kick: Rat King's sidearm kick (rat_king_pose::Kick, kick_frame,
+//     kick_arm), left only - the single kick owner (ruling 7), fed by the
+//     firing driver's "Drang fired" signal;
+//  3. Drang's reload: the left gun and arm lowered by h(u) x 1.15 m, u the
+//     phase the ammo side publishes; h(u) == 0 exactly from u >= 0.80 (ruling 8,
+//     before Drang is fire-ready at 0.85);
+//  4. Drang's slide cycle (mask bit 0), behind DAWN_STURM_DRANG_SLIDE;
+//  5. the marker p[77] = leftGun o S^-1 (critique-hand fix 1 / ruling 9), so a
+//     drangGripOffset moves the drawn gun and gun_sample() reports the gun drawn.
+// The marker is written on every mode-4 frame (mask 0 when nothing moves), so
+// Drang never follows Sturm's clip on bones 74/78. On any refused frame the
+// shader draws the static pair; the mirrored hand is exactly on it.
+//
+// Caller (akimbo.cpp export_hook) serializes State under alternatingLock. No
+// allocation, no OS call, no game-memory read: the only input is the export
+// buffer and Input (a Signals snapshot). Times are precise_seconds() (QPC).
+#include "alternating.h"
+#include "rat_king_pose.h"
+#include "smg_signals.h"
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+namespace dawn::client::hooks::akimbo::sturm_drang {
+using presentation::ActionClock;
+using presentation::Frame;
+using presentation::Vec;
+using presentation::add;
+using presentation::blend;
+using presentation::compose;
+using presentation::inverse;
+using presentation::mul;
+using presentation::rotate;
+using presentation::smoothstep;
+using presentation::valid;
+
+inline constexpr std::uint32_t model=0x81a29a19u;
+static_assert(sturm_drang_model(model)&&separated_model(model)&&single_marker_model(model)&&!alternating_model(model)
+    &&!alternating_firing(model)&&!smg_model(model)&&!sidearm_model(model)&&rig_class(model)==RigClass::handCannon
+    &&pose_bones(model)==80&&marker_bone(model)==77);
+inline constexpr unsigned bones=80,rootBone=72,markerBone=77,magazineBone=74,slideBone=78,leftGripBone=23,armBones=22;
+static_assert(markerBone==marker_bone(model)&&alternating::leftArm[4]==leftGripBone);
+inline constexpr unsigned leftMoves=1;   // mask bit 0: Drang's parts; bit 1 is unused (no Sturm vertex uses the patched VS)
+// Weapon-local binds of 80B9EAD2 locals 2 and 6 (design-hand 1.4; local 5 is
+// alternating::weaponBind5). The tests decode all three from the file.
+inline constexpr Frame weaponBind2{{.5f,.5f,.5f,.5f},{.1506765187f,.0001507335546f,.08052873611f},1};
+inline constexpr Frame weaponBind6{{.5000000596f,.5000001192f,.4999999404f,.4999998808f},{.09887924554f,-.0001468947737f,.118344659f},1};
+// Sturm's selectors on the HC rig (actions.json; idle 65 VERIFIED in the S&D dump).
+inline constexpr unsigned actionIdle=65,actionIdleAim=79,actionFire=66,actionFireAds=68,actionReload=59,
+    actionDraw=67,actionPutAway=78,actionSprintEnter=74,actionSprintLoop=42,actionSprintExit=75;
+inline constexpr double sturmFireClipSeconds=.8;                    // clip 80BC8679
+// Clock signatures (critique-hand 2.2): the same clips when a selector is not
+// the evaluator's; clock.base == selector and its duration within tolerance.
+inline constexpr float fireClipSeconds=.8f,fireClipTolerance=.02f,reloadClipSeconds=3.667f,reloadClipTolerance=.05f;
+inline constexpr double isolationIdleSeconds=.1,isolationReleaseSeconds=.12; // Thorn (alternating.h)
+inline constexpr float quietMaxMeters=.5f;          // Thorn's .25 m^2 displacement guard (fire)
+inline constexpr float quietReloadMaxMeters=1.2f;   // critique-hand 2.3: Sturm's reload clip, the mirror's reach
+inline constexpr float reloadDropMeters=1.15f;      // IKELOS smg.h
+// Ruling 8: one reload curve, hand-owned, driven by the ammo side's u (phase of
+// Drang's reload D): down over [.08,.20], up over [.64,.80], exactly 0 from .80
+// on (Drang is fire-ready at .85 D; the refill is at .50 D).
+inline constexpr float reloadDownStart=.08f,reloadDownSpan=.12f,reloadUpStart=.64f,reloadUpSpan=.16f;
+inline constexpr float reloadUpAt=.80f;
+static_assert(reloadUpStart+reloadUpSpan<=reloadUpAt&&reloadUpAt<.85f);
+// Slide cycle switch (critique-hand 2.4): 0 compiles it out; mask stays 0.
+#ifndef DAWN_STURM_DRANG_SLIDE
+#define DAWN_STURM_DRANG_SLIDE 1
+#endif
+inline constexpr bool slideCycle=DAWN_STURM_DRANG_SLIDE!=0;
+inline constexpr float slideTravelMeters=.02f;                       // [C]
+inline constexpr double slideBackSeconds=.025,slideReturnSeconds=.07;  // < .2 s (Drang 300 RPM)
+// A shot time stamped by another thread may be read a little after `now`.
+inline constexpr double shotFutureSeconds=.05;
+// Ruling 12 cross-check: a Drang shot within onsetWindow of a native Sturm fire
+// onset, with no Sturm shot within onsetSettle of that onset, is a conflict.
+inline constexpr double onsetWindowSeconds=.05,onsetSettleSeconds=.1;
+// Drang in the (mirrored Thorn) left hand, Drang weapon-local: identity = the
+// art's spacing. A [C] fit knob: it moves the drawn gun (and gun_sample), never
+// the hand. The define exists for the offline offset test (a non-identity knob).
+#ifndef DAWN_STURM_DRANG_GRIP_OFFSET
+#define DAWN_STURM_DRANG_GRIP_OFFSET Frame{}
+#endif
+inline constexpr Frame drangGripOffset=DAWN_STURM_DRANG_GRIP_OFFSET;
+
+inline bool idle_action(unsigned a) noexcept {return a==actionIdle||a==actionIdleAim;}
+inline bool own_action(unsigned a) noexcept {return a==actionFire||a==actionFireAds||a==actionReload;}
+inline bool interrupt_action(unsigned a) noexcept {
+    return a==actionDraw||a==actionPutAway||a==actionSprintEnter||a==actionSprintLoop||a==actionSprintExit;
+}
+inline bool known_action(unsigned a) noexcept {return idle_action(a)||own_action(a)||interrupt_action(a);}
+inline bool fire_signature(unsigned a,ActionClock c) noexcept {
+    return !idle_action(a)&&!interrupt_action(a)&&c.base==a&&std::isfinite(c.duration)&&std::abs(c.duration-fireClipSeconds)<fireClipTolerance;
+}
+inline bool reload_signature(unsigned a,ActionClock c) noexcept {
+    return !idle_action(a)&&!interrupt_action(a)&&c.base==a&&std::isfinite(c.duration)&&std::abs(c.duration-reloadClipSeconds)<reloadClipTolerance;
+}
+// Gameplay-review F2: what Sturm's latest selector allows Drang to do. The
+// export path publishes it every S&D mode-4 frame (Signals::publish_state); the
+// driver refuses a Drang shot while it is fresh (<= 100 ms) and blocked (draw,
+// put-away, sprint) or unknown (melee, finishers, anything outside the known S&D
+// set). reloading (Sturm's own reload, by selector or clock signature) keeps
+// Drang free: Sturm's CC29C0 "disabled" is then logged only (independent guns).
+enum class SturmState : unsigned char {none,ready,reloading,blocked,unknown};
+inline SturmState sturm_state(unsigned a,ActionClock c) noexcept {
+    if(interrupt_action(a))return SturmState::blocked;
+    if(a==actionReload||reload_signature(a,c))return SturmState::reloading;
+    if(idle_action(a)||own_action(a)||fire_signature(a,c))return SturmState::ready;
+    return SturmState::unknown;
+}
+inline constexpr const char* sturm_state_name(SturmState s) noexcept {
+    return s==SturmState::ready?"ready":s==SturmState::reloading?"reloading":s==SturmState::blocked?"blocked":s==SturmState::unknown?"unknown":"none";
+}
+struct StateView {SturmState state{};unsigned action{~0U};double at{-1e9};};
+// h(u): the lowering weight of Drang's reload. 0 when not reloading, for a
+// non-finite u, before .08 and from .80 on (exactly).
+inline float drang_hidden(bool active,float u) noexcept {
+    if(!active||!std::isfinite(u)||u<=reloadDownStart||u>=reloadUpAt)return 0;
+    return smoothstep((u-reloadDownStart)/reloadDownSpan)*(1-smoothstep((u-reloadUpStart)/reloadUpSpan));
+}
+// Gameplay-review F6: Sturm's own unflagged vertices read p[74]/p[78] too, so the
+// slide cycle writes them only while they rest at bind (1 mm, 1 degree): a Drang
+// shot during Sturm's reload or fire clip never freezes Sturm's parts at bind.
+inline bool at_bind(const Frame& f,const Frame& bind) noexcept {
+    const float dx=f.p.x-bind.p.x,dy=f.p.y-bind.p.y,dz=f.p.z-bind.p.z;
+    const float dot=std::fabs(f.q.x*bind.q.x+f.q.y*bind.q.y+f.q.z*bind.q.z+f.q.w*bind.q.w);
+    return dx*dx+dy*dy+dz*dz<=1e-6f&&dot>=.99996192f;   // cos(0.5 deg): 1 degree between the rotations
+}
+inline float slide_response(double age) noexcept {
+    if(!(age>=0)||age>=slideBackSeconds+slideReturnSeconds)return 0;
+    if(age<slideBackSeconds)return smoothstep(static_cast<float>(age/slideBackSeconds));
+    return 1-smoothstep(static_cast<float>((age-slideBackSeconds)/slideReturnSeconds));
+}
+
+// ---- Ruling 6: the ONE shared input -------------------------------------------
+// sturmShotAt / drangShotAt: the latest confirmed native Sturm emission / DLL
+// Drang emission (precise_seconds()); drangReloading / drangReloadU: Drang's
+// reload and its phase u = elapsed / D (ammo owns u); attached: Drang is in the
+// hand (reserved for the P1 throw; S1 always true). The hand reads it as one
+// snapshot in the export path.
+struct Input {double sturmShotAt{-1e9},drangShotAt{-1e9};bool drangReloading{};float drangReloadU{};bool attached{true};};
+// The firing/ammo side only publishes these atomics (any thread, lock-free,
+// never under an akimbo lock); the export branch takes snapshot().
+class Signals {
+    static constexpr std::uint64_t reloadingBit=1ULL<<32,attachedBit=1ULL<<33;
+    std::atomic<double> sturm_{-1e9},drang_{-1e9};
+    std::atomic<std::uint64_t> reload_{attachedBit};
+    // The drawn left gun in Sturm's weapon-root frame (builder 2): a seqlock over
+    // atomic words, one writer (export_hook under alternatingLock), lock-free
+    // readers (the H1 driver's left origin, design-firing 5.3).
+    // Words 8..11: the world camera rotation (controller+0xB0) of the same frame,
+    // word 12 its validity (gameplay-review F2: the shot line's aim_delta_deg).
+    std::atomic<std::uint64_t> leftSeq_{};
+    std::array<std::atomic<std::uint32_t>,13> leftWords_{};
+    std::atomic<double> leftAt_{-1e9};
+    // S2 decision 4: the aim frame of the latest S&D export frame (q = the world
+    // camera rotation, p = the view origin camera o eye), a seqlock like the left
+    // frame, published every S&D mode-4 frame whose camera and eye read (the hand
+    // layer's own writes are not needed for it).
+    std::atomic<std::uint64_t> aimSeq_{};
+    std::array<std::atomic<std::uint32_t>,8> aimWords_{};
+    std::atomic<double> aimAt_{-1e9};
+    // Sturm's latest selector and its class (gameplay-review F2), one word + its time.
+    std::atomic<std::uint64_t> state_{};
+    std::atomic<double> stateAt_{-1e9};
+    static void raise(std::atomic<double>& a,double t) noexcept {
+        double old=a.load(std::memory_order_relaxed);
+        while(t>old&&!a.compare_exchange_weak(old,t,std::memory_order_release,std::memory_order_relaxed)){}
+    }
+public:
+    static_assert(std::atomic<double>::is_always_lock_free&&std::atomic<std::uint64_t>::is_always_lock_free);
+    // A confirmed native Sturm emission (firing_hook, after the original returned true).
+    void sturm_fired(double at) noexcept {if(std::isfinite(at))raise(sturm_,at);}
+    // Ruling 7: THE "Drang fired" signal, once per confirmed Drang emission. The
+    // hand turns it into the one kick and the slide cycle.
+    void drang_fired(double at) noexcept {if(std::isfinite(at))raise(drang_,at);}
+    // Drang's reload state and phase (u clamped to [0,1], non-finite -> 0), one word.
+    void reload(bool reloading,float u,bool attached=true) noexcept {
+        if(!std::isfinite(u))u=0;
+        u=std::clamp(u,0.f,1.f);
+        reload_.store(std::bit_cast<std::uint32_t>(u)|(reloading?reloadingBit:0)|(attached?attachedBit:0),std::memory_order_release);
+    }
+    [[nodiscard]] Input snapshot() const noexcept {
+        const auto r=reload_.load(std::memory_order_acquire);
+        return {sturm_.load(std::memory_order_acquire),drang_.load(std::memory_order_acquire),(r&reloadingBit)!=0,
+                std::bit_cast<float>(static_cast<std::uint32_t>(r&0xffffffffULL)),(r&attachedBit)!=0};
+    }
+    // leftInRight = inverse(root 72) o leftGun of the last written frame, at its
+    // precise_seconds() time. Only the export path writes it (single writer).
+    void publish_left(const Frame& leftInRight,double at,const presentation::Quat* camera=nullptr) noexcept {
+        static_assert(sizeof(Frame)==32&&sizeof(presentation::Quat)==16);
+        if(!valid(leftInRight)||!std::isfinite(at))return;
+        std::array<std::uint32_t,13> words{};std::memcpy(words.data(),&leftInRight,sizeof(Frame));
+        if(camera){std::memcpy(words.data()+8,camera,sizeof(*camera));words[12]=1;}
+        const auto seq=leftSeq_.load(std::memory_order_relaxed);
+        leftSeq_.store(seq+1,std::memory_order_relaxed);
+        std::atomic_thread_fence(std::memory_order_release);
+        for(unsigned i=0;i<words.size();++i)leftWords_[i].store(words[i],std::memory_order_relaxed);
+        leftAt_.store(at,std::memory_order_relaxed);
+        leftSeq_.store(seq+2,std::memory_order_release);
+    }
+    // A consistent copy, or false (nothing published yet, or a writer kept racing).
+    [[nodiscard]] bool left(Frame& leftInRight,double& at,presentation::Quat* camera=nullptr,bool* cameraValid=nullptr) const noexcept {
+        for(unsigned attempt=0;attempt<4;++attempt){
+            const auto before=leftSeq_.load(std::memory_order_acquire);
+            if(!before||(before&1U))continue;
+            std::array<std::uint32_t,13> words{};
+            for(unsigned i=0;i<words.size();++i)words[i]=leftWords_[i].load(std::memory_order_relaxed);
+            const double t=leftAt_.load(std::memory_order_relaxed);
+            std::atomic_thread_fence(std::memory_order_acquire);
+            if(leftSeq_.load(std::memory_order_relaxed)!=before)continue;
+            std::memcpy(&leftInRight,words.data(),sizeof(Frame));at=t;
+            if(camera)std::memcpy(camera,words.data()+8,sizeof(*camera));
+            if(cameraValid)*cameraValid=words[12]!=0;
+            return true;
+        }
+        return false;
+    }
+    // S2: the aim frame (single writer: the export path). Rotation unit, position finite.
+    void publish_aim(const Frame& aim,double at) noexcept {
+        const float n=aim.q.x*aim.q.x+aim.q.y*aim.q.y+aim.q.z*aim.q.z+aim.q.w*aim.q.w;
+        if(!(n>.96f&&n<1.04f)||!std::isfinite(aim.p.x)||!std::isfinite(aim.p.y)||!std::isfinite(aim.p.z)||!std::isfinite(at))return;
+        std::array<std::uint32_t,8> words{};std::memcpy(words.data(),&aim,sizeof(Frame));
+        const auto seq=aimSeq_.load(std::memory_order_relaxed);
+        aimSeq_.store(seq+1,std::memory_order_relaxed);
+        std::atomic_thread_fence(std::memory_order_release);
+        for(unsigned i=0;i<words.size();++i)aimWords_[i].store(words[i],std::memory_order_relaxed);
+        aimAt_.store(at,std::memory_order_relaxed);
+        aimSeq_.store(seq+2,std::memory_order_release);
+    }
+    [[nodiscard]] bool aim(Frame& out,double& at) const noexcept {
+        for(unsigned attempt=0;attempt<4;++attempt){
+            const auto before=aimSeq_.load(std::memory_order_acquire);
+            if(!before||(before&1U))continue;
+            std::array<std::uint32_t,8> words{};
+            for(unsigned i=0;i<words.size();++i)words[i]=aimWords_[i].load(std::memory_order_relaxed);
+            const double t=aimAt_.load(std::memory_order_relaxed);
+            std::atomic_thread_fence(std::memory_order_acquire);
+            if(aimSeq_.load(std::memory_order_relaxed)!=before)continue;
+            std::memcpy(&out,words.data(),sizeof(Frame));at=t;return true;
+        }
+        return false;
+    }
+    // Sturm's selector class of the latest S&D mode-4 frame (the export path, one writer).
+    void publish_state(unsigned action,SturmState state,double at) noexcept {
+        if(!std::isfinite(at))return;
+        state_.store(static_cast<std::uint64_t>(action)|static_cast<std::uint64_t>(state)<<32,std::memory_order_relaxed);
+        stateAt_.store(at,std::memory_order_release);
+    }
+    [[nodiscard]] StateView state() const noexcept {
+        const double at=stateAt_.load(std::memory_order_acquire);const auto w=state_.load(std::memory_order_relaxed);
+        return {static_cast<SturmState>(w>>32),static_cast<unsigned>(w&0xffffffffULL),at};
+    }
+    void reset() noexcept {
+        sturm_.store(-1e9,std::memory_order_release);drang_.store(-1e9,std::memory_order_release);
+        reload_.store(attachedBit,std::memory_order_release);
+        leftSeq_.store(0,std::memory_order_release);leftAt_.store(-1e9,std::memory_order_release);
+        aimSeq_.store(0,std::memory_order_release);aimAt_.store(-1e9,std::memory_order_release);
+        state_.store(0,std::memory_order_relaxed);stateAt_.store(-1e9,std::memory_order_release);
+    }
+};
+inline Signals& signals() noexcept {static Signals s{};return s;}
+
+struct Report {
+    bool written{},isolated{},started{},releasing{},rest{},kick{},slide{},slideSkipped{},lowered{},reset{},rejected{},signature{},unknown{},onsetConflict{};
+    unsigned mask{},action{},base{};float weight{};
+};
+// Pose-space frames of the last written frame (the right gun = native root 72,
+// the left = Drang as drawn: quiet, kick and lowering included).
+struct Sample {Identity identity{};double at{-1};Frame right{},left{};};
+struct State {
+    Identity identity{};
+    rat_king_pose::Kick kick{};
+    double drangSeen{-1e9},lastLeftShot{-1e9},releaseAt{-1},lastNow{-1e9},onsetAt{-1e9},probeShot{-1e9};
+    unsigned lastAction{~0U};
+    bool drawing{},ready{},isolated{},probing{};float weight{};
+    Frame neutral{},leftGrip{};std::array<Frame,armBones> leftRest{};
+    Sample sample{};
+    // drangSeen survives a reset: a Drang shot published before a draw or an
+    // identity change never kicks the new identity.
+    void reset(const Identity& id) noexcept {const double seen=drangSeen;*this={};identity=id;drangSeen=seen;}
+    void select(const Identity& id) noexcept {if(id!=identity)reset(id);}
+    // The firing/FX muzzle source: fresh (<= 100 ms) pose-space gun frames.
+    bool gun_sample(const Identity& id,double now,Frame& right,Frame& left) const noexcept {
+        if(sample.identity!=id||!(sample.at>=0)||now<sample.at||now-sample.at>.1)return false;
+        right=sample.right;left=sample.left;return valid(right)&&valid(left);
+    }
+    bool pose(const Identity& id,void* data,unsigned mode,unsigned action,ActionClock clock,double now,
+              const Input& in,Report& r) noexcept {
+        r={};r.action=action;r.base=clock.base;select(id);
+        if(!sturm_drang_model(id.modelTag)||mode!=4||!data||!std::isfinite(now))return false;
+        if(now<lastNow){r.rejected=true;return false;}
+        std::array<Frame,bones> p{};std::memcpy(p.data(),data,sizeof(p));
+        for(const auto& f:p)if(!valid(f)){r.rejected=true;return false;}
+        const bool draw=action==actionDraw;
+        if(draw&&!drawing){reset(id);r.reset=true;}
+        drawing=draw;lastNow=now;
+        // Ruling 12 cross-check: native Sturm fire onsets vs Drang shots.
+        const bool fireNow=action==actionFire||action==actionFireAds,fireBefore=lastAction==actionFire||lastAction==actionFireAds;
+        if(fireNow&&!fireBefore)onsetAt=now;
+        lastAction=action;
+        const auto settle=[&](bool force) noexcept {
+            if(!probing||(!force&&now-probeShot<onsetSettleSeconds))return;
+            probing=false;
+            if(std::abs(onsetAt-probeShot)<=onsetWindowSeconds&&!(std::abs(in.sturmShotAt-onsetAt)<=onsetSettleSeconds))r.onsetConflict=true;
+        };
+        settle(false);
+        // Consume the Drang-fired signal: the one kick (ruling 7) and the slide.
+        if(std::isfinite(in.drangShotAt)&&in.drangShotAt>drangSeen&&in.drangShotAt<=now+shotFutureSeconds){
+            settle(true);
+            drangSeen=in.drangShotAt;lastLeftShot=in.drangShotAt;probing=true;probeShot=in.drangShotAt;
+            if(in.attached)kick.add_shot(true,in.drangShotAt);   // design-ammo 5: a detached gun never kicks
+        }
+        const Frame native=p[rootBone];
+        const bool idle=idle_action(action),interrupt=interrupt_action(action);
+        const bool fireSignature=fire_signature(action,clock),reloadSignature=reload_signature(action,clock);
+        const bool reloading=action==actionReload||reloadSignature;
+        const double shotAt=in.sturmShotAt;
+        const bool recentShot=std::isfinite(shotAt)&&shotAt<=now+shotFutureSeconds&&now-shotAt<sturmFireClipSeconds;
+        const bool own=!interrupt&&(own_action(action)||fireSignature||reloadSignature||recentShot);
+        r.signature=!own_action(action)&&(fireSignature||reloadSignature);
+        r.unknown=!known_action(action);
+        // 1. Isolation weight: 1 at once on Sturm's own action; release as Thorn.
+        if(own){r.started=!isolated;isolated=true;releaseAt=-1;weight=1;}
+        else if(isolated){
+            if(releaseAt<0)releaseAt=now+(idle?isolationIdleSeconds:0.0);
+            weight=now<releaseAt?1.f:1-smoothstep(static_cast<float>((now-releaseAt)/isolationReleaseSeconds));
+            r.releasing=true;
+            if(weight<=0){isolated=false;weight=0;releaseAt=-1;}
+        }
+        // 2. Calibration on quiet idle frames (Thorn alternating.h).
+        if(idle&&!isolated){
+            neutral=compose(inverse(p[0]),native);leftGrip=compose(inverse(native),p[leftGripBone]);
+            const Frame back=inverse(p[leftGripBone]);
+            for(unsigned i=0;i<armBones;++i)leftRest[i]=compose(back,p[alternating::leftArm[i]]);
+            ready=true;
+        }
+        if(isolated&&!ready){
+            neutral=alternating::restNeutral;leftGrip=alternating::restLeftGrip;leftRest=alternating::restLeftArm;
+            ready=true;r.rest=true;
+        }
+        // 3. The left (marker) root and arm: the quiet blend (Thorn, left side; no ADS alignment: S&D has no ADS).
+        Frame leftRoot=native;
+        if(weight>0){
+            leftRoot=blend(native,compose(p[0],neutral),weight);
+            const Vec d=add(leftRoot.p,mul(native.p,-1));
+            const float guard=reloading?quietReloadMaxMeters:quietMaxMeters;
+            if(d.x*d.x+d.y*d.y+d.z*d.z>guard*guard){r.rejected=true;return false;}
+            const Frame target=compose(leftRoot,blend(compose(inverse(native),p[leftGripBone]),leftGrip,weight));
+            const Frame delta=compose(target,inverse(p[leftGripBone]));
+            for(unsigned i=0;i<armBones;++i){const auto b=alternating::leftArm[i];
+                p[b]=blend(compose(delta,p[b]),compose(target,leftRest[i]),weight);}
+        }
+        Frame leftGun=compose(compose(leftRoot,rat_king_pose::pairSpacing),drangGripOffset);
+        // 4. Drang's kick (the Rat King sidearm kick, left only).
+        if(const float a=kick.amount(true,now);a>0){
+            const Frame kicked=compose(leftGun,rat_king_pose::kick_frame(a)),delta=compose(kicked,inverse(leftGun));
+            if(!rat_king_pose::kick_arm(p,true,delta))
+                for(unsigned i=0;i<armBones;++i)p[alternating::leftArm[i]]=compose(delta,p[alternating::leftArm[i]]);
+            leftGun=kicked;r.kick=true;
+        }
+        // 5. Drang's reload: the left gun and arm lowered rigidly (IKELOS smg.h), along -z of common root 0.
+        if(const float h=drang_hidden(in.drangReloading,in.drangReloadU);h>0){
+            const Vec d=rotate(p[0].q,{0,0,-reloadDropMeters*h});
+            leftGun.p=add(leftGun.p,d);
+            for(unsigned i=0;i<armBones;++i)p[alternating::leftArm[i]].p=add(p[alternating::leftArm[i]].p,d);
+            r.lowered=true;
+        }
+        // 6. Drang's slide cycle (mask bit 0): its parts relative to root 72; the magazine at bind.
+        unsigned mask=0;
+        if constexpr(slideCycle){
+            if(const float s=slide_response(now-lastLeftShot);s>0){
+                const Frame bind2=compose(native,weaponBind2),bind6=compose(native,weaponBind6);
+                if(at_bind(p[magazineBone],bind2)&&at_bind(p[slideBone],bind6)){
+                    mask=leftMoves;
+                    p[magazineBone]=bind2;
+                    p[slideBone]=compose(native,compose(Frame{{},{-slideTravelMeters*s,0,0},1},weaponBind6));
+                    r.slide=true;
+                }else r.slideSkipped=true;
+            }
+        }
+        // 7. The marker: Drang is drawn at marker o S, so marker = leftGun o S^-1 (ruling 9).
+        Frame marker=compose(leftGun,inverse(rat_king_pose::pairSpacing));
+        marker.scale=native.scale*smg::marker_scale(mask);
+        p[markerBone]=compose(marker,alternating::weaponBind5);
+        for(const auto& f:p)if(!valid(f)){r.rejected=true;return false;}
+        std::memcpy(data,p.data(),sizeof(p));
+        sample={id,now,native,leftGun};
+        r.written=true;r.isolated=isolated;r.weight=weight;r.mask=mask;return true;
+    }
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/sturm_drang_runtime.h b/Dawn/src/client/hooks/akimbo/sturm_drang_runtime.h
new file mode 100644
index 0000000000000000000000000000000000000000..7ccc4466993ac6d5012735b270ba64a0878593d9
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/sturm_drang_runtime.h
@@ -0,0 +1,175 @@
+#pragma once
+// Sturm & Drang Akimbo S1: the session scaffolding shared by the hand (builder 1)
+// and the firing + ammo driver (builder 2). Pure except for std::atomic; no OS
+// call, so the unit tests compile it as is.
+//
+// Install (INTEGRATION-S1 ruling 1): akimbo.cpp install() commits the 22
+// baseline hooks first, then evaluates the S&D guard groups
+// (sturm_drang_guards.h, checked reads) and the kill file, and only when plan()
+// says attach does it attach H1 (CCF6A0) in its OWN Detours transaction. Any
+// S&D failure logs "ev=sd stage=install result=disabled reason=..." and leaves
+// every baseline hook working. uninstall() removes H1 first.
+//
+// Kill switch: compile time kSturmDrang; runtime the file
+// <Dawn artifact dir>\sturm-drang.off, checked once at install. It disables the
+// whole S&D feature: no H1, no remap, no emission, no ammo work and no S&D pose
+// layer (the identity keeps the shared Thorn plumbing: the mirrored hand on the
+// static pair). A missing kill file costs one GetFileAttributesW at install.
+#include <atomic>
+#include <cstdint>
+#include <immintrin.h>
+
+namespace dawn::client::hooks::akimbo::sturm_drang::runtime {
+inline constexpr bool kSturmDrang=true;
+inline constexpr const wchar_t* killFileName=L"sturm-drang.off";
+// AkimboSturmDrangFiringCounters::installState bits.
+enum InstallBit : std::uint64_t {
+    compiled=1,driverGuards=2,ammoGuards=4,fxGuards=8,diagnosticGuards=16,killFile=32,
+    h1Attached=64,h1Failed=128,handOn=256,fxOn=512,diagnosticOn=1024,
+};
+// groups: sturm_drang::guards::check()'s mask (bit 0 driver, 1 ammo, 2 fx, 3 diagnostic).
+struct Plan {bool attach{},hand{},fx{},diagnostic{};const char* reason{"ok"};std::uint64_t bits{};};
+[[nodiscard]] constexpr Plan plan(bool compiledIn,unsigned groups,bool killFilePresent) noexcept {
+    Plan p{};
+    if(compiledIn)p.bits|=compiled;
+    if(groups&1U)p.bits|=driverGuards;
+    if(groups&2U)p.bits|=ammoGuards;
+    if(groups&4U)p.bits|=fxGuards;
+    if(groups&8U)p.bits|=diagnosticGuards;
+    if(killFilePresent)p.bits|=killFile;
+    if(!compiledIn){p.reason="compiled_off";return p;}
+    if(killFilePresent){p.reason="killfile";return p;}
+    // The hand needs no native call and no guard: only the kill switches stop it.
+    p.hand=true;p.bits|=handOn;
+    // critique-ammo R7: the driver and the ammo-critical groups gate firing and so
+    // the H1 attach; FX and the diagnostic call only gate themselves.
+    if(!(groups&1U)){p.reason="guard_driver";return p;}
+    if(!(groups&2U)){p.reason="guard_ammo";return p;}
+    p.attach=true;
+    p.fx=(groups&4U)!=0;p.diagnostic=(groups&8U)!=0;
+    if(p.fx)p.bits|=fxOn;
+    if(p.diagnostic)p.bits|=diagnosticOn;
+    return p;
+}
+// Session state. Written by install()/uninstall() (activation thread) and by
+// the driver; read lock-free by every hook.
+struct Session {
+    std::atomic<bool> hand{};          // the S&D pose layer runs (plan().hand)
+    std::atomic<bool> firing{};        // H1 attached: builder 2's remap/driver/ammo may run
+    std::atomic<bool> fx{},diagnostic{};
+    std::atomic<std::uint32_t> latches{};        // bit n = latch Ln, session-sticky
+    std::atomic<std::uintptr_t> sturmBarrel{};   // the armed S&D Sturm barrel; 0 = H1 passes through
+    // Builder 2: the discovery cache's pointers for the lock-free observers
+    // (pointer compares only): Drang's barrel (its own H1 and native Drang
+    // shots in firing_hook), the cached Sturm barrel (native Sturm shots) and
+    // both magazines (magazine_hook). 0 while no cache is valid.
+    std::atomic<std::uintptr_t> drangBarrel{},sturmBarrelCached{},sturmMag{},drangMag{};
+    // The cached barrels' root selves (barrel+0x98, regression-review F1): a
+    // pointer match counts only while the barrel still names this root, so a
+    // barrel re-allocated at a cached address (Thorn on Sturm's, Rat King on
+    // Drang's) is never captured. Stored before the pointers, cleared after them.
+    std::atomic<std::uint32_t> sturmSelfCached{},drangSelf{};
+    std::atomic<std::uint64_t> seenAt{};         // GetTickCount64 of the last S&D present/prepare (ruling 5 pre-gate)
+    // First latch of n: true once (log it once). Any latch disarms the driver.
+    bool latch(unsigned n) noexcept {
+        const std::uint32_t b=1U<<(n&31U);const auto old=latches.fetch_or(b,std::memory_order_acq_rel);
+        sturmBarrel.store(0,std::memory_order_release);return (old&b)==0;
+    }
+    [[nodiscard]] bool latched() const noexcept {return latches.load(std::memory_order_acquire)!=0;}
+    // A fresh S&D first-person frame within maxAgeMs (the cheap pre-gate of ruling 5).
+    [[nodiscard]] bool seen(std::uint64_t nowMs,std::uint64_t maxAgeMs) const noexcept {
+        const auto at=seenAt.load(std::memory_order_relaxed);return at&&nowMs>=at&&nowMs-at<=maxAgeMs;
+    }
+    void apply(const Plan& p,bool h1) noexcept {
+        hand.store(p.hand,std::memory_order_release);firing.store(p.attach&&h1,std::memory_order_release);
+        fx.store(p.attach&&h1&&p.fx,std::memory_order_release);diagnostic.store(p.attach&&h1&&p.diagnostic,std::memory_order_release);
+    }
+    void reset() noexcept {
+        hand.store(false);firing.store(false);fx.store(false);diagnostic.store(false);
+        latches.store(0);sturmBarrel.store(0);seenAt.store(0);
+        drangBarrel.store(0);sturmBarrelCached.store(0);sturmMag.store(0);drangMag.store(0);sturmSelfCached.store(0);drangSelf.store(0);
+    }
+};
+inline Session& session() noexcept {static Session s{};return s;}
+
+// Ruling 3: native ammo/FX writes run only inside the pinned driver invocation.
+// The pin is taken per invocation (gameplay-review F1, crash-review F4): the H1
+// call that holds the driver's busy flag pins its own thread at its start and
+// releases the pin at its end, so a job system that moves Sturm's H1 between
+// workers never starves Drang, and no native write can run outside an
+// invocation. admit() compares the CURRENT thread id with the pin immediately
+// before each native call (a refusal is counted by the caller). last() and
+// moves() are for the threads line (pin_moves: the invocation thread changed).
+class DriverThread {
+    std::atomic<std::uint32_t> id_{},last_{};
+    std::atomic<std::uint64_t> moves_{};
+public:
+    // The invocation's start (under busy_): true when the thread differs from the previous invocation's.
+    bool pin(std::uint32_t thread) noexcept {
+        id_.store(thread,std::memory_order_release);
+        const auto previous=last_.exchange(thread,std::memory_order_acq_rel);
+        if(previous&&thread&&previous!=thread){moves_.fetch_add(1,std::memory_order_relaxed);return true;}
+        return false;
+    }
+    void release() noexcept {id_.store(0,std::memory_order_release);}
+    [[nodiscard]] bool admit(std::uint32_t thread) const noexcept {return thread&&id_.load(std::memory_order_acquire)==thread;}
+    [[nodiscard]] std::uint32_t id() const noexcept {return id_.load(std::memory_order_acquire);}
+    [[nodiscard]] std::uint32_t last() const noexcept {return last_.load(std::memory_order_acquire);}
+    [[nodiscard]] std::uint64_t moves() const noexcept {return moves_.load(std::memory_order_relaxed);}
+    void reset() noexcept {id_.store(0,std::memory_order_release);last_.store(0,std::memory_order_release);moves_.store(0,std::memory_order_relaxed);}
+};
+// Crash-review F2 (critique-firing 3.8): our emission, spend and FX on Drang's
+// barrel/magazine vs Drang's own H1 (CCF6A0 -> CCF720 -> CB48C0) on another job
+// worker. A Dekker handshake with a bounded wait, so neither side can deadlock:
+//  - the driver announces `emitting` (seq_cst) and then reads drangInH1; a
+//    Drang H1 in flight -> it withdraws and the press stays pending (transient);
+//  - Drang's H1 announces drangInH1 (seq_cst) and then reads `emitting`; an
+//    emission in flight on ANOTHER thread -> it waits (pause) until the driver
+//    ends (after the spend and the FX post), at most `budget` seconds; a
+//    timeout is an overlap (L8). Our own emission re-entering Drang's H1 on the
+//    emitting thread never waits. A wait that ended in time is serialized
+//    (counted, never latched).
+enum class GateEntry : unsigned char {clear,waited,overlap};
+inline constexpr unsigned kMaxSpins=1U<<16;   // pauses without the clock moving: a stopped clock ends the wait
+struct EmitGate {
+    std::atomic<unsigned> drangInH1{};
+    std::atomic<bool> emitting{};
+    std::atomic<std::uint32_t> emitTid{};
+    // The driver, immediately before the emission. false: Drang's H1 is in flight.
+    [[nodiscard]] bool begin(std::uint32_t tid) noexcept {
+        emitTid.store(tid,std::memory_order_seq_cst);
+        emitting.store(true,std::memory_order_seq_cst);
+        if(drangInH1.load(std::memory_order_seq_cst)!=0){emitting.store(false,std::memory_order_seq_cst);return false;}
+        return true;
+    }
+    void end() noexcept {emitting.store(false,std::memory_order_seq_cst);}
+    // Drang's H1, before its original (always paired with leave()).
+    template<class Clock> [[nodiscard]] GateEntry enter(std::uint32_t tid,Clock&& clock,double budget) noexcept {
+        drangInH1.fetch_add(1,std::memory_order_seq_cst);
+        if(!emitting.load(std::memory_order_seq_cst)||emitTid.load(std::memory_order_seq_cst)==tid)return GateEntry::clear;
+        double last=clock();const double until=last+budget;unsigned still=0;
+        while(emitting.load(std::memory_order_seq_cst)){
+            const double c=clock();
+            if(!(c<=until))return GateEntry::overlap;
+            if(c<=last){if(++still>kMaxSpins)return GateEntry::overlap;}   // a stopped clock cannot hang it
+            else{still=0;last=c;}
+            _mm_pause();
+        }
+        return GateEntry::waited;
+    }
+    void leave() noexcept {drangInH1.fetch_sub(1,std::memory_order_seq_cst);}
+    void reset() noexcept {drangInH1.store(0);emitting.store(false);emitTid.store(0);}
+};
+inline constexpr double kDrangH1WaitSeconds=.001;   // crash-review F2: the bounded wait (about 1 ms)
+// Ruling 3 (hard rule): no native call while this thread holds an akimbo lock.
+// S&D code marks every akimbo lock it holds with LockScope; the driver asks
+// native_call_allowed() immediately before each native call and refuses (counted)
+// otherwise. Pure bookkeeping on the calling thread.
+inline thread_local unsigned lockDepth=0;
+struct LockScope {
+    LockScope() noexcept {++lockDepth;}
+    ~LockScope(){--lockDepth;}
+    LockScope(const LockScope&)=delete;LockScope& operator=(const LockScope&)=delete;
+};
+[[nodiscard]] inline bool native_call_allowed() noexcept {return lockDepth==0;}
+}
diff --git a/Dawn/src/client/hooks/akimbo/thorn_magazine.h b/Dawn/src/client/hooks/akimbo/thorn_magazine.h
new file mode 100644
index 0000000000000000000000000000000000000000..a19d069b355dbe3246ffedeb0f6bcc208845f406
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/thorn_magazine.h
@@ -0,0 +1,35 @@
+#pragma once
+#include "hud.h"
+
+namespace dawn::client::hooks::akimbo::thorn_magazine {
+inline constexpr float capacity=16.f;
+inline constexpr std::array<std::uintptr_t,10> callers{
+    0xcbba56,0xcbcf0d,0xcbd0d0,0xcbdc30,0xcbe450,
+    0xcc1de3,0xcc68f2,0xcc6c8e,0xcc75f7,0xcc8aa1};
+inline bool capacity_caller(std::uintptr_t rva) noexcept {
+    for(const auto caller:callers)if(rva==caller)return true;
+    return false;
+}
+// Native 81529057 embeds magazine8080384B at runtime+24D0, definition64B0.
+// Every capacity consumer reads the float property at magazine+E0. Qualify
+// that exact object and its own private art packet, including before draw.
+inline bool owns_capacity(const Memory& m,std::uintptr_t property,std::uintptr_t& magazine) noexcept {
+    using namespace hud::detail;
+    magazine=0;
+    if(property<0x10000+0x25b0||property>0x00007ffffffff000ULL)return false;
+    const auto address=property-0xe0,root=address-0x24d0;
+    std::array<unsigned,4> definition{};
+    std::int64_t parent{};Header before{},after{},contentHeader{};
+    std::uintptr_t content{};unsigned handle{},key{},magazineHandle{};std::uint64_t magazineOffset{};
+    if(!read(m,address,definition)||definition!=std::array<unsigned,4>{0x81529057,0x8080384b,0x64b0,0}
+        ||!read(m,address+16,parent)||parent!=-0x24e0
+        ||!header(m,root,before)||before.tag!=0x81529057||before.kind!=0x80bfdfeb||before.definition!=14240
+        ||!read(m,root+0xd70+0xf60,magazineHandle)||magazineHandle!=before.self
+        ||!read(m,root+0xd70+0xf68,magazineOffset)||magazineOffset!=0x24d0
+        ||!read(m,root+0x8c0,handle)||!resolve(m,handle,content)
+        ||!header(m,content,contentHeader)||contentHeader.owner!=before.owner
+        ||!hud::select(m,content,0x811c9dc5,key)||key!=0x46e42225
+        ||!header(m,root,after)||after!=before)return false;
+    magazine=address;return true;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/tube_reload.h b/Dawn/src/client/hooks/akimbo/tube_reload.h
new file mode 100644
index 0000000000000000000000000000000000000000..4d27a472ff25d7fbe6cc5b6d211c459a398a3d4b
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/tube_reload.h
@@ -0,0 +1,74 @@
+#pragma once
+// Independent tube-reload scheduling. This helper does not read game memory or
+// write ammunition: advance() returns a candidate transfer which the existing
+// qualified magazine transaction must commit together with this candidate.
+#include <algorithm>
+#include <cmath>
+
+namespace dawn::client::hooks::akimbo::tube_reload {
+struct Inputs {
+    float opening{},tactical{},empty{},closing{},refillFraction{};
+    int quantum{};
+};
+inline bool duration(float value) noexcept {
+    // D009A0 falls back to the animation duration when a property is zero.
+    // A caller must supply that proven fallback, never substitute a constant.
+    return std::isfinite(value)&&value>=.001f&&value<=15.f;
+}
+inline bool valid(const Inputs& v) noexcept {
+    return duration(v.opening)&&duration(v.tactical)&&duration(v.empty)&&duration(v.closing)
+        &&std::isfinite(v.refillFraction)&&v.refillFraction>=0.f&&v.refillFraction<=1.f
+        &&v.quantum>=1&&v.quantum<=200;
+}
+enum class Phase : unsigned {Idle,Opening,Inserting,Closing};
+struct Hand {
+    Phase phase{};
+    double elapsed{},seconds{},refillAt{};
+    bool refilled{};
+    bool active()const noexcept{return phase!=Phase::Idle;}
+    void cancel()noexcept{*this={};}
+    bool start(const Inputs& v,int rounds,int capacity,int reserve) noexcept {
+        if(active()||!valid(v)||capacity<1||capacity>200||rounds<0||rounds>=capacity
+            ||reserve<1||reserve>100000)return false;
+        phase=Phase::Opening;elapsed=0;seconds=v.opening;refillAt=0;refilled=false;return true;
+    }
+    // Native 10AD530/10AD6E0/10AD380 schedule opening/insertion/closing
+    // independently. D009A0 samples each new insertion's empty/tactical
+    // duration and its content+120 refill fraction; D08610 clears the event
+    // after one refill. Do not carry a long frame across multiple insertions.
+    int advance(double delta,const Inputs& v,int rounds,int capacity,int reserve,
+        bool transferReady=true,bool interrupt=false) noexcept {
+        if(!active()||!valid(v)||!std::isfinite(delta)||delta<0||delta>2.5
+            ||capacity<1||capacity>200||rounds<0||rounds>capacity||reserve<0||reserve>100000)return 0;
+        elapsed=std::min(seconds,elapsed+delta);
+        if(seconds-elapsed<1e-9)elapsed=seconds;
+        if(phase==Phase::Opening){
+            if(elapsed>=seconds)insert(v,rounds);
+            return 0;
+        }
+        if(phase==Phase::Closing){if(elapsed>=seconds)cancel();return 0;}
+        int amount=0;
+        if(!refilled&&elapsed+1e-9>=refillAt){
+            // A queued native spend must settle before changing the combined
+            // native count. Retain this one due event instead of skipping it,
+            // repeating it, or starting the next insertion while deferred.
+            if(!transferReady)return 0;
+            amount=std::min({v.quantum,capacity-rounds,reserve});refilled=true;
+        }
+        if(elapsed>=seconds&&refilled){
+            const int after=rounds+amount;
+            // Native insertion-loop completion accepts a fire interruption
+            // only with a loaded round. The other hand's fire is not this flag.
+            if(interrupt&&after>0)cancel();
+            else if(after<capacity&&reserve>amount)insert(v,after);
+            else {phase=Phase::Closing;elapsed=0;seconds=v.closing;refillAt=0;refilled=false;}
+        }
+        return amount;
+    }
+private:
+    void insert(const Inputs& v,int rounds) noexcept {
+        phase=Phase::Inserting;elapsed=0;seconds=rounds?v.tactical:v.empty;
+        refillAt=seconds*static_cast<double>(v.refillFraction);refilled=false;
+    }
+};
+}
diff --git a/Dawn/src/client/hooks/akimbo/tube_reload_native.h b/Dawn/src/client/hooks/akimbo/tube_reload_native.h
new file mode 100644
index 0000000000000000000000000000000000000000..63d6b85324315f563004f74b7d85ed76dca38eb9
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/tube_reload_native.h
@@ -0,0 +1,69 @@
+#pragma once
+#include "smg_magazines.h"
+#include "tube_reload.h"
+#include "content_selection.h"
+
+namespace dawn::client::hooks::akimbo::tube_reload {
+struct Pins {
+    std::uintptr_t coreAsset{},contentAsset{},content{},row{};
+    unsigned reloadDefinition{};
+    hud::detail::Header contentHeader{};
+    std::array<std::uintptr_t,4> properties{}; // close, tactical, empty, refill quantum
+    std::array<std::uint64_t,4> definitions{};
+    float opening{},refillFraction{};
+    bool operator==(const Pins&)const=default;
+};
+inline bool inspect(const Memory& m,const smg_ammo::Native& n,Pins& out) noexcept {
+    using namespace hud::detail;
+    out={};const auto* profile=profiles::find(n.modelTag);gun_layout::Layout layout{};
+    if(!profile||!smg_ammo::unchanged(m,n)||!gun_layout::source(m,profile->barrel,layout)
+        ||layout.reloadKind!=0x80803843||layout.reloadInterface!=0x80803842)return false;
+    const auto& b=profile->barrel;Pins p{};p.reloadDefinition=layout.reloadDefinition;std::uint64_t bytes{};
+    if(!resolve(m,b.coreTag,p.coreAsset)||!read(m,p.coreAsset,bytes)||bytes!=b.coreSize
+        ||layout.reloadDefinition>bytes||bytes-layout.reloadDefinition<0x104
+        ||!read(m,p.coreAsset+layout.reloadDefinition+0x100,p.opening))return false;
+    std::array<std::byte,0x38> controller{};std::array<unsigned,4> link{};
+    if(!read(m,n.root+0x2710,controller)||at<unsigned>(controller,0)!=b.coreTag
+        ||at<unsigned>(controller,4)!=layout.reloadKind
+        ||at<std::uint64_t>(controller,8)!=layout.reloadDefinition
+        ||at<std::int64_t>(controller,0x10)!=-0x2720
+        ||at<unsigned>(controller,0x20)!=0x80803844 // common interface, concrete type follows
+        ||at<unsigned>(controller,0x28)!=n.handle||at<unsigned>(controller,0x2c)!=layout.reloadInterface
+        ||at<std::uint64_t>(controller,0x30)!=0x2710
+        ||!read(m,n.root+0x28c8,link)||link!=std::array<unsigned,4>{n.handle,0x80803a0f,0x24d0,0})return false;
+    constexpr std::array<unsigned,4> offsets{0x27f0,0x2820,0x2850,0x2640};
+    for(unsigned i=0;i<offsets.size();++i){
+        std::array<std::byte,0x30> record{};
+        if(!read(m,n.root+offsets[i],record)||at<unsigned>(record,0xc)!=n.handle
+            ||at<std::uint64_t>(record,0x10)!=offsets[i]||at<unsigned>(record,0x20)!=b.coreTag
+            ||at<unsigned>(record,0x24)!=0x808045c4)return false;
+        const auto definition=at<std::uint64_t>(record,0x28);
+        if(!definition||(definition&7u)||definition>bytes-24)return false;
+        p.properties[i]=n.root+offsets[i];
+        p.definitions[i]=definition;
+    }
+    unsigned handle{},variant{},overrideTag{};
+    if(!read(m,n.root+0x8c0,handle)||!resolve(m,handle,p.content)||!header(m,p.content,p.contentHeader)
+        ||p.contentHeader.self!=handle||p.contentHeader.owner!=n.owner||p.contentHeader.tag!=b.contentTag
+        ||p.contentHeader.kind!=0x80803ac9||p.contentHeader.definition!=b.contentDefinition
+        ||!read(m,p.content+0x68,variant)||!content_selection::matches(b,variant)
+        ||!read(m,p.content+0x60,overrideTag)||overrideTag!=0xffffffff
+        ||!content_selection::row(m,b,variant,p.contentAsset,p.row))return false;
+    if(!read(m,p.row+0x120,p.refillFraction)||!smg_ammo::unchanged(m,n))return false;
+    out=p;return true;
+}
+// The trusted getter is native B8B7F0 (its existing verified trampoline), not
+// an offline DLL load or a raw interpretation of encoded property words.
+// D009A0 consumes the first three records; CC68FB/CC6922 consume mag+170,
+// adding its truncated quantum and clamping against capacity and reserve.
+template<class Getter> bool sample(const Memory& m,const smg_ammo::Native& n,Getter&& getter,Inputs& out) noexcept {
+    out={};Pins before{},after{};if(!inspect(m,n,before))return false;
+    Inputs v{};v.opening=before.opening;v.refillFraction=before.refillFraction;
+    v.closing=getter(before.properties[0]);v.tactical=getter(before.properties[1]);v.empty=getter(before.properties[2]);
+    const float quantum=getter(before.properties[3]);
+    if(!std::isfinite(quantum)||quantum<1.f||quantum>200.f)return false;
+    v.quantum=static_cast<int>(quantum);
+    if(!valid(v)||!inspect(m,n,after)||after!=before)return false;
+    out=v;return true;
+}
+}
