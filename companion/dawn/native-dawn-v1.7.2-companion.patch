+thread_local SpendScope* spendScope{};
+thread_local EmitScope* emitScope{};
+std::array<std::atomic<const char*>,32> refusals{};
+void refused(const char* reason) noexcept {
+    // Reasons are static literals. Repeated startup qualification misses must
+    // not consume the budget for a later distinct debit/queue failure.
+    bool first=false;
+    for(auto& slot:refusals){
+        auto* seen=slot.load(std::memory_order_relaxed);
+        if(seen&&std::strcmp(seen,reason)==0)return;
+        if(!seen){
+            if(slot.compare_exchange_strong(seen,reason,std::memory_order_relaxed)){first=true;break;}
+            if(seen&&std::strcmp(seen,reason)==0)return;
+        }
+    }
+    if(!first)return;
+    char line[160]{};(void)std::snprintf(line,sizeof(line),"ev=akimbo_burst result=blocked reason=%s",reason);
+    report(core::log::Level::warn,line);
+}
+bool rejected_phase(const char* reason) noexcept {
+    // A semantic/source failure is different from native empty/reload
+    // readiness. Do not let the following native failed-shot exit debit using
+    // a now-unqualified burst divisor; its scoped getter must return zero.
+    if(auto* exit=burst::runtime::phaseExit)exit->rejected=true;
+    refused(reason);return false;
+}
+bool current(const burst::runtime::Phase& phase,std::uintptr_t barrel) noexcept {
+    return phase.qualified&&phase.revision&&(phase.side==burst::left||phase.side==burst::right)
+        &&phase.count>=2&&phase.count<=burst::maxShots&&barrel==phase.native.root+0xd70
+        &&generic_gun_model(phase.identity.modelTag)&&still_current(memory,phase.identity)
+        &&smg_ammo::unchanged(memory,phase.native)&&native_akimbo_barrel(memory,barrel,phase.identity);
+}
+// CB9440 includes the selected content override. The exact cost expressions
+// remain source-proven constants; a transient unit-valued dynamic expression
+// cannot enter this path. This reader does not qualify a native phase driver.
+bool contract(const Identity& id,const smg_ammo::Native& native,float charge,unsigned& count) noexcept {
+    count=0;const auto* profile=profiles::find(id.modelTag);const auto property=nextCapacity.load(std::memory_order_acquire);
+    const auto barrel=native.root+0xd70;std::array<std::uintptr_t,4> properties{};std::array<float,4> counts{};
+    gun_cost::Expressions cost{},after{};gun_layout::Layout layout{};
+    if(!profile||!finite_burst_model(id.modelTag)||!property||charge!=0||(profile->barrel.flags&0x20)
+        ||!gun_layout::source(memory,profile->barrel,layout)||!layout.ordinary_reload()
+        ||!gun_layout::bullet_properties(memory,profile->barrel,native.root,native.handle,properties)
+        ||!gun_cost::qualify(memory,profile->barrel,barrel,cost))return false;
+    for(unsigned i=0;i<properties.size();++i)counts[i]=property(reinterpret_cast<void*>(properties[i]));
+    using Expression=float(__fastcall*)(void*,float);
+    const auto expression=reinterpret_cast<Expression>(moduleBase+0x578dc0);
+    const auto debit=expression(reinterpret_cast<void*>(cost.debit),charge);
+    const auto required=expression(reinterpret_cast<void*>(cost.required),charge);
+    const int selected=reinterpret_cast<int(__fastcall*)(void*)>(moduleBase+0xcb9440)(reinterpret_cast<void*>(barrel));
+    if(selected<2||selected>static_cast<int>(burst::maxShots)
+        ||!burst::finite_counts(counts,static_cast<unsigned>(selected))||!gun_cost::unit(debit,required,cost.fallback)
+        ||!gun_cost::qualify(memory,profile->barrel,barrel,after)||cost!=after
+        ||!smg_ammo::unchanged(memory,native)||!native_akimbo_barrel(memory,barrel,id))return false;
+    count=static_cast<unsigned>(selected);return true;
+}
+void settle(SpendScope& scope,const burst::Queued* queued) noexcept {
+    if(!scope.transaction.spend.valid||scope.transaction.settled)return;
+    const bool qualified=current(scope.phase,scope.barrel);
+    const auto getter=nextMagazine.load(std::memory_order_acquire);
+    const int loaded=qualified?getter(reinterpret_cast<void*>(scope.phase.native.magazine)):-1;
+    const bool fresh=qualified&&current(scope.phase,scope.barrel);
+    bool ok=false;
+    AcquireSRWLockExclusive(&magazineLock);
+    auto* owner=burstBook.find(burst::runtime::key(scope.phase.native));
+    auto* mag=magazineBook.find(scope.phase.native);
+    if(owner&&mag){
+        ok=burst::runtime::settle(*owner,*mag,scope.transaction,loaded,fresh,queued);
+        if(ok){activeMagazine=scope.phase.native;magazine_diagnostics(*mag);}else activeMagazine={};
+    }else if(owner){owner->failed=true;scope.transaction.settled=true;activeMagazine={};}
+    ReleaseSRWLockExclusive(&magazineLock);
+    if(!ok)refused("debit_observation");
+}
+// The phase adapter calls this from its finally path after a native transition.
+// It observes only the separate CB5DF0 modulo debit; shot receipts already paid
+// through settle() are never subtracted here a second time.
+void settle_exit(burst::runtime::ExitDebit& debit) noexcept {
+    if(!debit.valid||debit.settled)return;
+    const auto& phase=debit.phase;const auto barrel=phase.native.root+0xd70;
+    const bool before=current(phase,barrel);
+    const int loaded=before?nextMagazine.load(std::memory_order_acquire)(reinterpret_cast<void*>(phase.native.magazine)):-1;
+    const bool fresh=before&&current(phase,barrel);bool ok=false;
+    AcquireSRWLockExclusive(&magazineLock);
+    auto* owner=burstBook.find(burst::runtime::key(phase.native));auto* mag=magazineBook.find(phase.native);
+    if(owner&&mag){
+        ok=burst::runtime::settle_exit(*owner,*mag,debit,loaded,fresh);
+        if(ok){activeMagazine=phase.native;magazine_diagnostics(*mag);}
+    }else if(owner){owner->failed=true;debit.settled=true;}
+    if(!ok&&activeMagazine==phase.native)activeMagazine={};
+    ReleaseSRWLockExclusive(&magazineLock);
+    if(!ok)refused("exit_debit_observation");
+}
+bool invoke_shot(SpendScope& scope,void* barrel,int mode,float elapsed,unsigned ordinal,float charge,void* output) noexcept {
+    auto* previous=spendScope;spendScope=&scope;bool result=false;
+    __try {result=nextBurstShot.load(std::memory_order_acquire)(barrel,mode,elapsed,ordinal,charge,output);}
+    __finally {settle(scope,nullptr);spendScope=previous;}
+    return result;
+}
+void invoke_emission(EmitScope& scope,void* barrel,void* replay,void* packet,float elapsed) noexcept {
+    auto* previous=emitScope;emitScope=&scope;
+    __try {nextBurstEmit.load(std::memory_order_acquire)(barrel,replay,packet,elapsed);}
+    __finally {
+        emitScope=previous;
+        AcquireSRWLockExclusive(&magazineLock);
+        if(auto* owner=burstBook.find(burst::runtime::key(scope.native)))(void)owner->retire(scope.event);
+        ReleaseSRWLockExclusive(&magazineLock);
+    }
+}
+firing::Result dispatch(EmitScope& emission,const Identity& id,const firing::Arguments& args) noexcept {
+    const auto& packet=emission.event.packet;unsigned progress{};
+    if(emission.called||id!=emission.identity||reinterpret_cast<std::uintptr_t>(args.barrel)!=emission.barrel
+        ||args.replay||args.fromReplay||args.variant!=packet.ordinal||args.charge!=packet.charge
+        ||args.selectedOrigin!=packet.selected||args.flag!=(packet.flag!=0)
+        ||!local_read(nullptr,reinterpret_cast<std::uintptr_t>(args.patternProgress),&progress,sizeof(progress))
+        ||progress!=packet.progress||!smg_ammo::unchanged(memory,emission.native)||!still_current(memory,id))
+        return {false,firing::Route::blocked};
+    bool paid=false;
+    AcquireSRWLockShared(&magazineLock);
+    if(const auto* owner=burstBook.find(burst::runtime::key(emission.native))){
+        const auto receipt=owner->find(emission.event.receipt.token);
+        paid=!owner->failed&&receipt.receipt.valid&&receipt.receipt.side==emission.event.receipt.side
+            &&burst::same_payload(receipt.packet,packet);
+    }
+    ReleaseSRWLockShared(&magazineLock);
+    if(!paid)return {false,firing::Route::blocked};
+    emission.called=true;
+    smg_tracer::Scope scope{id,{},GetTickCount64(),emission.event.receipt.side,false};presentation::Frame gun{};
+    AcquireSRWLockShared(&alternatingLock);
+    const bool ready=smgState.muzzle_root(id,scope.side,scope.at,gun);
+    ReleaseSRWLockShared(&alternatingLock);
+    scope.ready=ready&&smg_tracer::muzzle(memory,id,gun,scope.muzzle);
+    if(!scope.ready)return {false,firing::Route::blocked};
+    const auto* previous=smgTracerScope;smgTracerScope=&scope;firing::Result result{};
+    __try {result=firing::dispatch_group(memory,nextFiring.load(std::memory_order_acquire),args,scope.side,scope.muzzle);}
+    __finally {smgTracerScope=previous;}
+    if(result.returned&&(result.route==firing::Route::left||result.route==firing::Route::right)){
+        AcquireSRWLockExclusive(&alternatingLock);smgState.fired(id,scope.side,GetTickCount64());ReleaseSRWLockExclusive(&alternatingLock);
+        auto& d=SunriseStatusAkimboVisuals;(scope.side==smg::left?d.smgLeft:d.smgRight).fetch_add(1,std::memory_order_relaxed);
+        report_generated(id,scope.side);
+    }
+    return result;
+}
+}
+__declspec(noinline) bool __fastcall burst_shot_hook(void* barrel,int mode,float elapsed,unsigned ordinal,float charge,void* output) noexcept {
+    Invocation invocation;const auto next=nextBurstShot.load(std::memory_order_acquire);
+    const auto caller=reinterpret_cast<std::uintptr_t>(_ReturnAddress()),address=reinterpret_cast<std::uintptr_t>(barrel);
+    const auto* phase=burst::runtime::phase;
+    if(!enabled.load(std::memory_order_acquire))return next(barrel,mode,elapsed,ordinal,charge,output);
+    if(!phase||!phase->qualified||address!=phase->native.root+0xd70){
+        if(finite_burst_owned(address)||finite_burst_candidate(address)){burst_native::refused("missing_phase");return false;}
+        return next(barrel,mode,elapsed,ordinal,charge,output);
+    }
+    unsigned count{};
+    if(caller!=moduleBase+0xcd063d||mode||burst_native::spendScope||!std::isfinite(elapsed)||elapsed<0||elapsed>60
+        ||!output||!burst_native::current(*phase,address)||!burst_native::contract(phase->identity,phase->native,charge,count)
+        ||count!=phase->count||ordinal>=count)return burst_native::rejected_phase("shot_scope");
