+// (critique-ammo minor: the trampolines are null-checked before every call).
+using AmmoGetter=int(__fastcall*)(void*);
+using PropertyGetter=float(__fastcall*)(void*);
+struct NativeApi {
+    std::uintptr_t base{};
+    firing::NativeBatch emit{};      // nextFiring: 181E930 without firing_hook
+    AmmoGetter loaded{};             // nextMagazine: CBCF30 without magazine_hook
+    PropertyGetter property{};       // nextCapacity: B8B7F0 without capacity_hook
+    double clockScale{};             // seconds per QPC tick (akimbo.cpp preciseScale)
+};
+void configure(const NativeApi&) noexcept;
+// E1. H1 (CCF6A0) post-original. akimbo.cpp calls it only while enabled, with
+// barrel == session().sturmBarrel != 0; native is the original's return value
+// and callerRva the dispatcher's return address (captured in the hook's own
+// frame, critique-firing 3.5). Returns H1's result: native (S2: keep-awake retired, H1 only observed).
+// `now` is unused: the driver takes its clock after copying the trigger (ruling 13).
+[[nodiscard]] bool driver_tick(std::uintptr_t barrel,bool native,double now,std::uintptr_t callerRva) noexcept;
+// Drang's own H1 (critique-firing 3.8, crash-review F2), called by
+// post_update_hook INSTEAD of the original for the cached Drang barrel: when the
+// barrel still names Drang's root (+0x98 == the cached self) it takes the
+// EmitGate (a bounded wait while our emission/spend/FX run on another worker),
+// calls next exactly once with the unchanged arguments, releases the gate and
+// counts the call (L8 on a wait that ran out). Otherwise just next(barrel, message).
+using PostUpdate=bool(__fastcall*)(void*,void*);
+[[nodiscard]] bool drang_h1(void* barrel,void* message,PostUpdate next) noexcept;
+// Clears every driver-owned state (install, uninstall, or a failed H1 attach).
+void driver_reset() noexcept;
+// S2 fix (crash F5): no driver pass is in flight. The driver runs inside binding_hook
+// (S2 decision 2), which H1's own invocation counter does not cover; the uninstall
+// clears session().firing, then detaches H1 only once this is true (a pass that starts
+// later sees firing off before any native call), so Drang's H1 never loses the
+// EmitGate while our emission, spend or FX still runs.
+[[nodiscard]] bool driver_idle() noexcept;
+// E2. Once per evaluator pass at (slot 0, action 0); the returned mode applies to
+// every (slot, action) of that pass (binding(), sturm_drang_firing.h).
+// clock: precise seconds (QPC); focused: game focused and no UI visible. Both
+// are called only past the pre-gate (a non-S&D player pays two atomic loads).
+using Clock=double(*)() noexcept;
+using Focus=bool(*)() noexcept;
+[[nodiscard]] Remap input_pass(std::uint64_t nowMs,Clock clock,Focus focused) noexcept;
+// E3. firing_hook's early S&D branch: true when the barrel NAMES the S&D Sturm or
+// Drang root: barrel+0x98 (the barrel's back-reference, a generation-bearing
+// handle) == the cached self (S2 decision 1: routing keys on handle identity, so a
+// relocated barrel is still recognised and a weapon re-allocated at an old cached
+// address (Thorn on Sturm's, Rat King on Drang's, regression-review F1) keeps its
+// own firing::dispatch route). Two acquire loads while no S&D identity is cached
+// (any player without S&D); otherwise one checked 4-byte read per native firing call.
+[[nodiscard]] inline bool cached_self(std::uintptr_t barrel,std::uint32_t want) noexcept {
+    std::uint32_t self{};return want&&checked_get(barrel+0x98,self)&&self==want;
+}
+enum class BarrelIdentity : unsigned char {none,sturm,drang};
+inline constexpr std::uint64_t kIdentityRecentMs=1000;
+[[nodiscard]] inline BarrelIdentity barrel_identity(std::uintptr_t barrel) noexcept {
+    if(!barrel)return BarrelIdentity::none;
+    const auto& s=runtime::session();
+    const auto sturm=s.sturmSelfCached.load(std::memory_order_acquire),drang=s.drangSelf.load(std::memory_order_acquire);
+    std::uint32_t self{};
+    if(!sturm&&!drang)return BarrelIdentity::none;
+    // S2 fix (regression F5): S2 keeps the S&D identity cached across swaps, so without
+    // this every firing_hook call of every other weapon paid a checked read (~345 ns).
+    // The read runs only for a cached S&D barrel pointer or while S&D was presented
+    // within 1 s (a relocated S&D barrel can only fire while S&D is drawn).
+    if(barrel!=s.sturmBarrelCached.load(std::memory_order_acquire)&&barrel!=s.drangBarrel.load(std::memory_order_acquire)){
+        const auto at=s.seenAt.load(std::memory_order_relaxed);const auto nowMs=GetTickCount64();
+        if(!at||nowMs<at||nowMs-at>kIdentityRecentMs)return BarrelIdentity::none;
+    }
+    if(!checked_get(barrel+0x98,self)||!self)return BarrelIdentity::none;
+    return self==sturm?BarrelIdentity::sturm:self==drang?BarrelIdentity::drang:BarrelIdentity::none;
+}
+[[nodiscard]] inline bool native_barrel(std::uintptr_t barrel) noexcept {return barrel_identity(barrel)!=BarrelIdentity::none;}
+// Calls next exactly once with the unchanged arguments and returns its result.
+[[nodiscard]] bool native_fire(const firing::Arguments&,firing::NativeBatch next) noexcept;
+// E4. Observers.
+void observe_projectile(std::uintptr_t projectile,bool result,std::uintptr_t callerRva) noexcept;
+void observe_magazine_hit(std::uintptr_t magazine,int loaded,std::uintptr_t callerRva,bool sturm) noexcept;
+// magazine_hook (the hottest path): two relaxed loads and compares, nothing else.
+inline void observe_magazine(std::uintptr_t magazine,int loaded,std::uintptr_t callerRva) noexcept {
+    if(!magazine)return;
+    const auto& s=runtime::session();
+    const auto sturm=s.sturmMag.load(std::memory_order_relaxed),drang=s.drangMag.load(std::memory_order_relaxed);
+    if(magazine==sturm||magazine==drang)observe_magazine_hit(magazine,loaded,callerRva,magazine==sturm);
+}
+// The install line's view of the damage feed.
+[[nodiscard]] bool damage_feed_on() noexcept;
+}
+namespace dawn::client::hooks::akimbo {
+// B7E3C0 passive damage feed (design-firing 9.4), called by the bootflow
+// module's summary hook; a no-op unless S&D firing is installed and a Drang
+// shot happened within the last 2 s. sturm_drang_damage_feed() records whether
+// that hook is installed (the install, discover and summary lines print it).
+void sturm_drang_observe_damage(std::uint32_t attacker,std::uint32_t target,bool killed,bool mode,float amount) noexcept;
+void sturm_drang_damage_feed(bool installed) noexcept;
+}
diff --git a/Dawn/src/client/hooks/akimbo/sturm_drang_ammo.h b/Dawn/src/client/hooks/akimbo/sturm_drang_ammo.h
new file mode 100644
index 0000000000000000000000000000000000000000..8dbca6639f33efbbd7dad46405b07e538acc75a8
--- /dev/null
+++ b/Dawn/src/client/hooks/akimbo/sturm_drang_ammo.h
@@ -0,0 +1,144 @@
+#pragma once
+// Sturm & Drang Akimbo S1: Drang's magazine and empty reload (design-ammo P0,
+// with the critique-ammo fixes B1, R1, R5 and R6; ruling 7 removed its
+// LeftKick: the hand owns the one kick). Pure: no OS or native call. The pins
+// read through a reader R with the discovery Reader's shape (header(), read(),
+// resolve(); at runtime discovery::Reader<CheckedMemory>: exact-length
+// ReadProcessMemory and the checked resolver, never hud::detail, critique B1).
+//
+// VERIFIED on the S&D dump (design-ammo 1.1/1.3, re-walked by critique-ammo 1):
+// Drang root (core 8152AEA4, kind 80BFDFEB, def 13616) +0x24D0 = the magazine
+// {8152AEA4, 8080384B, 0x6240, 0}, parent -0x24E0; barrel (root+0xD70)
+// +0xF60/+0xF68 = {root self, 0x24D0}; the capacity record mag+0xE0 (+0xC self,
+// +0x10 0x25B0, +0x20 {8152AEA4, 808045C4}, +0x28 def 0x63B0); the reload
+// controller root+0x2710 {8152AEA4, 80803845, 0x6490}, parent -0x2720, its
+// tactical/empty records +0x110/+0x140 (0x2820/0x2850, defs 0x6560/0x6578) and
+// magazine link +0x1B8 {self, 80803A0F, 0x24D0}. Rat King shares core, root and
+// controller definitions, so the pin also requires Drang's content
+// (critique-ammo R6, ruling 11): root+0x8C0 -> {8152AEA5, 80803AC9, def 1096}
+// owned by the same owner, variant +0x68 == 3 (Rat King Akimbo's is 10).
+//
+// The reload (design-ammo 3.2; native D009A0 fractions, rat_king_stretch.h):
+// D from Drang's own empty-reload property (root+0x2850 through B8B7F0), the
+// refill at 0.5 D (queued to the pinned driver, ruling 3), fire-ready at
+// 0.85 D, the end at D; u = elapsed / D is published for the hand, which is
+// fully up from u >= 0.80 (ruling 8).
+#include "rat_king_stretch.h"
+#include "sturm_drang_discovery.h"
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+namespace dawn::client::hooks::akimbo::sturm_drang::ammo {
+namespace rs=rat_king_stretch;
+inline constexpr std::uint32_t core=0x8152aea4u,rootKind=0x80bfdfebu,propertyClass=0x808045c4u;
+inline constexpr std::uint32_t contentTag=0x8152aea5u,contentKind=0x80803ac9u,contentDefinition=1096,drangVariant=3;
+inline constexpr std::uint64_t rootDefinition=13616,magazineOffset=0x24d0,capacityField=0xe0,capacityDefinition=0x63b0,barrelOffset=0xd70;
+inline constexpr std::array<std::uint32_t,4> magazineHeader{core,0x8080384bu,0x6240u,0};
+inline constexpr std::int64_t magazineParent=-0x24e0;
+inline constexpr std::uint64_t tacticalProperty=rs::controllerOffset+rs::tacticalField;   // root+0x2820
+inline constexpr std::uint64_t emptyProperty=rs::controllerOffset+rs::emptyField;         // root+0x2850
+static_assert(tacticalProperty==0x2820&&emptyProperty==0x2850);
+struct Magazine {
+    std::uintptr_t root{},barrel{},magazine{},content{};std::uint32_t self{},owner{};
+    bool operator==(const Magazine&)const=default;
+};
+template<class T,std::size_t N> T at(const std::array<std::byte,N>& b,std::size_t o) noexcept {T v{};std::memcpy(&v,b.data()+o,sizeof(T));return v;}
+// Re-pins Drang's ammo objects from the discovery key (root, self). Every read
+// is checked; the root header is read before and after and must not change.
+template<class R> bool drang_magazine(R& m,std::uintptr_t root,std::uint32_t self,Magazine& out) noexcept {
+    out={};
+    if(root<0x10000||root>0x00007fffffff0000ULL)return false;
+    const auto mag=root+magazineOffset,ctl=root+rs::controllerOffset,barrel=root+barrelOffset;
+    discovery::Header before{},after{},content{};std::array<std::uint32_t,4> mh{};std::int64_t parent{};
+    std::array<std::byte,0x30> cap{},tac{},emp{};std::array<std::byte,0x18> c{};std::array<std::byte,0x10> link{};
+    std::uint32_t barrelMag{},contentHandle{},contentAfter{};std::uint64_t barrelOff{};std::int32_t variant{};std::uintptr_t contentAddress{};
+    if(!m.header(root,before)||before.tag!=core||before.kind!=rootKind||before.definition!=rootDefinition||before.self!=self
+        ||!m.read(mag,mh)||mh!=magazineHeader||!m.read(mag+16,parent)||parent!=magazineParent
+        ||!m.read(barrel+0xf60,barrelMag)||barrelMag!=self||!m.read(barrel+0xf68,barrelOff)||barrelOff!=magazineOffset
+        ||!m.read(mag+capacityField,cap)||at<std::uint32_t>(cap,0xc)!=self||at<std::uint64_t>(cap,0x10)!=magazineOffset+capacityField
+        ||at<std::uint32_t>(cap,0x20)!=core||at<std::uint32_t>(cap,0x24)!=propertyClass||at<std::uint64_t>(cap,0x28)!=capacityDefinition
+        ||!m.read(ctl,c)||at<std::uint32_t>(c,0)!=core||at<std::uint32_t>(c,4)!=rs::controllerKind
+        ||at<std::uint64_t>(c,8)!=rs::controllerDefinition||at<std::int64_t>(c,0x10)!=rs::controllerParent
+        ||!m.read(ctl+rs::tacticalField,tac)||at<std::uint64_t>(tac,0x10)!=tacticalProperty||at<std::uint64_t>(tac,0x28)!=rs::tacticalDefinition
+        ||at<std::uint32_t>(tac,0xc)!=self||at<std::uint32_t>(tac,0x20)!=core
+        ||!m.read(ctl+rs::emptyField,emp)||at<std::uint64_t>(emp,0x10)!=emptyProperty||at<std::uint64_t>(emp,0x28)!=rs::emptyDefinition
+        ||at<std::uint32_t>(emp,0xc)!=self||at<std::uint32_t>(emp,0x20)!=core
+        ||!m.read(ctl+0x1b8,link)||at<std::uint32_t>(link,0)!=self||at<std::uint32_t>(link,4)!=rs::magazineClass
+        ||at<std::uint64_t>(link,8)!=magazineOffset
+        // critique-ammo R6: Drang's content, never Rat King's (same core).
+        ||!m.read(root+0x8c0,contentHandle)||!m.resolve(contentHandle,contentAddress)||!m.header(contentAddress,content)
+        ||content.self!=contentHandle||content.owner!=before.owner||content.tag!=contentTag||content.kind!=contentKind
+        ||content.definition!=contentDefinition||!m.read(contentAddress+0x68,variant)||variant!=static_cast<std::int32_t>(drangVariant)
+        ||!m.read(root+0x8c0,contentAfter)||contentAfter!=contentHandle
+        ||!m.header(root,after)||after!=before)return false;
+    out={root,barrel,mag,contentAddress,self,before.owner};return true;
+}
+// One spend per confirmed emission ticket (monotonic, from the driver). Idempotent.
+struct Ledger {
+    std::uint64_t lastShot{};
+    [[nodiscard]] bool claim(std::uint64_t shot) noexcept {if(!shot||shot<=lastShot)return false;lastShot=shot;return true;}
+};
+// refused: the magazine was below 1 immediately before the spend (critique R1:
+// CCA120 does not clamp, so it is never called then).
+enum class Spend : unsigned char {spent,unchanged,mismatch,unreadable,refused};
+inline constexpr const char* spend_name(Spend s) noexcept {
+    return s==Spend::spent?"spent":s==Spend::unchanged?"unchanged":s==Spend::mismatch?"mismatch":s==Spend::unreadable?"unreadable":"refused";
+}
+[[nodiscard]] inline bool plausible_rounds(int n) noexcept {return n>=0&&n<=400;}
+[[nodiscard]] inline Spend judge_spend(int before,int after) noexcept {
+    if(!plausible_rounds(before)||!plausible_rounds(after))return Spend::unreadable;
+    return after==before-1?Spend::spent:after==before?Spend::unchanged:Spend::mismatch;
+}
+
+// ---- The reload clock (design-ammo 3.2) ------------------------------------------------
+inline constexpr float transferAt=.5f,readyAt=.85f;             // D009A0 (rat_king_stretch.h)
+inline constexpr float fallbackSeconds=2.f;                      // IKELOS precedent; only if D is implausible
+inline constexpr double maxStep=.25;                             // seconds per tick (hitch clamp)
+enum class Step : unsigned char {none,transfer,ready,complete};
+struct Reload {
+    bool active{},empty{},transferred{},readyPosted{};
+    std::uint64_t generation{};float duration{};double elapsed{},last{};
+    // d: B8B7F0(root + 0x2850) (empty) or +0x2820 (tactical); implausible -> fallbackSeconds.
+    bool begin(double now,float d,bool emptyMag,std::uint64_t gen,bool& fallback) noexcept {
+        fallback=false;if(active)return false;
+        fallback=!rs::plausible(d);
+        *this={};active=true;empty=emptyMag;generation=gen;duration=fallback?fallbackSeconds:d;last=now;return true;
+    }
+    // One step per call, in order; focused=false freezes the clock (IKELOS rule).
+    Step advance(double now,bool focused,std::uint64_t gen) noexcept {
+        if(!active)return Step::none;
+        if(gen!=generation){cancel();return Step::none;}
+        const double dt=now>last?std::min(now-last,maxStep):0.;last=now;if(focused)elapsed+=dt;
+        const double u=elapsed/duration;
+        if(!transferred&&u>=transferAt){transferred=true;return Step::transfer;}
+        if(!readyPosted&&u>=readyAt){readyPosted=true;return Step::ready;}
+        if(transferred&&readyPosted&&u>=1.){active=false;return Step::complete;}
+        return Step::none;
+    }
+    void cancel() noexcept {active=false;transferred=readyPosted=false;elapsed=0;}
+    [[nodiscard]] float phase() const noexcept {return active?static_cast<float>(std::min(1.,elapsed/duration)):0.f;}
+    [[nodiscard]] bool can_fire() const noexcept {return !active||readyPosted;}   // fire-ready from .85 D
+};
+// The refill, planned from FRESH values at 0.5 D (never at begin): fill the
+// magazine from reserve. An overcharged magazine (loaded >= capacity) is never clamped.
+struct Transfer {int add{};};
+[[nodiscard]] inline Transfer plan_transfer(int loaded,int reserve,int capacity) noexcept {
+    if(capacity<1||capacity>200||loaded<0||loaded>400||reserve<0||reserve>100000)return {};
+    return {std::min(std::max(0,capacity-loaded),reserve)};
+}
+// CAEB50 lowers reserve only above max reserve; the fix-up takes the rest of
+// the added rounds, never twice: target = reserve0 - added, applied only when
+// the reserve read after CAEB50 is above it.
+[[nodiscard]] inline bool reserve_fixup(int reserve0,int added,int reserve1,int& target) noexcept {
+    target=std::max(0,reserve0-std::max(0,added));return reserve1>target;
+}
+// lastPacked: loaded | reserve << 16 | capacity << 32 | D ms << 48 (design-ammo 7.4).
+[[nodiscard]] inline std::uint64_t packed(int loaded,int reserve,int capacity,float d) noexcept {
+    const auto c=[](long long v){return static_cast<std::uint64_t>(std::clamp<long long>(v,0,0xffff));};
+    const long long ms=std::isfinite(d)?static_cast<long long>(d*1000.f+.5f):0;
+    return c(loaded)|c(reserve)<<16|c(capacity)<<32|c(ms)<<48;
+}
+}
diff --git a/Dawn/src/client/hooks/akimbo/sturm_drang_diagnostics.h b/Dawn/src/client/hooks/akimbo/sturm_drang_diagnostics.h
