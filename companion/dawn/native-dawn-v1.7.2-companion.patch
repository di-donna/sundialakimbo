+// ---- Collector (fx_collect_hook, 12701B0 from 121C643) ----------------------------------
+// order: 0 one live emitter; 1 two, in part-table order; 2 two, swapped.
+struct Patch {std::array<effects::Write,4> frames{};unsigned count{};effects::Group group{};std::uintptr_t metadata{};unsigned order{};};
+// The collector's fresh output of an expanded set: right frames [0, v), left
+// copies [v, 2v), valid 2v. Nothing is prepared unless every read matches.
+inline bool patch(const Memory& m,const Identity& id,const firing_effects::Sequence& s,const Selector& item,
