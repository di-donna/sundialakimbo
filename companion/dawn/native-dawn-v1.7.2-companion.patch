+// ---- File format (Dawn\cache\akimbo-rat-king-reload.bin, little-endian) -----------------
+inline constexpr wchar_t fileName[]=L"cache\\akimbo-rat-king-reload.bin";
+inline constexpr std::uint32_t fileMagic=0x56524b52u; // "RKRV"
+inline constexpr std::uint32_t fileVersion=1;
+inline constexpr std::uint32_t build=86657;
+// destiny2.exe SHA-256 of build 86657 (akimbo.cpp supported_file() refuses any other).
+inline constexpr std::array<unsigned char,32> exeSha256{0x81,0x96,0x43,0x80,0x66,0x4e,0x7f,0xce,0xe3,0xc6,0x20,0x08,0x5a,0x15,0x7f,0xde,
+    0xaf,0x91,0xfe,0xfa,0xcf,0x72,0x14,0x90,0x78,0x20,0xf1,0x88,0xbb,0xeb,0x4c,0xed};
+struct FileHeader {
+    std::uint32_t magic{},version{},headerBytes{},flags{};
+    std::array<unsigned char,32> exe{};
+    std::uint32_t build{},animation{},skeleton{},rig{},clip{};
+    std::uint16_t action{},actionSpecial{};
+    std::uint32_t knots{},bones{},frameBytes{};
+    float tFirst{},tLast{},maxGap{},duration{},speed{};
+    std::uint32_t samples{},payloadBytes{};
+    std::uint64_t recordedAt{},checksum{};
+};
+static_assert(sizeof(FileHeader)==128&&offsetof(FileHeader,exe)==16&&offsetof(FileHeader,build)==48&&offsetof(FileHeader,action)==68
+    &&offsetof(FileHeader,knots)==72&&offsetof(FileHeader,tFirst)==84&&offsetof(FileHeader,samples)==104
+    &&offsetof(FileHeader,recordedAt)==112&&offsetof(FileHeader,checksum)==120);
+struct FileImage {FileHeader header{};Recording payload{};};
+static_assert(sizeof(FileImage)==165216&&offsetof(FileImage,payload)==128);
+// FNV-1a 64 over header bytes [0,120) and the payload.
+inline constexpr std::uint64_t fnvOffset=0xcbf29ce484222325ULL,fnvPrime=0x100000001b3ULL;
+inline std::uint64_t fnv1a(const void* data,std::size_t size,std::uint64_t hash=fnvOffset) noexcept {
+    const auto* b=static_cast<const unsigned char*>(data);
+    for(std::size_t i=0;i<size;++i){hash^=b[i];hash*=fnvPrime;}
+    return hash;
+}
+inline std::uint64_t checksum(const FileImage& image) noexcept {
+    return fnv1a(&image.payload,sizeof(image.payload),fnv1a(&image.header,offsetof(FileHeader,checksum)));
+}
+// The header of image.payload (the caller copied the recording there).
+inline void encode(const Info& info,std::uint64_t recordedAt,FileImage& image) noexcept {
+    FileHeader& h=image.header;h={};
+    h.magic=fileMagic;h.version=fileVersion;h.headerBytes=sizeof(FileHeader);h.flags=info.flags;h.exe=exeSha256;
+    h.build=build;h.animation=rk::animation;h.skeleton=rk::skeleton;h.rig=rk::rig;h.clip=rk::reloadClip;
+    h.action=static_cast<std::uint16_t>(rk::actionReload);h.actionSpecial=static_cast<std::uint16_t>(rk::actionReloadSpecial);
+    h.knots=knots;h.bones=bones;h.frameBytes=sizeof(Frame);
+    h.tFirst=info.tFirst;h.tLast=info.tLast;h.maxGap=info.maxGap;h.duration=info.duration;h.speed=info.speed;
+    h.samples=info.samples;h.payloadBytes=sizeof(Recording);h.recordedAt=recordedAt;
+    h.checksum=checksum(image);
+}
+// Load results (the probe's fileLoadResult; akimbo.cpp logs the name).
+enum class Load:unsigned {none,loaded,missing,io,size,magic,exe,tags,shape,checksum,frames,coverage,structure};
+inline const char* load_name(Load r) noexcept {
+    constexpr const char* names[]{"none","loaded","missing","io","size","magic","exe","tags","shape","checksum","frames","coverage","structure"};
+    const auto i=static_cast<unsigned>(r);return i<std::size(names)?names[i]:"unknown";
+}
+// Validates a file image of `bytes` bytes, in this order: size; magic, version
+// and header size; the exe digest; build and tags; knots, bones and frame size;
+// the checksum; every frame; the coverage and its flags; the structure checks.
+inline Load validate(const FileImage& image,std::uint64_t bytes,Info& info) noexcept {
+    info={};
+    const FileHeader& h=image.header;
+    if(bytes!=sizeof(FileImage))return Load::size;
+    if(h.magic!=fileMagic||h.version!=fileVersion||h.headerBytes!=sizeof(FileHeader))return Load::magic;
+    if(h.exe!=exeSha256)return Load::exe;
+    if(h.build!=build||h.animation!=rk::animation||h.skeleton!=rk::skeleton||h.rig!=rk::rig||h.clip!=rk::reloadClip
+        ||h.action!=rk::actionReload||h.actionSpecial!=rk::actionReloadSpecial)return Load::tags;
+    if(h.knots!=knots||h.bones!=bones||h.frameBytes!=sizeof(Frame)||h.payloadBytes!=sizeof(Recording))return Load::shape;
+    if(h.checksum!=checksum(image))return Load::checksum;
+    for(const auto& k:image.payload.knot)for(const auto& f:k)if(!valid(f))return Load::frames;
+    const bool complete=(h.flags&flagComplete)!=0,provisional=(h.flags&flagProvisional)!=0,headTail=(h.flags&flagHeadTail)!=0;
+    if(!std::isfinite(h.tLast)||complete==provisional||(complete&&!(h.tLast>=rk::recordComplete))
+        ||(provisional&&!(h.tLast>=rk::recordProvisional&&h.tLast<rk::recordComplete))||!(h.maxGap>=0&&h.maxGap<=rk::recordMaxGap))return Load::coverage;
+    // Runtime v5: the first sample within the arming window, and flagHeadTail
+    // exactly on a complete recording whose head was sampled by recordHeadPhase.
+    if(!(h.tFirst>=0&&h.tFirst<=rk::recordArmPhase)||(h.flags&~(flagComplete|flagHeadTail|flagProvisional))
+        ||headTail!=(complete&&h.tFirst<=rk::recordHeadPhase))return Load::coverage;
+    if(structure(image.payload,h.tLast,headTail,h.maxGap))return Load::structure;
+    info={h.tFirst,h.tLast,h.maxGap,h.duration,h.speed,h.samples,h.flags};
+    return Load::loaded;
+}
