+  if(visited)return Result::pending;
+  if(!candidate_.equipment||!candidate_.active||!candidate_.model||!candidate_.sturm.key.root||!candidate_.drang.key.root)return refuse("identity");
+  if(!linked_) {
+   for(unsigned i=0;i<linkCount_;++i) {
+    if(linkHeaders_[i].owner==candidate_.sturm.key.owner) {
+     if(candidate_.sturmLink)return refuse("identity");candidate_.sturmLink=links_[i];candidate_.sturmLinkHeader=linkHeaders_[i];
