+class Probe {
+    SRWLOCK lock_{};
+    std::atomic<bool> armed_{};
+    std::atomic<unsigned> liveJobs_{};
+    std::atomic<std::uint64_t> lastJobAt_{};
+    std::atomic<std::uint32_t> localOwner_{};
+    std::atomic<std::uint64_t> localAt_{};
+    std::atomic<bool> localRatKing_{};
+    Counters* counters_{};
+    std::array<wchar_t,512> directory_{};std::size_t directoryLength_{};
+    std::array<Rig,16> rigs_{};
+    std::array<Job,64> jobs_{};unsigned nextJob_{};
+    std::array<PoseFile,poseFiles> files_{};
+    // io_[i] is touched only by the thread that set ioBusy_[i].
+    std::array<PoseIo,poseFiles> io_{};
+    std::array<std::atomic<bool>,poseFiles> ioBusy_{};
+    // Set by a last sample that could not close its file; cleared by whoever
+    // then closes it (the next export of the rig, or reset).
+    std::array<std::atomic<bool>,poseFiles> closePending_{};
+    Budget<rigRatKingRecords,rigRecords> rigSeen_{};Budget<jobRatKingRecords,jobRecords> jobSeen_{};
+    Budget<actionRatKingRecords,actionRecords> actionSeen_{};
+    Budget<firingRatKingRecords,firingLocalRecords> firingLocal_{};Seen<firingOtherRecords> firingOther_{};
+    Budget<hudRatKingRecords,hudRecords> hudSeen_{};Budget<soundRatKingRecords,soundRecords> soundSeen_{};
+    Budget<fxAllocateRatKingRecords,fxAllocateRecords> fxAllocateSeen_{};Budget<fxCollectRatKingRecords,fxCollectRecords> fxCollectSeen_{};
+    struct Walk {std::uint64_t key{},at{};};
+    std::array<Walk,16> walks_{};unsigned nextWalk_{};
+
+    [[nodiscard]] bool local(std::uint32_t owner,std::uint64_t now) const noexcept {
+        const auto at=localAt_.load(std::memory_order_acquire);
+        return owner&&owner!=0xffffffff&&owner==localOwner_.load(std::memory_order_acquire)&&now>=at&&now-at<=localWindowMs;
+    }
+    /** The local weapon is a probed rig carrying a native Rat King model. Call after local(). */
+    [[nodiscard]] bool local_rat_king() const noexcept {return localRatKing_.load(std::memory_order_acquire);}
+    void close_pose_files() noexcept {
+        for(unsigned i=0;i<poseFiles;++i){
+            // A writer still holding the slot keeps it; reset runs only when idle.
+            if(ioBusy_[i].exchange(true,std::memory_order_acquire))continue;
+            if(io_[i].handle!=INVALID_HANDLE_VALUE)CloseHandle(io_[i].handle);
+            io_[i]={};closePending_[i].store(false,std::memory_order_relaxed);
+            ioBusy_[i].store(false,std::memory_order_release);
+        }
+    }
+    static void log_pose(const char* stage,const PoseFile& file,unsigned frame,const char* last) noexcept {
+        Line line{};std::size_t used=0;
+        append(line,used,"ev=akimbo_probe kind=pose stage=%s rk=%u anim=%08X skel=%08X rig=%08X nodes=%u frame=%u file=akimbo-probe-pose-%08X%s.bin",
+            stage,file.ratKing?1U:0U,file.animation,file.skeleton,file.rig,file.nodes,frame,file.animation,file.ratKing?"":"-other");
+        // last= on done lines: written (the last sample landed), failed (its
+        // write failed) or dropped (it lost the slot or its pose was unreadable).
+        if(last)append(line,used," last=%s",last);
+        emit(line,used);
+    }
+    // A pending close left by a dropped last sample. A writer still holding
+    // the slot keeps it; the next export of the rig retries.
+    void finish_pose_file(unsigned slot,const PoseFile& file) noexcept {
+        if(ioBusy_[slot].exchange(true,std::memory_order_acquire))return;
+        const bool finish=closePending_[slot].exchange(false,std::memory_order_acq_rel);
+        auto& io=io_[slot];
+        if(finish&&io.handle!=INVALID_HANDLE_VALUE){CloseHandle(io.handle);io.handle=INVALID_HANDLE_VALUE;}
+        ioBusy_[slot].store(false,std::memory_order_release);
+        if(finish)log_pose("done",file,poseFrames-1,"dropped");
+    }
+    // Caller holds lock_.
+    int find_rig(std::uintptr_t animation,std::uint32_t self) const noexcept {
+        for(unsigned i=0;i<rigs_.size();++i)if(rigs_[i].animation==animation&&rigs_[i].self==self)return static_cast<int>(i);
+        return -1;
+    }
+    int store_rig(const Rig& r) noexcept {
+        int slot=-1;std::uint64_t oldest=~0ULL;
+        for(unsigned i=0;i<rigs_.size();++i){
+            if(rigs_[i].animation==r.animation){slot=static_cast<int>(i);break;}
+            if(rigs_[i].examinedAt<oldest){oldest=rigs_[i].examinedAt;slot=static_cast<int>(i);}
+        }
+        rigs_[static_cast<unsigned>(slot)]=r;return slot;
+    }
+    int pose_file(const Rig& r) noexcept {
