+        // neutral after that offset, relative to the animated common root.
+        // Inverting the current offset keeps the quiet gun in the same shown
+        // position through hip/ADS transitions, without suppressing common
+        // controller movement or dropping the correction when aim changes.
+        const Frame alignment=compose(inverse(controller),compose(blend(Frame{},sightAlignment,aim),controller));
