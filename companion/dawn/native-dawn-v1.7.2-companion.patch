--- /dev/null
+++ b/Dawn/unit/akimbo_burst_cadence_tests.cpp
@@ -0,0 +1,102 @@
+#include "../src/client/hooks/akimbo/burst_cadence.h"
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <vector>
+
+namespace b=dawn::client::hooks::akimbo::burst;
+namespace p=dawn::client::hooks::akimbo::burst_phase;
+namespace c=dawn::client::hooks::akimbo::burst_cadence;
+static unsigned checks{};
+static void check_impl(bool value,unsigned line){++checks;if(!value){std::fprintf(stderr,"failed check %u at line %u\n",checks,line);std::exit(1);}}
+#define check(...) check_impl((__VA_ARGS__),__LINE__)
+static bool near(float a,float z){return std::abs(a-z)<.00002f;}
+struct Event {unsigned hand{},ordinal{};float at{};};
+
+// A three-round phase fixture supplies the native-returned intervals unchanged.
+// It is deliberately an ABI-independent clock test, not a substitute for native
+// phase qualification or an assertion that a production hook has been enabled.
+static void timeline(float frame,unsigned frames){
+    c::State state{};state.hands={p::Snapshot{1,0,.025f},p::Snapshot{1,0,.075f}};
+    float now=0,shared=0;unsigned calls=0;std::vector<Event> events;
+    const std::array<float,2> interval{.10f,.15f};
+    for(unsigned f=0;f<frames;++f){
+        auto result=c::advance(state,frame,[&](const c::Context& context,const auto& hands){
+            check(context.step>0&&context.elapsed<=frame&&context.remaining>=0);
+            check(hands[0].valid()&&hands[1].valid());shared+=context.step;++calls;return true;
+        },[&](unsigned side,const c::Context& context,p::Snapshot& hand){
+            check(context.step>=0&&context.elapsed<=frame);
+            if(hand.phase==0||hand.remaining>0)return c::Transition::unchanged;
+            if(hand.phase==1){
+                events.push_back({side,hand.ordinal,now+context.elapsed});
+                ++hand.ordinal;hand.remaining=interval[c::index(side)];
+                if(hand.ordinal==3){hand.phase=4;hand.remaining=.25f;}
+            }else{hand={};}
+            return c::Transition::changed;
+        });
+        if(!result.complete)std::fprintf(stderr,"timeline dt %.9g frame %u time %.9g, advances %u transitions %u L %u/%.9g R %u/%.9g\n",frame,f,result.advanced,result.advances,result.transitions,state.hands[0].phase,state.hands[0].remaining,state.hands[1].phase,state.hands[1].remaining);
+        check(result.complete&&!state.busy&&!state.failed&&near(result.advanced,frame));now+=frame;
+    }
+    check(near(shared,now)&&calls>0);check(events.size()==6);
+    const std::array<float,3> left{.025f,.125f,.225f},right{.075f,.225f,.375f};
+    for(const auto& event:events){check(event.ordinal<3);check(near(event.at,(event.hand==b::left?left:right)[event.ordinal]));}
+    check(state.hands[0].idle()&&state.hands[1].idle());
+}
+int main(){
+    timeline(.01f,80);timeline(.02f,40);timeline(.05f,16);timeline(.1f,8);timeline(.8f,1);
+    // Time spent with one idle/blocked hand still advances its partner normally.
+    for(unsigned count=2;count<=64;++count){
+        c::State s{};s.hands[0]={1,0,0};unsigned fired=0;float shared=0;
+        auto r=c::advance(s,.8f,[&](auto ctx,const auto&){shared+=ctx.step;return true;},
+            [&](unsigned side,auto,p::Snapshot& h){
+                if(side==b::right||h.phase==0||h.remaining>0)return c::Transition::unchanged;
+                ++fired;++h.ordinal;h.remaining=.01f;if(fired==count)h={};return c::Transition::changed;
+            });
+        check(r.complete&&fired==count&&near(shared,.8f)&&s.hands[1].idle());
+    }
+    // Tied deadlines alternate callback order, without altering either interval.
+    c::State ties{};ties.hands={p::Snapshot{1,0,.1f},p::Snapshot{1,0,.1f}};std::vector<unsigned> order;
+    auto tr=c::advance(ties,.41f,[](auto,const auto&){return true;},[&](unsigned side,auto,p::Snapshot& h){
+        if(h.remaining>0)return c::Transition::unchanged;
+        order.push_back(side);++h.ordinal;h.remaining=.1f;return c::Transition::changed;
+    });
+    check(tr.complete&&order==std::vector<unsigned>({b::left,b::right,b::right,b::left,b::left,b::right,b::right,b::left}));
+    // No native effects for dt0 or malformed input, and no reentrant driver.
+    const auto untouched=[](auto,const auto&){check(false);return true;};
+    const auto uncalled=[](unsigned,auto,p::Snapshot&){check(false);return c::Transition::unchanged;};
+    c::State z{};check(c::advance(z,0,untouched,uncalled).complete);
+    for(float bad:{-1.f,61.f,std::numeric_limits<float>::infinity(),std::numeric_limits<float>::quiet_NaN()}){
+        c::State s{};check(!c::advance(s,bad,untouched,uncalled).complete&&!s.failed&&!s.busy);
+    }
+    z.busy=true;check(!c::advance(z,1,untouched,uncalled).complete&&z.busy);
+    // Failed callbacks retain completed effects/time and poison replay; do not
+    // claim rolling back a C++ snapshot also rolled back native shots/debits.
+    c::State fault{};fault.hands[0]={1,0,.1f};unsigned steps=0;
+    auto fr=c::advance(fault,.5f,[&](auto,const auto&){return ++steps!=2;},
+        [](unsigned side,auto,p::Snapshot& h){if(side==b::right||h.remaining>0)return c::Transition::unchanged;
+            ++h.ordinal;h.remaining=.1f;return c::Transition::changed;});
+    check(!fr.complete&&fault.failed&&!fault.busy&&near(fr.advanced,.1f)&&fault.hands[0].ordinal==1);
+    check(!c::advance(fault,1,untouched,uncalled).complete);
+    c::State invalid{};auto ir=c::advance(invalid,1,untouched,
+        [](unsigned,auto,p::Snapshot& h){h.remaining=-1;return c::Transition::changed;});
+    check(!ir.complete&&invalid.failed);
+    // An unchanged result is a promise, not permission to hide a mutation.
+    c::State hidden{};check(!c::advance(hidden,1,untouched,
+        [](unsigned,auto,p::Snapshot& h){h.ordinal=1;return c::Transition::unchanged;}).complete&&hidden.failed);
+    // Native's six immediate transitions bound is applied per lane. A broken
+    // zero-duration cycle stops before it can spin indefinitely.
+    c::State cycle{};unsigned changed=0;auto cr=c::advance(cycle,1,untouched,
+        [&](unsigned,auto,p::Snapshot& h){++changed;h.phase=h.phase==0?1:0;return c::Transition::changed;});
+    check(!cr.complete&&cycle.failed&&changed==13);
+    // Forced stop/recovery observes a fresh native input even before its own
+    // deadline. Waiting until remaining==0 would incorrectly keep firing.
+    c::State stop{};stop.hands={p::Snapshot{1,1,.6f},p::Snapshot{3,2,.7f}};
+    unsigned polled=0;const auto sr=c::advance(stop,.05f,[](auto,const auto&){return true;},
+        [&](unsigned side,const c::Context& ctx,p::Snapshot& h){
+            check(near(ctx.step,.05f)&&near(ctx.elapsed,.05f));++polled;
+            if(side==b::left){h.phase=4;h.remaining=.2f;return c::Transition::changed;}
+            check(h.phase==3&&near(h.remaining,.65f));return c::Transition::unchanged;
+        });
+    check(sr.complete&&polled==2&&stop.hands[0].phase==4&&near(stop.hands[0].remaining,.2f));
+    std::printf("burst cadence: %u checks passed\n",checks);
+}
