+        ||native.originCount!=c||native.targetCount!=c||native.poseCount!=c
+        ||(native.flags&0xfffff000u)!=0x12000||group.valid||group.start||group.capacity!=c)return false;
+    output.originCount=output.targetCount=output.poseCount=2*c;metadata.capacity=static_cast<std::int16_t>(2*c);return true;
+}
+// ---- Allocation (fx_allocate_hook, 1206F00 called from 12067C6) -----------------------
+inline constexpr std::uintptr_t allocateCaller=0x12067c6;
+struct Allocation {firing_effects::Sequence sequence{};Selector item{};unsigned nativeCount{};};
+// Before the native allocation: the always-on sequence of the private akimbo
+// (after the owner walk) and a pinned local selector whose particle asset is
+// the one being allocated. nativeCount: its capacity, the emitter count whose
+// pose buffer fx_pose_allocate_hook doubles (effects::doubles_pose_allocation).
+inline bool qualify(const Memory& m,std::uintptr_t callerRva,std::uintptr_t sequence,std::uintptr_t particle,
+                    std::uintptr_t selectorAddress,Allocation& out) noexcept {
+    out={};firing_effects::Sequence s{};Selector item{};std::uintptr_t asset{};
+    if(callerRva!=allocateCaller||!firing_effects::sequence(m,sequence,s)||s.profile!=&firing_effects::ratKingGlow
+        ||!selector(m,s,selectorAddress,item)||!hud::detail::resolve(m,item.particle,asset)||asset!=particle
+        ||!firing_effects::private_owner(m,s))return false;
+    out={s,item,item.capacity};return true;
+}
+// Why a qualified allocation stayed native (the probe's glowAllocateStage).
+namespace stage {
+inline constexpr unsigned ok=0,notDoubled=1,notValid=2,output=3,metadata=4,group=5,shape=6,owner=7,rowWrite=8,outputWrite=9,disabled=10;
+}
+struct AllocationPatch {std::uintptr_t row{};effects::Group before{},after{};effects::Allocation output{};};
+// After the native allocation: its pose buffer was doubled (doubled, at
+// offset), the output {c,c,c} becomes {2c,2c,2c} and the group's capacity 2c,
+// after the owner walk again. The caller writes the row (after), then the
+// output, and restores the row (before) if the output write fails.
+inline unsigned allocation_patch(const Memory& m,std::uintptr_t moduleBase,const Allocation& a,bool doubled,std::uint64_t offset,
+                                 std::uintptr_t validAddress,std::uintptr_t outputAddress,AllocationPatch& out) noexcept {
+    out={};bool ok{};effects::Allocation native{};effects::Group group{};std::uintptr_t row{};
+    if(!doubled)return stage::notDoubled;
+    if(!read(m,validAddress,ok)||!ok)return stage::notValid;
+    if(!read(m,outputAddress,native))return stage::output;
+    if(!effects::metadata_address(m,moduleBase,native.metadata,row))return stage::metadata;
+    if(!read(m,row,group))return stage::group;
+    AllocationPatch p{};p.row=row;p.before=group;
+    if(!expand(native,group,offset,a.item,p.output,p.after))return stage::shape;
